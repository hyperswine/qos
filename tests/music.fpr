# music.fpr -- the music channel: an MP3 beside the .qa (or under
# FPR_ASSETS), decoded by the host as it plays.  Plays three seconds of
# models/music/Skyward_Little_World.mp3 at half volume with a chime on
# top, then quits.  With FPR_SND_DUMP set, the mix lands in a WAV the
# check reads back: the decoder is proven by the sound being there.
#
#   make qos-app PROG=tests/music.fpr
#   (cd qos && FPR_ASSETS=../models/music ./qosp --yes ../app.qa)
#: music ../models/music/Skyward_Little_World.mp3

unsafe program.

main =
  r = sndMusic "Skyward_Little_World.mp3" 500;
  _ = sndPlay (2, 660, 660, 120, 300, 800);
  _ = Sys.sleepUs 3000000;
  _ = sndMusic "" 0;
  "music: start={r} (1 playing, 0 off, -1 not found)".

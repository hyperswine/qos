# qsys.fpr (test) -- stage 3: the System layer as a module, apps
# ENUMERATED off the disk instead of hardcoded, the namespace exercised
# end to end.  QS.boot spawns registry/storage/log/files/vfs, reads
# apps/index, attaches every apps/<id>.qa it names (manifest identity,
# skip-on-error), and returns the Qsys record.  This test then:
#
#   1. reports the attached set (ids from MANIFESTS, not from any list
#      compiled into this image -- add a .qa to the disk, reboot, it
#      appears with zero shell changes)
#   2. calls one export from EACH plugin through its table index
#   3. writes /tmp/note.txt through the vfs (create-on-write) and reads
#      it back; content length counts boots -- run twice, it grows
#   4. lists the namespace and logs one line through /services/log
#
#   make qos-app-macos PROG=tests/qsys.fpr
#   make plugsyms-macos
#   make plugin-qa-macos PROG=tests/plugmini.fpr  PLUGSLOT=0
#   make plugin-qa-macos PROG=tests/plughello.fpr PLUGSLOT=1
#   cd qos && make disk-seed QAS="../plugmini.qa ../plughello.qa" \
#     && make portable && ./qosp --yes ../app.qa      # run TWICE
#
# (The seed resets the disk; the SECOND run without re-seeding is the
# persistence leg: boot #2, note bytes doubled.)

QS = use "../programs/mods/qsys".
AK = use "../programs/mods/appkit".

Qsys = QS.Qsys.
App  = QS.App.

main =
  me = myself 0;
  q = QS.boot me;
  Qsys sys st vfs log apps = q;
  case QS.lenL apps == 0 of
    True -> "qsys: booted, but no apps on the disk (seed it first)"
  | False -> run me vfs log apps.

run : unsafe Int -> Int -> Int -> List App -> String .
run me vfs log apps =
  n = QS.lenL apps;
  ping = callAt apps "plugmini" "plugPing" 0;
  hi = callAt apps "plughello" "helloTitle" 0;
  dbl = callIAt apps "plughello" "helloDouble" 21;
  _ = QS.call me vfs (AK.Write "/tmp/note.txt" "hi ");
  body = QS.call me vfs (AK.Read "/tmp/note.txt");
  boots = strlen body / 3;
  paths = QS.lenL (QS.call me vfs (AK.VfsList 0));
  _ = QS.call me log (AK.LogAdd 0 "qsys test: boot #{boots} complete");
  ids = QS.appIds apps;
  nb = strlen body;
  lg = Sys.logSeq 0;
  "qsys: boot #{boots}; {n} apps [{ids}]; ping={ping}; hello={hi}; 21+21={dbl}; note={nb}B; {paths} paths; logs={lg}".

# resolve export `nm` in the app whose manifest id is `aid`, call it
tblOf : unsafe List App -> String -> Int .
tblOf apps aid = case apps of
    Nil -> 0 - 1
  | a :: r -> tblStep r aid a.
tblStep : unsafe List App -> String -> App -> Int .
tblStep r aid a = case a of App id nm ti ->
  case QS.strEq id aid of True -> ti | False -> tblOf r aid.

callAt : unsafe List App -> String -> String -> Int -> String .
callAt apps aid nm u = callAt2 nm u (tblOf apps aid).
callAt2 nm u ti = case ti < 0 of
    True -> "(app missing)"
  | False -> callAt3 u (Mod.findAt ti nm).
callAt3 u fr =
  (f, f') = fr;
  case f == 1 of
    True -> f' u
  | False -> "(export missing)".

callIAt : unsafe List App -> String -> String -> Int -> Int .
callIAt apps aid nm x = callIAt2 nm x (tblOf apps aid).
callIAt2 nm x ti = case ti < 0 of
    True -> 0 - 1
  | False -> callIAt3 x (Mod.findAt ti nm).
callIAt3 x fr =
  (f, f') = fr;
  case f == 1 of
    True -> f' x
  | False -> 0 - 1.

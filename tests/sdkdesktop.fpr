# Prebuilt acceptance driver: attaches the externally built SDK counter.
unsafe program.
QL = use "../programs/mods/qlog#7022992c8e4a9fba".
Plug = use "../programs/mods/plug".
AP = use "../programs/mods/appclient".
AW = use "../programs/mods/appwire".
S = use "../programs/mods/scene2d".
AC = use "std/actor#201a0e9bf98a5154".
check tag True = Unit.
check tag False = error "sdkdesktop: {tag}".
status (Ok (AW.Frame sid rev tree values text)) = text.
status other = "invalid frame".
awaitClock me state left =
  if left <= 0 then error "sdkdesktop: clock effect did not complete" else
    (fresh, frame) = AP.exchange me AW.Tick state;
    if status frame == "clock ready" then fresh else
      _ = Sys.sleepUs 5000; awaitClock me fresh (left - 1).
main =
  disk = QL.direct (device "blk");
  head = QL.ensure disk;
  qa = case QL.readLatest disk head "apps/counter-example.qa" of Ok bytes -> bytes | Err why -> error why;
  table = Mod.plugs 0;
  _ = case Plug.attach qa of Ok u -> Unit | Err why -> error why;
  me = myself 0;
  (opened, first) = AP.launch 0 0 800 480 me table AP.empty;
  _ = check "open with Main session client" (status first == "Count: 0");
  (one, incremented) = AP.exchange me (AW.Key 57) opened;
  _ = check "SPACE increments" (status incremented == "Count: 1");
  (two, incrementedAgain) = AP.exchange me (AW.Key 57) one;
  _ = check "second increment" (status incrementedAgain == "Count: 2");
  stale = AC.callWithin 500 me two.actor (AW.Event two.session two.sequence AW.Tick);
  _ = check "stale sequence refused" (case stale of Ok (AW.Refused why) -> True | other -> False);
  (sized, frame) = AP.exchange me (AW.Resize 1024 600) two;
  _ = check "resize reaches viewport" (case frame of
      Ok (AW.Frame sid rev (S.Box attrs children) values text) -> S.wOf attrs == 1024 and S.hOf attrs == 600
    | other -> False);
  (reset, zero) = AP.exchange me (AW.Key 14) sized;
  _ = check "BACKSPACE resets" (status zero == "Count: 0");
  (idle, closed) = AP.leave me reset;
  _ = check "bounded close acknowledged" (case closed of Ok (AW.Closed sid (Ok u)) -> idle.actor == 0 | other -> False);
  _ = Sys.sleepUs 10000;
  _ = check "app stopped" (not (Sys.alive reset.actor));
  (reopened, fresh) = AP.launch 0 0 800 480 me table idle;
  _ = check "session state resets on reopen" (status fresh == "Count: 0");
  (done, ended) = AP.leave me reopened;
  _ = check "second close" (case ended of Ok (AW.Closed sid (Ok u)) -> True | other -> False);
  clockQa = case QL.readLatest disk head "apps/clock-example.qa" of Ok bytes -> bytes | Err why -> error why;
  clockTable = Mod.plugs 0;
  _ = case Plug.attach clockQa of Ok u -> Unit | Err why -> error why;
  (clock, clockFrame) = AP.launch 0 0 800 480 me clockTable AP.empty;
  readyClock = if status clockFrame == "clock ready" then clock else awaitClock me clock 100;
  (clockDone, clockClosed) = AP.leave me readyClock;
  _ = check "clock effect and cleanup" (case clockClosed of Ok (AW.Closed sid (Ok u)) -> True | other -> False);
  "sdkdesktop: HOLDS".

# sysed2 -- compatible successor: capitalize the first letter.
editLine s = case strlen s == 0 of
    True -> s
  | False -> "{upA (charAt s 1)}{substr s 2 (strlen s - 1)}".
upA c = case c >= 97 of True -> upB c | False -> chr c.
upB c = case c <= 122 of True -> chr (c - 32) | False -> chr c.
editName u = "sys.v2".

# dungeon.fpr -- the dungeon's rules, played headlessly and asserted.
#
# The point of splitting mods/dungeonrules.fpr out of the game: a turn is
# `R.key model code -> model`, a pure function, so a whole game is a fold
# of key codes over the model and every mechanic can be checked without a
# GPU, a window, a frame loop or a single frame of animation.  The Java
# original needed a JavaFX stage and four controllers to do the same.
#
#   make qos-app PROG=tests/dungeon.fpr && (cd qos && ./qosp --yes ../app.qa)
unsafe program.

R = use "../programs/mods/dungeonrules".

Wall = R.Wall.
Boulder = R.Boulder.
Switch = R.Switch.
Treasure = R.Treasure.
Key = R.Key.
Door = R.Door.
Portal = R.Portal.
Exit = R.Exit.
Potion = R.Potion.
Nuke = R.Nuke.
Ob = R.Ob.
En = R.En.
Untouchable = R.Untouchable.
Armed = R.Armed.

# key codes, by the name the player would use
kUp = 17.      # w
kDown = 31.    # s
kLeft = 30.    # a
kRight = 32.   # d
kAct = 57.     # space
kSlot1 = 2.

# a game is a fold of keys over the model
play m Nil = m.
play m (k :: r) = play (R.key m k) r.
# the same, from a fresh board already in play
fresh = R.key R.initModel kAct.
# the board with nobody hunting you: the object rules (boulders, doors,
# portals) are about the objects, and a wandering enemy standing in the
# corridor would only make the script flaky.  Lifting them out is one
# field of an immutable record -- which is the whole argument for keeping
# the rules pure.
quiet = quietOf fresh.
quietOf m = { m | ens = Nil }.

expect what got want = case got == want of
    True -> print "ok  {what}"
  | False -> print "FAIL {what}: got {got}, wanted {want}".
expectT what got = case got of
    True -> print "ok  {what}"
  | False -> print "FAIL {what}".

# ---- the board reads back as it was written --------------------------------------------
t1 =
  m = fresh;
  _ = expect "the player starts where '@' is" (m.px, m.py) (1, 1);
  _ = expect "three enemies" (R.lenOf m.ens) 3;
  _ = expect "three treasure" (R.countKind m.obs Treasure) 3;
  _ = expect "two switches" (R.countKind m.obs Switch) 2;
  _ = expectT "the wall ring is solid" (R.blocked m 0 0 and R.blocked m 18 12);
  _ = expectT "the floor is not" (not (R.blocked m 2 1));
  0.

# ---- treasure, and the goal that counts it ----------------------------------------------
t2 =
  m = play fresh (kRight :: kRight :: kRight :: Nil);   # (1,1) -> (4,1), the 'T'
  _ = expect "walking over treasure takes it" m.took 1;
  _ = expect "and it leaves the board" (R.countKind m.obs Treasure) 2;
  _ = expectT "the treasure goal is not met yet" (not (R.goalMet m R.GTreasure));
  0.

# ---- the sword: a stance, and five swings -----------------------------------------------
t3 =
  m = play fresh (kRight :: kDown :: kDown :: Nil);     # (2,3), the 'W'
  _ = expect "the sword arms you" m.swings 5;
  _ = expectT "and the stance follows the model" (R.stanceOf m == Armed);
  _ = expect "bare hands hit for 1, a sword for 3" (dmgOf m) 3;
  0.
dmgOf m = (d, taken, rad) = R.statsOf m; d.

# ---- a boulder onto a switch: the BOULDERS goal -----------------------------------------
# (1,1) -> east to the column-4 gap, south to (4,8), west to (3,8), face
# north into the boulder at (3,7) -- blocked, which is what turns you --
# then act: the boulder slides onto the switch at (3,6).
t4 =
  m = play quiet (kRight :: kRight :: kRight ::
                  kDown :: kDown :: kDown :: kDown :: kDown :: kDown :: kDown ::
                  kLeft :: kUp :: kAct :: Nil);
  _ = expectT "the boulder moved onto the switch" (R.hasKind (R.atOf m.obs 3 6) Boulder);
  _ = expectT "and left the tile it was on" (not (R.hasKind (R.atOf m.obs 3 7) Boulder));
  _ = expectT "one switch is not both" (not (R.goalMet m R.GBoulders));
  0.

# ---- a door opens only to its own key ---------------------------------------------------
# Door 1 sits at (9,3); its key is at (7,3).  Row 3 is walled at x=5, so
# the way in is along row 1 and down the x=8 column.  Try the door first
# with an empty bag, then take the key and try again.
t5 =
  atDoor = play quiet (kRight :: kRight :: kRight :: kRight :: kRight ::
                       kRight :: kRight :: kDown :: kDown :: Nil);
  _ = expect "you stop at the door" (atDoor.px, atDoor.py) (8, 3);
  locked = R.key atDoor kAct;
  _ = expectT "a door with no key stays shut" (R.hasKind (R.atOf locked.obs 9 3) (Door 1));
  # step back onto the key at (7,3), then return and open it
  opened = play locked (kLeft :: kRight :: kAct :: Nil);
  _ = expectT "the key is in the bag" (R.hasKind opened.inv (Key 1));
  _ = expectT "and the door is open" (not (R.hasKind (R.atOf opened.obs 9 3) (Door 1)));
  _ = expectT "the key is NOT spent" (R.hasKind opened.inv (Key 1));
  0.

# ---- the potion: a stance change the enemies read ----------------------------------------
t6 =
  m = fresh;
  m1 = { m | inv = Potion :: Nil };
  m2 = R.key m1 kSlot1;
  _ = expectT "the potion makes you untouchable" (R.stanceOf m2 == Untouchable);
  _ = expect "for six turns" m2.invT 6;
  _ = expect "and it leaves the bag" (R.lenOf m2.inv) 0;
  0.

# ---- the nuke clears its neighbourhood ---------------------------------------------------
t7 =
  m = fresh;
  # put the player next to two enemies and give them a nuke
  m1 = { m | px = 5, py = 5, inv = Nuke :: Nil,
             ens = En 1 5 6 4 :: En 2 6 5 4 :: En 3 15 11 4 :: Nil };
  m2 = R.key m1 kSlot1;
  _ = expect "the two next to you are gone" (R.lenOf m2.ens) 1;
  _ = expectT "the one across the room is not" (survives m2.ens 3);
  0.
survives Nil i = False.
survives (En j x y hp :: r) i = case j == i of True -> True | False -> survives r i.

# ---- enemies pursue, and flee while you glow ---------------------------------------------
# One enemy, three tiles east on an open row; the player holds still by
# pressing into a wall.  Enemies act on every second turn, so two waits
# close one tile.
t8 =
  m = fresh;
  one = { m | px = 2, py = 1, ens = En 1 6 1 4 :: Nil, turn = 0 };
  after = play one (kUp :: kUp :: kUp :: kUp :: Nil);   # north is the wall
  _ = expectT "an enemy closes on you" (nearer after.ens 6);
  glow = { one | invT = 6 };
  fled = play glow (kUp :: kUp :: kUp :: kUp :: Nil);
  _ = expectT "and runs while you are untouchable" (further fled.ens 6);
  0.
nearer Nil x0 = False.
nearer (En i x y hp :: r) x0 = x < x0.
further Nil x0 = False.
further (En i x y hp :: r) x0 = x > x0.

# ---- the goal tree: the composite, folded -------------------------------------------------
t9 =
  m = fresh;
  # the win condition is (treasure AND boulders) OR enemies, THEN the exit
  none = { m | ens = Nil, obs = Ob Exit 5 5 :: Nil, took = 3 };
  _ = expectT "no enemies satisfies the OR arm" (R.goalMet none R.GEnemies);
  _ = expectT "but the exit is still owed" (not (R.goalMet none R.goal0));
  done = { none | over = 1 };
  _ = expectT "reaching it completes the tree" (R.goalMet done R.goal0);
  _ = expect "the checklist has a line per node" (R.lenOf (R.goalLines done R.goal0)) 7;
  0.

# ---- a portal moves you to its twin --------------------------------------------------------
t10 =
  m = fresh;
  # the pair is at (16,8) and (14,11); walk east onto the first
  at = { m | px = 15, py = 8 };
  through = R.key at kRight;
  _ = expect "the portal puts you at its twin" (through.px, through.py) (14, 11);
  0.

# ---- dying ends the game -------------------------------------------------------------------
t11 =
  m = fresh;
  hurt = { m | hp = 2, px = 2, py = 1, ens = En 1 3 1 4 :: Nil };
  # walk into it bare-handed: 1 damage to it, 2 back to you, twice over
  dead = play hurt (kUp :: kUp :: kUp :: kUp :: kUp :: kUp :: Nil);
  _ = expectT "hp runs out" (dead.hp == 0);
  _ = expect "and the screen turns" dead.screen R.scLost;
  0.

main =
  _ = t1; _ = t2; _ = t3; _ = t4; _ = t5; _ = t6;
  _ = t7; _ = t8; _ = t9; _ = t10; _ = t11;
  _ = print "dungeon rules: done";
  0.

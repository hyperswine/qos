# mvuweb.fpr -- LV.server end to end: the SAME formal four (App init
# update subs view) that mvugame runs against a render service, served
# to a browser over the socket tier.
#
#   make qos-app PROG=tests/mvuweb.fpr
#   (cd qos && make portable && FPR_PORT=8123 ./qosp --yes ../app.qa)
#
# then from another shell (qos/tests-host/mvuweb-check.sh automates it):
#   curl http://127.0.0.1:8123/                    -> the page: CSS, __LV__
#                                                     seed, livejs, poll script
#   POST /live/event {"msg":"bump","arg":"5"}      -> {"d":{...}}   (delta)
#   POST /live/event {"msg":"__poll","arg":""}     -> ticks flushed  (delta)
#   POST /live/event {"msg":"theme","arg":""}      -> {"s":[...  (reshape:
#                                                     the class flip changes
#                                                     the statics)
#   POST /live/event {"msg":"quit","arg":""}       -> server answers, closes,
#                                                     qosp prints the result
#
# subs = STick 200: ticks advance the model server-side between
# requests AND the served page carries the 200 ms poll script.

MV = use "std/mvu".
G  = use "../programs/mods/genview".
LV = use "../programs/mods/liveview".

App = MV.App.
MQuit = MV.MQuit.
EMsg = MV.EMsg.
ETick = MV.ETick.
STick = MV.STick.

M = Type (M count ticks night).

wInit env = M 0 0 0.

wUpdate : unsafe _ -> _ -> _ -> _ .
wUpdate env ev m = case ev of
    ETick -> wTick m
  | EMsg msg arg -> wMsg msg arg m
  | e -> (m, Nil).
wTick m =
  M c t n = m;
  (M c (t + 1) n, Nil).
wMsg : unsafe String -> String -> _ -> _ .
wMsg msg arg m | G.strEq msg "bump" = wBump m (num arg).
wMsg msg arg m | G.strEq msg "theme" = wTheme m.
wMsg msg arg m | G.strEq msg "quit" = (m, MQuit :: Nil).
wMsg msg arg m = (m, Nil).
wBump m d =
  M c t n = m;
  (M (c + d) t n, Nil).
wTheme m =
  M c t n = m;
  (M c t (1 - n), Nil).

num : unsafe String -> Int .
num s = numGo s 1 0.
numGo : unsafe String -> Int -> Int -> Int .
numGo s i acc | i > strlen s = acc.
numGo s i acc = numCh s i acc (charAt s i).
numCh : unsafe String -> Int -> Int -> Int -> Int .
numCh s i acc c | and2 (c >= 48) (c <= 57) = numGo s (i + 1) (acc * 10 + (c - 48)).
numCh s i acc c = acc.
and2 a b = case a of True -> b | False -> False.

wSubs m = STick 200 :: Nil.

titleCls n = case n == 1 of True -> "text-lg upper warm" | False -> "text-lg upper acc".

wView m =
  M c t n = m;
  G.El "div" [G.Cls "col gap-2 p-4", G.Local "one" "1", G.Local "ten" "10"]
    [ G.El "div" [G.Cls (titleCls n)] [G.Txt "MVUWEB"]
    , G.El "div" [G.Cls "big tabular"] [G.Dyn "{c}"]
    , G.El "div" [G.Cls "dim text-sm"] [G.Txt "ticks ", G.Dyn "{t}"]
    , G.El "div" [G.Cls "row gap-2"]
        [ G.El "button" [G.Cls "btn round px-3 py-2", G.OnClick "bump" "one"] [G.Txt "+1"]
        , G.El "button" [G.Cls "btn round px-3 py-2", G.OnClick "bump" "ten"] [G.Txt "+10"]
        , G.El "button" [G.Cls "btn round px-3 py-2", G.OnClick "theme" ""] [G.Txt "theme"]
        , G.El "button" [G.Cls "btn round px-3 py-2", G.OnClick "quit" ""] [G.Txt "quit"] ] ].

main = LV.server (App wInit wUpdate wSubs wView).

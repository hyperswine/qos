unsafe program.
A = use "std/actor".
Pair = {x : Int, y : Int}.
add acc p = acc + p.x + p.y.
worker boss self =
  (before, _) = Sys.memStats 0;
  v = Vec.fromList [{x = 1, y = 2}, {x = 3, y = 4}];
  (sum, v) = Vec.fold add 0 v;
  _ = Vec.free v;
  _ = Sys.poolReset 0;
  (after, _) = Sys.memStats 0;
  _ = send boss (sum == 10 and before == after, myPid 0);
  Unit.
junk n = case n == 0 of True -> Nil | False -> n :: junk (n - 1).
length xs = case xs of Nil -> 0 | _ :: rest -> 1 + length rest.
overflow boss self = _ = length (junk 1000); send boss False >> Unit.
share value boss self = _ = sendArc boss value; Unit.
require (Ok a) = a.
require (Err why) = error why.
refused (Err _) = True.
refused _ = False.
main =
  me = myself 0;
  pid = myPid 0;
  invalid = refused (A.spawnWithHeap 0 (worker me));
  denied = refused (A.spawnWithHeap 1099511627776 (worker me));
  a = require (A.spawnWithHeap 131072 (worker me));
  (local, childPid) = receiveFrom me a;
  _ = receiveFromRes me a;
  b = require (A.spawnWithHeap 128 (overflow me));
  overrun = case receiveFromRes me b of Err "dead actor" -> True | _ -> False;
  c = require (A.spawnWithHeap 131072 (worker me));
  (next, _) = receiveFrom me c;
  _ = receiveFromRes me c;
  s = require (A.spawnWithHeap 131072 (share (20, 22) me));
  value = receiveFrom me s;
  _ = receiveFromRes me s;
  (x, y) = value;
  escaped = x + y;
  _ = drop value;
  _ = receiveNow me;
  samePid = pid > 0 and childPid == pid;
  "memoryproc: invalid={invalid} denied={denied} local={local} pid={samePid} overrun={overrun} next={next} escaped={escaped}".

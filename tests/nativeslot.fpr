# nativeslot.fpr -- a TEST KERNEL (built in place of programs/system.fpr):
# the native process slot refuses a second image while one is running, and
# refuses it BEFORE writing anything, so the running process is untouched.
#
#   make -C qos native SYSTEM=../tests/nativeslot.fpr KERNEL=<elf>
#   KERNEL=<elf> tools/build-process-app.sh tests/slowproc.fpr <toml> <qa>
#   tools/mkdisk.py <img> 8 <qa>;  qemu ... -kernel <elf> -drive <img>
#
# Expected: "nativeslot: second=refused first=intact
# linger=refused-then-accepted HOLDS"

FS = use "std/fs".
QAR = use "../programs/mods/qar".
QaImg = use "../programs/mods/qaimg".

Sys.placeImageAt : String -> Int -> Int -> List Int -> String -> (Int, String) .

# (ok, msg) of one placement of the archive, or (0, why) before placing
place : String -> (Int, String) .
place qa = case QAR.sectionBytes qa "LOAD" of
    Err e -> (0, "no LOAD: {e}")
  | Ok load -> place2 qa load.
place2 : String -> String -> (Int, String) .
place2 qa load = case QAR.extent qa "IMAGE" of
    Err e -> (0, "no IMAGE: {e}")
  | Ok r -> place3 qa load r.
place3 : String -> String -> (Int, Int) -> (Int, String) .
place3 qa load r =
  (ipos, iln) = r;
  case QaImg.parse load of
    Err e -> (0, "bad LOAD: {e}")
  | Ok m -> (case QaImg.check m iln of
      Err e -> (0, "bad image: {e}")
    | Ok m2 -> Sys.placeImageAt qa (ipos - 1) iln (QaImg.nums m2) "CkSlow\n").

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  case FS.readLatest me fs "apps/CkSlow.qa" of
    Err e -> "nativeslot: no apps/CkSlow.qa on the disk ({e})"
  | Ok slow -> (case FS.readLatest me fs "apps/CkLinger.qa" of
      Err e -> "nativeslot: no apps/CkLinger.qa on the disk ({e})"
    | Ok linger -> run me slow linger).

has s sub = strIndexOf sub s > 0.

# 1. a second placement while the first process runs: refused, and the first
#    process's result shows its code and data were not touched
# 2. a process whose main returned while its child still runs: the slot is
#    refused until the child ends, then accepted
run : unsafe Int -> String -> String -> String .
run me slow linger =
  (ok1, m1) = place slow;
  case ok1 == 2 of
    False -> "nativeslot: first placement failed: {m1}"
  | True -> run2 me slow linger (place slow).

run2 : unsafe Int -> String -> String -> (Int, String) -> String .
run2 me slow linger res =
  (ok2, m2) = res;
  second = case ok2 == 0 and has m2 "still running" of
      True -> "refused"
    | False -> "WRONG ({ok2} {m2})";
  first = case receiveRes me of Ok s -> s | Err e -> "failed: {e}";
  intact = case strCmp first "slowproc: intact 4500001500000" == 0 of
      True -> "intact"
    | False -> "WRONG ({first})";
  (okL, mL) = placeWhenFree linger 200;
  lingered = case okL == 2 of
      False -> "linger not placed ({mL})"
    | True -> lingerCheck me slow;
  verdict = case strCmp second "refused" == 0 and strCmp intact "intact" == 0 and strCmp lingered "refused-then-accepted" == 0 of
      True -> "HOLDS"
    | False -> "FAILED";
  "nativeslot: second={second} first={intact} linger={lingered} {verdict}".

lingerCheck : unsafe Int -> String -> String .
lingerCheck me slow =
  r = case receiveRes me of Ok s -> s | Err e -> "failed: {e}";
  (okA, mA) = place slow;
  case okA == 0 and has mA "still running" of
    False -> "not refused while the child ran ({okA} {mA}; main said {r})"
  | True -> lingerAfter me slow.
lingerAfter : unsafe Int -> String -> String .
lingerAfter me slow =
  (okB, mB) = placeWhenFree slow 400;
  case okB == 2 of
    False -> "never accepted ({mB})"
  | True -> (case receiveRes me of
      Ok s -> "refused-then-accepted"
    | Err e -> "accepted but failed: {e}").

# retry while the slot is still held (quiescence takes a moment); anything
# else is final
placeWhenFree : unsafe String -> Int -> (Int, String) .
placeWhenFree qa n =
  (ok, m) = place qa;
  case ok == 0 and has m "still running" and n > 0 of
    True -> Sys.sleepUs 20000 >> placeWhenFree qa (n - 1)
  | False -> (ok, m).

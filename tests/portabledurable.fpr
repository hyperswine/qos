# Fresh-process probe for tools/portable-durable-check.py. The script substitutes
# action, leaving all page operations on the routed block-service path.
unsafe program.
QL = use "../programs/mods/qlog".
B = use "std/blockio".
SVC = use "svc#75479fb6d5f34670".
Wire = use "std/storage#a8f7ee14e1efae76".
action = 0.
outcome r = case r of Ok s -> "Ok {s}" | Err why -> "Err {why}".
inspect src h =
  QL.Meta mh v w c d sw mr = QL.metaOr src h;
  "head={h} v={v} w={w} c={c} data={d} swap={sw} root={mr} key={outcome (QL.readLatest src h "key")} dead={outcome (QL.readLatest src h "dead")}".
perform src h = case action of
    1 -> (case QL.appendRes src h "QREC" "key" "new" of Ok h2 -> "append {inspect src h2}" | Err why -> "refused {why}")
  | 2 -> (case QL.compactRes src h of Ok h2 -> "compact {inspect src h2}" | Err why -> "refused {why}")
  | 3 -> swapProbe src h
  | 4 -> rejectProbe src h
  | 7 -> (case QL.replaceRes src h "key" (strcat (strcat oversizedKey oversizedKey) "end") of Ok h2 -> "replaced head={h2}" | Err why -> "refused {why}")
  | 10 -> bulkReplay src h
  | 8 -> replayProbe src h
  | 6 -> inputProbe src h
  | other -> inspect src h.
bulkReplay src h =
  idx = QL.scanIdxE src h;
  first = QL.idxReplayE src idx "key" "";
  second = QL.idxLatestE src idx "new-key";
  a = if first == "old" then "old" else if first == strcat "old" oversizedKey then "whole" else "partial";
  b = case second of Err why -> why | Ok bytes -> if bytes == secondChunk then "whole" else "partial";
  "pair={a}/{b} verify={outcome (QL.verifyLog src h)}".
replayProbe src h =
  bytes = QL.idxReplayE src (QL.scanIdxE src h) "key" "";
  value = if bytes == "old" then "old" else if bytes == strcat (strcat oversizedKey oversizedKey) "end" then "new" else "partial";
  "replay={value} verify={outcome (QL.verifyLog src h)}".
swapProbe src h =
  QL.Meta mh v w c d sw mr = QL.metaOr src h;
  _ = QL.sbW src (QL.Meta mh v w c d (QL.pageCount src - 2) mr);
  a = QL.swapWrite src "swap-end";
  b = QL.swapWrite src "swap-wrap";
  "swap first={a} second={b} {inspect src h}".
rejectProbe src h =
  staleAppend = outcome (QL.appendRes src (h - 1) "QREC" "key" "bad");
  staleCompact = outcome (QL.compactRes src (h - 1));
  verified = outcome (QL.verifyLog src h);
  "stale-append={staleAppend} stale-compact={staleCompact} verify={verified}".
isRefused r = case r of Err why -> True | Ok h -> False.
inputProbe src h =
  tag = isRefused (QL.appendRes src h "unknown" "key" "x");
  empty = isRefused (QL.appendRes src h "QREC" "" "x");
  space = isRefused (QL.appendRes src h "QREC" "a b" "x");
  newline = isRefused (QL.appendRes src h "QREC" (strcat "a" (strcat (chr 10) "b")) "x");
  tab = isRefused (QL.appendRes src h "QREC" (strcat "a" (strcat (chr 9) "b")) "x");
  nul = isRefused (QL.appendRes src h "QREC" (strcat "a" (strcat (chr 0) "b")) "x");
  oversize = isRefused (QL.appendRes src h "QREC" oversizedKey "x");
  tombstone = isRefused (QL.appendRes src h "QDEL" "key" "x");
  bulk = isRefused (QL.appendPackedRes src h (strcat "50 key" (strcat (chr 10) "x")) 1);
  count = isRefused (QL.appendPackedRes src h (strcat "3 key" (strcat (chr 10) "old")) 2);
  bulkKey = isRefused (QL.appendBulkRes src h (("", "old") :: Nil));
  "input tag={tag} empty={empty} space={space} newline={newline} tab={tab} nul={nul} oversize={oversize} tombstone={tombstone} bulk={bulk} count={count} bulk-key={bulkKey}".
oversizedKey =
  k1 = "x";
  k2 = strcat k1 k1;
  k3 = strcat k2 k2;
  k4 = strcat k3 k3;
  k5 = strcat k4 k4;
  k6 = strcat k5 k5;
  k7 = strcat k6 k6;
  k8 = strcat k7 k7;
  k9 = strcat k8 k8;
  k10 = strcat k9 k9;
  k11 = strcat k10 k10;
  k12 = strcat k11 k11;
  strcat k12 k12.
worker : unsafe Int -> Int -> Unit .
worker boss self =
  block = B.serve self (device "blk");
  src = QL.routed block;
  case (action == 5 or action == 9 or action == 11 or action == 12 or action == 13) of True -> QL.actorWith src self | False -> workerProbe boss src.
workerProbe boss src =
  h = QL.ensure src;
  send boss (perform src h) >> Unit.
secondChunk = strcat "A" (strcat (substr oversizedKey 0 4094) "Z").
chunks n = if n == 0 then Nil else ("chunk-{n}", oversizedKey) :: chunks (n - 1).
sendBulk child me =
  n = if action == 11 then 1 else if action == 12 then 8 else 2;
  entries = if n == 2 then [("key", oversizedKey), ("new-key", secondChunk)] else chunks n;
  (bytes, count) = QL.bulkPack entries;
  if count == n then send child (SVC.Rpc me 7 "" bytes) else error "bulk count".
openGate boss self =
  target = receiveFrom self boss;
  send target True >> Unit.
gatedWorker boss gate self =
  _ = receiveFrom self gate;
  worker boss self.
pairProbe me =
  gate = spawn (openGate me);
  child = Wire.spawn 8 Wire.inboxBytes (gatedWorker me gate);
  _ = send child (SVC.Rpc me 12 "" "");
  _ = send child (SVC.Rpc me 2 "pair-probe" "first");
  _ = send child (SVC.Rpc me 2 "pair-probe" "second");
  _ = send gate child;
  before = case receiveFrom me child of Ok token -> QL.parseNum token | Err why -> error why;
  first = receiveFrom me child;
  second = receiveFrom me child;
  _ = send child (SVC.Rpc me 3 "pair-probe" "");
  replay = receiveFrom me child;
  _ = send child (SVC.Rpc me 1 "pair-probe" "");
  latest = receiveFrom me child;
  _ = send child (SVC.Rpc me 12 "" "");
  after = receiveFrom me child;
  expected = before + 1;
  if after == Ok "{expected}" and first == Ok "" and second == Ok "" and replay == Ok "firstsecond" and latest == Ok "second"
  then "durable: pair acknowledged in order" else error "pair generation, acknowledgement or replay mismatch".
main =
  me = myself 0;
  if action == 13 then pairProbe me else
    child = spawn (worker me);
    _ = case action of 5 -> send child (SVC.Rpc me 5 "" "") | 9 -> sendBulk child me | 11 -> sendBulk child me | 12 -> sendBulk child me | other -> Ok Unit;
    "durable: {outcome (receiveFromRes me child)}".

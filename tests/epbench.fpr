# epbench.fpr -- what an endpoint operation costs with and without the
# open (docs/2026-11-06-ZERO-OVERHEAD-OS-AMENDED.md).
#
# One owner that answers at once, reached through the real namespace
# (mods/epservice.fpr) and the real client calls (mods/ep.fpr):
#   per-op   open, write, close for every write: what Svc.write does
#            (mods/svc.fpr viaNs/viaOp), 8 messages
#   held     one open, then only writes on that handle, 2 messages each
# Nanoseconds per write, the clock read around each loop.
#
#   ./qos.py run tests/epbench.fpr --harts 1
#: expect epbench: DONE

unsafe program.

Endpoint = use "../programs/mods/epservice#e8bce05a1ddf73db".
EP = use "../programs/mods/ep#c66ad65e68dd97f5".
EC = use "../programs/mods/epclient#5e2a0f910e610193".
AC = use "std/actor#201a0e9bf98a5154".

Sys.mtime : Unit -> Int .

owner : unsafe Int -> a .
owner me = oLoop me 1.
oLoop : unsafe Int -> Int -> a .
oLoop me next =
  m = receive me;
  (from, id, q) = m;
  oMsg me next (from, id) q.
oMsg : unsafe Int -> Int -> (Int, Int) -> EP.Ep -> a .
oMsg me next ret q = case q of
    EP.Open url mode -> AC.reply ret (EP.Opened next) >> oLoop me (next + 1)
  | EP.Write h v -> AC.reply ret (Ok v) >> oLoop me next
  | EP.Close h -> AC.reply ret (Ok 0) >> oLoop me next
  | other -> AC.reply ret (Err "epbench: unsupported") >> oLoop me next.

must r = case r of Ok v -> v | Err e -> error "epbench: {e}".

perOp me ns k = if k == 0 then Unit else
  ep = must (EC.open me ns "/services/bench" "rw");
  (w, kept) = EC.write me ep (EP.IInt k);
  _ = must w;
  _ = must (EC.close me kept);
  perOp me ns (k - 1).
held me ep k = if k == 0 then ep else
  (w, kept) = EC.write me ep (EP.IInt k);
  _ = checkEcho k (must w);
  held me kept (k - 1).

checkEcho k v = case v of EP.IInt n -> if n == k then Unit else error "wrong echo" | other -> error "wrong reply shape".

# Same owner, handle, EP.Write, reply matching and keep/drop as held.
# The countdown supplies unique IDs while only one request is outstanding.
counted me ep k = if k == 0 then Unit else
  (owner, h) = ep;
  _ = must (send owner (me, k, EP.Write h (EP.IInt k)));
  _ = checkEcho k (must (must (AC.awaitReply me owner k)));
  counted me ep (k - 1).

# Consume the echoed integer while the reply is borrowed. Only Unit escapes.
# As in awaitReply, unrelated senders stay queued and stale owner replies drop.
borrowedEcho me owner k = case receiveFromRes me owner of
    Err why -> error "epbench: {why}"
  | Ok msg ->
      (rid, result) = msg;
      if rid == k then
        _ = checkEcho k (must result);
        drop msg
      else drop msg >> borrowedEcho me owner k.

borrowed me ep k = if k == 0 then Unit else
  (owner, h) = ep;
  _ = must (send owner (me, k, EP.Write h (EP.IInt k)));
  _ = borrowedEcho me owner k;
  borrowed me ep (k - 1).

report name n t0 t1 = print "epbench: {name} {(t1 - t0) * 100 / n} ns per write".

main =
  me = myself 0;
  ns = AC.spawnWith (AC.Dynamic 64) Endpoint.namespace;
  lst = AC.spawnWith (AC.Dynamic 64) (Endpoint.lister ns);
  _ = EP.register me ns "/" lst;
  svc = AC.spawnWith (AC.Dynamic 64) owner;
  _ = must (EP.register me ns "/services/bench" svc);
  n = 20000;
  _ = perOp me ns 1000;
  warm = must (EC.open me ns "/services/bench" "rw");
  warmed = held me warm 1000;
  _ = must (EC.close me warmed);
  raw = must (EP.open me ns "/services/bench" "rw");
  _ = counted me raw 1000;
  _ = borrowed me raw 1000;
  t0 = Sys.mtime Unit;
  _ = perOp me ns n;
  t1 = Sys.mtime Unit;
  ep = must (EC.open me ns "/services/bench" "rw");
  heldStart = Sys.mtime Unit;
  kept = held me ep n;
  t2 = Sys.mtime Unit;
  _ = must (EC.close me kept);
  rawStart = Sys.mtime Unit;
  _ = counted me raw n;
  t3 = Sys.mtime Unit;
  _ = borrowed me raw n;
  t4 = Sys.mtime Unit;
  _ = must (EP.close me raw);
  _ = report "per-op (open, write, close)" n t0 t1;
  _ = report "held (write only)" n heldStart t2;
  _ = report "held (countdown ID)" n rawStart t3;
  _ = report "held (countdown ID, borrowed echo)" n t3 t4;
  print "epbench: DONE".

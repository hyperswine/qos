unsafe program.
# Loaded native process: the real ABI trampoline must return storage Err
# while preserving unrelated mailbox traffic from the kernel.
main =
  me = myself 0;
  tag = receive me;
  _ = Sys.sleepUs 50000;
  r = Sys.storeReq (if tag == 2 then 2 else 3) "";
  noise = case receiveNow me of Ok (Err "unrelated") -> True | _ -> False;
  "storeprobe: {r} noise={noise}".

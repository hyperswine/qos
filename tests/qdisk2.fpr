# qdisk2.fpr -- stage 2 of qosp.disk: the docs/DISK.txt format, tested
# end to end on QOS Portable over hal/unix/blk_raw.c.
#
#   make qos-app PROG=tests/qdisk2.fpr && (cd qos && make portable \
#     && ./qosp --yes ../app.qa)
#
# Run it TWICE (persistence is a two-boot property).  What it proves,
# per boot, against mods/qlog:
#   meta     the v2 superblock: version, write/commit flags, DATA bound,
#            SWAP cursor, merkle root -- and that a torn append (commit
#            flag 0) is detected and rolled back by `ensure`.
#   hashes   every record carries its chunk hash; verifyLog is Ok, a
#            deliberately corrupted payload page flips it to Err, and
#            restoring the bytes heals it.
#   bulk     one QBLK record holds three small chunks; readLatest,
#            replayAll and countRecs see the chunks, not the record.
#   compact  a tombstoned record and its tombstone vanish (head shrinks
#            by exactly their pages), live urls survive, the sweep is
#            IDEMPOTENT (same head, same merkle root twice), and the
#            root lands nonzero in the superblock.
#   swap     the circular buffer: a write at the last page wraps the
#            cursor back to the partition start and overwrites there.
#   bounds   DATA is bounded: an append past dataEnd is refused as Err.
# URLs are boot-scoped ({boot}) so every run's own assertions stay
# deterministic while the log underneath only ever grows.

QL = use "../programs/mods/qlog".
Meta = QL.Meta.

okOr r alt = case r of Ok s -> s | Err e -> alt.
isErr r = case r of Ok s -> False | Err e -> True.
isOk r = case r of Ok s -> True | Err e -> False.

mVer m =
  Meta h v w c d sw mr = m;
  v.
mCommit m =
  Meta h v w c d sw mr = m;
  c.
mDataEnd m =
  Meta h v w c d sw mr = m;
  d.
mSwapHead m =
  Meta h v w c d sw mr = m;
  sw.
mRoot m =
  Meta h v w c d sw mr = m;
  mr.
mWithSwapHead m sw2 =
  Meta h v w c d sw mr = m;
  Meta h v w c d sw2 mr.
mWithDataEnd m d2 =
  Meta h v w c d sw mr = m;
  Meta h v w c d2 sw mr.
mTorn m =
  Meta h v w c d sw mr = m;
  Meta h v 1 0 d sw mr.

main =
  dsk = device "blk";
  n = blkPages dsk;
  case n == 0 of
    True -> "qdisk2: no disk (host could not open qosp.disk)"
  | False -> run dsk n.

run dsk np =
  h0 = QL.ensure dsk;
  boot = QL.countRecs dsk h0 "qd2/boots" + 1;
  h1 = QL.appendRec dsk h0 "QREC" "qd2/boots" "b";
  m0 = QL.metaOr dsk h1;

  # ---- bulk: three chunks, one record (2 pages, not 6) ----------------------
  hBulk0 = h1;
  h2 = QL.appendBulk dsk h1 (("qd2/bk{boot}", "alpha") ::
                             (("qd2/bk{boot}", "beta") ::
                              (("qd2/other{boot}", "gamma") :: Nil)));
  bulkPg = (h2 - hBulk0) == 2;
  bl = okOr (QL.readLatest dsk h2 "qd2/bk{boot}") "(err)";
  br = QL.replayAll dsk h2 "qd2/bk{boot}";
  bn = QL.countRecs dsk h2 "qd2/bk{boot}";
  bo = okOr (QL.readLatest dsk h2 "qd2/other{boot}") "(err)";

  # ---- hashes: verify, corrupt one payload page, heal it --------------------
  hHv = h2;
  h3 = QL.appendRec dsk h2 "QREC" "qd2/hv{boot}" "check-me";
  v1 = isOk (QL.verifyLog dsk h3);
  _ = blkWrite dsk (hHv + 1) "corrupted!";
  v2 = isErr (QL.verifyLog dsk h3);
  _ = blkWrite dsk (hHv + 1) "check-me";
  v3 = isOk (QL.verifyLog dsk h3);

  # ---- compact: tombstoned data + its tombstone vanish, idempotently --------
  h4 = QL.appendRec dsk h3 "QREC" "qd2/tmp{boot}" "junkjunk";
  h5 = QL.appendRec dsk h4 "QDEL" "qd2/tmp{boot}" "";
  h6 = QL.compact dsk h5;
  cShrunk = h6 == (h5 - 3);
  h7 = QL.compact dsk h6;
  cIdem = h7 == h6;
  root = mRoot (QL.metaOr dsk h7);
  cRoot = root > 0;
  cDead = isErr (QL.readLatest dsk h7 "qd2/tmp{boot}");
  cLive = QL.strEq (okOr (QL.readLatest dsk h7 "qd2/bk{boot}") "(err)") "beta";
  cReplay = QL.strEq (QL.replayAll dsk h7 "qd2/bk{boot}") "alphabeta";
  cVerify = isOk (QL.verifyLog dsk h7);

  # ---- swap: the circular buffer wraps onto the partition start -------------
  mS = QL.metaOr dsk h7;
  d = mDataEnd mS;
  _ = QL.sbW dsk (mWithSwapHead mS (np - 1));
  w1 = QL.swapWrite dsk "one";
  w2 = QL.swapWrite dsk "two";
  sw1 = w1 == (np - 1);
  sw2 = w2 == d;
  swCur = mSwapHead (QL.metaOr dsk h7) == (d + 1);
  swBack = QL.strEq (substr (QL.swapRead dsk d) 1 3) "two";

  # ---- bounds: an append past dataEnd is refused ----------------------------
  mF = QL.metaOr dsk h7;
  _ = QL.sbW dsk (mWithDataEnd mF (h7 + 1));
  fullOk = isErr (QL.appendRes dsk h7 "QREC" "qd2/full{boot}" "x");
  _ = QL.sbW dsk mF;

  # ---- torn append: commit flag 0 is detected and rolled back ---------------
  _ = QL.sbW dsk (mTorn (QL.metaOr dsk h7));
  hT = QL.ensure dsk;
  tornOk = case hT == h7 of
             True -> mCommit (QL.metaOr dsk h7) == 1
           | False -> False;

  "qdisk2: boot #{boot} v={mVer m0} d={mDataEnd m0}/{np} bulk[2pg={bulkPg} latest={bl} replay={br} n={bn} other={bo}] hash[ok={v1} corrupt={v2} healed={v3}] compact[shrunk={cShrunk} idem={cIdem} root>0={cRoot} dead={cDead} live={cLive} replay={cReplay} verify={cVerify}] swap[wrap={sw1} over={sw2} cur={swCur} read={swBack}] full={fullOk} torn={tornOk} head={h7}".

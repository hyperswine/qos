# plugmini.fpr -- the smallest plugin: two exports and no dependencies,
# for proving the disk-loaded plugin path (tests/qload.fpr).  Every
# top-level definition lands in this image's fpr_modtab, resolvable
# after attach via Mod.findAt.
#
#   make plugin-qa-macos PROG=tests/plugmini.fpr PLUGSLOT=0
#   make -C qos disk-seed QAS=../plugmini.qa
#
# (Shell-rebuild law: plugsyms[-macos] first, and rebuild this after
# EVERY shell image rebuild -- the PROVIDE addresses must match the
# running image exactly.)

plugPing u = "pong from a .qa read off qosp.disk".
plugAdd a b = a + b.

main = "plugmini is a plugin: load it via tests/qload.fpr".

# qsysfail.fpr -- the failure paths of mods/qsys's files and mods/ep's
# contract, against fake services (no disk): every outcome is an honest
# answer.
#
#   1. a write that storage refuses (Err) is reported, and the cached
#      body is unchanged: a read after it returns what the disk holds
#   2. storage that has ENDED: the write says so, the body is unchanged
#   3. a file actor whose first replay failed says "read failed", never
#      serves "" as the file, and refuses writes until it can read
#   4. a service that ended is Err "dead actor" (not a caller parked for
#      ever); an open of a url whose owner has ended is refused by name
#   5. a full mailbox is Err "mailbox full" (the request never queued)
#   6. an unrelated message queued by another actor is not read as the
#      reply, and is still there afterwards
#
#   ./qos.py run tests/qsysfail.fpr
#: expect qsysfail: HOLDS

unsafe program.

QS = use "../programs/mods/qsys".
AK = use "../programs/mods/appkit".
EP = use "../programs/mods/ep".
AC = use "std/actor".
SVC = use "../programs/mods/svc".
Rpc = SVC.Rpc.

# storage whose replay answers `body` and whose append answers `ap`
store : unsafe String -> Result String String -> Int -> a .
store body ap me =
  m = receive me;
  case m of Rpc replyTo tag url pay ->
    (case tag == 3 of
       True -> send replyTo (Ok body) >> store body ap me
     | False -> send replyTo ap >> store body ap me).

# answers one replay, then ends
storeOnce me = case receive me of Rpc replyTo tag url pay -> send replyTo (Ok "abc").

# ends at once
gone me = Unit.

# never reads its mailbox while the test runs
stuck me = _ = Sys.sleepUs 3000000; Unit.

pinger target me = send target "tick".

fill : unsafe Int -> Int -> Unit .
fill k n = case n == 0 of
    True -> Unit
  | False -> send k n >> fill k (n - 1).

expect : String -> String -> String -> Bool .
expect what got want = case QS.strEq got want of
    True -> True
  | False -> _ = print "qsysfail: {what}: got [{got}] wanted [{want}]"; False.

# a file actor over a fake store, claimed in a fresh namespace
fileAt : unsafe Int -> Int -> Int -> String -> Unit .
fileAt me ns st path =
  f = AC.spawnWith (AC.Dynamic 64) (QS.fileActor st path);
  case EP.register me ns path f of
    Ok n -> Unit
  | Err e -> error "qsysfail: claim {path}: {e}".

main =
  me = myself 0;
  ns = AC.spawnWith (AC.Dynamic 64) EP.namespace;
  _ = EP.register me ns "/" (AC.spawnWith (AC.Dynamic 64) (EP.lister ns));
  # 1. a refused append
  st1 = spawn (store "abc" (Err "data partition full"));
  _ = fileAt me ns st1 "/tmp/a";
  w1 = AK.vfsWrite me ns "/tmp/a" "X";
  r1 = AK.vfsRead me ns "/tmp/a";
  ok1 = expect "refused write" w1 "write failed: data partition full"
    and expect "body after refused write" r1 "abc";
  # 2. storage that ended after the replay
  st2 = spawn storeOnce;
  _ = fileAt me ns st2 "/tmp/b";
  w2 = AK.vfsWrite me ns "/tmp/b" "X";
  r2 = AK.vfsRead me ns "/tmp/b";
  ok2 = expect "write to ended storage" w2 "write failed: storage service: dead actor"
    and expect "body after ended storage" r2 "abc";
  # 3. a file actor that never could read its body
  st3 = spawn gone;
  _ = Sys.sleepUs 20000;
  _ = fileAt me ns st3 "/tmp/c";
  r3 = AK.vfsRead me ns "/tmp/c";
  w3 = AK.vfsWrite me ns "/tmp/c" "X";
  ok3 = expect "unreadable file" r3 "read failed: /tmp/c (storage service: dead actor)"
    and expect "write to unreadable file" w3 "write failed: /tmp/c could not be read (storage service: dead actor)";
  # 4. an ended service, directly and as the owner of a url
  g = spawn gone;
  _ = Sys.sleepUs 20000;
  c4 = AC.call me g (EP.Read 1 0);
  _ = EP.register me ns "/tmp/d" g;
  r4 = AK.vfsRead me ns "/tmp/d";
  ok4 = expect "call to ended service" "{c4}" "Err dead actor"
    and expect "open of an ended owner" r4 "/tmp/d: its owner dead actor";
  # 5. a full mailbox
  k = AC.spawnWith (AC.Static 8) stuck;
  _ = fill k 8;
  c5 = AC.call me k (EP.Read 1 0);
  ok5 = expect "full mailbox" "{c5}" "Err mailbox full";
  # 6. an event from someone else, queued before the call
  st6 = spawn (store "note" (Ok "1"));
  _ = fileAt me ns st6 "/tmp/e";
  _ = spawn (pinger me);
  _ = Sys.sleepUs 20000;
  r6 = AK.vfsRead me ns "/tmp/e";
  ev = receive me;
  ok6 = expect "reply with an event queued" r6 "note" and expect "the event" ev "tick";
  case ok1 and ok2 and ok3 and ok4 and ok5 and ok6 of
    True -> "qsysfail: HOLDS"
  | False -> "qsysfail: FAILED".

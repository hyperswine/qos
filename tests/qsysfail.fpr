# qsysfail.fpr -- the failure paths of mods/qsys's files and mods/ep's
# contract, against fake services (no disk): every outcome is an honest
# answer.
#
#   1. a write that storage refuses (Err) is reported, and the cached
#      body is unchanged: a read after it returns what the disk holds
#   2. storage that has ENDED: the write says so; a later open replays
#      honestly (dead storage) instead of serving a retired cache
#   3. a file actor whose first replay failed says "read failed", never
#      serves "" as the file, and refuses writes until it can read
#   4. a service that ended is Err "dead actor" (not a caller parked for
#      ever); an open of a url whose owner has ended is refused by name
#   5. a full mailbox is Err "mailbox full" (the request never queued)
#   6. an unrelated message queued by another actor is not read as the
#      reply, and is still there afterwards
#   7. an uncertain append: the cache goes unknown, the replay recovers it
#   8. handle leases: closing one of two handles refuses the closed one
#      ("no such handle") while the other still reads
#   9. another client's handle is refused; the last close retires the actor
#  10. 70 sequential open/close pairs succeed (closed files free the
#      manager's 64-live-actor budget)
#  11. 64 files held open bound the 65th; closing them admits it again
#  12. 64 clients that open a file each and END without Close do not keep
#      the budget: the 65th open is admitted (their actors are reclaimed)
#  13. open/read/close cycles from 4 clients on one file while its actor
#      keeps going idle: every read answers (no Open forwarded to an actor
#      that is retiring), and the actor is retired once they are done
#
#   ./qos.py run tests/qsysfail.fpr
#: expect qsysfail: HOLDS

unsafe program.

QS = use "../programs/mods/qsys".
AK = use "../programs/mods/appkit".
EP = use "../programs/mods/ep#c66ad65e68dd97f5".
AC = use "std/actor#201a0e9bf98a5154".
SVC = use "../programs/mods/svc#75479fb6d5f34670".
Rpc = SVC.Rpc.

# storage whose replay answers `body` and whose append answers `ap`
store : unsafe String -> Result String String -> Int -> a .
store body ap me =
  m = receive me;
  (ret, (until, (tag, url, pay))) = SVC.requestFields m;
  _ = SVC.reply ret (if tag == 3 then Ok body else ap);
  store body ap me.

# answers one replay, then ends
storeOnce me = (ret, _) = SVC.requestFields (receive me); SVC.reply ret (Ok "abc").
uncertainStore body me =
  (ret, (until, (tag, url, pay))) = SVC.requestFields (receive me);
  _ = SVC.reply ret (if tag == 3 then Ok body else Err "storage service: deadline exceeded (outcome unknown)");
  uncertainStore (if tag == 2 then "abcX" else body) me.

# ends at once
gone me = Unit.

# never reads its mailbox while the test runs
stuck me = _ = Sys.sleepUs 3000000; Unit.

pinger target me = send target "tick".

fill : unsafe Int -> Int -> Unit .
fill k n = case n == 0 of
    True -> Unit
  | False -> send k n >> fill k (n - 1).

expect : String -> String -> String -> Bool .
expect what got want = case QS.strEq got want of
    True -> True
  | False -> _ = print "qsysfail: {what}: got [{got}] wanted [{want}]"; False.

# a file actor over a fake store, claimed in a fresh namespace
fileAt : unsafe Int -> Int -> Int -> String -> Unit .
fileAt me ns st path =
  f = AC.spawnWith (AC.Dynamic 64) (QS.fileActor st path);
  case EP.register me ns path f of
    Ok n -> Unit
  | Err e -> error "qsysfail: claim {path}: {e}".
fileAtR : unsafe Int -> Int -> Int -> String -> Int .
fileAtR me ns st path =
  f = AC.spawnWith (AC.Dynamic 64) (QS.fileActor st path);
  case EP.register me ns path f of
    Ok n -> f
  | Err e -> error "qsysfail: claim {path}: {e}".
# the production path: one file manager over the store, the path claimed
# to it, so a retired file actor is respawned on the next open
mgrAt : unsafe Int -> Int -> Int -> String -> Unit .
mgrAt me ns st path =
  mgr = spawn (QS.filesMgr st ns [path]);
  case EP.register me ns path mgr of
    Ok n -> Unit
  | Err e -> error "qsysfail: claim {path}: {e}".
waitDead : unsafe Int -> Int -> Bool .
waitDead a n = if Sys.alive a then (if n <= 0 then False else _ = Sys.sleepUs 5000; waitDead a (n - 1)) else True.
# a read through an endpoint owned by someone else, reported to the boss
spyRead ep boss me = _ = send boss (EP.read me ep 0); Unit.
holdMany : unsafe Int -> Int -> List String -> List (Int, Int) -> List (Int, Int) .
holdMany me ns paths acc = case paths of
    Nil -> acc
  | p :: rest -> (case EP.open me ns p "read" of Err why -> acc | Ok ep -> holdMany me ns rest (ep :: acc)).
closeAll : unsafe Int -> List (Int, Int) -> Unit .
closeAll me eps = case eps of
    Nil -> Unit
  | ep :: rest -> _ = EP.close me ep; closeAll me rest.
ownersOf : unsafe List (Int, Int) -> List Int .
ownersOf eps = case eps of
    Nil -> Nil
  | (o, h) :: rest -> o :: ownersOf rest.
waitDeads : unsafe List Int -> Bool .
waitDeads actors = case actors of
    Nil -> True
  | a :: rest -> waitDead a 400 and waitDeads rest.
takeN : unsafe List a -> Int -> List a .
takeN xs n = case xs of
    Nil -> Nil
  | x :: rest -> if n <= 0 then Nil else x :: takeN rest (n - 1).
seqAll : unsafe Int -> Int -> List String -> Bool .
seqAll me ns paths = case paths of
    Nil -> True
  | p :: rest -> (case EP.open me ns p "read" of
      Err why -> False
    | Ok ep -> _ = EP.close me ep; seqAll me ns rest).
mkPaths : unsafe String -> Int -> List String .
mkPaths pre n = mpGo pre 1 n.
mpGo : unsafe String -> Int -> Int -> List String .
mpGo pre i n = if i > n then Nil else "{pre}{i}" :: mpGo pre (i + 1) n.

# opens a file and ends without closing it
holder ns path boss me = _ = EP.open me ns path "read"; send boss 1.
# n open/read/close cycles; reports how many reads did not answer "abc"
cycler ns path n boss me = send boss (cycles me ns path n 0).
cycles : unsafe Int -> Int -> String -> Int -> Int -> Int .
cycles me ns path n bad = if n <= 0 then bad else
  cycles me ns path (n - 1) (if QS.strEq (AK.vfsRead me ns path) "abc" then bad else bad + 1).
spawnHolders : unsafe Int -> List String -> Int -> Unit .
spawnHolders ns paths boss = case paths of
    Nil -> Unit
  | p :: rest -> _ = spawn (holder ns p boss); spawnHolders ns rest boss.
collectN : unsafe Int -> Int -> Int -> Int .
collectN me k acc = if k <= 0 then acc else collectN me (k - 1) (acc + receive me).
spawnCyclers : unsafe Int -> String -> Int -> Int -> Int -> Unit .
spawnCyclers ns path k n boss = if k <= 0 then Unit else
  _ = spawn (cycler ns path n boss); spawnCyclers ns path (k - 1) n boss.
# a namespace with one manager over /tmp and the given files
mgrNs : unsafe Int -> Int -> List String -> (Int, Int) .
mgrNs me st known =
  ns = AC.spawnWith (AC.Dynamic 64) EP.namespace;
  mgr = spawn (QS.filesMgr st ns known);
  _ = (case EP.register me ns "/tmp" mgr of Ok n -> Unit | Err e -> error "qsysfail: claim /tmp: {e}");
  _ = QS.filesRegister me ns mgr known;
  (ns, mgr).
liveOwner : unsafe Int -> Int -> String -> Int .
liveOwner me ns path = case EP.open me ns path "read" of
    Err why -> 0
  | Ok ep -> (o, h) = ep; _ = EP.close me ep; o.

main =
  me = myself 0;
  ns = AC.spawnWith (AC.Dynamic 64) EP.namespace;
  _ = EP.register me ns "/" (AC.spawnWith (AC.Dynamic 64) (EP.lister ns));
  # 1. a refused append
  st1 = spawn (store "abc" (Err "data partition full"));
  _ = mgrAt me ns st1 "/tmp/a";
  w1 = AK.vfsWrite me ns "/tmp/a" "X";
  r1 = AK.vfsRead me ns "/tmp/a";
  ok1 = expect "refused write" w1 "write failed: data partition full"
    and expect "body after refused write" r1 "abc";
  # 2. storage that ended after the replay
  st2 = spawn storeOnce;
  _ = mgrAt me ns st2 "/tmp/b";
  w2 = AK.vfsWrite me ns "/tmp/b" "X";
  r2 = AK.vfsRead me ns "/tmp/b";
  ok2 = expect "write to ended storage" w2 "write failed: storage service: dead actor"
    and expect "reopen after ended storage" r2 "read failed: /tmp/b (storage service: dead actor)";
  # 3. a file actor that never could read its body
  st3 = spawn gone;
  _ = Sys.sleepUs 20000;
  _ = mgrAt me ns st3 "/tmp/c";
  r3 = AK.vfsRead me ns "/tmp/c";
  w3 = AK.vfsWrite me ns "/tmp/c" "X";
  ok3 = expect "unreadable file" r3 "read failed: /tmp/c (storage service: dead actor)"
    and expect "write to unreadable file" w3 "write failed: /tmp/c could not be read (storage service: dead actor)";
  # 4. an ended service, directly and as the owner of a url
  g = spawn gone;
  _ = Sys.sleepUs 20000;
  c4 = AC.call me g (EP.Read 1 0);
  _ = EP.register me ns "/tmp/d" g;
  r4 = AK.vfsRead me ns "/tmp/d";
  ok4 = expect "call to ended service" "{c4}" "Err dead actor"
    and expect "open of an ended owner" r4 "/tmp/d: its owner dead actor";
  # 5. a full mailbox
  k = AC.spawnWith (AC.Static 8) stuck;
  _ = fill k 8;
  c5 = AC.call me k (EP.Read 1 0);
  ok5 = expect "full mailbox" "{c5}" "Err mailbox full";
  # 6. an event from someone else, queued before the call
  st6 = spawn (store "note" (Ok "1"));
  _ = fileAt me ns st6 "/tmp/e";
  _ = spawn (pinger me);
  _ = Sys.sleepUs 20000;
  r6 = AK.vfsRead me ns "/tmp/e";
  ev = receive me;
  ok6 = expect "reply with an event queued" r6 "note" and expect "the event" ev "tick";
  st7 = spawn (uncertainStore "abc");
  _ = mgrAt me ns st7 "/tmp/f";
  w7 = AK.vfsWrite me ns "/tmp/f" "X";
  r7 = AK.vfsRead me ns "/tmp/f";
  ok7 = expect "unknown write" w7 "write failed: storage service: deadline exceeded (outcome unknown)"
    and expect "reloaded unknown outcome" r7 "abcX";
  # 8. two handles on one file: closing one refuses it, the other reads on
  st8 = spawn (store "abc" (Ok "1"));
  f8 = fileAtR me ns st8 "/tmp/g";
  epA = (case EP.open me ns "/tmp/g" "read" of Ok ep -> ep | Err why -> error "qsysfail: open g: {why}");
  epB = (case EP.open me ns "/tmp/g" "read" of Ok ep -> ep | Err why -> error "qsysfail: reopen g: {why}");
  _ = EP.close me epA;
  staleA = EP.read me epA 0;
  liveB = EP.read me epB 0;
  ok8 = (case staleA of Err why -> QS.strEq why "no such handle" | Ok v -> False)
    and (case liveB of Ok v -> (case v of EP.IStr s -> QS.strEq s "abc" | other -> False) | Err why -> False);
  # 9. another client's handle is refused; the last close retires the actor
  _ = spawn (spyRead epB me);
  spyGot = receive me;
  ok9a = case spyGot of Err why -> QS.strEq why "no such handle" | Ok v -> False;
  _ = EP.close me epB;
  ok9 = ok9a and waitDead f8 400;
  # 10. 70 sequential open/close pairs against one manager
  stM = spawn (store "abc" (Ok "1"));
  knownM = mkPaths "/tmp/m" 70;
  mgr = spawn (QS.filesMgr stM ns knownM);
  _ = (case EP.register me ns "/tmp" mgr of Ok n -> Unit | Err e -> error "qsysfail: claim /tmp: {e}");
  _ = QS.filesRegister me ns mgr knownM;
  ok10 = seqAll me ns knownM;
  # 11. 64 held open bound the 65th; closing them admits it again
  held = holdMany me ns (takeN knownM 64) Nil;
  extra1 = EP.open me ns "/tmp/m65" "read";
  ok11a = case extra1 of Err why -> QS.strEq why "file actor budget exhausted (64 live files)" | Ok ep -> False;
  _ = closeAll me held;
  _ = waitDeads (ownersOf held);
  extra2 = EP.open me ns "/tmp/m65" "read";
  ok11b = case extra2 of Ok ep -> _ = EP.close me ep; True | Err why -> False;
  ok11 = QS.lenL held == 64 and ok11a and ok11b;
  # 12. clients that die holding a lease
  st12 = spawn (store "abc" (Ok "1"));
  known12 = mkPaths "/tmp/z" 65;
  (ns12, mgr12) = mgrNs me st12 known12;
  _ = spawnHolders ns12 (takeN known12 64) me;
  held12 = collectN me 64 0;
  _ = Sys.sleepUs 20000;
  extra12 = EP.open me ns12 "/tmp/z65" "read";
  ok12 = held12 == 64 and (case extra12 of Ok ep -> _ = EP.close me ep; True
    | Err why -> _ = print "qsysfail: 65th open after 64 dead holders: {why}"; False);
  # 13. concurrent open/close cycles on one file under one manager
  st13 = spawn (store "abc" (Ok "1"));
  (ns13, mgr13) = mgrNs me st13 ["/tmp/race"];
  _ = spawnCyclers ns13 "/tmp/race" 4 50 me;
  bad13 = collectN me 4 0;
  owner13 = liveOwner me ns13 "/tmp/race";
  ok13 = bad13 == 0 and owner13 > 0 and waitDead owner13 400;
  _ = (if bad13 == 0 then Unit else print "qsysfail: 13. {bad13} of 200 cycled reads did not answer");
  _ = print "qsysfail: 12={ok12} 13={ok13}";
  case ok1 and ok2 and ok3 and ok4 and ok5 and ok6 and ok7 and ok8 and ok9 and ok10 and ok11 and ok12 and ok13 of
    True -> "qsysfail: HOLDS"
  | False -> "qsysfail: FAILED".

# apps.fpr -- TWO APP IMAGES FROM THE DISK, running side by side under
# their own pids (docs/MEMORY.md, stage 2).  The shell spawns Files and
# the Loader, then LAUNCHES appa and appb: each is an apps/<id>.qa
# record the loader attaches (the shell-stamp gate as ever) and runs by
# spawning its `app` export under a fresh pid -- the shell's actors are
# pid 0, appa's are pid 1, appb's (helper included) pid 2.  Both report
# back through the launcher handle they were handed as their first
# message; when they exit, their memory goes home to the memory actor.
#
#   ./qos.py run tests/apps.fpr
#: plugins tests/appa.fpr tests/appb.fpr
#: expect apps: appa pid 1 ran (helper pid 1) = 9006000; appb pid 2 ran (helper pid 2) = 42; shell pid 0; APPS HOLD

unsafe program.

FS = use "std/fs".
LD = use "std/loader".

expectOk what r = case r of
    Ok v -> v
  | Err e -> error "apps {what}: {e}".

nth 0 (x :: xs) = x.
nth n (x :: xs) = nth (n - 1) xs.
nth n Nil = 0.

# the two reports arrive in either order: keep them by name
reports me 0 a b = (a, b).
reports me n a b =
  (name, pid, hp, r) = receive me;
  case name == "appa" of
    True -> reports me (n - 1) (pid, hp, r) b
  | False -> reports me (n - 1) a (pid, hp, r).

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  ld = LD.serve fs;
  _ = expectOk "replay" (LD.replay me ld);
  free0 = nth 1 (Sys.memInfo 0);
  ha = expectOk "launch appa" (LD.launch me ld "appa");
  hb = expectOk "launch appb" (LD.launch me ld "appb");
  ((pa, ha2, ra), (pb, hb2, rb)) = reports me 2 (0, 0, 0) (0, 0, 0);
  _ = settle me 20;
  free1 = nth 1 (Sys.memInfo 0);
  pct = free1 * 100 / free0;
  distinct = pa != pb and pa != 0 and pb != 0 and myPid 0 == 0;
  inherit = ha2 == pa and hb2 == pb;
  verdict = case distinct and inherit and ra == 9006000 and rb == 42 and pct >= 97 of
      True -> "APPS HOLD"
    | False -> "APPS BROKEN (free {pct}%)";
  "apps: appa pid {pa} ran (helper pid {ha2}) = {ra}; appb pid {pb} ran (helper pid {hb2}) = {rb}; shell pid {myPid 0}; {verdict}".

settle me 0 = 0.
settle me n =
  _ = yield me;
  _ = Sys.sleepUs 2000;
  settle me (n - 1).

# notesed2 -- SIGNATURE-COMPATIBLE successor: same exports, same
# arities.  The edit now CAPITALIZES the first letter instead of
# appending a newline -- the visible behavior change the live reload
# must deliver mid-run, same Model, same actor.
editLine s = case strlen s == 0 of
    True -> s
  | False -> "{upA (charAt s 1)}{substr s 2 (strlen s - 1)}".
upA c = case c >= 97 of
    True -> upB c
  | False -> chr c.
upB c = case c <= 122 of
    True -> chr (c - 32)
  | False -> chr c.
editName u = "caps.v2".

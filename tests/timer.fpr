# timer.fpr -- Timer.qa + std.timer end to end, BOTH backends:
#
#   * native (bare metal): Sys.timerBind answers 1 -- deadlines are
#     CLINT mtimecmp arms, MTIP pops the IRQ HART (the last live hart,
#     auxiliary by design) out of wfi, and the bridge delivers the due
#     message.  Expect mode=1.
#   * portable (qosp): no hardware timer -- Timer.qa spawns sleeper
#     children over Sys.sleepUs.  Expect mode=0.
#
#   make qos-app PROG=tests/timer.fpr && (cd qos && ./qosp --yes ../app.qa)
#   make bare-metal-run PROG=tests/timer.fpr
#
# Expected (native):   timer: mode=1 sleep50=ok after=ok order=ok
# Expected (portable): timer: mode=0 sleep50=ok after=ok order=ok
#
# sleep50 proves the blocking path waited >= 50 ms of CLINT time;
# after proves the fire-and-forget fire lands in the caller's OWN
# mailbox (schedule, then collect later); order proves two pending
# deadlines both fire through the ONE armed slot, nearest first.

TM = use "../programs/mods/timer".
T = use "std/timer".

TFire = TM.TFire.

main =
  me = myself 0;
  cl = device "clint";
  clk = reg32 cl 49144;
  svc = spawn TM.actor;
  mode = T.ping svc;

  # blocking sleep: must cost at least the asked-for CLINT time
  t0 = Mmio.read clk;
  _ = T.sleep svc 50;
  d1 = Mmio.read clk - t0;
  s50 = case d1 >= 500000 of True -> "ok" | False -> "SHORT({d1})";

  # fire-and-forget: schedule, then collect from our own mailbox
  _ = T.after svc 20;
  f = receiveFrom me svc;
  aok = case f of TFire -> "ok" | o -> "WRONG";

  # two pending deadlines: later one asked first, both must fire
  _ = T.after svc 40;
  _ = T.after svc 10;
  g1 = receiveFrom me svc;
  g2 = receiveFrom me svc;
  t2 = Mmio.read clk;
  ook = case and2 (isFire g1) (isFire g2) of
      True -> (case t2 - t0 >= 900000 of True -> "ok" | False -> "EARLY")
    | False -> "WRONG";

  _ = kill svc;
  "timer: mode={mode} sleep50={s50} after={aok} order={ook}".

isFire f = case f of TFire -> True | o -> False.
and2 a b = case a of True -> b | False -> False.

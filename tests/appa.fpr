# appa -- an APP IMAGE (docs/MEMORY.md, stage 2): a plugin whose `app`
# export is spawned by the loader under a pid of its own.  Its first
# message is the launcher's handle; it does some allocating work and
# reports (name, pid, result) back, then exits -- its blocks go home.
unsafe program.
build 0 acc = acc.
build n acc = build (n - 1) ((n, n + 1) :: acc).
total Nil s = s.
total ((a, b) :: r) s = total r (s + a + b).
app me =
  shell = receive me;
  n = total (build 3000 Nil) 0;
  _ = send shell ("appa", myPid 0, myPid 0, n);
  0.

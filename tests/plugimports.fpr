# plugimports.fpr -- a plugin binds to the app's runtime BY NAME
# (docs/2026-10-01-IMPORT-TABLE.md).  tools/plugimports-check.sh builds
# plugmini.qa and plugneeds.qa ONCE, runs tests/qload.fpr with them, then
# rebuilds the shell as THIS program and runs it on the same disk:
#
#   - the same plugmini.qa attaches under a second, different shell build
#     (there is no shell stamp, and no address it was built for), and its
#     exports run;
#   - plugneeds.qa imports a name no app exports, and is refused by name
#     before anything of it runs.
#
# Expected: "plugimports: plugmini under a second shell: 40+2=42;
# plugneeds: the plugin needs ..., which this app does not export HOLDS"

QL = use "../programs/mods/qlog".
Plug = use "../programs/mods/plug".

has s sub = strIndexOf sub s >= 0.

main =
  dsk = device "blk";
  h = QL.ensure dsk;
  case QL.readLatest dsk h "apps/plugmini.qa" of
    Err e -> "plugimports: apps/plugmini.qa not on the disk ({e})"
  | Ok mini -> (case QL.readLatest dsk h "apps/plugneeds.qa" of
      Err e -> "plugimports: apps/plugneeds.qa not on the disk ({e})"
    | Ok needs -> run mini needs).

run mini needs =
  n0 = Mod.plugs 0;
  first = case Plug.attach mini of
      Err e -> "plugmini refused: {e}"
    | Ok u -> call n0;
  second = case Plug.attach needs of
      Ok u -> "plugneeds ATTACHED"
    | Err e -> e;
  ok = has first "40+2=42" and has second "the plugin needs " and has second "which this app does not export";
  verdict = case ok of True -> "HOLDS" | False -> "FAILED";
  "plugimports: {first}; plugneeds: {second} {verdict}".

call n0 =
  (f, add) = Mod.findAt n0 "plugAdd";
  case f == 1 of
    False -> "plugmini attached but plugAdd not exported"
  | True -> "plugmini under a second shell: 40+2={add 40 2}".

# growlog.fpr -- growth is ATTRIBUTED.  Every grant through
# the ONE counted gateway records (site, want, got, actor) into a
# lock-free ring -- no lock, no print, no allocation at the write (the
# instrumentation-poison law); Sys.growLog pulls formatted copies from
# ordinary code.  Spawning an actor forces stack/acb grants under a
# loaded process, so the ring must name a big-block or stack site.
child self = receive.
lgNth : unsafe a -> Int -> String .
lgNth Nil i = "".
lgNth (v :: r) 0 = v.
lgNth (v :: r) i = lgNth r (i - 1).
lgLen : unsafe a -> Int .
lgLen Nil = 0.
lgLen (v :: r) = 1 + lgLen r.
main =
  a = spawn child;
  evs = Sys.growLog 0;
  n = lgLen evs;
  h = lgNth evs 0;
  "growlog: {n} events, newest [{h}]".

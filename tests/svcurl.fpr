# svcurl.fpr -- the Svc surface (mods/svc.fpr) on the hosted HAL: every
# service is `Svc.read caps url` / `Svc.write caps url v`, capability-gated
# by URL prefix, then an open, one operation and a close through the
# namespace to the endpoint that claimed the url (mods/sysep.fpr).
# Storage is diskless here, so its endpoint answers IErr -- absence is data.

#: expect svcurl done

unsafe program.

SVCM = use "../programs/mods/svc".
EP = use "../programs/mods/ep".
SE = use "../programs/mods/sysep".
AC = use "std/actor".
Svc  = SVCM.Svc.
IoV  = EP.IoV.
IUnit = EP.IUnit.
IInt = EP.IInt.
IStr = EP.IStr.
IErr = EP.IErr.

expect name ok = case ok of
    True -> print ("ok " + name)
  | False -> error ("FAIL " + name).

main =
  me = myself 0;
  u = device "uart";
  cl = device "clint";
  con = (reg8 u 5, reg8 u 0);
  clk = reg32 cl 49144;
  granted = ("/services/display", "write")
         :: ("/services/clock", "read")
         :: ("/services/keyboard", "read")
         :: ("/services/storage", "write")
         :: ("/nope", "read")
         :: Nil;
  ns = AC.spawnWith (AC.Dynamic 64) EP.namespace;
  _ = EP.register me ns "/" (AC.spawnWith (AC.Dynamic 64) (EP.lister ns));
  st = { has = False, act = 0, uart = 0, timer = 0, ns = ns };
  _ = SE.boot me ns con clk 0 0 st;
  caps = SVCM.Caps con me clk granted "svctest" st;

  # display: the write verb (and the /line sub-route)
  _ = Svc.write caps "/services/display" (IStr "svc: display route ");
  _ = Svc.write caps "/services/display/line" (IStr "works");

  # clock: the read verb on a device register route
  t = case Svc.read caps "/services/clock" of IInt v -> v | _ -> 0 - 1;
  _ = expect "clock read" (t >= 0);

  # keyboard poll: nonblocking, no input waiting -> 0
  k = case Svc.read caps "/services/keyboard/poll" of IInt v -> v | _ -> 0 - 1;
  _ = expect "keyboard poll (none)" (k == 0);

  # storage: diskless -> the miss is DATA, not a fault
  _ = expect "storage diskless is data"
        (case Svc.write caps "/services/storage/kv" (IStr "x") of
           IErr _ -> True | _ -> False);

  # a granted url with no route: also data
  _ = expect "unknown route is data"
        (case Svc.read caps "/nope" of IErr _ -> True | _ -> False);

  # wrong value shape for a route: data
  _ = expect "wrong shape is data"
        (case Svc.write caps "/services/display" (IInt 3) of
           IErr _ -> True | _ -> False);
  print "svcurl done".

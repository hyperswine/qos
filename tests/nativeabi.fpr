unsafe program.
Q = use "../programs/mods/qaimg".
main =
  valid = Q.nativeAbi "base 0\nnativeabi 1\nentry 2\n" == 1;
  absent = Q.nativeAbi "base 0\n" == (0 - 1);
  duplicate = Q.nativeAbi "nativeabi 1\nnativeabi 1\n" == (0 - 1);
  huge = Q.nativeAbi "nativeabi 9223372036854775809\n" == (0 - 1);
  negative = Q.nativeAbi "nativeabi -1\n" == (0 - 1);
  trailing = Q.nativeAbi "nativeabi 1oops\n" == (0 - 1);
  noValue = Q.nativeAbi "nativeabi \n" == (0 - 1);
  mixed = "planeactors 7\nnativeabi 3oops\nplanememory 999999999\nnativeabi 4\nplaneactors 8";
  image = Q.Img 0 0 1 1 1 1 "" "";
  combined = case Q.nativeNums image mixed of
      [_, _, _, _, _, abi, actors, memory] -> abi == (0 - 1) and actors == (0 - 1) and memory == 999999999
    | other -> False;
  verdict = if valid and absent and duplicate and huge and negative and trailing and noValue and combined then "HOLDS" else "FAILED";
  "nativeabi: {verdict}".

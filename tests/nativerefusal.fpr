unsafe program.
# Test kernel: execute actual relocatable process images against a full,
# dead and killed-during-request storage actor. Then serve a real request.
FS = use "std/fs".
S = use "../programs/mods/svc".
NI = use "nativeimage".
Sys.bindStore : Int -> S.Rpc -> Unit .
Sys.bindApp : String -> Unit .
Sys.images : Int -> Int .
Sys.arenaFree : Int -> Int .
Sys.testFillFrom : Int -> Int -> Int -> Result Unit String .
stuck self = _ = Sys.sleepUs 1000000; stuck self.

pending boss self = case receive self of S.Rpc caller tag key pay -> _ = send boss 88; Sys.sleepUs 3000000 >> Unit.
start qa =
  (ok, why, root) = NI.place qa;
  _ = case ok == 2 of True -> Unit | False -> error "probe placement: {why}";
  root.
probe me qa =
  root = start qa;
  _ = send root 0;
  _ = send root (Err "unrelated");
  NI.result me root.
main =
  me = myself 0;
  fs = FS.serve (device "blk");
  qa = case FS.readLatest me fs "apps/CkSlow.qa" of Ok s -> s | Err e -> error e;
  failqa = case FS.readLatest me fs "apps/CkFail.qa" of Ok s -> s | Err e -> error e;
  _ = Sys.bindApp "CkSlow";
  full = spawnCap 0 1 stuck;
  _ = Sys.bindStore full (S.Rpc full 0 "" "");
  fullroot = start qa;
  _ = case Sys.testFillFrom full fullroot 8 of Err "mailbox full" -> Unit | _ -> error "process channel not full";
  _ = send fullroot 0;
  _ = send fullroot (Err "unrelated");
  refused = NI.result me fullroot;
  _ = kill full;
  dead = probe me qa;
  waiting = spawn (pending me);
  _ = Sys.bindStore waiting (S.Rpc waiting 0 "" "");
  (ok, why, root) = NI.place qa;
  _ = case ok == 2 of True -> Unit | False -> error why;
  _ = send root 0;
  _ = send root (Err "unrelated");
  _ = case receiveFromRes me waiting of Ok 88 -> Unit | _ -> error "storage never received request";
  _ = kill waiting;
  during = NI.result me root;
  _ = Sys.bindStore fs (S.Rpc fs 0 "" "");
  healthy = probe me qa;
  (failok, failwhy, failroot) = NI.place failqa;
  _ = case failok == 2 of True -> Unit | False -> error failwhy;
  failed = NI.result me failroot;
  freed = NI.settle 0 400;
  verdict = if refused == "storeprobe: Err storage: the storage actor refused the request noise=True" and dead == refused and during == "storeprobe: Err dead actor noise=True" and healthy == "storeprobe: Ok  noise=True" and failed == "failed: dead actor" and freed then "HOLDS" else "FAILED";
  "nativerefusal: full=[{refused}] dead=[{dead}] during=[{during}] healthy=[{healthy}] routed=[{failed}] freed={freed} {verdict}".

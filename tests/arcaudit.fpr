# arcaudit.fpr — ARC.qa in action: baseline, deliberate leak, audit.
# The leak is one undropped received message root — exactly the class
# every qosp session paid for in blood; here ARC.qa CATCHES it.
uart = device "uart" .
lsrReady = v = read (reg8 uart 5); BITTEST v 5 .
putc : unsafe Int -> Unit .
putc c | lsrReady = write (reg8 uart 0) c.
putc c = putc c .
# console text over THIS file's putc (the prelude cannot host these:
# putc is per-target device code, and the prelude is a cached unit)
puts : unsafe String -> Unit .
puts s = putsFrom s 1 .
putsFrom : unsafe String -> Int -> Unit .
putsFrom s i | i > strlen s = Unit.
putsFrom s i = putc (charAt s i) >> putsFrom s (i + 1) .
nl : unsafe Unit .
nl = putc 13 >> putc 10 .

ARCM = use "../programs/mods/arcsvc".
Arc = ARCM.Arc.

# a well-behaved echo (drops) and a leaky one (keeps the root)
echo : unsafe Int -> f42 .
echo me = m = receive me; echoStep me m .
echoStep : unsafe Int -> (Int, Int) -> g42 .
echoStep me m = (replyTo, n) = m; send replyTo (n * 2, 0) >> drop m >> echo me .

# leaky RETAINS the root (carries it into the recursion) — a real
# retention the autodrop pass correctly refuses to touch (m is
# referenced after the destructure), and ARC.qa catches.
leaky : unsafe Int -> p42 .
leaky me = m = receive me; leakyStep me m .
leakyStep : unsafe Int -> (Int, Int) -> i42 .
leakyStep me m = (replyTo, n) = m; send replyTo (n * 3, 0) >> leakyHold me m .
leakyHold : unsafe Int -> (Int, Int) -> j42 .
leakyHold me kept = m2 = receive me; leakyStep me m2 .

roundTrip me svc n =
  _ = send svc (me, n);
  r = receive me;
  (v, z) = r;
  _ = drop r;
  v .

main =
  me = myself 0;
  _ = nl >> puts "arcaudit: Arc policy as a service (/services/arc when loaded)" >> nl;
  a = Arc.start Unit;
  e = spawn echo;
  l = spawn leaky;
  b = Arc.baseline me a;
  _ = puts "baseline captured: live = {b}" >> nl;
  v1 = roundTrip me e 21;
  d1 = Arc.audit me a;
  _ = puts "after clean echo ({v1}):  audit delta = {d1}" >> nl;
  v2 = roundTrip me l 21;
  d2 = Arc.audit me a;
  _ = puts "after leaky echo ({v2}):  audit delta = {d2}   <- the kept root, caught" >> nl;
  verdict (d1 == 0) (d2 > 0) .

verdict : unsafe Bool -> Bool -> Unit .
verdict True True = puts "ARC.qa: clean path flat, leak detected -- policy is service-owned" >> nl.
verdict _ _ = puts "ARC.qa: unexpected deltas" >> nl.

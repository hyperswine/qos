# gltext.fpr -- the walker's text pass and disc meshes: a coin and a
# flat label on the ground in the 3D scene, then the 2D layer with the
# SDF face at several sizes, alpha, and discs.  Snapshots frame 6 to
# /tmp/gltext-1.ppm and quits.
#
#   make qos-app PROG=tests/gltext.fpr
#   (cd qos && make portable-gl && xvfb-run -a ./qosp-gl --yes ../app.qa)
unsafe program.

MV = use "std/mvu".
GL = use "../programs/mods/glsvc".

App = MV.App.
MQuit = MV.MQuit.
ETick = MV.ETick.
STick = MV.STick.

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).

lights = ((3000, 9000, 6000), (1000, 1000, 1000)) :: Nil.
camera = ((0, 5200, 7800), (0, 0, 0), 950).

scene t = Scene Nil (ents t) lights camera.
ents t =
  Ent "plane" (0, 0, 0) 0 (12000, 1000, 12000) (150, 170, 150) ::
  Ent "coin" (0 - 2000, 20, 0) 0 (2400, 1000, 2400) (950, 720, 200) ::
  Ent "cube" (2000, 500, 0) (t * 100) (1000, 1000, 1000) (250, 450, 950) ::
  Ent (1, "Alpha Tank") (0 - 3200, 30, 1800) 0 (700, 700, 1000) (1000, 1000, 1000) ::
  Ent (1, "yawed") (1400, 30, 1800) 400 (600, 600, 1000) (1000, 900, 300) :: Nil.

# 960x600 virtual px: 1 px = 25 milli, pen at (x, baseline)
pen x y = ((x - 480) * 25, (300 - y) * 25, 0).
txt s x y em col = Ent (0, s) (pen x y) 0 (em * 25, em * 25, 1) col.
disc x y r col = Ent "disc" ((x - 480) * 25, (300 - y) * 25, 0) 0 (r * 50, r * 50, 1) col.

ui t =
  txt "Terra II" 40 70 48 (1000, 1000, 1000) ::
  txt "The quick brown fox jumps over the lazy dog 0123456789" 40 110 20 (900, 910, 930) ::
  txt "Light Infantry  ATK 2  HP 3  cost 2" 40 140 14 (900, 910, 930) ::
  txt "small text at twelve px: Ammo, Supply, Move" 40 160 12 (700, 720, 760) ::
  txt "faded" 40 200 24 (1000, 1000, 1000, 400) ::
  disc 700 200 40 (1000, 700, 200) ::
  disc 700 200 30 (100, 100, 120) ::
  txt "3" 690 212 32 (1000, 1000, 1000) :: Nil.

init env = 0.
update env ev t = case ev of
    ETick -> tick (t + 1)
  | e -> (t, Nil).
tick t | t > 12 = (t, MQuit :: Nil).
tick t = (t, Nil).
subs t = STick 40 :: Nil.
view t = (scene t, (ui t, 15000), case t >= 6 of True -> 1 | False -> 0).

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  gl = spawn (GL.serve 960 600 "gltext" Nil);
  cfg = { env = 0, mt = mt, tick = 160000, input = gl, render = gl };
  _ = print "gltext: text + discs";
  MV.game me cfg (App init update subs view).

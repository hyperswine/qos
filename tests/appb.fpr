# appb -- the second app image: spawns a helper of its own, which
# inherits the app's pid (the process is the pid, not the actor), and
# reports (name, pid, helper's pid, result).
unsafe program.
helper parent me =
  _ = send parent (myPid 0, 7 * 6);
  0.
app me =
  shell = receive me;
  h = spawn (helper me);
  (hp, r) = receiveFrom me h;
  _ = send shell ("appb", myPid 0, hp, r);
  0.

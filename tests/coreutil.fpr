# coreutil.fpr -- focused behavior checks for the shared pure helpers.

C = use "../programs/mods/coreutil".

main = parseOk (C.parseNat "42").
parseOk r = case r of
    Err e -> error "coreutil: valid parse failed"
  | Ok n -> case n == 42 of
      False -> error "coreutil: valid parse changed"
    | True -> parseBad (C.parseNat "12x").
parseBad r = case r of
    Ok n -> error "coreutil: invalid parse accepted"
  | Err e -> compatibility Unit.
compatibility u =
  (word, next) = C.wordAt "abc 12" 1 6;
  case C.and2 (C.strEq word "abc") (next == 5) of
    False -> error "coreutil: token helper changed"
  | True -> case C.and2 (C.parseDigits "12x" == 12) (C.parseDigitsAt "h34" 2 == 34) of
      False -> error "coreutil: compatibility parse changed"
    | True -> collections Unit.
collections u =
  ls = C.lines "one\n\ntwo\n";
  joined = C.listAppend [1, 2] [3];
  case C.and2 (C.listLen ls == 2) (C.listLen joined == 3) of
    False -> error "coreutil: collection helper changed"
  | True -> case C.strEq "same" "same" of
      False -> error "coreutil: string equality failed"
    | True -> case C.strEq "same" "other" of
        True -> error "coreutil: string inequality failed"
      | False -> "coreutil: OK".
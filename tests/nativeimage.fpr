# nativeimage.fpr -- a TEST KERNEL (built in place of programs/system.fpr):
# native process images are memory like any other
# (docs/2026-10-01-PROCESS-IMAGES.md).  A relocatable image is placed in a
# block from the buddy, so:
#
#   1. two processes run at once -- the second placement is not refused, and
#      both compute the right answer (neither image overwrote the other);
#   2. an image stays while any actor of its process runs -- a process whose
#      main returned while its child still runs keeps its image until the
#      child ends -- and then goes;
#   3. when every process has ended, no image is left and the memory is back.
#
#   tools/nativeimage-check.sh builds this kernel and the two images.
#
# Expected: "nativeimage: concurrent=both-intact linger=held-then-freed
# images=0 memory=returned HOLDS"

FS = use "std/fs".
QAR = use "../programs/mods/qar".
QaImg = use "../programs/mods/qaimg".

Sys.placeImageAt : String -> List Int -> List Int -> String -> Int -> (Int, String, Int) .
Sys.reservePid : Unit -> Int .
Sys.images : Int -> Int .
Sys.arenaFree : Int -> Int .

# (ok, msg, root) of one placement of the archive -- root is the process's
# root actor, whose result the test waits for by sender -- or (0, why, 0)
# before placing
place : String -> (Int, String, Int) .
place qa = case QAR.sectionBytes qa "LOAD" of
    Err e -> (0, "no LOAD: {e}", 0)
  | Ok load -> place2 qa load.
place2 : String -> String -> (Int, String, Int) .
place2 qa load = case QAR.extent qa "IMAGE" of
    Err e -> (0, "no IMAGE: {e}", 0)
  | Ok r -> (case QAR.extent qa "RELOC" of
      Err e -> (0, "no RELOC: {e}", 0)
    | Ok rel -> place3 qa load r rel).
place3 : String -> String -> (Int, Int) -> (Int, Int) -> (Int, String, Int) .
place3 qa load r rel =
  (ipos, iln) = r;
  (rpos, rln) = rel;
  case QaImg.parse load of
    Err e -> (0, "bad LOAD: {e}", 0)
  | Ok m -> (case QaImg.check m iln of
      Err e -> (0, "bad image: {e}", 0)
    | Ok m2 -> Sys.placeImageAt qa (ipos :: iln :: rpos :: rln :: Nil) (QaImg.nativeNums m2 (QaImg.nativeAbi load)) "CkSlow\n" (Sys.reservePid Unit)).

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  case FS.readLatest me fs "apps/CkSlow.qa" of
    Err e -> "nativeimage: no apps/CkSlow.qa on the disk ({e})"
  | Ok slow -> (case FS.readLatest me fs "apps/CkLinger.qa" of
      Err e -> "nativeimage: no apps/CkLinger.qa on the disk ({e})"
    | Ok linger -> run me slow linger).

intact s = strCmp s "slowproc: intact 4500001500000" == 0.
# the result of ONE process: its root actor's own reply (receiveFromRes), so
# two processes finishing in either order are told apart, and a root that
# dies without answering is "failed: dead actor"
result me root = case receiveFromRes me root of Ok m -> resultOf m | Err e -> "failed: {e}".
resultOf m = case m of Ok s -> s | Err e -> "failed: {e}".

run : unsafe Int -> String -> String -> String .
run me slow linger =
  imgs0 = Sys.images 0;
  free0 = Sys.arenaFree 0;
  (ok1, m1, r1) = place slow;
  (ok2, m2, r2) = place slow;
  concurrent = case ok1 == 2 and ok2 == 2 of
      False -> "WRONG (placed {ok1} {m1}; {ok2} {m2})"
    | True -> both (result me r1) (result me r2);
  (okL, mL, rL) = place linger;
  lingered = case okL == 2 of
      False -> "linger not placed ({mL})"
    | True -> lingerCheck me rL imgs0;
  _ = settle imgs0 400;
  imgs = Sys.images 0 - imgs0;
  free1 = Sys.arenaFree 0;
  memory = case free1 + 524288 >= free0 of
      True -> "returned"
    | False -> "NOT RETURNED ({free0} -> {free1})";
  verdict = case strCmp concurrent "both-intact" == 0 and strCmp lingered "held-then-freed" == 0 and imgs == 0 and strCmp memory "returned" == 0 of
      True -> "HOLDS"
    | False -> "FAILED";
  "nativeimage: concurrent={concurrent} linger={lingered} images={imgs} memory={memory} {verdict}".

both a b = case intact a and intact b of
    True -> "both-intact"
  | False -> "WRONG ({a} / {b})".

# main has returned; its child still runs the image's code, so the image is
# still there; once the child ends it goes
lingerCheck : unsafe Int -> Int -> Int -> String .
lingerCheck me root imgs0 =
  r = result me root;
  held = Sys.images 0 - imgs0;
  case held == 1 of
    False -> "not held while the child ran ({held} images; main said {r})"
  | True -> (case settle imgs0 600 of
      True -> "held-then-freed"
    | False -> "never freed").

# wait until the images are back to imgs0 (True), or give up (False)
settle : unsafe Int -> Int -> Bool .
settle imgs0 n = case Sys.images 0 == imgs0 of
    True -> True
  | False -> (case n <= 0 of
      True -> False
    | False -> Sys.sleepUs 20000 >> settle imgs0 (n - 1)).

# mvulat.fpr -- INPUT / DISPLAY latency, measured as the SERVICE
# ROUNDTRIPS an MVU app actually performs, headless (no real
# keyboard, no real display -- the services are simulated actors
# speaking the exact same Poll / Rv protocols the real ones speak, so
# the numbers are the actor-messaging + scheduling cost of the paths):
#
#   input rt    the drain's unit of work: send (me, Poll 0) to the
#               input service actor, receiveFrom the (kind,a,b) reply
#               -- one keyboard/mouse poll (a mouse click rides the
#               same kind-4 evdev arm as a key press; pointer MOTION
#               is not in the protocol yet)
#   display rt  the frame's unit of work: send (me, Render ..) to the
#               render service actor, receiveFrom the (draws, bytes)
#               reply -- what stands between a computed scene and the
#               renderer having it
#   key->update the END-TO-END simulation: the input service stamps a
#               press with mt AT REPLY TIME and smuggles the stamp AS
#               the key code; update stamps again on the EKey's
#               arrival.  That spans service reply -> drain ->
#               subscription filter -> update -- the full MVU input
#               pipeline (frame pacing excluded: cfg.tick = 0).
#   frame       total run time / frames: one whole MVU iteration
#               (poll drain + update + statics check + worker
#               dispatch + vals + render call + reply).
#
# Time source: the clint's mtime register (10 MHz -> 1 tick = 0.1us),
# the same register std.MVU's own pacing reads.  Stats are min/avg/
# max in us plus a 4-bucket histogram ( <=10us <=100us <=1ms >1ms ).
#
#   make qos-app PROG=tests/mvulat.fpr
#   (cd qos && make portable && ./qosp --yes ../app.qa)
#
# Expected: three "lat ..." lines and a result line with key->update
# stats and the avg frame time; the check leg asserts shape, not
# numbers (they are host-dependent).

MV = use "std/mvu".

MApp = MV.MApp.
MQuit = MV.MQuit.
ETick = MV.ETick.
EKey = MV.EKey.
EResize = MV.EResize.
SKeys = MV.SKeys.
Rv = MV.Rv.
Render = MV.Render.
Dims = MV.Dims.
Poll = MV.Poll.

# ---- stats: (n, sum, mn, mx, b10, b100, b1000, bBig), ticks ----------------

st0 = (0, 0, 1000000000, 0, 0, 0, 0, 0).

statAdd st d =
  (n, s, mn, mx, b1, b2, b3, b4) = st;
  mn2 = statMin mn d;
  mx2 = statMax mx d;
  case d <= 100 of
    True -> (n + 1, s + d, mn2, mx2, b1 + 1, b2, b3, b4)
  | False -> case d <= 1000 of
      True -> (n + 1, s + d, mn2, mx2, b1, b2 + 1, b3, b4)
    | False -> case d <= 10000 of
        True -> (n + 1, s + d, mn2, mx2, b1, b2, b3 + 1, b4)
      | False -> (n + 1, s + d, mn2, mx2, b1, b2, b3, b4 + 1).
statMin a b = case b < a of True -> b | False -> a.
statMax a b = case b > a of True -> b | False -> a.

# ticks -> us with one decimal (10 ticks = 1us)
usF t = "{t / 10}.{imod10 t}".
imod10 t = t - (t / 10) * 10.

statShow name st =
  (n, s, mn, mx, b1, b2, b3, b4) = st;
  avg = statAvg s n;
  "lat {name}: n={n} min={usF mn}us avg={usF avg}us max={usF mx}us  [<=10us:{b1} <=100us:{b2} <=1ms:{b3} >1ms:{b4}]".
statAvg s n = case n == 0 of True -> 0 | False -> s / n.

# ---- the null render service (Rv protocol, headless + quiet) ---------------

nullRender : unsafe Int -> a .
nullRender me =
  m = receive me;
  (replyTo, q) = m;
  nrMsg me replyTo q.
nrMsg : unsafe Int -> Int -> Rv -> a .
nrMsg me replyTo q = case q of
    Dims u -> send replyTo (80, 24) >> nullRender me
  | Render st vs sc fr -> send replyTo (1, 0) >> nullRender me
  | Poll u -> send replyTo (0, 0, 0) >> nullRender me.

# ---- the null input service (Poll protocol: keyboard with no keys) ---------

nullInput : unsafe Int -> a .
nullInput me =
  m = receive me;
  (from, q) = m;
  send from (0, 0, 0) >> nullInput me.

# ---- the stamping input service: N presses, stamp AS the key code ----------
# One kind-4 press per poll while the budget lasts (then kind 0
# forever) -- a keyboard whose key-down instant IS the reply instant,
# so update's stamp minus the code is the service->update latency.

stampInput : unsafe Int -> Int -> a .
stampInput left me =
  m = receive me;
  (from, q) = m;
  siReply left from me.
siReply : unsafe Int -> Int -> Int -> a .
siReply left from me = case left == 0 of
    True -> send from (0, 0, 0) >> stampInput 0 me
  | False -> siStamp left from me.
siStamp : unsafe Int -> Int -> Int -> a .
siStamp left from me =
  clint = device "clint";
  mt = reg32 clint 49144;
  _ = send from (4, read mt, 1);
  stampInput (left - 1) me.

# ---- direct service-roundtrip probes (the drain/frame unit of work) --------

pollRt : unsafe Int -> Int -> Int -> Int -> _ -> _ .
pollRt me inp mt k st | k == 0 = st.
pollRt me inp mt k st =
  t0 = read mt;
  _ = send inp (me, Poll 0);
  r = receiveFrom me inp;
  t1 = read mt;
  _ = drop r;
  pollRt me inp mt (k - 1) (statAdd st (t1 - t0)).

renderRt : unsafe Int -> Int -> Int -> Int -> _ -> _ .
renderRt me rsvc mt k st | k == 0 = st.
renderRt me rsvc mt k st =
  t0 = read mt;
  _ = send rsvc (me, Render 0 ("x=1 y=2" :: "hud 60fps" :: Nil) 1 k);
  r = receiveFrom me rsvc;
  t1 = read mt;
  _ = drop r;
  renderRt me rsvc mt (k - 1) (statAdd st (t1 - t0)).

# ---- the MVU app (the POWERED MApp surface: dn carries the stats) ----------
# model = (keyStats, got); env = mt (the clint register, opaque to MVU)

nKEYS = 400.

lInit env = (st0, 0).

lUpdate me env ev m = case ev of
    EKey t -> lKey env t m
  | e -> (m, Nil).
lKey env t m =
  (st, got) = m;
  now = read env;
  st2 = statAdd st (now - t);
  case got + 1 == nKEYS of
    True -> ((st2, got + 1), MQuit :: Nil)
  | False -> ((st2, got + 1), Nil).

lSk m = 0.
lVw vp m = 0.
lVl self env vp m = "mvulat" :: Nil.  # one string/frame: a nonzero payload
lSubs m = SKeys :: Nil.

lDone m =
  (st, got) = m;
  statShow "key->update" st.

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  inp0 = spawn nullInput;
  rsvc = spawn nullRender;
  _ = print (statShow "input-poll rt" (pollRt me inp0 mt 1000 st0));
  _ = print (statShow "render rt" (renderRt me rsvc mt 500 st0));
  inp = spawn (stampInput nKEYS);
  cfg = { env = mt, mt = mt, tick = 0, input = inp, render = rsvc };
  tR0 = read mt;
  r = MV.run me cfg (MApp lInit lUpdate lSk lVw lVl lDone lSubs);
  tR1 = read mt;
  "{r} [run {usF (tR1 - tR0)}us]".

unsafe program.
# runprog.fpr -- the Editor's Run, end to end in QOS: source strings packaged
# by the host compiler (Sys.compile, worker-backed since ABI v21), started as
# processes of their own by programs/mods/runprog.fpr, their consoles
# captured, their ends seen: a return, a trap, a stop.  And a compile that
# takes seconds holds no hart: on ONE hart, a ticker keeps ticking through it.
#
#   ./qos.py run tests/runprog.fpr --harts 1     (the directive below starts
#                                                 the compiler daemon)
#: fprd
#: expect runprog: HOLDS
RP = use "../programs/mods/runprog".
PG = use "std/hosted".
Sys.killPid : (pid : Int | pid > 0) -> String -> Int .
Sys.alive : Int -> Bool .
CP = use "std/compile".
AC = use "std/actor#201a0e9bf98a5154".

check what ok = if ok then Unit else error "runprog: {what}".

# a ticker: counts 2 ms naps until asked, then answers the count
tick self n = case receiveNow self of
    Ok borrowed ->
      m = keep borrowed;
      _ = drop borrowed;
      (from, id, q) = m;
      _ = AC.reply (from, id) n;
      Unit
  | Err why -> _ = Sys.sleepUs 2000; tick self (n + 1).

package src = CP.plugin 0 "qedrun" (RP.wrap src).

# start it (confined to `budget` bytes) and poll it to its end (or until n
# polls): what it printed, how it ended
runToEnd me src n = runWithin me src (64 * 1048576) n.
runWithin me src budget n = case package src of
    Err why -> ("", "compile failed: {why}")
  | Ok qa -> case (if budget > 0 then RP.start qa budget 1 else Err "no budget") of
      Err why -> ("", "start failed: {why}")
    | Ok proc -> drain me proc n "".
drain : Int -> RP.Proc -> Int -> String -> (String, String) .
drain me proc n acc = if n <= 0 then (strcat acc (RP.stop proc), "still running") else
  case RP.poll me proc of
    (text, said, RP.Running more) -> _ = Sys.sleepUs 5000; drain me more (n - 1) (strcat acc text)
  | (text, said, RP.Ended how) -> (strcat acc text, how).

# Deliberately withhold takes until the root ends. The capture limit applies
# between takes, so a consumer that drains a slower producer every 5 ms can
# correctly collect the whole flood without losing any bytes. Waiting for
# death makes overflow independent of machine speed and hart scheduling.
runUndrained me src n = case package src of
    Err why -> ("", "compile failed: {why}")
  | Ok qa -> case RP.start qa (64 * 1048576) 1 of
      Err why -> ("", "start failed: {why}")
    | Ok proc ->
        RP.Proc root pid = proc;
        ended = waitEnded root n;
        drain me (RP.Proc root pid) (if ended then 1 else 0) "".
waitEnded root n = if not (Sys.alive root) then True
  else if n <= 0 then False
  else _ = Sys.sleepUs 5000; waitEnded root (n - 1).

# run a program to its end, then ask its pid to end again: how many were left
startedPid me src n = case package src of
    Err why -> 0 - 1
  | Ok qa -> case RP.start qa (64 * 1048576) 1 of
      Err why -> 0 - 2
    | Ok proc -> (pid, held) = RP.pidOf proc; (out, how) = drain me held n ""; leftOf pid.
# start one that waits for ever, stop it, and ask again
stoppedPid me src = case package src of
    Err why -> 0 - 1
  | Ok qa -> case RP.start qa (64 * 1048576) 1 of
      Err why -> 0 - 2
    | Ok proc -> (pid, held) = RP.pidOf proc; _ = Sys.sleepUs 30000; _ = RP.stop held; leftOf pid.
leftOf pid = _ = Sys.sleepUs 20000; if pid > 0 then Sys.killPid pid "left?" else 0 - 3.

# ---- an app (std/hosted): this test is its host -------------------------------
# (no header: the entry goes first, as for a plain main)
appSource = "P = use \"std/hosted\".\nMsg = Type (Got (Result String String)).\ninit = \{n = 0, file = \"none\"}.\nupdate ev m = case ev of\n    P.Key P.Enter -> (\{m | n = m.n + 1}, P.readFile \"/home/x.txt\" (fn r -> Got r) :: Nil)\n  | P.Key (P.Char \"q\") -> (m, P.quit :: Nil)\n  | P.Msg (Got (Ok t)) -> (\{m | file = t}, Nil)\n  | P.Msg (Got (Err w)) -> (\{m | file = strcat \"refused \" w}, Nil)\n  | other -> (m, Nil).\nview size m = (cols, rows) = size; [\"n \{m.n} of \{cols}x\{rows}\", strcat \"file \" m.file].\nsubs m = Nil.\napp = \{ init = init, update = update, view = view, subs = subs }.\n".
# poll the process actor until the app says something: what it said (frames, asks), and why it ended
said : Int -> Int -> Int -> (List PG.ToHost, String) .
said me actor n = case RP.pollActor me actor of
    RP.Step text words True how -> (case words of
        Nil -> if n <= 0 then (Nil, "silent") else _ = Sys.sleepUs 5000; said me actor (n - 1)
      | w :: rest -> (words, ""))
  | RP.Step text words False how -> (words, how).
frameIn words = case words of Nil -> Nil | w :: rest -> (case w of PG.Frame lines -> lines | other -> frameIn rest).
askIn words = case words of Nil -> (0, "") | w :: rest -> (case w of PG.Ask token (PG.ReadReq path) -> (token, path) | other -> askIn rest).
hostedApp me = case CP.plugin 0 "qedrun" (RP.wrapApp appSource) of
    Err why -> "package: {why}"
  | Ok qa -> case RP.open me qa (64 * 1048576) 40 10 of
      Err why -> "start: {why}"
    | Ok (actor, pid) ->
        (w1, e1) = said me actor 400;
        first = frameIn w1;
        _ = RP.tellActor actor (PG.KeyIn 28);
        (w2, e2) = said me actor 400;
        (token, path) = askIn w2;
        _ = RP.tellActor actor (PG.Answer token (PG.Text "hello"));
        (w3, e3) = said me actor 400;
        third = frameIn w3;
        _ = RP.tellActor actor (PG.KeyIn 16);
        (w4, e4) = said me actor 400;
        _ = RP.stopActor me actor;
        "{(case first of a :: rest -> a | Nil -> "-")}|{path}|{(case third of a :: b :: rest -> b | other -> "-")}|{e4}".

main =
  me = myself 0;
  ticker = spawn (fn self -> tick self 0);
  hello = package "main = _ = print \"hello from run\"; 6 * 7.";
  ticks = (case AC.call me ticker 0 of Ok n -> n | Err why -> 0 - 1);
  _ = check "a compile holds no hart (ticks {ticks})" (ticks > 20);
  _ = check "the package" (case hello of Ok qa -> strlen qa > 1000 | Err why -> error "runprog: package: {why}");
  (out1, how1) = runToEnd me "main = _ = print \"hello from run\"; 6 * 7." 400;
  _ = check "output captured: [{out1}] {how1}" (out1 == "hello from run\n42\n" and how1 == "finished");
  (out2, how2) = runToEnd me "main = print \"only this\"." 400;
  _ = check "a Unit main: [{out2}]" (out2 == "only this\n()\n" and how2 == "finished");
  (out3, how3) = runToEnd me "main = _ = print \"before\"; error \"boom\"." 400;
  # what the program printed, then the runtime's own line for its failure
  # (logged from the failing actor, so captured with the rest)
  _ = check "a trap ends it with its reason: [{out3}] {how3}" (out3 == "before\n[ERR] actor failed: boom\n" and how3 == "boom");
  bad = package "main = 1 +";
  badWhy = (case bad of Ok qa -> "packaged?!" | Err why -> why);
  # the entry goes in before the program: an unfinished last line is
  # reported as the program's own (line 2 of the package is line 1 of it)
  _ = check "a compile error names the line: [{badWhy}]" (strIndexOf "qedrun.fpr:2:" badWhy >= 0);
  _ = check "the entry maps back" (RP.userLine "main = 1 +" 2 == 1 and RP.userLine "unsafe program.\nmain = 1." 3 == 2);
  _ = check "after the header" (RP.wrap "# hi\nunsafe program.\nmain = 1." == "# hi\nunsafe program.\n{RP.entry}\nmain = 1.");
  _ = check "first without one" (RP.wrap "main = 1." == "{RP.entry}\nmain = 1.");
  _ = check "tab, split and signature entries count"
    (RP.hasMain ["main\t= 42."] and RP.hasMain ["main", "  = 42."] and RP.hasMain ["main : unsafe Int ."]
     and RP.hasMain ["main # run it"] and RP.hasApp ["app\t= 1."] and RP.hasApp ["app", ": Type ."]);
  _ = check "near misses are not entries"
    (not (RP.hasMain ["mainfoo = 1"]) and not (RP.hasMain ["  main = 1"]) and not (RP.hasMain ["# main = 1"])
     and not (RP.hasMain ["main"]) and not (RP.hasMain ["main", "print 1."]) and not (RP.hasApp ["application = 1"]));
  (outT, howT) = runToEnd me "main\t= 42." 400;
  _ = check "a tab entry runs: [{outT}] {howT}" (outT == "42\n" and howT == "finished");
  (outS, howS) = runToEnd me "main\n  = 40 + 2." 400;
  _ = check "a split entry runs: [{outS}] {howS}" (outS == "42\n" and howS == "finished");
  (out4, how4) = runToEnd me "unsafe program.\nspin : unsafe Int -> Int .\nspin n = spin (n + 1).\nmain = _ = print \"spinning\"; spin 0." 20;
  _ = check "a spinning program is stopped: [{out4}] {how4}" (out4 == "spinning\n" and how4 == "still running");
  (out5, how5) = runUndrained me "unsafe program.\nsay : unsafe Int -> Unit .\nsay n = if n <= 0 then Unit else _ = print \"0123456789012345678901234567890123456789\"; say (n - 1).\nmain = say 5000." 2000;
  # 5,000 lines of 40 bytes plus newline, followed by the entry's "()\n".
  lost = 5000 * 41 + 3 - 65536;
  notice = "[{lost} earlier bytes not kept]\n";
  _ = check "an undrained flood keeps its last 64 KiB and says what it lost: {how5}, {strlen out5} bytes"
    (how5 == "finished" and RP.startsWith notice out5 and strlen out5 == 65536 + strlen notice
     and substr out5 (strlen notice) 15 == "67890123456789\n"
     and substr out5 (strlen out5 - 3) 3 == "()\n");
  # confinement: what would have stopped the machine ends the program, with its reason
  (o6, how6) = runWithin me "unsafe program.\ndeep : unsafe Int -> Int .\ndeep n = 1 + deep (n + 1).\nmain = deep 0." (16 * 1048576) 2000;
  _ = check "a runaway recursion ends the program: {how6}" (strIndexOf "budget of 16 MiB is used up" how6 >= 0 and strIndexOf "stack" how6 >= 0);
  (o7, how7) = runWithin me "unsafe program.\nhog : unsafe Int -> List Int -> Int .\nhog n acc = hog (n + 1) (n :: acc).\nmain = hog 0 Nil." (16 * 1048576) 2000;
  _ = check "a memory hog ends the program: {how7}" (strIndexOf "budget of 16 MiB is used up" how7 >= 0 and strIndexOf "heap" how7 >= 0);
  (o8, how8) = runToEnd me "main = _ = device \"blk\"; 1." 400;
  _ = check "a device is not granted: {how8}" (strIndexOf "device" how8 >= 0 and strIndexOf "not granted" how8 >= 0);
  (o9, how9) = runToEnd me "main = blkPages 0." 400;
  _ = check "nor the raw disk: {how9}" (strIndexOf "blkPages (the raw disk) is not granted" how9 >= 0);
  (o10, how10) = runToEnd me "main = kill 5." 400;
  _ = check "a handle that is not an actor is the program's mistake: {how10}" (strIndexOf "not an actor" how10 >= 0);
  # what main started goes with it, and a stop ends every actor
  left = startedPid me "unsafe program.\nnap : unsafe Int -> Unit .\nnap me = _ = receive me; nap me.\nmain = _ = spawn nap; _ = spawn nap; \"left two\"." 400;
  _ = check "a program's actors end with its root ({left})" (left == 0);
  stopped = stoppedPid me "unsafe program.\nnap : unsafe Int -> Unit .\nnap me = _ = receive me; nap me.\nmain = _ = spawn nap; _ = spawn nap; nap (myself 0)." ;
  _ = check "a stop ends every actor ({stopped})" (stopped == 0);
  # an app: its frames, its keys, its file ask answered by the host, its quit
  hosted = hostedApp me;
  _ = check "an app runs under its host: {hosted}" (hosted == "n 0 of 40x10|/home/x.txt|file hello|finished");
  # the capture went with each program: the console is the host's again
  _ = print "runprog: HOLDS";
  "runprog: HOLDS".

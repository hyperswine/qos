#: expect appsession: HOLDS
unsafe program.
C = use "../programs/mods/clockapp".
L = use "../programs/mods/logsapp".
B = use "../programs/mods/browserapp".
D = use "../programs/mods/diskapp".
T = use "../programs/mods/termapp".
ED = use "../programs/mods/editapp".
E = use "../programs/mods/editbuf".
AS = use "../programs/mods/appsession".
AW = use "../programs/mods/appwire".
AP = use "../programs/mods/appclient".
S2 = use "../programs/mods/scene2d".
AC = use "std/actor#201a0e9bf98a5154".
check tag True = Unit.
check tag False = error "appsession: {tag}".
typeKeys Nil m = m.
typeKeys (k :: rest) m = (next, cmds) = ED.update (AW.Key k) m; typeKeys rest next.
ticks 0 m = (m, Nil).
ticks n m = (next, cmds) = ED.update AW.Tick m; if n == 1 then (next, cmds) else ticks (n - 1) next.
appMain : unsafe Int -> Unit .
appMain me = C.run me.
silent me = _ = receive me; _ = Sys.sleepUs 3000000; Unit.
adopt parent me =
  app = spawn C.run;
  _ = AC.callWithin 500 me app (AW.magic, AW, (7, (800, 480), (0, 0)));
  _ = send parent app;
  _ = receive me; Unit.
adoptClient parent me =
  client = spawn (AP.run me 0 0 800 480);
  _ = send parent client;
  _ = receive me; Unit.
main =
  (c, _) = C.init;
  (ready, _) = C.update (AW.Arrived 1 (Ok (AW.Time 123))) c;
  _ = check "check 1" (ready.time == 123 and not ready.busy);
  (stale, _) = C.update (AW.Arrived 2 (Ok (AW.Time 999))) ready;
  _ = check "check 2" (stale.time == 123);
  (b, _) = B.init;
  (paths, _) = B.update (AW.Arrived 1 (Ok (AW.Lines ["/one", "/two"] ""))) b;
  (reading, _) = B.update (AW.Key 28) paths;
  (back, _) = B.update (AW.Key 14) reading;
  (late, _) = B.update (AW.Arrived reading.token (Ok (AW.Text "late"))) back;
  _ = check "check 3" (late.mode == 0 and late.lines == Nil and not late.busy);
  me = myself 0;
  app = spawn C.run;
  boot = AC.callWithin 500 me app (AW.magic, AW, (1, (800, 480), (0, 0)));
  _ = check "check 4" (case boot of Ok (magic, schema, session) -> magic == AW.magic and schema == AW and session == 1 | other -> False);
  answer = AC.callWithin 500 me app (AW.Event 1 1 (AW.Key 30));
  _ = check "check 5" (case answer of Ok (AW.Frame session revision tree vals status) -> session == 1 and revision >= 2 | other -> False);
  staleReply = AC.callWithin 500 me app (AW.Event 1 1 AW.Tick);
  _ = check "check 6" (case staleReply of Ok (AW.Refused why) -> True | other -> False);
  wrongClose = AC.callWithin 500 me app (AW.Close 2);
  _ = check "check 7" (case wrongClose of Ok (AW.Refused why) -> True | other -> False);
  closed = AC.callWithin 1500 me app (AW.Close 1);
  _ = check "check 8" (case closed of Ok (AW.Closed 1 (Ok u)) -> True | other -> False);
  _ = Sys.sleepUs 10000;
  _ = check "check 9" (not (Sys.alive app));
  bad = spawn C.run;
  refused = AC.callWithin 500 me bad ("wrong-version", AW, (2, (800, 480), (0, 0)));
  _ = check "check 10" (case refused of Ok (magic, schema, session) -> magic == "refused" and session == 0 | other -> False);
  managed = spawn C.run;
  _ = AC.callWithin 500 me managed (AW.magic, AW, (3, (800, 480), (0, 0)));
  (live, frame) = AP.exchange me AW.Tick {AP.empty | actor = managed, session = 3};
  _ = check "client frame" (case frame of Ok (AW.Frame sid rev tree vals status) -> sid == 3 and rev > 0 | other -> False);
  (sized, resizedFrame) = AP.exchange me (AW.Resize 1280 640) live;
  _ = check "session resize reaches child view" (case resizedFrame of
    Ok (AW.Frame sid rev (S2.Box attrs kids) vals status) -> S2.wOf attrs == 1280 and S2.hOf attrs == 640
    | other -> False);
  (idle, left) = AP.leave me sized;
  _ = check "client close" (case left of Ok (AW.Closed sid (Ok u)) -> idle.actor == 0 | other -> False);
  _ = check "missing entry" (case AP.entry 99999 of Err why -> True | other -> False);
  client = spawn (AP.run me 0 0 800 480);
  _ = check "client rejection" (case AP.call me client (AP.Open 99999) of Err why -> True | other -> False);
  _ = send client (0, AW.Refused "stale reply");
  _ = check "parked client drains stale replies" (case AP.call me client AP.Inspect of Ok other -> True | Err why -> False);
  _ = check "client stop" (case AP.stop me client of Ok u -> True | other -> False);
  hung = spawn silent;
  start = AC.nowUs Unit;
  (forced, failure) = AP.exchange me AW.Tick {AP.empty | actor = hung, session = 9};
  _ = check "check 15" (case failure of Err why -> strlen why > 0 and forced.actor == 0 and forced.cleanup != "" and forced.failures == 1 | other -> False);
  _ = check "check 16" (AC.nowUs Unit - start < 2200000 and not (Sys.alive hung));
  (retryIdle, retryAnswer) = AP.launch 0 0 800 480 me 99999 forced;
  _ = check "retry reaches entry validation" (case retryAnswer of Err why -> why == "no app-session entry" and retryIdle.failures == 1 | other -> False);
  (exhausted, deniedRetry) = AP.launch 0 0 800 480 me 99999 {forced | failures = 3};
  _ = check "bounded recovery" (case deniedRetry of Err why -> why == "app recovery budget exhausted; restart Main" | other -> False);
  notNegotiated = spawn silent;
  (aborted, startupError) = AP.abortStartup {AP.empty | actor = notNegotiated} "wrong schema";
  _ = check "bootstrap abort" (not (Sys.alive notNegotiated) and aborted.failures == 1 and aborted.cleanup != "");
  _ = check "retain primary cleanup" (AP.retain "first failure" "second failure" == "first failure; second failure");
  schemaBad = spawn C.run;
  rejected = AC.callWithin 500 me schemaBad (AW.magic, "old-schema", (4, (800, 480), (0, 0)));
  _ = check "schema refused" (case rejected of Ok (magic, schema, sid) -> magic == "refused" | other -> False);
  slow = spawn silent;
  browser = spawn B.run;
  _ = AC.callWithin 500 me browser (AW.magic, AW, (5, (800, 480), (slow, 0)));
  closing = AC.callWithin 1500 me browser (AW.Close 5);
  _ = check "close during namespace read" (case closing of Ok (AW.Closed 5 (Ok u)) -> True | other -> False);
  _ = kill slow;
  owner = spawn (adopt me);
  orphan = case receiveFromRes me owner of Ok app -> app | Err why -> error why;
  _ = send owner Unit;
  _ = Sys.sleepUs 50000;
  _ = check "app owner death" (not (Sys.alive orphan));
  clientOwner = spawn (adoptClient me);
  parkedClient = case receiveFromRes me clientOwner of Ok actor -> actor | Err why -> error why;
  _ = Sys.sleepUs 10000;
  _ = send clientOwner Unit;
  _ = Sys.sleepUs 50000;
  _ = check "parked client owner death" (not (Sys.alive parkedClient));
  unstarted = spawn C.run;
  _ = Sys.sleepUs 1100000;
  _ = check "startup fuse" (not (Sys.alive unstarted));
  (logs, _) = L.init;
  (wanted, _) = L.update (AW.Key 18) logs;
  (follow, commands) = L.update (AW.Arrived 1 (Ok (AW.Lines ["old severity"] ""))) wanted;
  _ = check "latest severity only" (follow.sev == 2 and follow.busy and follow.rows == Nil and commands != Nil);
  (disk, _) = D.init;
  (failedDisk, _) = D.update (AW.Arrived 1 (Err "storage unavailable")) disk;
  (retryDisk, commands) = D.update (AW.Key 19) failedDisk;
  _ = check "disk retry" (retryDisk.busy and retryDisk.token == 2 and commands != Nil);
  # the Terminal's language: pure pipelines answer at once; a stage that
  # touches the namespace is one job and the pipeline resumes on its result
  (t0, _) = T.init;
  (counted, cmds1) = T.submit "echo one two three | nl | count" t0;
  _ = check "term pure pipeline" (T.lastLine counted == "1" and cmds1 == Nil and not counted.running);
  (kept, _) = T.submit "let n = echo a b | count ; echo there are $n lines" counted;
  _ = check "term let and $var" (T.lastLine kept == "there are 1 lines");
  (listing, cmds2) = T.submit "ls /home | grep t | count" kept;
  _ = check "term ls is a job" (listing.running and (case cmds2 of AW.Fetch tok AW.ListRoot :: Nil -> True | other -> False));
  (resumed, cmds3) = T.update (AW.Arrived listing.token (Ok (AW.Lines ["/home/t.txt", "/home/notes/a", "/tmp/x"] ""))) listing;
  _ = check "term listing resumes the pipeline" (T.lastLine resumed == "2" and not resumed.running and cmds3 == Nil);
  (writing, cmds4) = T.submit "echo hello | write notes/b.txt" resumed;
  _ = check "term write is a replacing job under cwd" (case cmds4 of AW.Fetch tok (AW.WritePath p t) :: Nil -> p == "/home/notes/b.txt" and t == "hello\n" | other -> False);
  (done, _) = T.update (AW.Arrived writing.token (Ok (AW.Done "wrote 6 bytes to /home/notes/b.txt"))) writing;
  _ = check "term job result shown" (T.lastLine done == "wrote 6 bytes to /home/notes/b.txt");
  (bad, cmds5) = T.submit "frobnicate" done;
  _ = check "term unknown word" (T.lastLine bad == "error: frobnicate: no such word (help)" and cmds5 == Nil);
  (moved, _) = T.submit "cd ../tmp ; pwd" bad;
  _ = check "term cd normalizes" (T.lastLine moved == "/tmp");
  (b2, _) = B.init;
  (tree, _) = B.update (AW.Arrived 1 (Ok (AW.Lines ["/home", "/home/notes/a", "/home/t.txt", "/logs/normal", "/", "/readme"] ""))) b2;
  _ = check "browser root folders win over same-named urls" (tree.paths == [("home", 1), ("logs", 1), ("readme", 0)]);
  (inHome, _) = B.update (AW.Key 28) tree;
  _ = check "browser descends a prefix" (inHome.dir == "/home" and inHome.paths == [("notes", 1), ("t.txt", 0)] and not inHome.busy);
  (upAgain, _) = B.update (AW.Key 14) inHome;
  _ = check "browser backspace goes up" (upAgain.dir == "" and upAgain.cursor == 0);
  # the Editor: its session record first; typing undone a run at a time; a
  # save through the safety job; a build's and a run's errors on the
  # buffer's own line (the Run entry is a line the buffer does not have);
  # the session record half a second after a change, and a recovery
  (e0, initCmds) = ED.init;
  _ = check "editor reads its session first" (case initCmds of AW.Fetch tok (AW.ReadPath p) :: Nil -> p == "/home/.editor/session" | other -> False);
  (e1, _) = ED.update (AW.Arrived 1 (Err "no such file")) e0;
  e3 = typeKeys [30, 48] e1;
  _ = check "editor typing" (E.toText e3.buf == "ab" and ED.dirty e3);
  (e4, _) = ED.update (AW.Key 4044) e3;
  _ = check "editor undoes a run of typing" (E.toText e4.buf == "" and not (ED.dirty e4));
  (e5, _) = ED.update (AW.Key 4021) e4;
  _ = check "editor redo" (E.toText e5.buf == "ab" and ED.dirty e5);
  (e6, cmds6) = ED.update (AW.Key 4031) e5;
  _ = check "editor save asks where" (e6.mode == 2 and e6.query == "/home/" and cmds6 == Nil);
  e7 = typeKeys [45, 52, 33, 25, 19] e6;
  (e8, cmds8) = ED.update (AW.Key 28) e7;
  _ = check "editor save is the safe job" (case cmds8 of AW.Fetch tok (AW.SaveFile p t) :: Nil -> p == "/home/x.fpr" and t == "ab" | other -> False);
  (e9, _) = ED.update (AW.Arrived e8.token (Ok (AW.Done "saved"))) e8;
  _ = check "editor saved" (not (ED.dirty e9) and e9.path == "/home/x.fpr");
  broken = {e9 | buf = E.fromText "main = 6 * 7.\nx = ."};
  (b1, bcmds) = ED.update (AW.Key 4048) broken;
  _ = check "editor build is a compile job" (case bcmds of AW.Fetch tok (AW.Compile prof src) :: Nil -> prof == "plugin:0:qedbuild" and src == "main = 6 * 7.\nx = ." | other -> False);
  (b2, _) = ED.update (AW.Arrived b1.token (Err "/b/fprd-src/qedbuild.fpr:2:5:\nunexpected '.'")) b1;
  _ = check "editor build error on its line and column" (b2.buf.row == 1 and b2.buf.col == 4 and not b2.building and E.nth b2.out (E.count b2.out - 3) == "x.fpr:2:5:" and b2.outBack == 3);
  (r1, rcmds) = ED.update (AW.Key 4019) broken;
  _ = check "editor run compiles the entry first" (case rcmds of AW.Fetch tok (AW.Compile prof src) :: Nil -> prof == "plugin:0:qedrun" and strIndexOf "qedRun me" src == 0 | other -> False);
  (r2, _) = ED.update (AW.Arrived r1.token (Err "/b/fprd-src/qedrun.fpr:3:5:\nunexpected '.'")) r1;
  _ = check "editor run error mapped past the entry" (r2.buf.row == 1 and r2.buf.col == 4 and E.nth r2.out (E.count r2.out - 3) == "x.fpr:2:5:");
  (s5, scmds) = ticks 5 (typeKeys [30] e9);
  _ = check "editor keeps its session" (case scmds of AW.Fetch tok (AW.WritePath p t) :: Nil -> p == "/home/.editor/session" and t == "qed1\n/home/x.fpr\n1\naba" | other -> False);
  (q0, _) = ED.init;
  (q1, _) = ED.update (AW.Arrived 1 (Ok (AW.Text "qed1\n/home/y.fpr\n1\nhello\nworld"))) q0;
  _ = check "editor recovers unsaved work" (E.toText q1.buf == "hello\nworld" and q1.path == "/home/y.fpr" and ED.dirty q1);
  "appsession: HOLDS".

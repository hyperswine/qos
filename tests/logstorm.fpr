# logstorm.fpr -- the console echo is rate-limited BY
# SEQUENCE (16 echoes per 64 ring writes + an honest suppression
# summary when echo resumes); the RINGS are never limited.  The leg
# asserts: bounded echo count, the "rings intact" line, and ring seq
# proving all 100 lines landed.
spam : (n : Int | measure n) -> Int .
spam n | n <= 0 = 0.
spam n = u = log "line {n}"; spam (n - 1).
main =
  u = spam 100;
  s = Sys.logSeq 0;
  "spam done: ring seq {s}".

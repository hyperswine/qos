# timerroute.fpr -- "/services/timer" through Svc (an open, a write, a
# close through the namespace; the timer endpoint is mods/sysep.fpr's): a
# capability-gated write (IInt ms) schedules a fire, and Timer.qa
# sends TFire straight to the CALLER's mailbox once due -- the message
# is what moves the caller from the backlog into the ready zone, under
# the scheduler's ordinary admission bounds.  The uartroute test's
# shape, for time.
#
#   make qos-app PROG=tests/timerroute.fpr
#   (cd qos && ./qosp --yes ../app.qa)
#
# Expected: timerroute: write=ok fire=ok

unsafe program.

SV = use "../programs/mods/svc".
EP = use "../programs/mods/ep".
SE = use "../programs/mods/sysep".
TM = use "../programs/mods/timer".
AC = use "std/actor".

Caps = SV.Caps.
Svc = SV.Svc.
IInt = EP.IInt.
IUnit = EP.IUnit.
TFire = TM.TFire.

main =
  me = myself 0;
  u = device "uart";
  con = (reg8 u 5, reg8 u 0);
  cl = device "clint";
  clk = reg32 cl 49144;
  tsvc = spawn TM.actor;
  ns = AC.spawnWith (AC.Dynamic 64) EP.namespace;
  _ = EP.register me ns "/" (AC.spawnWith (AC.Dynamic 64) (EP.lister ns));
  st = { has = False, act = 0, uart = 0, timer = tsvc, ns = ns };
  _ = SE.boot me ns 0 tsvc clk st;
  granted = ("/services/timer", "rw") :: Nil;
  caps = Caps con me clk granted "timerroute" st;
  t0 = read clk;
  r = Svc.write caps "/services/timer" (IInt 30);
  wok = case r of IUnit -> "ok" | e -> "ERR";
  f = receiveFrom me tsvc;
  d = read clk - t0;
  fok = case f of
      TFire -> (case d >= 300000 of True -> "ok" | False -> "EARLY({d})")
    | o -> "WRONG";
  _ = kill tsvc;
  "timerroute: write={wok} fire={fok}".

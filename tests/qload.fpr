# qload.fpr -- stage 2 of qosp.disk: the System.qa loading mechanism in
# miniature.  A .qa is BYTES ON THE LOG like anything else: read
# apps/plugmini.qa off the disk with mods/qlog, hand the bytes to
# Plug.attach (syscall tag 4 -- the host filesystem never enters the
# path), then resolve and call the plugin's exports through Mod.findAt.
#
#   make qos-app-macos PROG=tests/qload.fpr
#   make plugsyms-macos
#   make plugin-qa-macos PROG=tests/plugmini.fpr PLUGSLOT=0
#   (cd qos && make disk-seed QAS=../plugmini.qa \
#     && make portable && ./qosp --yes ../app.qa)
#
# Expected: "qload: <N>B .qa read off disk -> table #0; ping=pong from
# a .qa read off qosp.disk; 40+2=42".  Ordering law: plugsyms AFTER the
# shell build, plugin AFTER plugsyms, disk-seed AFTER the plugin.

QL = use "../programs/mods/qlog".
Plug = use "../programs/mods/plug".

main =
  dsk = device "blk";
  n = blkPages dsk;
  case n == 0 of
    True -> "qload: no disk (host could not open qosp.disk)"
  | False -> load dsk (QL.ensure dsk).

load dsk h = load2 dsk (QL.readLatest dsk h "apps/plugmini.qa").
load2 dsk r =
  case r of
    Err e -> "qload: apps/plugmini.qa not on the disk ({e}) -- seed it: make -C qos disk-seed QAS=../plugmini.qa"
  | Ok bytes -> att (Mod.plugs 0) (strlen bytes) (Plug.attach bytes).
att n0 bl r =
  case r of
    Err e -> "qload: attach failed: {e}"
  | Ok u -> probe n0 bl.
probe n0 bl =
  (f, ping) = Mod.findAt n0 "plugPing";
  case f == 1 of
    False -> "qload: attached but plugPing not exported"
  | True -> probe2 n0 bl (ping 0).
probe2 n0 bl s =
  (f, add) = Mod.findAt n0 "plugAdd";
  case f == 1 of
    False -> "qload: plugAdd not exported"
  | True -> "qload: {bl}B .qa read off disk -> table #{n0}; ping={s}; 40+2={add 40 2}".

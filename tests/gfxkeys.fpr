# gfxkeys.fpr -- GLFW keys arrive as SYNTHETIC EVDEV.
# Polls until two keypresses (value 1) arrive and reports their codes.
# Driven by xdotool against the GLFW window under Xvfb: `h` must decode
# to evdev 35 and `H` (shift-h) to 1035 -- the shift BIAS proving the
# events went through evdev_raw's one modifier machine, not a GLFW
# side channel.  The scripted driver types plain h then shift+h.
waitKey : unsafe Int -> Int .
waitKey 0 = 0 - 1.
waitKey n =
  (k, a, c) = inputPoll Unit;
  waitKey2 k a c n.
waitKey2 : unsafe Int -> Int -> Int -> Int -> Int .
waitKey2 k a c n | k == 4, c == 1 = a.
waitKey2 k a c n = waitKey (n - 1).
main =
  d = glInit 320 240;
  k1 = waitKey 20000000;
  k2 = waitKey 20000000;
  "gfx keys: {k1} {k2}".

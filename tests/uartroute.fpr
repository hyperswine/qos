# uartroute.fpr -- "/services/uart" through the ONE Svc funnel, the
# System.qa route in miniature: a Caps value carrying the uart service
# actor in its services slot, writes routed as DMA-shaped enqueues,
# reads routed as rx takes -- all capability-gated by the URL grant.
#
#   make qos-app PROG=tests/uartroute.fpr
#   printf 'hi' | (cd qos && ./qosp --yes ../app.qa)
#
# Expected: ROUTED-UART-TX on the console, then
#   uartroute: wrote 15B via /services/uart; rx="hi"

SV = use "../programs/mods/svc".
UM = use "../programs/mods/uart".

Caps = SV.Caps.
Svc = SV.Svc.
IStr = SV.IStr.
IInt = SV.IInt.
IErr = SV.IErr.

ucall : Int -> Int -> _ -> Unit .
ucall me a msg =
  _ = send a (me, msg);
  r = receiveFrom me a;
  Unit.
  # ^ r's release is autodrop v2's (unused receive: dropped at once)

main =
  me = myself 0;
  u = device "uart";
  con = (reg8 u 5, reg8 u 0);
  cl = device "clint";
  clk = reg32 cl 49144;
  usvc = spawn UM.actor;
  # the System.qa boot dance: open + budget + share (raw RPC -- the
  # privileged side; apps get the linear std.uart client instead)
  _ = ucall me usvc UM.UOpen;
  _ = ucall me usvc (UM.UBuf 8192);
  _ = ucall me usvc UM.UShare;
  granted = ("/services/uart", "rw") :: Nil;
  caps = Caps con me clk granted "uartroute" { has = True, act = 0, uart = usvc, timer = 0 };
  r1 = Svc.write caps "/services/uart" (IStr "ROUTED-UART-TX\n");
  n = case r1 of IInt k -> k | e -> 0 - 1;
  rx = waitR caps clk (read clk + 30000000);
  "uartroute: wrote {n}B via /services/uart; rx=\"{rx}\"".

# poll the routed read until bytes arrive (stdin feeds the host tty)
waitR : unsafe _ -> Int -> Int -> String .
waitR caps clk dl =
  r2 = Svc.read caps "/services/uart";
  rx = case r2 of IStr s -> s | e2 -> "(err)";
  case strlen rx > 0 of
    True -> rx
  | False -> case read clk > dl of
      True -> ""
    | False -> waitR caps clk dl.

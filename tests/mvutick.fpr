# mvutick.fpr -- std.MVU's first app: a tick-driven counter, headless,
# proving the extracted architecture without a display:
#
#   - no input actor (input = 0) and no SKeys subscription: update
#     receives ONLY the subscribed ETick events
#   - STick 1 delivers a tick every millisecond -- decoupled from the
#     3 ms frame budget (cfg.tick), so some frames carry no event at
#     all and the count climbs slower than the frame number
#   - skey = count / 10: the statics REBUILD exactly when the tens
#     digit rolls -- expect builds #1..#4 banners from textRender and
#     "4 statics builds" in the result (counts 1..30 span keys 0..3)
#   - MQuit at count 31 -> the run ends from update, elm-style
#   - vals runs in the persistent worker each frame; poolReset at every
#     frame boundary keeps the arena flat (Sys.memStats in the result)
#
#   make qos-app PROG=tests/mvutick.fpr
#   (cd qos && make portable && ./qosp --yes ../app.qa)
#
# Expected result line:
#   mvutick: final count=31, arena <g>g/<m>MB [mvu: <n> frames, 4 statics builds]

MV = use "std/mvu".

MApp = MV.MApp.
MQuit = MV.MQuit.
MLog = MV.MLog.
ETick = MV.ETick.
STick = MV.STick.

appInit env = 0.

appUpdate me env ev count = case ev of
    ETick -> tickUp count
  | e -> (count, Nil).
tickUp count = case count + 1 > 30 of
    True -> (count + 1, MQuit :: Nil)
  | False -> tickQ (count + 1).
tickQ c = case c == 10 of
    True -> (c, MLog "mvutick: crossed 10" :: Nil)
  | False -> (c, Nil).

appSubs count = STick 1 :: Nil.

appSkey count = count / 10.

appView vp count =
  (vw, vh) = vp;
  band = count / 10;
  "MVUTICK  {vw}x{vh}" :: "band {band}0s" :: Nil.

appVals self env vp count =
  (g, mb) = Sys.memStats 0;
  "count={count}" :: "arena={g}g" :: Nil.

appDone count =
  (g, mb) = Sys.memStats 0;
  "mvutick: final count={count}, arena {g}g/{mb}MB".

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  render = spawn MV.textRender;
  # cfg is an open record: name what you provide, in any order, and
  # add app-private fields freely -- nothing downstream re-arities
  cfg = { env = 0, mt = mt, tick = 30000, input = 0, render = render };
  app = MApp appInit appUpdate appSkey appView appVals appDone appSubs;
  MV.run me cfg app.

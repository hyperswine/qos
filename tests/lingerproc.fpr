# lingerproc.fpr -- a process whose main returns while a child actor it
# spawned is still running slot code (tests/nativeslot.fpr): the slot is
# not reusable until that child has ended too.
sumTo : unsafe Int -> Int -> Int .
sumTo n acc = case n == 0 of
    True -> acc
  | False -> sumTo (n - 1) (acc + n).
worker : unsafe Int -> Unit .
worker self = _ = sumTo 20000000 0; Unit.
main =
  _ = spawn worker;
  "lingerproc: main returned".

# pos.fpr -- POS v2 (sol/examples/pos2.sol) on the native QOS target,
# served by FPRLive (programs/mods/fprlive.fpr): one register, many
# cashiers, each browser tab a websocket SESSION with its own login and
# cart over ONE shared model (revenue, stock, receipts).
#
#   make qos-app PROG=tests/pos.fpr
#   (cd qos && FPR_PORT=8123 ./qosp --yes ../app.qa)
#   open http://127.0.0.1:8123/
#
# With FPR_DISK set (tools/mkdisk.py disk 4) the store survives restarts:
# revenue, stock and the receipt log are one record (pos/state) on the
# storage service, rewritten at every checkout and restock.
#
# Messages (EMsg sid msg arg), all from the browser:
#   login name        this session's cashier (printable, at most 24 bytes)
#   logout            forget the session (EGone, a closed socket, does too)
#   buy k             ring catalog item k into THIS session's cart, if
#                     the store has it (all carts' claims count)
#   void              empty the cart
#   checkout          stock -= cart, revenue += total, a receipt; refused
#                     (cart kept) when another cashier took the last one
#   restock k         +10 on item k, capped at 999
#   quit              stop the server (the harness's off switch)
#
# qos/tests-host/fprlive-check.py drives it as several websocket clients,
# well-behaved and otherwise.

unsafe program.          # the loose mode: no per-function safety ceremony

MV = use "std/mvu".
FS = use "std/fs".
G  = use "../programs/mods/genview".
FL = use "../programs/mods/fprlive".
Core = use "../programs/mods/coreutil".

App = FL.App.
EMsg = FL.EMsg.
EGone = FL.EGone.
MQuit = MV.MQuit.
El = G.El.
Txt = G.Txt.
Dyn = G.Dyn.
Cls = G.Cls.
Att = G.Att.
strEq = G.strEq.

# ---- catalog --------------------------------------------------------------------

nItems = 6.
nameAt 0 = "flat white".
nameAt 1 = "long black".
nameAt 2 = "cheese toastie".
nameAt 3 = "brownie".
nameAt 4 = "carrot cake".
nameAt 5 = "sparkling water".
nameAt k = "?".
priceAt 0 = 5.
priceAt 1 = 4.
priceAt 2 = 9.
priceAt 3 = 6.
priceAt 4 = 7.
priceAt 5 = 3.
priceAt k = 0.

# ---- model ------------------------------------------------------------------------

M = Type (M revenue stock receipts sessions).
Sess = Type (Sess sid user cart note).
E = Type (E me fs).

initialStock = 12 :: 12 :: 12 :: 12 :: 12 :: 12 :: Nil.

at Nil k = 0.
at (x :: r) 0 = x.
at (x :: r) k = at r (k - 1).
adjust Nil k d = Nil.
adjust (x :: r) 0 d = (x + d) :: r.
adjust (x :: r) k d = x :: adjust r (k - 1) d.
count Nil k = 0.
count (x :: r) k | x == k = 1 + count r k.
count (x :: r) k = count r k.
total Nil = 0.
total (k :: r) = priceAt k + total r.
len Nil = 0.
len (x :: r) = 1 + len r.

# sessions, keyed by connection id
sGet Nil sid = Sess sid "" Nil "".
sGet (Sess i u c n :: r) sid | i == sid = Sess i u c n.
sGet (s :: r) sid = sGet r sid.
sPut ss (Sess i u c n) = Sess i u c n :: sDel ss i.
sDel Nil sid = Nil.
sDel (Sess i u c n :: r) sid | i == sid = sDel r sid.
sDel (s :: r) sid = s :: sDel r sid.

# every cart's claim on item k, across sessions
claimed Nil k = 0.
claimed (Sess i u c n :: r) k = count c k + claimed r k.
# the cart can be filled from stock
covered Nil stock = True.
covered (k :: r) stock | count (k :: r) k <= at stock k = covered r stock.
covered c stock = False.

# ---- persistence: one record, line 1 revenue, line 2 stock, then receipts -------------

load env = case env of
    E me 0 -> M 0 initialStock Nil Nil
  | E me fs -> loaded (FS.readLatest me fs "pos/state").
# a service reply is a message: read it, then DROP it (its slab is ours to release)
loaded r = m = fromRec r; _ = drop r; m.
fromRec (Ok s) = fromLines (Core.lines s).
fromRec (Err e) = M 0 initialStock Nil Nil.
fromLines (r :: s :: rc) = M (Core.parseDigits r) (stockOf s 1 0 Nil) rc Nil.
fromLines ls = M 0 initialStock Nil Nil.
stockOf s i k acc | k == nItems = rev acc Nil.
stockOf s i k acc =
  (w, j) = Core.wordAt s i (strlen s);
  stockOf s j (k + 1) (Core.parseDigits w :: acc).
rev Nil acc = acc.
rev (x :: r) acc = rev r (x :: acc).

save env m = case env of
    E me 0 -> m
  | E me fs -> h = FS.append me fs "pos/state" (toRec m); _ = drop h; m.
toRec m =
  M rv stock rc ss = m;
  "{rv}\n{joinSp stock}\n{joinNl rc}".
joinSp ns = Core.joinWith " " (strs ns Nil).
strs Nil acc = rev acc Nil.
strs (x :: r) acc = strs r ("{x}" :: acc).
joinNl rc = Core.joinWith "\n" rc.
joinCm cart = Core.joinWith ", " (names cart Nil).
names Nil acc = rev acc Nil.
names (k :: r) acc = names r (nameAt k :: acc).

# ---- update ---------------------------------------------------------------------------

pInit env = load env.

pUpdate env ev m = case ev of
    EMsg sid msg arg -> pMsg env sid msg arg m
  | EGone sid -> (forget sid m, Nil)
  | e -> (m, Nil).

pMsg env sid msg arg m | strEq msg "login" = (login sid (clean arg 1 "") m, Nil).
pMsg env sid msg arg m | strEq msg "logout" = (forget sid m, Nil).
pMsg env sid msg arg m | strEq msg "quit" = (m, MQuit :: Nil).
pMsg env sid msg arg m = withUser env sid msg arg m (sGet (sessionsOf m) sid).
sessionsOf (M rv st rc ss) = ss.

# the rest need a cashier; a session without one is told so, not ignored
withUser env sid msg arg m (Sess i "" c n) = (m, Nil).
withUser env sid msg arg m s | strEq msg "buy" = (buy sid (Core.parseNat arg) m s, Nil).
withUser env sid msg arg m s | strEq msg "void" = (note sid "" (withCart sid Nil m) , Nil).
withUser env sid msg arg m s | strEq msg "checkout" = (checkout env sid m s, Nil).
withUser env sid msg arg m s | strEq msg "restock" = (restock env sid (Core.parseNat arg) m, Nil).
withUser env sid msg arg m s = (m, Nil).

# a cashier name: printable (UTF-8 passes, control bytes drop), at most
# 24 bytes and never cut inside a multi-byte character
clean s i acc | i > strlen s = acc.
clean s i acc | Core.and2 (strlen acc >= 24) (band (charAt s i) 192 != 128) = acc.
clean s i acc | Core.or2 (charAt s i < 32) (charAt s i == 127) = clean s (i + 1) acc.
clean s i acc = clean s (i + 1) (strcat acc (chr (charAt s i))).

login sid name m | blank name 1 = m.
login sid name m =
  M rv st rc ss = m;
  M rv st rc (sPut ss (Sess sid name Nil "")).
blank s i | i > strlen s = True.
blank s i | charAt s i == 32 = blank s (i + 1).
blank s i = False.
forget sid m =
  M rv st rc ss = m;
  M rv st rc (sDel ss sid).
withCart sid cart m =
  M rv st rc ss = m;
  Sess i u c n = sGet ss sid;
  M rv st rc (sPut ss (Sess i u cart n)).
note sid txt m =
  M rv st rc ss = m;
  Sess i u c n = sGet ss sid;
  M rv st rc (sPut ss (Sess i u c txt)).

buy sid (Err e) m s = note sid "no such item" m.
buy sid (Ok k) m s | k >= nItems = note sid "no such item" m.
buy sid (Ok k) m s | len (cartOf s) >= 32 = note sid "cart full" m.
buy sid (Ok k) m s | claimed (sessionsOf m) k >= at (stockOf2 m) k = note sid "sold out: {nameAt k}" m.
buy sid (Ok k) m s = note sid "" (withCart sid (k :: cartOf s) m).
cartOf (Sess i u c n) = c.
stockOf2 (M rv st rc ss) = st.

checkout env sid m (Sess i u Nil n) = note sid "cart is empty" m.
checkout env sid m (Sess i u cart n) | covered cart (stockOf2 m) =
  M rv st rc ss = m;
  t = total cart;
  r = "{len rc + 1}|{u}|{t}|{joinCm (rev cart Nil)}";
  m2 = M (rv + t) (sell cart st) (r :: rc) ss;
  save env (note sid "sold: {joinCm (rev cart Nil)} for {t}" (withCart sid Nil m2)).
checkout env sid m s = note sid "not enough stock for this cart" m.
sell Nil st = st.
sell (k :: r) st = sell r (adjust st k (0 - 1)).

restock env sid (Err e) m = note sid "no such item" m.
restock env sid (Ok k) m | k >= nItems = note sid "no such item" m.
restock env sid (Ok k) m | at (stockOf2 m) k >= 990 = note sid "shelf full: {nameAt k}" m.
restock env sid (Ok k) m =
  M rv st rc ss = m;
  save env (note sid "restocked {nameAt k}" (M rv (adjust st k 10) rc ss)).

pSubs m = Nil.

# ---- view: per session ---------------------------------------------------------------

pView sid m =
  M rv st rc ss = m;
  Sess i user cart nt = sGet ss sid;
  case strEq user "" of
    True -> loginView
  | False -> dash user cart nt m.

loginView =
  El "div" [Cls "col gap-3 p-6", G.Local "name" ""]
    [ El "div" [Cls "text-xs upper dim"] [Txt "point of sale"]
    , El "div" [Cls "text-2xl bold"] [Txt "Sign in"]
    , G.Inp [Cls "field w-full", G.Input "name", G.OnEnter "login" "name", Att "placeholder" "cashier name", Att "maxlength" "24"]
    , El "button" [Cls "btn round px-3 py-2", G.OnClick "login" "name"] [Txt "open register"]
    , El "div" [Cls "dim text-xs"] [Txt "link: ", El "span" [Att "id" "lv-link"] [Txt "connecting"]] ].

dash user cart nt m =
  M rv st rc ss = m;
  El "div" [Cls "col gap-3 p-4", G.Local "tab" "1"]
    [ nav user
    , El "div" [G.ShowIf "tab:1"] [register cart nt st]
    , El "div" [G.ShowIf "tab:2"] [receipts rv rc]
    , El "div" [G.ShowIf "tab:3"] [inventory st nt] ].

nav user =
  El "div" [Cls "row between center gap-2"]
    [ El "div" [Cls "row gap-2"]
        [ tab "1" "Register", tab "2" "Receipts", tab "3" "Inventory" ]
    , El "div" [Cls "row gap-2 center dim text-sm"]
        [ Txt "cashier ", El "b" [Cls "ink"] [Dyn user]
        , El "span" [Att "id" "lv-wire", Cls "text-xs mono"] []
        , El "span" [Att "id" "lv-link", Cls "text-xs"] [Txt "live"]
        , El "button" [Cls "btn pill px-3 py-2", G.OnClick "logout" ""] [Txt "sign out"] ] ].
tab n label = El "button" [Cls "btn pill px-3 py-2", G.OnSet "tab" n, Att "data-on" "tab:{n}"] [Txt label].

register cart nt st =
  El "div" [Cls "row gap-3 wrap"]
    [ El "div" [Cls "col gap-2 grow"] (items 0 st)
    , El "div" [Cls "col gap-2 panel round p-3"]
        [ El "div" [Cls "text-xs upper dim"] [Txt "cart"]
        , El "div" [Cls "text-sm"] [Dyn (joinCm (rev cart Nil))]
        , El "div" [Cls "text-2xl bold tabular"] [Txt "$", Dyn "{total cart}"]
        , El "div" [Cls "row gap-2"]
            [ El "button" [Cls "btn round px-3 py-2", G.OnSend "void" ""] [Txt "void"]
            , El "button" [Cls "btn round px-3 py-2 glow", G.OnSend "checkout" ""] [Txt "checkout"] ]
        , El "div" [Cls "warm text-sm"] [Dyn nt] ] ].
items k st | k == nItems = Nil.
items k st = item k st :: items (k + 1) st.
item k st =
  El "div" [Cls "row between center card round p-2 gap-2"]
    [ El "div" [Cls "grow"] [Txt (nameAt k)]
    , El "div" [Cls "dim text-sm tabular"] [Dyn "{at st k}", Txt " left"]
    , El "div" [Cls "tabular"] [Txt "${priceAt k}"]
    , El "button" [Cls "btn pill px-3 py-2", G.OnSend "buy" "{k}"] [Txt "add"] ].

receipts rv rc =
  El "div" [Cls "col gap-2"]
    [ El "div" [Cls "text-xs upper dim"] [Txt "revenue"]
    , El "div" [Cls "big tabular"] [Txt "$", Dyn "{rv}"]
    , El "div" [Cls "mono text-sm pre"] [Dyn (joinNl rc)] ].

inventory st nt =
  El "div" [Cls "col gap-2"] (crates 0 st nt).
crates k st nt | k == nItems = El "div" [Cls "warm text-sm"] [Dyn nt] :: Nil.
crates k st nt = crate k st :: crates (k + 1) st nt.
crate k st =
  El "div" [Cls "row between center card round p-2 gap-2"]
    [ El "div" [Cls "grow"] [Txt (nameAt k)]
    , El "div" [Cls "tabular"] [Dyn "{at st k}"]
    , El "button" [Cls "btn pill px-3 py-2", G.OnSend "restock" "{k}"] [Txt "+10"] ].

main =
  me = myself 0;
  disk = device "blk";
  env = case blkPages disk == 0 of
      True -> E me 0
    | False -> E me (FS.serve disk);
  FL.serve { env = env, css = G.cssFor } (App pInit pUpdate pView pSubs).

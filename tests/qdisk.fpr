# qdisk.fpr -- stage 1 of qosp.disk: `device "blk"` on QOS Portable,
# with ALL record policy in FPRISC (mods/qlog) over the policy-free
# page tier (hal/unix/blk_raw.c, HAL table v5).  The same qlog module
# System.qa runs over virtio-blk on native runs here over a host file;
# tools/mkdisk.py seeds either.
#
#   make qos-app PROG=tests/qdisk.fpr && (cd qos && make portable \
#     && ./qosp --yes ../app.qa)
#
# Run it TWICE: persistence is a two-boot property -- the boot counter
# climbs and the head advances, on the same qosp.disk.  Run it on a
# `make disk-seed QAS="..."` image and apps/index lists the installed
# set -- the System.qa discovery record, readable before any loader
# exists.  URLs are boot-scoped ({boot}) so every run's own assertions
# stay deterministic while the log underneath only ever grows.

QL = use "../programs/mods/qlog".

rep : String -> Int -> String .
rep s n = repGo s n "".
repGo : String -> (n : Int | measure n) -> String -> String .
repGo s n acc = case n <= 0 of True -> acc | False -> repGo s (n - 1) (acc + s).

okOr r alt = case r of Ok s -> s | Err e -> alt.

# the index record is newline-joined; flatten for a one-line result
oneLine : unsafe String -> String .
oneLine s = olGo s 1 (strlen s) "".
olGo : unsafe String -> Int -> Int -> String -> String .
olGo s i n acc = case i > n of True -> acc | False -> olCh s i n acc (charAt s i).
olCh : unsafe String -> Int -> Int -> String -> Int -> String .
olCh s i n acc c =
  case c == 10 of
    True -> olGo s (i + 1) n (acc + ",")
  | False -> olGo s (i + 1) n (acc + (chr c)).

main =
  dsk = device "blk";
  n = blkPages dsk;
  case n == 0 of
    True -> "qdisk: no disk (host could not open qosp.disk)"
  | False -> run dsk n.

run : unsafe Device -> Int -> String .
run dsk n =
  h0 = QL.ensure dsk;                                # formats a blank disk
  boot = QL.countRecs dsk h0 "qdisk/boots" + 1;      # the two-boot proof
  h1 = QL.appendRec dsk h0 "QREC" "qdisk/boots" "b";
  big = rep "0123456789abcdef" 320;                  # 5120 B = 2 payload pages
  h2 = QL.appendRec dsk h1 "QREC" "qdisk/big{boot}" big;
  h3 = QL.appendRec dsk h2 "QREC" "qdisk/kv{boot}" "hello ";
  h4 = QL.appendRec dsk h3 "QREC" "qdisk/kv{boot}" "world";
  lat = okOr (QL.readLatest dsk h4 "qdisk/kv{boot}") "(err)";
  all = QL.replayAll dsk h4 "qdisk/kv{boot}";
  bigBack = okOr (QL.readLatest dsk h4 "qdisk/big{boot}") "";
  bigOk = case strlen bigBack == 5120 of
            True -> QL.strEq bigBack big
          | False -> False;
  idx = okOr (QL.readLatest dsk h4 "apps/index") "(unseeded)";
  "qdisk: boot #{boot} on {n} pages; latest={lat} replay={all} big5120={bigOk} apps/index=[{oneLine idx}] head={h4}".

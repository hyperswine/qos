# qar.fpr -- shared QAR2 section-table parser checks.

QAR = use "../programs/mods/qar".

expectEq got want msg = case QAR.strEq got want of
    True -> Unit
  | False -> error msg.

expectBytes r want msg = case r of
    Err e -> error msg
  | Ok got -> expectEq got want msg.

expectErr r msg = case r of
    Err e -> Unit
  | Ok v -> error msg.

main =
  man = "id = \"demo\"\nname = \"Demo\"\n";
  load = "base 0\n";
  image = "abc";
  loadOff = strlen man;
  imageOff = loadOff + strlen load;
  qa = "QAR2\nMANIFEST 0 {strlen man}\nLOAD {loadOff} {strlen load}\nIMAGE {imageOff} {strlen image}\n\n{man}{load}{image}";
  _ = expectBytes (QAR.manifestOf qa) man "qar: manifest changed";
  _ = expectBytes (QAR.sectionBytes qa "LOAD") load "qar: load changed";
  _ = expectBytes (QAR.sectionBytes qa "IMAGE") image "qar: image changed";
  _ = expectErr (QAR.sectionBytes qa "NOPE") "qar: missing section accepted";
  _ = expectErr (QAR.manifestOf "QAR1\n\n") "qar: invalid magic accepted";
  _ = expectErr (QAR.manifestOf "QAR2\nMANIFEST 0 9\n\nx") "qar: bounds failure accepted";
  "qar: OK".
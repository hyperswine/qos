# blanket safety + structured arenas, together: `unsafe program.` marks
# every function below at once (no per-function ceremony -- programs
# are the loose mode; std.* library code still states the line per
# function, enforced at use time), and Sys.arena runs scratch work
# under a fresh pool, deep-copies the result out, and frees the rest
# wholesale.  Escape bugs are impossible by construction: the result
# leaves by copy, caller locals live in a different pool.
unsafe program.

# scratch tree work: build a big list, keep only its length + one item
build 0 acc = acc.
build n acc = build (n - 1) ("row {n}" :: acc).

nth (x :: r) 0 = x.
nth (x :: r) i = nth r (i - 1).

scratch u =
  big = build 500 Nil;
  (lenOf big, nth big 250).

lenOf Nil = 0.
lenOf (x :: r) = 1 + lenOf r.

main =
  a0 = arcLive 0;
  (n, pick) = Sys.arena scratch;
  # nested arenas: the override save/restore
  (n2, p2) = Sys.arena (fn u -> Sys.arena scratch);
  _ = print "arena: {n} rows, kept '{pick}' (nested: {n2} '{p2}')";
  _ = print "arena arc delta: {arcLive 0 - a0} (0 = nothing leaked out)";
  0.

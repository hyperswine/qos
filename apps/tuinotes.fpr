# tuinotes.fpr -- notes as a loaded process, with the FULL TUI editor
# (green border, live header, scrolling list pane, inverse input line)
# rendered through mods/tui over this process's own console, and every
# committed line persisted IMMEDIATELY through the syscall channel.
# The plain intro/exit lines around the alt screen keep the two-boot
# storage regression's grep strings.
P   = use "../programs/mods/procapp".
TUI = use "../programs/mods/tui".

main =
  cs = Sys.caps Unit;
  case P.hasGrant cs "/services/display" "write" of
    False -> "display not granted: notes wrote nothing"
  | True -> case P.hasGrant cs "/services/keyboard" "read" of
      False -> "keyboard not granted: nothing to take notes with"
    | True -> notesRun (P.openCon Unit) (P.hasGrant cs "/services/storage" "write").

notesRun con stg =
  me = myself 0;
  _ = P.putLn con "";
  _ = P.putLn con "  == QOS Notes ==   (a loaded process)";
  _ = notesHello con stg;
  _ = TUI.enterScreen (P.puts con);
  nFrame con me stg Nil 0 "" (TUI.invalidBuf 80 24).

notesHello con stg =
  case stg of
    False -> P.putLn con "  [no storage capability: notes are session-only]"
  | True -> notesHello1 con (P.kvReplay Unit).
notesHello1 con r =
  case r of
    Err e -> P.putLn con ("  [storage: " + e + "]")
  | Ok s -> P.putLn con "  [storage: {countLf s 1 0} note(s) on disk]".
countLf s i n = case i > strlen s of True -> n | False -> countLf s (i + 1) (n + lfAt s i).
lfAt s i = case charAt s i == 10 of True -> 1 | False -> 0.

# ---- the editor loop: frame, key, commit ------------------------------------
nFrame con me stg notes count input old =
  new = TUI.frame (P.puts con) old (notesW stg notes count input) (80, 24);
  nEdit con me stg notes count input new.
nEdit con me stg notes count input buf =
  k = P.getc me con;
  case P.or2 (k == 13) (k == 10) of
    True -> nCommit con me stg notes count input buf
  | False -> case P.or2 (k == 127) (k == 8) of
      True -> nFrame con me stg notes count (strDrop1 input) buf
    | False -> case P.and2 (k >= 32) (k <= 126) of
        True -> nFrame con me stg notes count (input + chr k) buf
      | False -> nEdit con me stg notes count input buf.
strDrop1 s = substr s 1 (strlen s - 1).
# NB: FPRISC is strict -- `and2 a b` evaluates BOTH args before the
# call, so charAt must be bounds-gated by CONTROL FLOW, not by and2
# (charAt "" 1 inside an and2 guard panics on an empty buffer).
nCommit con me stg notes count input buf =
  case strlen input == 0 of
    True -> nEdit con me stg notes count input buf                # empty: ignore
  | False -> nCommit1 con me stg notes count input buf.
nCommit1 con me stg notes count input buf =
  case P.and2 (strlen input == 1) (charAt input 1 == 46) of   # lone '.'
    True -> nExit con stg notes count
  | False -> nSave con me stg notes count input buf.
nSave con me stg notes count input buf =
  _ = case stg of True -> P.kvAppend input >> Unit | False -> Unit;
  nFrame con me stg (input :: notes) (count + 1) "" buf.
nExit con stg notes count =
  _ = TUI.leaveScreen (P.puts con);
  _ = P.putLn con ("  saved " + P.showI count + " note(s):");
  _ = dumpNotes con (rev notes Nil);
  case stg of
    True -> P.putLn con "  [persisted to storage]" >> "notes done"
  | False -> "notes done".
rev xs acc = case xs of Nil -> acc | x :: r -> rev r (x :: acc).
dumpNotes con ns =
  case ns of
    Nil -> Unit
  | x :: r -> P.putLn con ("    - " + x) >> dumpNotes con r.

# ---- the widget tree --------------------------------------------------------
notesW stg notes count input sz =
  TUI.borderW 3 (TUI.vboxW (
    (TUI.LFix 1, notesHdrW count stg) ::
    (TUI.LFix 1, TUI.lineW 3 0 "") ::
    (TUI.LFlex 1, notesListW notes) ::
    (TUI.LFix 1, TUI.lineW 8 5 "  > {input}_") ::
    (TUI.LFix 1, TUI.lineW 1 7 "  enter save+persist   bksp edit   '.' alone exits") ::
    Nil)) sz.
notesHdrW count stg sz =
  TUI.hboxW (
    (TUI.LFix 30, TUI.lineW 3 0 "  QOS notes   [loaded process]") ::
    (TUI.LFlex 1, TUI.lineW 4 0 "      {count} this session") ::
    (TUI.LFix 26, TUI.lineW (storColOf stg) 0 (storTagOf stg)) ::
    Nil) sz.
storColOf stg = case stg of True -> 3 | False -> 4.
storTagOf stg = case stg of True -> "storage: live-persist" | False -> "storage: session-only".
notesListW notes sz =
  (w, h) = sz;
  notesRows (rev notes Nil) 1 w h.
notesRows ns i w h =
  case i > h of
    True -> Nil
  | False -> notesRow ns i w :: notesRowsNext ns i w h.
notesRowsNext ns i w h =
  case ns of
    Nil -> notesRows Nil (i + 1) w h
  | _ :: r -> notesRows r (i + 1) w h.
notesRow ns i w =
  case ns of
    Nil -> TUI.repCell 8192 w
  | x :: _ -> TUI.lineRow 0 0 "    {i}. {x}" w.

# hello_proc.fpr -- the dynamically loaded process, now CAPABILITY-
# GATED.  System.qa serializes the user's grants into the entry ABI;
# Sys.caps hands them back here, and THIS side enforces them: without
# /services/display (write) the process touches no console byte and
# returns a refusal string for the loader to render.  Also still
# exercises memory growth (large list -> fpr_grow_memory round trips).

and2 a b = case a of True -> b | False -> False.
lfC = 10.
# does any "url mode" line match?
hasGrant : unsafe String -> String -> String -> Bool .
hasGrant s url mode = hgGo s 1 (strlen s) (url + " " + mode).
hgGo : unsafe String -> Int -> Int -> String -> Bool .
hgGo s i n want =
  case i > n of
    True -> False
  | False -> hgLine s i n want (lineEnd s i n).
hgLine : unsafe String -> Int -> Int -> String -> Int -> Bool .
hgLine s i n want e =
  case lineEq s i (e - 1) want of
    True -> True
  | False -> hgGo s (e + 1) n want.
lineEnd : unsafe String -> Int -> Int -> Int .
lineEnd s i n = case i > n of True -> n | False -> case charAt s i == lfC of True -> i | False -> lineEnd s (i + 1) n.
lineEq : unsafe String -> Int -> Int -> String -> Bool .
lineEq s i j want =
  case (j - i + 1) == strlen want of
    True -> leGo s i j want 1
  | False -> False.
leGo : unsafe String -> Int -> Int -> String -> Int -> Bool .
leGo s i j want k =
  case i > j of
    True -> True
  | False -> case charAt s i == charAt want k of
      True -> leGo s (i + 1) j want (k + 1)
    | False -> False.

grow : unsafe Int -> List Int -> List Int .
grow n acc = case n == 0 of True -> acc | False -> grow (n - 1) (Cons n acc).
lenAcc : unsafe List w38 -> Int -> Int .
lenAcc xs acc = case xs of Nil -> acc | _ :: t -> lenAcc t (acc + 1).

main =
  cs = Sys.caps Unit;
  case hasGrant cs "/services/display" "write" of
    False -> "display not granted: this process wrote nothing"
  | True -> hello.

hello : unsafe String .
hello =
  xs = grow 100000 Nil;
  n = lenAcc xs 0;
  _ = print "hello from a CAPABILITY-GATED loaded process! list len = {n}";
  "wrote greeting".

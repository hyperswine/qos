unsafe program.
# logs root: explicitly export the appkit entry points for scoped lookup.
A = use "../programs/mods/logsapp".
appMeta u = A.appMeta u.
appInit self env = A.appInit self env.
appUpdate self env key state = A.appUpdate self env key state.
appTree viewport = A.appTree viewport.
appVals self env state = A.appVals self env state.
main : Unit .
main =
  _ = A.appMeta 0;
  Unit.

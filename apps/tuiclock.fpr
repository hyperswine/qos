# tuiclock.fpr -- the big-digit clock as a REAL dynamically loaded
# process: reads its capability blob via Sys.caps, enforces its own
# gate through mods/procapp, renders through mods/tui with a writer
# over ITS OWN console -- System.qa contributed only the permission
# grant and the loader.  Denied display -> returns a refusal string.
P   = use "../programs/mods/procapp".
TUI = use "../programs/mods/tui".

main =
  cs = Sys.caps Unit;
  case P.hasGrant cs "/services/display" "write" of
    False -> "display not granted: the clock drew nothing"
  | True -> case P.hasGrant cs "/services/keyboard" "read" of
      False -> "keyboard not granted: a clock you cannot quit is a trap"
    | True -> case P.hasGrant cs "/services/clock" "read" of
        False -> "clock not granted: nothing to show"
      | True -> runClock (P.openCon Unit) (P.openClk Unit).

runClock con clk =
  w = P.puts con;
  _ = P.putLn con "";
  _ = P.putLn con "  == QOS Clock ==   (a loaded process; q returns)";
  _ = TUI.enterScreen w;
  cFrame con clk w (TUI.invalidBuf 80 24).
cFrame con clk w old =
  sec = P.secsOf (read clk);
  new = TUI.frame w old (bigClockW sec) (80, 24);
  cWait con clk w new sec.
cWait con clk w buf sec =
  k = P.pollKey con;
  case k == 113 of
    True -> cQuit con w
  | False -> cTick con clk w buf sec.
cTick con clk w buf sec =
  case P.secsOf (read clk) == sec of
    True -> cWait con clk w buf sec
  | False -> cFrame con clk w buf.
cQuit con w =
  _ = TUI.leaveScreen w;
  _ = P.putLn con "  (clock app done)";
  "clock done".

bigClockW sec sz =
  mm = sec / 60;
  ss = sec - mm * 60;
  col = 2 + mm - (mm / 6) * 6;
  TUI.borderW col (TUI.vboxW (
    (TUI.LFix 1, TUI.lineW col 0 "  QOS   uptime   [loaded process]") ::
    (TUI.LFlex 1, TUI.fillW 8192) ::
    (TUI.LFix 5, glyphLineW mm ss col) ::
    (TUI.LFlex 1, TUI.fillW 8192) ::
    (TUI.LFix 1, TUI.lineW 1 7 "  q return to launcher") ::
    Nil)) sz.
glyphLineW mm ss col sz =
  (w, h) = sz;
  glyphRows mm ss col w 0.
glyphRows mm ss col w r =
  case r >= 5 of
    True -> Nil
  | False -> TUI.padTo w 8192 (glyphRow mm ss col r) :: glyphRows mm ss col w (r + 1).
glyphRow mm ss col r =
  catAll (TUI.repCell 8192 30
    :: digCells (mm / 10) r col :: gap 1
    :: digCells (mm - (mm / 10) * 10) r col :: gap 1
    :: colonCells r col :: gap 1
    :: digCells (ss / 10) r col :: gap 1
    :: digCells (ss - (ss / 10) * 10) r col :: Nil).
catAll xs = case xs of Nil -> Nil | x :: r -> TUI.append x (catAll r).
gap n = TUI.repCell 8192 n.
digCells d r col = blockCells (substr (fontD d) (r * 3 + 1) 3) col.
blockCells s col = bcGo s col 1.
bcGo s col i =
  case i > strlen s of
    True -> Nil
  | False -> bcCell s col i :: bcGo s col (i + 1).
bcCell s col i =
  case charAt s i == 35 of
    True -> TUI.mkCell 32 0 col
  | False -> 8192.
colonCells r col =
  case P.or2 (r == 1) (r == 3) of
    True -> TUI.mkCell 32 0 col :: Nil
  | False -> 8192 :: Nil.
fontD d =
  case d of
    0 -> "#### ## ## ####"
  | 1 -> " #  #  #  #  # "
  | 2 -> "###  #####  ###"
  | 3 -> "###  ####  ####"
  | 4 -> "# ## ####  #  #"
  | 5 -> "####  ###  ####"
  | 6 -> "####  #### ####"
  | 7 -> "###  #  #  #  #"
  | 8 -> "#### ##### ####"
  | _ -> "#### ####  ####".

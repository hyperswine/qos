// tank_turret.coscad -- the turret, the one degree of freedom: its pivot is
// the origin, so a yaw in the scene rotates it in place on the hull.  Same
// frame as tank_hull (Z up, +Y forward); the base sits at z = 0 and the
// game places it on the hull top.  ⎏ n r h is an n-sided prism -- the gun
// and the cupola are 8-sided on purpose: this is a low-poly tank.

// the turret box, slightly forward of the pivot
body = χ -0.45 (ψ -0.45 (ζ 0 (▬ 0.9 1.0 0.36)))
// a smaller roof step
roof = χ -0.35 (ψ -0.35 (ζ 0.36 (▬ 0.7 0.8 0.08)))
// the mantlet the gun comes out of
mantlet = χ -0.25 (ψ 0.475 (ζ 0.06 (▬ 0.5 0.25 0.28)))
// the main gun: an 8-sided prism along +Z, rotated onto +Y, from y 0.6 to 1.9
gun = ψ 0.6 (ζ 0.2 (θ -90 (⎏ 8 0.07 1.3)))
// muzzle brake
muzzle = χ -0.09 (ψ 1.78 (ζ 0.11 (▬ 0.18 0.14 0.18)))
// commander's cupola, offset left and back
cupola = χ -0.2 (ψ -0.15 (ζ 0.44 (⎏ 8 0.14 0.1)))

main = body ⊕ roof ⊕ mantlet ⊕ gun ⊕ muzzle ⊕ cupola

// hq_fence.coscad -- the security fence across the front of the compound
// (y = 1.05): nine hex posts, a panel, a top rail, a second rail leaning
// out, lamps on the corner posts.  Same frame as hq.coscad.

post_1 = χ -2.0 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_2 = χ -1.5 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_3 = χ -1.0 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_4 = χ -0.5 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_5 = χ 0.0 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_6 = χ 0.5 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_7 = χ 1.0 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_8 = χ 1.5 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
post_9 = χ 2.0 (ψ 1.05 (ζ 0.08 (⎏ 6 0.05 0.75)))
// the panel between the posts, a thin sheet, and the rails
panel = χ -2.05 (ψ 1.03 (ζ 0.2 (▬ 4.1 0.03 0.5)))
rail = χ -2.05 (ψ 1.02 (ζ 0.78 (▬ 4.1 0.06 0.06)))
// the outward-leaning wire: a thin sheet rotated forward at the top
lean = ψ 1.12 (ζ 0.88 (θ 40 (χ -2.05 (ψ -0.015 (ζ -0.1 (▬ 4.1 0.03 0.2))))))
// lamps on the corner posts
lamp_l = χ -2.07 (ψ 0.98 (ζ 0.83 (▬ 0.14 0.14 0.1)))
lamp_r = χ 1.93 (ψ 0.98 (ζ 0.83 (▬ 0.14 0.14 0.1)))

main = post_1 ⊕ post_2 ⊕ post_3 ⊕ post_4 ⊕ post_5 ⊕ post_6 ⊕ post_7 ⊕ post_8 ⊕ post_9 ⊕ panel ⊕ rail ⊕ lean ⊕ lamp_l ⊕ lamp_r

// hq_dish.coscad -- the satellite dish, its pivot at the origin so a yaw
// turns it: a pedestal, a tilted 10-sided disk, a feed arm.  The game
// places it on the command building's roof.

pedestal = ζ 0 (⎏ 8 0.09 0.35)
// the disk, tilted 55 deg back so it looks up and forward
disk = ζ 0.4 (θ -55 (⎏ 10 0.42 0.05))
// the feed: a thin prism out of the disk centre, along its axis
feed = ζ 0.4 (θ -55 (⎏ 6 0.025 0.38))
horn = ζ 0.4 (θ -55 (ζ 0.36 (⎏ 6 0.06 0.06)))

main = pedestal ⊕ disk ⊕ feed ⊕ horn

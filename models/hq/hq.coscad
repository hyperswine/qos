// hq.coscad -- the HQ compound, the buildings: a slab, the command
// building with its entrance, a silo on the right, two watchtowers at
// the back corners.  +Y is the front (toward the enemy), on z = 0,
// 4.2 wide x 2.4 deep.  The fence (hq_fence) and the dish (hq_dish,
// which turns) are their own parts.

slab = χ -2.1 (ψ -1.2 (ζ 0 (▬ 4.2 2.4 0.08)))
// the command building, left of centre, with a low entrance in front
building = χ -1.5 (ψ -0.8 (ζ 0.08 (▬ 1.9 1.2 1.0)))
entrance = χ -0.95 (ψ 0.4 (ζ 0.08 (▬ 0.8 0.35 0.55)))
roofbox = χ -1.35 (ψ -0.7 (ζ 1.08 (▬ 0.5 0.5 0.25)))
// the silo on the right: a 12-sided drum and a conical cap
silo = χ 1.35 (ψ -0.25 (ζ 0.08 (⎏ 12 0.45 1.55)))
cap = χ 1.35 (ψ -0.25 (ζ 1.63 (▻ 0.48 0.32)))
// two watchtowers at the back corners: a leg, a cabin, a pointed roof
leg_l = χ -1.96 (ψ -1.06 (ζ 0.08 (▬ 0.22 0.22 1.45)))
cabin_l = χ -2.1 (ψ -1.2 (ζ 1.5 (▬ 0.5 0.5 0.36)))
roof_l = χ -1.85 (ψ -0.95 (ζ 1.86 (▻ 0.36 0.22)))
leg_r = χ 1.74 (ψ -1.06 (ζ 0.08 (▬ 0.22 0.22 1.45)))
cabin_r = χ 1.6 (ψ -1.2 (ζ 1.5 (▬ 0.5 0.5 0.36)))
roof_r = χ 1.85 (ψ -0.95 (ζ 1.86 (▻ 0.36 0.22)))

main = slab ⊕ building ⊕ entrance ⊕ roofbox ⊕ silo ⊕ cap ⊕ leg_l ⊕ cabin_l ⊕ roof_l ⊕ leg_r ⊕ cabin_r ⊕ roof_r

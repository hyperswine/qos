// truck_kit.coscad -- the truck's dark parts: six 10-sided wheels on
// X axles.  Same frame as truck.coscad; the canvas is truck_canvas.coscad.

// a wheel is a 10-sided prism along Z rotated onto X (ϕ 90), radius 0.18,
// 0.14 wide; the rotation carries the base to x = 0, so offset by hand
wheel_fl = χ 0.6 (ψ 0.95 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
wheel_fr = χ -0.46 (ψ 0.95 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
wheel_ml = χ 0.6 (ψ -0.45 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
wheel_mr = χ -0.46 (ψ -0.45 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
wheel_rl = χ 0.6 (ψ -0.9 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
wheel_rr = χ -0.46 (ψ -0.9 (ζ 0.18 (ϕ 90 (⎏ 10 0.18 0.14))))
main = wheel_fl ⊕ wheel_fr ⊕ wheel_ml ⊕ wheel_mr ⊕ wheel_rl ⊕ wheel_rr

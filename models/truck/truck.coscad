// truck.coscad -- Terra II's support unit: a 1940s-style cargo truck
// (the Opel Blitz silhouette), body only: chassis, cab, bonnet, bed.
// +Y forward, on z = 0, 1.05 wide x 2.4 long.  The wheels and the canvas
// are truck_kit.coscad.

// chassis rails
chassis = χ -0.42 (ψ -1.2 (ζ 0.28 (▬ 0.84 2.4 0.12)))
// the bonnet (engine) at the front, a little lower than the cab
bonnet = χ -0.4 (ψ 0.72 (ζ 0.4 (▬ 0.8 0.55 0.36)))
grille = χ -0.34 (ψ 1.25 (ζ 0.42 (▬ 0.68 0.04 0.32)))
bumper = χ -0.5 (ψ 1.28 (ζ 0.3 (▬ 1.0 0.06 0.08)))
// the cab, with a raked windscreen block
cab = χ -0.48 (ψ 0.15 (ζ 0.4 (▬ 0.96 0.6 0.62)))
screen = ψ 0.72 (ζ 0.85 (θ 20 (χ -0.44 (ψ -0.03 (ζ -0.15 (▬ 0.88 0.06 0.3))))))
// front mudguards
guard_l = χ -0.6 (ψ 0.9 (ζ 0.36 (▬ 0.14 0.5 0.1)))
guard_r = χ 0.46 (ψ 0.9 (ζ 0.36 (▬ 0.14 0.5 0.1)))
// the cargo bed
bed = χ -0.52 (ψ -1.18 (ζ 0.4 (▬ 1.04 1.28 0.42)))

main = chassis ⊕ bonnet ⊕ grille ⊕ bumper ⊕ cab ⊕ screen ⊕ guard_l ⊕ guard_r ⊕ bed

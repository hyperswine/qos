// infantry.coscad -- Terra II's Soft combat unit: a low-poly soldier
// standing on z = 0, facing +Y, about 1.1 tall.  The body only; the kit
// (helmet, rifle, boots, pack) is infantry_kit.coscad so it can carry a
// second colour.  Plain ▬ is corner-origin: parts are written as
// χ (cx - x/2) (ψ (cy - y/2) (ζ (cz - z/2) (▬ x y z))).

// legs, a little apart
leg_l = χ -0.16 (ψ -0.08 (ζ 0.12 (▬ 0.14 0.16 0.38)))
leg_r = χ 0.02 (ψ -0.08 (ζ 0.12 (▬ 0.14 0.16 0.38)))
// torso
torso = χ -0.21 (ψ -0.12 (ζ 0.5 (▬ 0.42 0.24 0.36)))
// shoulders slightly wider than the torso
shoulders = χ -0.25 (ψ -0.11 (ζ 0.78 (▬ 0.5 0.22 0.1)))
// the head: a 6-sided prism (the helmet sits over it)
head = ζ 0.88 (⎏ 6 0.11 0.18)
// arms: the right one forward holding the rifle, the left across
arm_r = χ 0.21 (ψ 0.0 (ζ 0.62 (▬ 0.1 0.26 0.1)))
arm_l = χ -0.31 (ψ -0.02 (ζ 0.55 (▬ 0.1 0.3 0.1)))

main = leg_l ⊕ leg_r ⊕ torso ⊕ shoulders ⊕ head ⊕ arm_r ⊕ arm_l

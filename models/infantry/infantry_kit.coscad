// infantry_kit.coscad -- the soldier's kit, drawn dark: helmet, boots,
// backpack.  The rifle is infantry_rifle.coscad, its own part so it can
// move in the soldier's hands.  Same frame as infantry.coscad.

boot_l = χ -0.17 (ψ -0.12 (ζ 0 (▬ 0.16 0.26 0.12)))
boot_r = χ 0.01 (ψ -0.12 (ζ 0 (▬ 0.16 0.26 0.12)))
// helmet: a wider hex prism over the head, with a brim
helmet = ζ 1.02 (⎏ 6 0.14 0.1)
brim = ζ 1.0 (⎏ 6 0.17 0.03)
// backpack on the back (-Y)
pack = χ -0.15 (ψ -0.3 (ζ 0.52 (▬ 0.3 0.16 0.3)))
main = boot_l ⊕ boot_r ⊕ helmet ⊕ brim ⊕ pack

// infantry_rifle.coscad -- the rifle, held diagonally across the chest
// (yawed 25 deg): a hex barrel along +Y, a stock behind, a magazine and a
// grip below.  Its own part, at the soldier's origin, so the game can
// draw it forward and back and swing it a little.

barrel = ω 25 (ψ 0.08 (ζ 0.66 (θ -90 (⎏ 6 0.045 0.55))))
stock = ω 25 (χ -0.045 (ψ -0.22 (ζ 0.58 (▬ 0.09 0.32 0.13))))
mag = ω 25 (χ -0.025 (ψ 0.12 (ζ 0.54 (▬ 0.05 0.06 0.14))))
grip = ω 25 (χ -0.025 (ψ 0.0 (ζ 0.55 (▬ 0.05 0.05 0.12))))

main = barrel ⊕ stock ⊕ mag ⊕ grip

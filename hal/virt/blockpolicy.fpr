# First block-policy slice: exact deadline decisions, no clock, allocation,
# scheduling or device effects here. Ownership transitions are interpreted by
# the caller using one atomic state; physical DMA/reset effects remain there.
profile builtin.
w n = Word.fromInt n.
# Int has fewer bits than Word. Compare the top two bits separately rather
# than truncating an unsigned clock/elapsed value into a signed tagged Int.
high x = Word.toInt (Word.shr x 62).
low x = Word.toInt (Word.and x (Word.not (Word.shl (w 3) 62))).
ge a b = case high a == high b of True -> low a >= low b | False -> high a > high b.
expired : Word -> Word -> Word -> Word -> Word -> Int .
expired since now ticks parks parkLimit = case Word.eq since (w 0) of
    True -> yes (ge parks parkLimit)
  | False -> yes (ge (case Word.eq now (w 0) of True -> w 0 | False -> Word.sub now since) ticks).
yes b = case b of True -> 1 | False -> 0.

# Recovery commands interpreted by the driver under its atomic ownership
# protocol. State: 0 idle, 1 held, 2 orphan, 3 reclaiming, 4 resetting,
# 5 offline. Completed DMA wins over timeout; a recovering owner cannot be
# replaced. Command: 0 park, 1 reclaim, 2 reset, 3 refuse wait.
waiting : Int -> Bool -> Bool -> Bool -> Int .
waiting 2 completed resetDue waitDue = case completed of
    True -> 1
  | False -> case resetDue of True -> 2 | False -> 0.
waiting other completed resetDue waitDue = case waitDue of True -> 3 | False -> 0.

# 0 park, 1 confirmed reset, 2 reset budget exhausted. A zero probe budget
# cannot confirm anything; a ready device on the last allowed probe can.
resetStep : Word -> Int -> Int -> Int .
resetStep status attempt limit = case attempt >= limit of
    True -> 2
  | False -> case Word.eq status (w 0) of True -> 1 | False -> 0.

# Admission bounds: finite request (<=60s), reset probes (<=10s at 100us),
# and a waiter multiplier. Mechanism C retains the same RV32 guards.
budgetValid : Int -> Int -> Int -> Int .
budgetValid us probes factor = yes (us >= 1 and us <= 60000000 and probes >= 1 and probes <= 100000 and factor >= 1 and factor <= 64).

# Events: 0 acquire, 1 abandon, 2 claim completion, 3 claim reset,
# 4 finish recovery, 5 failed/cancelled recovery, 6 release completed request,
# 7 return a claim whose pre-CAS observations became stale.
# A successful CAS grants exclusive effects to a claimant. Reclaiming retains
# DMA until used-ring acknowledgement; resetting retains it through reset and
# queue reinitialization. Offline is absorbing. Invalid events cannot release
# another owner's DMA; invalid state values quarantine instead.
ownership : Int -> Int -> Int .
ownership 0 0 = 1.
ownership 1 1 = 2.
ownership 2 2 = 3.
ownership 2 3 = 4.
ownership 3 4 = 0.
ownership 3 5 = 5.
ownership 4 4 = 0.
ownership 4 5 = 5.
ownership 1 6 = 0.
ownership 3 7 = 2.
ownership 4 7 = 2.
ownership state event = if state >= 0 and state <= 5 then state else 5.

# Re-read completion/deadline facts AFTER the claim CAS: another waiter may
# have recovered and abandoned a new request between observation and CAS.
# 0 return to orphan, 1 acknowledge completion, 2 perform reset.
claimStep : Int -> Bool -> Bool -> Int .
claimStep 3 completed resetDue = if completed then 1 else 0.
claimStep 4 completed resetDue = case completed of True -> 0 | False -> if resetDue then 2 else 0.
claimStep state completed resetDue = 0.

unsafe program.
FS = use "std/fs".
QL = use "programs/mods/qlog".
spectreRun : unsafe String -> Int .
spectreJob : unsafe Int -> Int -> Int .
spectreTicks : unsafe Int -> Int .
spectrePrompt : unsafe Unit -> String .
space : unsafe String -> Int -> Int .
space line i = if i >= strlen line then i else if charAt line i == 32 then i else space line (i + 1).
# `soak N`: N numbered lines carrying 03, 7E and 7D (the bytes qlink escapes),
# for the console link's soak test (tools/qhost soak).
soakLine k = "S{k} {chr 3}{chr 126}{chr 125} 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".
soakRun : unsafe Int -> Int -> Int .
soakRun n k = if k >= n then n else _ = print (soakLine k); soakRun n (k + 1).
soakCmd count = _ = soakRun count 0; print "soak done".
# `keys N`: key events from the input device until N have arrived
keyEvents : unsafe String -> Int -> Int .
keyEvents evs i = if i + 4 > strlen evs then 0 else
  _ = print "key code {charAt evs (i + 1) + 256 * charAt evs (i + 2)} value {charAt evs (i + 3)}";
  1 + keyEvents evs (i + 4).
keysLoop : unsafe Int -> Int -> Int .
keysLoop want got = if got >= want then got else
  evs = inRead (device "in0");
  if strlen evs == 0 then _ = Sys.sleepUs 2000; keysLoop want got else keysLoop want (got + keyEvents evs 0).
keysFor want = _ = keysLoop want 0; print "keys done".
showResult r = case r of Ok text -> print text | Err why -> print "error: {why}".
create me fs name text = case FS.readLatest me fs name of
    Ok old -> print "already exists"
  | Err why -> if FS.missing why then (case FS.append me fs name text of Ok ack -> print "created {name}" | Err msg -> print "error: {msg}") else print "error: {why}".
command me fs line =
  a = space line 0;
  op = substr line 0 a;
  n = strlen line;
  b = space line (a + 1);
  slot = if line == "status 1" or line == "stop 1" then 1 else if line == "status 2" or line == "stop 2" then 2 else 0;
  if op == "status" and (slot > 0 or line == "status") then (case spectreJob slot 0 of
        259 -> print "running; yields {spectreTicks slot}"
      | 257 -> print "invalid exit status"
      | 260 -> print "stopped"
      | 261 -> print "no app"
      | code -> print "exit {code}")
  else if op == "stop" and (slot > 0 or line == "stop") then (if spectreJob slot 1 == 1 then print "stopped" else print "no running app")
  else if line == "ls" then showResult (FS.rpc me fs 14 "" "")
  else if op == "run" and b == n and a + 1 < n then (case FS.readLatest me fs (substr line (a + 1) (n - a - 1)) of
      Err why -> print "run: {why}"
    | Ok image -> status = spectreRun image; if status > 0 then print "started job {status}" else if status == 0 then print "run: busy" else print "run: invalid app")
  else if op == "soak" and b == n and a + 1 < n then soakCmd (parseInt (substr line (a + 1) (n - a - 1)))
  else if op == "cat" and b == n and a + 1 < n then showResult (FS.readLatest me fs (substr line (a + 1) (n - a - 1)))
  else if op == "create" and b > a + 1 and b < n then create me fs (substr line (a + 1) (b - a - 1)) (substr line (b + 1) (n - b - 1))
  else if line == "date" then (case clkNow (device "clk0") of "" -> print "date: the host has not sent the time" | ms -> print "epoch ms {ms}")
  else if op == "hcat" and b == n and a + 1 < n then showResult (hfRead (device "hf0") (substr line (a + 1) (n - a - 1)))
  else if op == "hls" then showResult (hfList (device "hf0") (if a + 1 < n then substr line (a + 1) (n - a - 1) else "."))
  else if op == "hput" and b > a + 1 and b < n then (case hfWrite (device "hf0") (substr line (a + 1) (b - a - 1)) (substr line (b + 1) (n - b - 1)) of Ok u -> print "written" | Err why -> print "error: {why}")
  else if op == "beep" then (if audTone (device "aud0") 880 200 == 0 then print "beep sent" else print "beep: no listener")
  else if op == "keys" and b == n and a + 1 < n then keysFor (parseInt (substr line (a + 1) (n - a - 1)))
  else print "usage: create NAME TEXT | ls | cat NAME | run NAME | status [1|2] | stop [1|2] | soak N | date | hcat P | hls [P] | hput P TEXT | beep | keys N".
turn me fs state = _ = command me fs (spectrePrompt Unit); (True,state).
main =
  me = myself 0;
  fs = spawn (QL.actorWith (QL.direct (device "blk")));
  Sys.loop Unit (turn me fs).

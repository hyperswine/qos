# ─── Pin 76 motor: breadboard planner ────────────────────────────────────────
#
# Places the transistor motor switch on the a–e half of a 170-tie breadboard
# and draws it. Adapted from NeoProlog's examples/breadboard.nprolog, which
# places two-pin parts spanning adjacent columns only. Its first motor layout
# had to model Q1 as a two-terminal base-collector proxy, and the emitter
# landed in the wrong strip. This planner knows three kinds of footprint:
#
#   axial  two legs in one row, 1..4 columns apart (resistor, diode); the
#          body lies over the holes between the legs, which stay empty
#   to92   three legs in three adjacent columns of one row (transistor); it
#          may face either way, which mirrors the leg order
#   wire   one hole, for an off-board connection (FPGA pin, supply, motor lead)
#
# The five holes of one column are one strip. Legs on the same net share a
# strip, legs on different nets never do. Among the narrowest windows that
# fit, the planner picks the layout with the shortest axial spans.
#
# Run:  infera motor76.nprolog     (the queries at the end print the plan
#       for wiring.md and the CSV for netlist.csv)

# Explicit acknowledgements of partiality or conservative proof gaps.
plan : unsafe.
legs_of : unsafe.
strip_lines : unsafe.
report : unsafe.
netlist : unsafe.

<- notable.

# ─── The circuit ─────────────────────────────────────────────────────────────
# axial Circuit Name Value NetA NetB LabelA LabelB DescA DescB
# to92  Circuit Name Value NetL NetM NetR LabelL LabelM LabelR Face
#       (legs as seen with the flat face toward you, legs down)
# wire  Circuit Name Net Label Desc

axial motor76 r1 "1 kΩ" pin76 base "R1" "R1" "leg" "leg".
axial motor76 d1 "1N5819" switched motor_vcc "D1A" "D1K" "anode" "cathode (striped end)".
to92 motor76 q1 "BC550" switched base gnd "Q1C" "Q1B" "Q1E" "flat face".
wire motor76 pin76w pin76 "P76" "FPGA pin 76".
wire motor76 mminus switched "M-" "motor −".
wire motor76 mplus motor_vcc "M+" "motor +".
wire motor76 vsup motor_vcc "V+" "MB-V2 3.3 V (or 5 V if the motor is rated for it)".
wire motor76 gmb gnd "GND" "MB-V2 GND".
wire motor76 gtn gnd "GND" "Tang Nano GND".

# ─── List helpers ────────────────────────────────────────────────────────────

member X [X | _].
member X [_ | T] <- member X T.

append [] L L.
append [H | T] L [H | R] <- append T L R.

length [] 0.
length [_ | T] N <- length T N1, N is N1 + 1.

between Lo Hi Lo <- Lo <= Hi.
between Lo Hi X <- Lo < Hi, Lo1 is Lo + 1, between Lo1 Hi X.

dedup [] [].
dedup [X | T] R <- (member X T -> R = R1 ; R = [X | R1]), dedup T R1.

repeat_str S N Out <- (N <= 0 -> Out = "" ; N1 is N - 1, repeat_str S N1 R, str_concat S R Out).

atom_upper A S <- str_atom S0 A, str_upper S0 S.

# ─── Placement variables ─────────────────────────────────────────────────────
# Every part becomes legs:  leg Part Label Net Col Row
# and axial parts also a body:  body Part Row Left Right  (legs at Left, Right)

parts C Ps <-
  findall (ax N V A B LA LB DA DB) (axial C N V A B LA LB DA DB) Axs,
  findall (tr N V L M R LL LM LR F) (to92 C N V L M R LL LM LR F) Trs,
  findall (wi N Net L D) (wire C N Net L D) Wis,
  append Axs Trs P1, append P1 Wis Ps.

# place Part Lo Hi Placed Legs Bodies Vars Spans
place (ax N V A B LA LB DA DB) Lo Hi (pax N V A B LA LB DA DB Row Left Span Flip)
      [leg N LA A CA Row, leg N LB B CB Row] [body N Row Left Right]
      [Left, Span, Row, Flip] [Span] <-
  Row in 1..5, Span in 1..4, Flip in 0..1,
  Left in Lo..Hi, Right #= Left + Span, Right #<= Hi,
  CA #= Left + Span * Flip,
  CB #= Left + Span - Span * Flip.
place (tr N V L M R LL LM LR F) Lo Hi (ptr N V L M R LL LM LR F Row Left Flip)
      [leg N LL L CL Row, leg N LM M CM Row, leg N LR R CR Row] []
      [Left, Row, Flip] [] <-
  Row in 1..5, Flip in 0..1,
  Left in Lo..Hi, Left + 2 #<= Hi,
  CL #= Left + 2 * Flip,
  CM #= Left + 1,
  CR #= Left + 2 - 2 * Flip.
place (wi N Net L D) Lo Hi (pwi N Net L D Row Col) [leg N L Net Col Row] [] [Col, Row] [] <-
  Row in 1..5, Col in Lo..Hi.

place_all [] _ _ [] [] [] [] [].
place_all [P | Ps] Lo Hi [Q | Qs] Legs Bodies Vars Spans <-
  place P Lo Hi Q L1 B1 V1 S1,
  place_all Ps Lo Hi Qs L2 B2 V2 S2,
  append L1 L2 Legs, append B1 B2 Bodies, append V1 V2 Vars, append S1 S2 Spans.

# ─── Constraints ─────────────────────────────────────────────────────────────

hole_vars [] [].
hole_vars [leg _ _ _ Col Row | T] [H | Hs] <- H #= Col * 10 + Row, hole_vars T Hs.

# Same net -> same strip; different nets -> different strips.
strips [] .
strips [L | T] <- strips_with L T, strips T.

strips_with _ [].
strips_with (leg P1 L1 N1 C1 R1) [leg _ _ N2 C2 _ | T] <-
  (N1 == N2 -> C1 #= C2 ; C1 #!= C2),
  strips_with (leg P1 L1 N1 C1 R1) T.

# An axial body covers the holes strictly between its legs in its row.
covers [] _.
covers [B | Bs] Legs <- cover_legs B Legs, covers Bs Legs.

cover_legs _ [].
cover_legs (body P Row Left Right) [leg Q _ _ C R | T] <-
  (P == Q -> true
   ; reify (R #= Row) Same,
     reify (C #<= Left) Before,
     reify (C #>= Right) After,
     Before + After #>= Same),
  cover_legs (body P Row Left Right) T.

sum_list [] 0.
sum_list [X | T] S <- sum_list T S1, S #= S1 + X.

# ─── Search: narrowest window, then shortest spans ───────────────────────────

net_count C K <-
  parts C Ps, place_all Ps 1 17 _ Legs _ _ _,
  findall N (member (leg _ _ N _ _) Legs) All, dedup All Ns, length Ns K.

solve C Lo Hi Placed Legs <-
  parts C Ps,
  place_all Ps Lo Hi Placed Legs Bodies Vars Spans,
  hole_vars Legs Holes, all_different Holes,
  strips Legs,
  covers Bodies Legs,
  sum_list Spans Cost,
  labeling [min Cost] Vars.

plan C Placed Legs <-
  net_count C K,
  once (between 0 8 Extra, Lo is 8, Hi is 8 + K - 1 + Extra, solve C Lo Hi Placed Legs).

# ─── Drawing ─────────────────────────────────────────────────────────────────
# Rows are drawn e (top) to a (bottom), so row a is nearest the reader, as on
# a board with its a–e side toward you. Cells are five characters wide.

row_letter 1 "a". row_letter 2 "b". row_letter 3 "c". row_letter 4 "d". row_letter 5 "e".

hole_name Col Row S <- row_letter Row L, str_num CS Col, str_concat L CS S.

cols_of Legs Lo Hi <-
  findall C (member (leg _ _ _ C _) Legs) Cs, min_list Cs Lo0, max_list Cs Hi0,
  Lo is Lo0 - 1, Hi is Hi0 + 1.

min_list [X] X.
min_list [X | T] M <- T = [_ | _], min_list T M1, M is min X M1.
max_list [X] X.
max_list [X | T] M <- T = [_ | _], max_list T M1, M is max X M1.

covered Placed Col Row <-
  member (pax _ _ _ _ _ _ _ _ Row Left Span _) Placed,
  Col > Left, Col < Left + Span.

# A leg of an axial part is joined to its body with ─ on the body's side.
cell Placed Legs Col Row S <-
  ( member (leg P L _ Col Row) Legs -> leg_fill Placed P Col FL FR, str_length L N, Pad is 5 - N, pad_centre L Pad FL FR S
  ; covered Placed Col Row -> S = "─────"
  ; S = "  ·  " ).

leg_fill Placed P Col FL FR <-
  ( member (pax P _ _ _ _ _ _ _ _ Left Span _) Placed ->
      (Col == Left -> FL = " ", FR = "─" ; FL = "─", FR = " ")
  ; FL = " ", FR = " " ).

pad_centre L Pad FL FR S <-
  Left is Pad / 2, Right is Pad - Left,
  repeat_str FL Left SL, repeat_str FR Right SR,
  str_concat SL L S1, str_concat S1 SR S.

board_row Placed Legs Lo Hi Row ->
  { row_letter Row L }, " ", wr L, " ", cells Placed Legs Lo Hi Row, nl.

cells Placed Legs Col Hi Row ->
  ( { Col <= Hi } -> { cell Placed Legs Col Row S, Col1 is Col + 1 }, wr S, cells Placed Legs Col1 Hi Row
  ; [] ).

board_rows Placed Legs Lo Hi Row ->
  ( { Row >= 1 } -> board_row Placed Legs Lo Hi Row, { Row1 is Row - 1 }, board_rows Placed Legs Lo Hi Row1
  ; [] ).

header Lo Hi -> "   ", header_cols Lo Hi, nl.
header_cols Col Hi -> ( { Col <= Hi } -> { Col1 is Col + 1 }, padl Col 3, "  ", header_cols Col1 Hi ; [] ).

# One line per strip: its net and what goes in it.
strip_lines Legs Col Hi ->
  ( { Col <= Hi } ->
      { findall (h L H) (member (leg _ L _ Col R) Legs, hole_name Col R H) Hs, Col1 is Col + 1 },
      ( { Hs = [] } -> []
      ; { once (member (leg _ _ N Col _) Legs), atom_upper N NS }, "  ", padr Col 4, padr NS 11, hole_list Hs, nl ),
      strip_lines Legs Col1 Hi
  ; [] ).

hole_list [] -> [].
hole_list [h L H | T] -> padr L 4, padr H 6, hole_list T.

# One line per part: where its legs go and which way it faces.
part_lines [] _ -> [].
part_lines [pax N V _ _ LA LB DA DB Row Left Span Flip | T] Legs ->
  { atom_upper N NS, CA is Left + Span * Flip, CB is Left + Span - Span * Flip,
    hole_name CA Row HA, hole_name CB Row HB },
  "  ", padr NS 5, padr V 8, wr DA, " ", wr HA, ",  ", wr DB, " ", wr HB,
  ( { Span == 1 } -> ",  stood on end" ; ",  lying over the holes between" ), nl,
  part_lines T Legs.
part_lines [ptr N V _ _ _ LL LM LR F Row Left Flip | T] Legs ->
  { atom_upper N NS, CL is Left + 2 * Flip, CM is Left + 1, CR is Left + 2 - 2 * Flip,
    hole_name CL Row HL, hole_name CM Row HM, hole_name CR Row HR,
    (Flip == 0 -> Toward = "row a (toward you)" ; Toward = "row e (away from you)") },
  "  ", padr NS 5, padr V 8, wr LL, " ", wr HL, ",  ", wr LM, " ", wr HM, ",  ", wr LR, " ", wr HR,
  "   ", wr F, " toward ", wr Toward, nl,
  part_lines T Legs.
part_lines [pwi N _ L D Row Col | T] Legs ->
  { hole_name Col Row H }, "  ", padr L 5, padr H 8, "wire to ", wr D, nl,
  part_lines T Legs.

report C ->
  { plan C Placed Legs, cols_of Legs Lo Hi },
  "=== Breadboard, a–e side (row a nearest you) ===", nl,
  header Lo Hi,
  board_rows Placed Legs Lo Hi 5,
  header Lo Hi, nl,
  "=== Parts ===", nl,
  part_lines Placed Legs, nl,
  "=== Strips (each column is one connected strip) ===", nl,
  strip_lines Legs Lo Hi.

# The same plan as CSV, the source of netlist.csv.
csv_lines [] -> [].
csv_lines [leg P L N C R | T] ->
  { atom_upper N NS, atom_upper P PS, hole_name C R H },
  wr NS, ",", wr PS, ",", wr L, ",", wr H, nl, csv_lines T.

netlist C ->
  { plan C _ Legs }, "net,part,leg,board_hole", nl, csv_lines Legs.

> emit (report motor76)?
> emit (netlist motor76)?

# Generated from the tested matched binary SDK; never seeds or rewrites user disks.
class QosPortable < Formula
  desc "Installed QOS desktop app SDK with its matched FP-RISC compiler"
  homepage "https://github.com/hyperswine/qos"
  url "https://github.com/hyperswine/qos/releases/download/desktop-v__VERSION__/__ARCHIVE__"
  version "__VERSION__"
  sha256 "__SHA256__"
  license "MIT"

  depends_on arch: :arm64
  depends_on macos: :golden_gate
  depends_on "glfw"
  depends_on "libarchive"
  depends_on "libgit2"
  depends_on "lld"
  depends_on "llvm"
  depends_on "python@3.14"
  conflicts_with "qos-fpr", because: "both install the qos command"

  def install
    libexec.install "libexec/qos-portable"
    tools = "#{Formula["llvm"].opt_bin}:#{Formula["lld"].opt_bin}:#{Formula["python@3.14"].opt_libexec}/bin:$PATH"
    # Only `qos` is exported. `qos build` runs the private, hash-matched compiler;
    # global `fpr` and `sol` belong to the standalone FP-RISC toolchain.
    (bin/"qos").write_env_script Formula["python@3.14"].opt_bin/"python3.14",
                               [libexec/"qos-portable/tools/portable_sdk.py"], { PATH: tools, PYTHONDONTWRITEBYTECODE: "1" }
  end

  def caveats
    <<~EOS
      Native macOS ARM64 desktop SDK (API 2/session 5). Start with:
        qos new counter
        cd counter && qos build
        qos disk create "$HOME/qosp.disk"
        qos install build/counter.qa "$HOME/qosp.disk"
        qos run "$HOME/qosp.disk"
      Keep projects and disks outside the Cellar. Close QOS before installing apps.
      Package upgrades preserve external disks; they do not migrate incompatible profiles.
      Since 0.2.0 this package no longer installs `fpr`: use `qos build` where
      0.1.0 used `fpr build --target=qos-portable`. Existing disks and apps keep working.
      The separate contributor workflow remains qos.py toolchain install from source.
    EOS
  end

  test do
    assert_match "QOS Portable __VERSION__", shell_output("#{bin}/qos --version")
    system bin/"qos", "new", "counter"
    cd "counter" do
      system bin/"qos", "build"
      assert_path_exists "build/counter.qa"
      system bin/"qos", "disk", "create", testpath/"main.disk"
      system bin/"qos", "install", "build/counter.qa", testpath/"main.disk"
    end
  end
end

# pathnotes.fpr -- the NOTES app on the full value-space iteration
# stack (docs/PATHS.md): std.MVU + the message port, first-class paths
# both tiers, and std.livereload -- most app iteration happens LIVE, in
# value space, while the types stay a fixed skeleton.
#
#   * the Model is a declared shape; @Model is its SCHEMA, so ANY
#     Int/String field (nested included) is editable at runtime by a
#     plain ("set", "path value") message -- applied by update, the
#     single writer, transactionally (bad path -> logged refusal,
#     model untouched).  No per-app inspector code: ("dump", "") walks
#     the schema and prints every leaf.
#   * the line-EDIT function lives behind the LOADER SERVICE
#     (std.loader over std.fs -- the app touches no device, reads no
#     records; every accepted swap is recorded as sys/live): a
#     ("swap", "<id>") message pulls a version out of the DISK store at
#     a STEP BOUNDARY.  v1 appends a newline; v2 capitalizes the first
#     letter instead -- same signature, checked by the compat gate,
#     which REFUSES the arity-changed impostor.  The live version's
#     name is a value IN the model (ver), so replay history knows which
#     code was live at every step.
#   * commands arrive through MV.port from a driver actor: per-sender
#     FIFO, drained once per frame -- every mutation of the model,
#     debug sets included, is an ordinary message.
#
#   ./qos.py run tests/pathnotes.fpr        (the line below IS the harness:
#                                            qos.py builds these as plugin
#                                            modules, seeds a fresh QLOG
#                                            image, points FPR_DISK at it)
#: plugins tests/notesed1.fpr tests/notesed2.fpr tests/notesedbad.fpr
#: expect pathnotes: OK notes=Third note|Fourth one n=4 cap=2 ui=live ver=caps.v2 log=refused notesedbad
#
#   by hand, the same thing:
#   make qos-app PROG=tests/pathnotes.fpr && make plugsyms
#   make plugin-qa PROG=tests/notesed1.fpr PLUGSLOT=0
#   make plugin-qa PROG=tests/notesed2.fpr PLUGSLOT=1
#   make plugin-qa PROG=tests/notesedbad.fpr PLUGSLOT=2
#   python3 tools/mkdisk.py /tmp/pn.img 8 notesed1.qa notesed2.qa notesedbad.qa
#   (cd ../qos && FPR_DISK=/tmp/pn.img ./qosp --yes ../fp-risc/app.qa)
#
# Expected (one line, plus the inspector block on stdout; cap=2 keeps
# only the newest two notes, so the v1-committed ones age out except
# "Third note"'s neighbor -- the final list is the LAST TWO commits):
#   pathnotes: OK notes=Third note|Fourth one n=4 cap=2
#   ui=live ver=caps.v2 log=refused notesedbad

FS = use "std/fs".
LD = use "std/loader".
MV = use "std/mvu".
L = use "std/lens".

MApp = MV.MApp.  MQuit = MV.MQuit.
EMsg = MV.EMsg.  SPort = MV.SPort.

Ui = {tag : String, fg : Int}.
Model = {notes : List String, input : String, count : Int, cap : Int,
         ver : String, log : String, ui : Ui, port : Int}.

# ---- helpers ----------------------------------------------------------------

revL : unsafe List a -> List a -> List a .
revL acc l = case l of Nil -> acc | x :: r -> revL (x :: acc) r.
joinBar : unsafe List String -> String -> String .
joinBar l acc = case l of
    Nil -> acc
  | s :: r -> joinBar r (joinOne acc (escLf s 1 "")).
joinOne acc s = case strlen acc == 0 of True -> s | False -> "{acc}|{s}".
# newline -> visible "\n" so the summary stays one greppable line
escLf : unsafe String -> Int -> String -> String .
escLf s i acc = case i > strlen s of
    True -> acc
  | False -> escLf s (i + 1) (escOne acc (charAt s i)).
escOne acc c = case c == 10 of
    True -> "{acc}\\n"
  | False -> "{acc}{chr c}".

# ---- the app ----------------------------------------------------------------

appInit env =
  (ld, port) = env;
  nm = LD.bind "editName";
  {notes = Nil, input = "", count = 0, cap = 3,
   ver = nm "", log = "-", ui = {tag = "boot", fg = 2}, port = port}.

appUpdate : Int -> _ -> _ -> _ -> _ .
appUpdate me env ev m = case ev of
    EMsg tag arg -> appMsg me env m tag arg
  | e -> (m, Nil).

# this should be ideally using clause matching on string literals
appMsg : Int -> _ -> _ -> String -> String -> _ .
appMsg me env m tag arg = case L.strEq tag "note" of
    True -> appNote m arg
  | False -> case L.strEq tag "set" of
      True -> appSet m arg
    | False -> case L.strEq tag "swap" of
        True -> appSwap me env m arg
      | False -> case L.strEq tag "dump" of
          True -> appDump m
        | False -> case L.strEq tag "quit" of
            True -> (m, MQuit :: Nil)
          | False -> ({m | log = "unknown msg {tag}"}, Nil).

# a committed line goes through the LIVE edit module (resolved at the
# step, never stored in the model -- a stored closure would pin v1)
appNote : _ -> String -> _ .
appNote m line =
  f = LD.bind "editLine";
  cP = @Model.count;
  ({m | notes = List.take (f line :: m.notes) m.cap, count = cP.get m + 1}, Nil).

# the string tier: any schema leaf, set from a wire string; a refusal
# is transactional and LOGGED, never applied
appSet : _ -> String -> _ .
appSet m pv = case L.setWords (@Model) pv m of
    Ok m2 -> (m2, Nil)
  | Err e -> ({m | log = e}, Nil).

# the ladder's next rung: module swap at a step boundary, as ONE
# message to the Loader service -- which gates it (shell stamp, arity
# chain) and records the new live set as sys/live; ver (a model VALUE)
# records what's live on this side.
appSwap : Int -> _ -> _ -> String -> _ .
appSwap me env m id =
  (ld, port) = env;
  r = LD.load me ld id;
  case r of
    Ok u -> appSwapOk m
  | Err e -> ({m | log = "refused {id}"}, Nil).
appSwapOk m =
  nm = LD.bind "editName";
  ({m | ver = nm ""}, Nil).

# the generic inspector: walk the schema, no per-app code
appDump : _ -> _ .
appDump m =
  _ = print "-- inspector --\n{L.dump (@Model) m ""}-- end --";
  (m, Nil).

appSubs m = SPort m.port :: Nil.
appSkey m = 0.
appView vp m = "PATHNOTES" :: Nil.
appVals self env vp m = "n={m.count}" :: "ver={m.ver}" :: Nil.

appDone : unsafe _ -> String .
appDone m =
  "pathnotes: OK notes={joinBar (revL Nil m.notes) ""} n={m.count} cap={m.cap} ui={m.ui.tag} ver={m.ver} log={m.log}".

# ---- the driver: every mutation is a message --------------------------------

driver : Int -> Int -> String .
driver port me =
  _ = send port ("note", "hello qos");        # v1: trailing newline
  _ = send port ("set", "ui.tag live");       # nested leaf, by string
  _ = send port ("set", "input drafting...");
  _ = send port ("set", "cap 2");             # a TUNABLE changes live
  _ = send port ("note", "second note");
  _ = send port ("swap", "notesed2");         # hot swap: caps.v2
  _ = send port ("note", "third note");       # -> "Third note", cap drops oldest
  _ = send port ("set", "nope.where 1");      # bad path: logged, ignored
  _ = send port ("swap", "notesedbad");       # arity drift: REFUSED (logged)
  _ = send port ("note", "fourth one");       # still v2
  _ = send port ("dump", "");
  _ = send port ("quit", "");
  "driver done".

# ---- main -------------------------------------------------------------------

expectOk what r = case r of
    Ok i -> i
  | Err e -> error "pathnotes {what}: {e}".

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  ld = LD.serve fs;
  _ = expectOk "load v1" (LD.load me ld "notesed1");
  clint = device "clint";
  mt = reg32 clint 49144;
  render = spawn MV.textRender;
  port = spawn MV.port;
  _ = spawn (driver port);
  cfg = { env = (ld, port), mt = mt, tick = 3000, input = 0, render = render };
  app = MApp appInit appUpdate appSkey appView appVals appDone appSubs;
  r = MV.run me cfg app;
  _ = kill port;
  r.

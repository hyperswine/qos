# livereload.fpr -- hot module swap, THE SERVICE WAY (docs/PATHS.md §6):
# the app touches no device and reads no records itself.  It spawns the
# two interpreters -- Files (std.fs, the log's one writer) and the
# Loader (std.loader, the only thing that turns apps/<id>.qa records
# into live code) -- and everything after that is messages:
#
#   1. LD.load "mathv1": the loader reads the record, passes the shell
#      matched-set + arity gates, attaches, RECORDS the chain as
#      sys/live.  A worker actor binds mathOp and folds requests into
#      its own accumulator (the state that must survive).
#   2. LD.load "mathv2" + a Reload nudge: the SAME worker re-binds --
#      next request computes with v2, accumulator intact.  Because the
#      loader wrote sys/live, this swap would also survive a reboot
#      (tests/sysdisk.fpr proves that property).
#   3. LD.load "mathbad" (arity drift) is REFUSED by the gate, detached,
#      never recorded; the worker keeps running v2.
#
# std/livereload.fpr remains the LOW-LEVEL tier (its header carries the
# reload-safety rules the compiler guarantees); std.loader is the
# intended surface, and this test now exercises it.
#
#   ./qos.py run tests/livereload.fpr
#: plugins tests/mathv1.fpr tests/mathv2.fpr tests/mathbad.fpr
#: expect livereload: v1: 20 22 | v2 (same actor, acc kept): 30 | bad: refused | still v2: 36 | acc=108

FS = use "std/fs".
LD = use "std/loader".

Nudge = Type (Reload url).

# ---- the worker: state in the loop args, code behind a bound fn ------------
worker : unsafe _ -> Int -> a .
worker f me = wloop f me 0.
wloop : unsafe _ -> Int -> Int -> a .
wloop f me acc =
  m = receive me;
  case m of
    (from, v) -> wcalc f me acc from v
  | u -> wloop (LD.bind "mathOp") me acc.
         # ^ re-bind; the ACCUMULATOR rides through
wcalc : unsafe _ -> Int -> Int -> Int -> Int -> a .
wcalc f me acc from v =
  r = f v;
  _ = send from (r, acc + r);
  wloop f me (acc + r).

askW : Int -> Int -> Int -> (Int, Int) .
askW me w v =
  _ = send w (me, v);
  reply = receiveFrom me w;
  (r, a) = reply;
  (r, a).

expectOk what r = case r of
    Ok i -> i
  | Err e -> error "livereload {what}: {e}".

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  ld = LD.serve fs;

  # 1. v1 out of the store, through the loader's gates; worker binds
  _ = expectOk "load v1" (LD.load me ld "mathv1");
  w = spawn (worker (LD.bind "mathOp"));
  (r1, a1) = askW me w 10;
  (r2, a2) = askW me w 11;

  # 2. the hot swap: one message to the loader, one nudge to the worker
  _ = expectOk "load v2" (LD.load me ld "mathv2");
  _ = send w (Reload "mathv2");
  (r3, a3) = askW me w 10;

  # 3. the impostor: refused, detached, never recorded; v2 stays bound
  bad = LD.load me ld "mathbad";
  badS = case bad of
      Ok i -> "ACCEPTED?!"
    | Err e -> "refused";
  (r4, a4) = askW me w 12;

  _ = kill w;
  "livereload: v1: {r1} {r2} | v2 (same actor, acc kept): {r3} | bad: {badS} | still v2: {r4} | acc={a4}".

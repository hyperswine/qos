# sysdisk.fpr -- THE DISK IS THE SYSTEM, proven with two boots of one
# image.  Everything that exists is records on the log, interpreted by
# two services the app spawns: Files (std.fs over mods/qlog's one
# writer) and the Loader (std.loader), which turns apps/<id>.qa records
# into live code and RECORDS the attach chain as sys/live.
#
#   BOOT 1 (fresh disk: module records only, no sys/live)
#     replay -> 0.  Load sysed1, commit a note; load sysed2 -- a hot
#     swap through the shell-stamp + arity gates -- notes capitalize;
#     sysbad REFUSES (chain intact, sys/live untouched).  Every step's
#     outcome exists only as log records when the process exits.
#   BOOT 2 (the SAME disk, same app, new process)
#     replay -> 2: the loader re-reads sys/live and reassembles the
#     live set -- the hot swap SURVIVED THE REBOOT, with no compiler,
#     no operator, no Load calls; notes capitalize immediately.
#
#   ./qos.py run tests/sysdisk.fpr        (boot 1; the leg runs both)
#: plugins tests/sysed1.fpr tests/sysed2.fpr tests/sysbad.fpr
#: expect sysdisk boot1: [one] [Two] bad=refused live=sysed2 sysed1 ver=sys.v2
#
# Boot 2's expected line (the check-all leg drives both):
#   sysdisk boot2: replayed 2 [Three] ver=sys.v2 (no loads, no compiler -- the disk decided)

FS = use "std/fs".
LD = use "std/loader".

expectOk what r = case r of
    Ok v -> v
  | Err e -> error "sysdisk {what}: {e}".

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  ld = LD.serve fs;
  n = expectOk "replay" (LD.replay me ld);
  case n == 0 of
    True -> boot1 me ld
  | False -> boot2 me ld n.

# ---- boot 1: build the live set, one message per step ----------------------
boot1 me ld =
  _ = expectOk "load v1" (LD.load me ld "sysed1");
  n1 = (LD.bind "editLine") "one";
  _ = expectOk "load v2" (LD.load me ld "sysed2");
  n2 = (LD.bind "editLine") "two";
  bad = LD.load me ld "sysbad";
  badS = case bad of Ok i -> "ACCEPTED?!" | Err e -> "refused";
  "sysdisk boot1: [{n1}] [{n2}] bad={badS} live={LD.list me ld} ver={(LD.bind "editName") ""}".

# ---- boot 2: the disk decided; nothing to do but use what's live -----------
boot2 me ld n =
  n3 = (LD.bind "editLine") "three";
  "sysdisk boot2: replayed {n} [{n3}] ver={(LD.bind "editName") ""} (no loads, no compiler -- the disk decided)".

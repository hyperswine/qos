# gl2d.fpr -- scene2d's box treatments on the walker: rounded corners,
# shadows, translucent fills, borders as rings, proportional text and a
# menu laid over a layer (buildAt), a clipped and scrolled row of chips,
# a label cut with "..".  Snapshots frame 6 to /tmp/gl2d-1.ppm
# and quits; the check reads pixels back (a glass card over a grey field
# must be one even tint, corners included).
#
#   make qos-app PROG=tests/gl2d.fpr
#   (cd ../qos && make portable-gl && xvfb-run -a ./qosp-gl --yes ../fp-risc/app.qa)
unsafe program.

MV = use "std/mvu".
GL = use "../programs/mods/glsvc".
S2 = use "../programs/mods/scene2d".

App = MV.App.
MQuit = MV.MQuit.
ETick = MV.ETick.
STick = MV.STick.

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).
Box = S2.Box.
Lbl = S2.Lbl.
Row = S2.Row.
Col = S2.Col.
Pad = S2.Pad.
Gap = S2.Gap.
W = S2.W.
H = S2.H.
Grow = S2.Grow.
Bg = S2.Bg.
Fg = S2.Fg.
Bord = S2.Bord.
Fs = S2.Fs.
Round = S2.Round.
Shadow = S2.Shadow.
Bga = S2.Bga.
Center = S2.Center.
Mid = S2.Mid.
Clip = S2.Clip.
Scroll = S2.Scroll.
Ellip = S2.Ellip.

lights = ((3000, 9000, 6000), (1000, 1000, 1000)) :: Nil.
camera = ((0, 5200, 7800), (0, 0, 0), 950).
scene t = Scene Nil (Ent "plane" (0, 0, 0) 0 (12000, 1000, 12000) (150, 170, 150) :: Nil) lights camera.

grey = (500, 500, 500).
glass = (12, 16, 26, 800).
yellow = (1000, 860, 300).
ink = (930, 940, 960).
t em col s = Lbl (Fs em :: Fg col :: Nil) s.
card attrs kids = Box (Col :: W 200 :: H 120 :: Pad 12 :: Gap 6 :: attrs) kids.

# four cards on a grey field: glass + border + shadow, glass + border,
# glass alone, opaque + border; then a text line under them
tree =
  Box (Col :: W 960 :: H 600 :: Pad 40 :: Gap 20 :: Bg grey :: Nil)
      (Box (Row :: Gap 20 :: Nil)
           (card (Round 18 :: Shadow :: Bga glass :: Bord yellow :: Nil) (t 16 ink "glass shadow ring" :: Nil) ::
            card (Round 18 :: Bga glass :: Bord yellow :: Nil) (t 16 ink "glass ring" :: Nil) ::
            card (Round 18 :: Bga glass :: Nil) (t 16 ink "glass" :: Nil) ::
            card (Round 18 :: Bg (34, 40, 56) :: Bord yellow :: Nil) (t 16 ink "opaque ring" :: Nil) :: Nil) ::
       Box (Row :: Gap 12 :: Mid :: Nil)
           (Box (Row :: W 22 :: H 22 :: Round 11 :: Bg yellow :: Center :: Mid :: Nil) (t 12 (34, 40, 56) "3" :: Nil) ::
            t 14 ink "a badge, a chip" ::
            Box (Row :: Pad 5 :: Round 9 :: Bg (48, 58, 84) :: Mid :: Nil) (t 12 ink "CHIP" :: Nil) :: Nil) ::
       Box (Row :: Gap 20 :: Nil)
           (Box (Row :: W 300 :: H 60 :: Pad 8 :: Gap 10 :: Clip :: Scroll 40 0 :: Bg (34, 40, 56) :: Nil)
                (chip "one" :: chip "two" :: chip "three" :: chip "four" :: chip "five" :: chip "six" :: Nil) ::
            Box (Col :: W 160 :: Pad 8 :: Bg (34, 40, 56) :: Nil)
                (Lbl (Fs 16 :: Fg ink :: Ellip 140 :: Nil) "a rather long label that must be cut" :: Nil) :: Nil) :: Nil).
chip s = Box (Row :: W 90 :: H 44 :: Round 8 :: Bg yellow :: Center :: Mid :: Nil) (t 14 (34, 40, 56) s :: Nil).
# a menu over it all
menu =
  Box (Col :: W 960 :: H 600 :: Center :: Mid :: Bga (0, 0, 0, 520) :: Nil)
      (Box (Col :: W 300 :: Pad 20 :: Gap 8 :: Round 16 :: Shadow :: Bga glass :: Bord yellow :: Nil)
           (t 24 yellow "PAUSED" :: t 15 ink "Resume" :: Nil) :: Nil).

ui t =
  (es, sl) = S2.buildW (960, 600) tree;
  (ms, sl2) = S2.buildAt (960, 600) menu 40;
  case t >= 9 of True -> es + ms | False -> es.

init env = 0.
update env ev t = case ev of
    ETick -> tick (t + 1)
  | e -> (t, Nil).
tick t | t > 14 = (t, MQuit :: Nil).
tick t = (t, Nil).
subs t = STick 40 :: Nil.
view t = (scene t, (ui t, S2.camAt 600), case t >= 11 of True -> 2 | False -> (case t >= 6 of True -> 1 | False -> 0)).

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  gl = spawn (GL.serve 960 600 "gl2d" Nil);
  cfg = { env = 0, mt = mt, tick = 160000, input = gl, render = gl };
  _ = print "gl2d: box treatments";
  MV.game me cfg (App init update subs view).

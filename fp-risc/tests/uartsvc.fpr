# uartsvc.fpr -- std.uart end to end: the LINEAR PHASE-TYPED handle
# driving UART.qa (programs/mods/uart.fpr) through every round trip --
# open, params (divisor latch), buffer budget, arm (interrupts on,
# PLIC source bound to the service actor), DMA-shaped writes, flush
# completion, interrupt-driven receive, close.
#
# On bare metal (QEMU virt) the transmit drain and the receive path
# are INTERRUPT-driven: the 16550's THRE/RDA raise PLIC source 10,
# hart 0 wakes from wfi (no trap), and the irq lands in the service
# actor's mailbox as a plain Int.  The check leg types bytes on stdin
# after boot; they arrive as RX interrupts.  On QOS Portable the same
# protocol runs over the synchronous host-tty backend.
#
#   make bare-metal-run PROG=tests/uartsvc.fpr   (feed stdin for rx)
#   make qos-app PROG=tests/uartsvc.fpr && (cd ../qos && ./qosp --yes ...)
#
# Expected: the DMA payload appears on the console, then
#   uartsvc: tx=33B flushed; rx=<n>B first=<c>  (n>0 when stdin fed)

UM = use "../programs/mods/uart".
U = use "std/uart".

# take rx with a deadline: poll the service until bytes arrive or ~2s
# of mtime passes (10 MHz clint ticks; each poll is a full round trip,
# so the service actor keeps getting scheduled on both tiers)
waitRx : unsafe _ -> Int -> Int -> (String, _) .
waitRx u mt dl =
  (s, u2) = U.readRx u;
  case strlen s > 0 of
    True -> (s, u2)
  | False -> case read mt > dl of
      True -> ("", u2)
    | False -> nap mt (read mt + 100000) >> waitRx u2 mt dl.
                # ^ ~10ms between polls: a poll is a whole round trip

nap : unsafe Int -> Int -> Unit .
nap mt until = case read mt > until of
    True -> Unit
  | False -> nap mt until.

firstCh s = case strlen s > 0 of True -> charAt s 1 | False -> 0.

main =
  clint = device "clint";
  mt = reg32 clint 49144;
  svc = spawn UM.actor;
  h = U.open svc;
  h2 = U.params h 1;                   # divisor 1 (QEMU: cosmetic, real dance)
  h3 = U.buffer h2 4096;
  u = U.arm h3;                        # UartCfg -> Uart: irq live from here
  (n1, u2) = U.write u "UARTDMA[";
  (n2, u3) = U.write u2 "payload-0123456789]\n";
  u4 = U.flush u3;                     # completion: buffer fully drained
  (rx, u5) = waitRx u4 mt (read mt + 80000000);
  _ = U.close u5;
  "uartsvc: tx={n1 + n2}B flushed; rx={strlen rx}B first={firstCh rx}".

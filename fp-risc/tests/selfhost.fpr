# selfhost.fpr -- the on-QOS ladder, END TO END, without leaving the
# running system, THE SERVICE WAY: SOURCE STRINGS edited inside the
# app are compiled and PACKAGED into hot-loadable module .qa bytes
# (CP.plugin -> the tag-7 channel -> the host fprd daemon running the
# plugin-qa pipeline), appended through the Files service as
# apps/<id>.qa records -- the same records a seeded disk carries --
# and pulled back through the Loader service's gates.  The app touches
# no device and reads no records itself; and because the loader writes
# sys/live, every swap made here would also SURVIVE A REBOOT
# (tests/sysdisk.fpr proves that property).
#
#   1. v1 ("editLine s = s") packaged at sub-slot 0, stored, loaded,
#      bound, used
#   2. v2 (capitalize-first, same signature) packaged at sub-slot 1:
#      the gate passes, the SAME app re-binds -- a hot swap whose
#      whole toolchain round trip started from a string in the model
#   3. the impostor (arity drift) packages FINE but the load REFUSES
#      it and v2 stays bound -- the checked precondition, not a
#      convention, exactly as with disk-seeded versions
#
#
#   ./qos.py run tests/selfhost.fpr     (the directive below starts the
#                                        compiler daemon for the run)
#: fprd
#: expect selfhost: v1 one | v2 hot self-compiled Two | bad: refused | still v2: Three ver=self.v2
#
#   by hand: python3 tools/fprd.py &  then the usual qos-app + qosp run

CP = use "std/compile".
FS = use "std/fs".
LD = use "std/loader".

srcV1 = "editLine s = s.\neditName u = \"self.v1\".".

# no string interpolation inside the embedded source (keeps escaping
# honest): v2 capitalizes via strcat/chr instead of a {..} splice
srcV2 = "editLine s = case strlen s == 0 of True -> s | False -> (chr (upC (charAt s 1))) + (substr s 2 (strlen s - 1)).\nupC c = case c >= 97 of True -> upD c | False -> c.\nupD c = case c <= 122 of True -> c - 32 | False -> c.\neditName u = \"self.v2\".".

srcBad = "editLine a b = a.\neditName u = \"self.bad\".".

expectOk what r = case r of
    Ok v -> v
  | Err e -> error "selfhost {what}: {e}".

# source -> .qa bytes (the daemon packages at sub-slot <slot>'s base)
# -> a record through the Files service, for any later boot to load
mint me fs slot id src =
  qa = expectOk "package {id}" (CP.plugin slot id src);
  expectOk "store {id}" (FS.append me fs "apps/{id}.qa" qa).

main =
  me = myself 0;
  fs = FS.serve (device "blk");
  ld = LD.serve fs;
  _ = mint me fs 0 "selfed1" srcV1;
  _ = expectOk "load v1" (LD.load me ld "selfed1");
  n1 = (LD.bind "editLine") "one";
  _ = mint me fs 1 "selfed2" srcV2;
  _ = expectOk "load v2" (LD.load me ld "selfed2");
  n2 = (LD.bind "editLine") "two";
  _ = mint me fs 2 "selfedbad" srcBad;
  bad = LD.load me ld "selfedbad";
  badS = case bad of Ok i -> "ACCEPTED?!" | Err e -> "refused";
  n3 = (LD.bind "editLine") "three";
  ver = (LD.bind "editName") "";
  "selfhost: v1 {n1} | v2 hot self-compiled {n2} | bad: {badS} | still v2: {n3} ver={ver}".

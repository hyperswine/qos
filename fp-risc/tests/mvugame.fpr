# mvugame.fpr -- the elm surface end to end: MVU.game running an App
# (init/update/subs/view -- the formal four) against a CUSTOM render
# service and a SCRIPTED input service, deterministically:
#
#   - subs = SKeys only: update hears exactly the scripted presses,
#     never a tick -- time is unsubscribed, so the run is a pure
#     function of the script
#   - the input actor speaks the Poll protocol (kind 4 presses, kind 0
#     end-of-frame), one press per frame then the terminator: the
#     drain law exercised without a keyboard
#   - the render service is app-owned (the voxel-interactive shape: a
#     renderer holding its own state behind the Rv protocol); view
#     runs IN THE WORKER and the whole scene rides the dynamics slot
#   - EResize arrives once at start (the render service's Dims) and
#     lands in the model, unsubscribed
#
#   make qos-app PROG=tests/mvugame.fpr
#   (cd ../qos && make portable && ./qosp --yes ../fp-risc/app.qa)
#
# Expected output (exact -- the run is scripted):
#   gr f0: x=1 vp=32x8
#   gr f1: x=2 vp=32x8
#   gr f2: x=1 vp=32x8
#   game over [mvu: 3 frames, 1 statics builds]

MV = use "std/mvu".

App = MV.App.
MQuit = MV.MQuit.
EKey = MV.EKey.
EResize = MV.EResize.
SKeys = MV.SKeys.
Rv = MV.Rv.
Render = MV.Render.
Dims = MV.Dims.
Poll = MV.Poll.

# ---- the app: the formal four ----------------------------------------------

M = Type (M x w h).

gInit env = M 0 0 0.

gUpdate env ev m = case ev of
    EKey k -> gKey k m
  | EResize w h -> gSize w h m
  | e -> (m, Nil).
gKey k m =
  M x w h = m;
  case k == 105 of
    True -> (M (x + 1) w h, Nil)
  | False -> case k == 106 of
      True -> (M (x - 1) w h, Nil)
    | False -> case k == 16 of
        True -> (m, MQuit :: Nil)
      | False -> (m, Nil).
gSize w h m =
  M x ow oh = m;
  (M x w h, Nil).

gSubs m = SKeys :: Nil.

gView m =
  M x w h = m;
  "x={x} vp={w}x{h}" :: Nil.

# ---- the scripted input service (the Poll protocol) ------------------------
# script entries: a key code = one kind-4 press; 0 = end of this
# frame's batch (the kind-0 reply the drain stops on); an exhausted
# script answers kind 0 forever.

feed : unsafe List Int -> Int -> a .
feed script me =
  m = receive me;
  (from, q) = m;
  case script of
    Nil -> send from (0, 0, 0) >> feed Nil me
  | k :: r -> feedOne r from k me.
feedOne : unsafe List Int -> Int -> Int -> Int -> a .
feedOne r from k me = case k == 0 of
    True -> send from (0, 0, 0) >> feed r me
  | False -> send from (4, k, 1) >> feed r me.

# ---- the app-owned render service (the Rv protocol) ------------------------
# A stand-in for a voxel-class renderer: fixed dims, one draw per
# frame, the scene (view's output, computed in the worker) printed as
# the observable draw.

gameRender : unsafe Int -> a .
gameRender me =
  m = receive me;
  (replyTo, q) = m;
  grMsg me replyTo q.
grMsg : unsafe Int -> Int -> Rv -> a .
grMsg me replyTo q = case q of
    Dims u -> send replyTo (32, 8) >> gameRender me
  | Render st vs sc fr -> grFrame me replyTo vs fr
  | Poll u -> send replyTo (0, 0, 0) >> gameRender me.
grFrame : unsafe Int -> Int -> List String -> Int -> a .
grFrame me replyTo vs fr =
  _ = grDraw vs fr;
  _ = send replyTo (1, grBytes vs 0);
  gameRender me.
grDraw vs fr = case vs of
    Nil -> 0
  | s :: r -> print "gr f{fr}: {s}" >> 0.
grBytes : unsafe List String -> Int -> Int .
grBytes vs n = case vs of
    Nil -> n
  | v :: r -> grBytes r (n + strlen v).

# ---- main ------------------------------------------------------------------

main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  render = spawn gameRender;
  inp = spawn (feed (105 :: 0 :: 105 :: 0 :: 106 :: 0 :: 16 :: 0 :: Nil));
  cfg = { env = 0, mt = mt, tick = 5000, input = inp, render = render };
  MV.game me cfg (App gInit gUpdate gSubs gView).

# ============================================================================
# dungeon.fpr -- the dungeon crawler (github.com/hyperswine/dungeon_game),
# a 2D JavaFX game, remade in pure FP-RISC on QOS: turn-based, top-down,
# with an angled camera that follows the player.
#
# THE TRANSLATION.  The Java original is a textbook OOP exercise -- an
# Entity inheritance tree, a CombatStrategy strategy, CombatDecorator
# decorators, a GoalComposite composite, JavaFX properties with change
# listeners, and a mutable Dungeon the controllers reach into.  None of
# that survives contact with a language where the model is one immutable
# value:
#
#   Entity subclasses          -> ONE `Th` sum type; behaviour is a `case`
#                                 in a pure function, not virtual dispatch
#   CombatStrategy (strategy)  -> `stanceOf m`, a pure function of state:
#                                 the stance IS what the model says it is
#   CombatDecorator (wrapper)  -> `statsOf m`, a fold of the live effects
#                                 into one derived record
#   GoalComposite (composite)  -> a recursive `Goal` type + `goalMet`,
#                                 which is what the pattern was imitating
#   BooleanProperty + listener -> derived every frame from the model; a
#                                 value that is a function of state is
#                                 never stored, so it cannot go stale
#   Dungeon mutation + probes  -> `step : Ev -> Model -> (Model, Cmds)`
#   Controllers                -> MVU update + subs (std.MVU, terra2's shape)
#
# WHAT IS KEPT.  Walls; boulders pushed onto floor switches; doors that
# open only to a matching key; portal pairs; treasure; a sword with five
# swings; an invincibility potion that makes contact lethal and sends the
# enemies running; a nuke that clears its neighbourhood; a taunt that
# pulls every enemy one step; the exit; enemies that pursue on every
# second player turn; and the AND/OR goal tree over exit / enemies /
# boulders / treasure.
#
# WHAT IS ASSUMED.  The Java enemy re-ran A* per move; here one BFS from
# the player each enemy turn gives every enemy an optimal step (and a
# flee step while the player is invincible) for less work and no ties
# broken by queue order.  Sprites become solids: the walker's cube,
# sphere, disc and coin.  Hyper-scroll/dungeon-pass, sound and the level
# editor are out; the level is built in code (`level0`).
#
# KEYS  arrows / WASD: step (and face) that way -- one turn each
#       space: interact with the tile you face (push, unlock, take, exit)
#       1-4: use inventory slot (potion, nuke, taunt, key)
#       R: restart   H: help   P: screenshot   Q: quit
#
#   make qos-app PROG=programs/dungeon.fpr
#   (cd ../qos && make portable-gl && ./qosp-gl --yes ../fp-risc/app.qa)
#   headless: xvfb-run -a ./qosp-gl ... with FPR_EVDEV=keys.evd
#   (qos/tests-host/dungeon-check.py drives a scripted run)
# ============================================================================
#: host gl
#: expect dungeon over

unsafe program.

MV = use "std/mvu".
GL = use "mods/glsvc".
S2 = use "mods/scene2d".
Fm = use "mods/fontm".
Core = use "mods/coreutil".
R = use "mods/dungeonrules".

App = MV.App.
MQuit = MV.MQuit.
ETick = MV.ETick.
EKey = MV.EKey.
STick = MV.STick.
SKeys = MV.SKeys.

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).
Box = S2.Box.
Lbl = S2.Lbl.
Row = S2.Row.
Col = S2.Col.
Pad = S2.Pad.
Gap = S2.Gap.
W = S2.W.
H = S2.H.
Bg = S2.Bg.
Fg = S2.Fg.
Bord = S2.Bord.
Fs = S2.Fs.
Round = S2.Round.
Shadow = S2.Shadow.
Bga = S2.Bga.
Center = S2.Center.
Mid = S2.Mid.
Grow = S2.Grow.


# ---- the rules, re-exported ---------------------------------------------------------------
# The shell renders and wires; every rule lives in mods/dungeonrules.fpr.
# These aliases are what let `case k of Wall -> ...` read the same here.
Wall = R.Wall.
Boulder = R.Boulder.
Switch = R.Switch.
Door = R.Door.
Portal = R.Portal.
Exit = R.Exit.
Treasure = R.Treasure.
Sword = R.Sword.
Potion = R.Potion.
Nuke = R.Nuke.
Taunt = R.Taunt.
Key = R.Key.
Ob = R.Ob.
En = R.En.
Bare = R.Bare.
Armed = R.Armed.
Untouchable = R.Untouchable.
Aura = R.Aura.

initModel = R.initModel.
goal0 = R.goal0.
cell = R.cell.
scTitle = R.scTitle.
scPlay = R.scPlay.
scWon = R.scWon.
scLost = R.scLost.
scHelp = R.scHelp.
stanceOf m = R.stanceOf m.
stanceName m = R.stanceName m.
goalMet m g = R.goalMet m g.
goalLines m g = R.goalLines m g.
lenOf xs = R.lenOf xs.
atOf obs x y = R.atOf obs x y.
hasKind ks k = R.hasKind ks k.
countKind obs k = R.countKind obs k.
dxOf d = R.dxOf d.
tickOf m = R.tick m.

# ---- the MVU four ------------------------------------------------------------------------
init env = initModel.

# the only command this game issues is the one that ends it.  The rules
# are silent; the SHELL is what speaks, printing a line whenever the
# recorded message changes -- which is also the headless transcript.
update env ev m =
  m2 = step ev m;
  m3 = announce m m2;
  case m3.quit of
    1 -> (m3, MQuit :: Nil)
  | q -> (m3, Nil).
announce m m2 | Core.strEq m.msg m2.msg = m2.
announce m m2 | Core.strEq m2.msg "" = m2.
announce m m2 =
  _ = print "[dungeon] {m2.msg}";
  overLine m2.
overLine m | m.screen == scWon =
  _ = print "[dungeon] WON in {m.turn} turns: {m.took} treasure, {lenOf m.ens} enemies left";
  m.
overLine m | m.screen == scLost =
  _ = print "[dungeon] DIED on turn {m.turn}";
  m.
overLine m = m.

step ETick m = tickOf m.
step (EKey k) m = R.enqueue m k.
step ev m = m.

subs m = STick R.tickMs :: SKeys :: Nil.

view m = (scene m, ui m, m.snap).

# ---- the 3D board ------------------------------------------------------------------------
# One cell is `cell` world units (mods/dungeonrules); the board is
# centred on the origin so the camera maths stays symmetric.
wx m x = x * cell - m.w * cell / 2.
wz m y = y * cell - m.h * cell / 2.

# EVERY colour in this program is MILLI (0..1000), on both the 3D walker
# and the 2D layer -- the first cut wrote 0..255 and the dungeon came out
# a coal mine.
sun = (900, 870, 800).
sky = (150, 160, 240).
ambient = (400, 420, 500).
lights = ((5000, 14000, 7000), sun) :: (sky, ambient) :: Nil.

floorCol = (520, 505, 610).
floorAlt = (455, 442, 545).
wallCol = (300, 285, 390).
wallTop = (670, 650, 780).
playerCol = (420, 745, 940).
enemyCol = (850, 360, 360).
boulderCol = (590, 550, 500).
switchOff = (470, 430, 275).
switchOn = (940, 805, 355).
doorCol = (690, 470, 260).
portalCol = (590, 430, 900).
goldCol = (960, 785, 315).
swordCol = (810, 840, 890).
potionCol = (430, 865, 670).
nukeCol = (940, 510, 275).
tauntCol = (900, 705, 940).
exitCol = (470, 920, 590).

scene m =
  es0 = groundEnts m Nil;
  es1 = tileEnts m 0 0 es0;
  es2 = obEnts m m.obs es1;
  es3 = enemyEnts m m.ens es2;
  es4 = playerEnts m es3;
  Scene Nil es4 lights (cameraOf m).

# the angled follow camera: behind and above the player, looking down at
# the tile they stand on.  This is the whole "top-down 3D" of the brief --
# a fixed pitch, no rotation, so the board never becomes disorienting.
# On the screens that are ABOUT the dungeon rather than played in it --
# title, won, lost -- the same rig pulls back onto the board's centre, so
# the level you just walked is what is behind the words.
cameraOf m | m.screen == scPlay = followCam m.
cameraOf m = wideCam m.
followCam m =
  x = m.camx - m.w * cell / 2;
  z = m.camz - m.h * cell / 2;
  ((x, 15500, z + 11500), (x, 0, z + 700), 1000).
wideCam m = ((0, 15500, 11500), (0, 0, 700), 1000).

groundEnts m es =
  Ent "plane" (0, 0 - 40, 0) 0 (60000, 100, 60000) (70, 70, 120) :: es.

# the floor: a checker so movement is legible, skipped under walls
tileEnts m x y es | y >= m.h = es.
tileEnts m x y es | x >= m.w = tileEnts m 0 (y + 1) es.
tileEnts m x y es | hasKind (atOf m.obs x y) Wall = tileEnts m (x + 1) y (wallEnt m x y es).
tileEnts m x y es =
  c = case (x + y) % 2 == 0 of True -> floorCol | False -> floorAlt;
  tileEnts m (x + 1) y
    (Ent "cube" (wx m x, 0, wz m y) 0 (cell - 40, 60, cell - 40) c :: es).
wallEnt m x y es =
  Ent "cube" (wx m x, 300, wz m y) 0 (cell, 700, cell) wallCol ::
  Ent "cube" (wx m x, 660, wz m y) 0 (cell - 60, 40, cell - 60) wallTop :: es.

obEnts m Nil es = es.
obEnts m (Ob k x y :: r) es = obEnts m r (obEnt m k x y es).
obEnt m Wall x y es = es.                        # drawn with the floor
obEnt m Boulder x y es =
  Ent "sphere" (wx m x, 330, wz m y) 0 (760, 760, 760) boulderCol :: es.
obEnt m Switch x y es =
  on = hasKind (atOf m.obs x y) Boulder;
  c = case on of True -> switchOn | False -> switchOff;
  Ent "disc" (wx m x, 70, wz m y) 0 (620, 40, 620) c :: es.
obEnt m (Door i) x y es =
  Ent "cube" (wx m x, 340, wz m y) 0 (cell - 120, 720, 260) (tintOf doorCol i) ::
  Ent "sphere" (wx m x + 240, 380, wz m y) 0 (120, 120, 120) goldCol :: es.
obEnt m (Portal i) x y es =
  a = m.ms / 4 % 6284;
  Ent "disc" (wx m x, 90, wz m y) a (740, 60, 740) portalCol ::
  Ent "disc" (wx m x, 130, wz m y) (6284 - a) (420, 60, 420) (825, 705, 1000) :: es.
obEnt m Exit x y es =
  Ent "disc" (wx m x, 80, wz m y) (m.ms / 8 % 6284) (800, 50, 800) exitCol ::
  Ent "cube" (wx m x, 420, wz m y) 0 (140, 700, 140) (785, 1000, 825) :: es.
obEnt m Treasure x y es =
  Ent "coin" (wx m x, 180 + bob m 0, wz m y) (m.ms / 3 % 6284) (420, 420, 420) goldCol :: es.
obEnt m Sword x y es =
  Ent "cube" (wx m x, 240, wz m y) (m.ms / 6 % 6284) (120, 520, 120) swordCol :: es.
obEnt m Potion x y es =
  Ent "sphere" (wx m x, 200 + bob m 300, wz m y) 0 (360, 440, 360) potionCol :: es.
obEnt m Nuke x y es =
  Ent "sphere" (wx m x, 200, wz m y) 0 (440, 440, 440) nukeCol :: es.
obEnt m Taunt x y es =
  Ent "cube" (wx m x, 210 + bob m 600, wz m y) (m.ms / 5 % 6284) (340, 340, 340) tauntCol :: es.
obEnt m (Key i) x y es =
  Ent "coin" (wx m x, 190 + bob m 900, wz m y) (m.ms / 4 % 6284) (300, 300, 300) (tintOf goldCol i) :: es.
# keyed things read apart at a glance without a second mesh: id 1 keeps
# the base colour, id 2 shifts toward violet
tintOf c 1 = c.
tintOf c i = (r, g, b) = c; (r - 40, g + 30, b + 60).
# a slow float, offset per item so the room does not pulse in unison
bob m o = sinM ((m.ms + o) / 3 % 6284) * 60 / 1000.

enemyEnts m Nil es = es.
enemyEnts m (En i x y hp :: r) es =
  k = case hp > 2 of True -> 1 | False -> 0;
  c = case k == 1 of True -> enemyCol | False -> (590, 275, 275);
  enemyEnts m r
    (Ent "cube" (wx m x, 300, wz m y) 0 (520, 620, 520) c ::
     Ent "sphere" (wx m x, 700, wz m y) 0 (400, 400, 400) c ::
     Ent "sphere" (wx m x, 60, wz m y) 0 (700, 20, 700) (0, 0, 0, 260) :: es).

playerEnts m es =
  x = wx m m.px;
  z = wz m m.py;
  c = case stanceOf m of
      Untouchable -> (980, 940, 550)
    | Aura -> (940, 630, 980)
    | s -> playerCol;
  (dx, dy) = dxOf m.dir;
  es1 = Ent "sphere" (x, 60, z) 0 (760, 20, 760) (0, 0, 0, 300) :: es;
  es2 = Ent "cube" (x, 320, z) 0 (560, 660, 560) c :: es1;
  es3 = Ent "sphere" (x, 760, z) 0 (440, 440, 440) (960, 880, 805) :: es2;
  # the nose: which way a step will go, so facing is never a guess
  es4 = Ent "cube" (x + dx * 340, 460, z + dy * 340) 0 (180, 180, 180) (1000, 1000, 1000) :: es3;
  ringEnts m x z es4.
# the invincibility ring, and the aura's wider one
ringEnts m x z es | m.invT > 0 =
  Ent "disc" (x, 40, z) (m.ms / 2 % 6284) (1100, 30, 1100) (980, 900, 470, 500) :: es.
ringEnts m x z es | m.auraT > 0 =
  Ent "disc" (x, 40, z) (m.ms / 2 % 6284) (1500, 30, 1500) (940, 590, 980, 420) :: es.
ringEnts m x z es = es.

# a milli-precision sine over milli-radians (Bhaskara), the same one
# terra2 uses -- there is no float in this program at all
sinM x =
  r = ((x % 6283) + 6283) % 6283;
  case r > 3142 of
    True -> 0 - sinM (r - 3142)
  | False -> 16 * r * (3142 - r) * 1000 / (5 * 3142 * 3142 - 4 * r * (3142 - r)).
cosM x = sinM (x + 1571).

# ---- the 2D layer ------------------------------------------------------------------------
uiW = 960.
uiH = 600.
ink = (930, 940, 960).
dim = (610, 640, 710).
accent = (940, 825, 470).
panel = (30, 32, 48, 880).
glass = (30, 32, 48, 620).       # the HUD reads over the board, not instead of it
scrim = (12, 12, 22, 560).       # a full-screen dim under the end cards
card  = (26, 28, 44, 900).

ui m | m.screen == scTitle = built (titleTree m).
ui m | m.screen == scHelp = built (helpTree m).
ui m | m.screen == scWon = built (overTree m "THE DUNGEON IS YOURS" exitCol).
ui m | m.screen == scLost = built (overTree m "YOU DIED" enemyCol).
ui m = built (playTree m).
built tree = (es, sl) = S2.buildW (uiW, uiH) tree; (es, S2.camAt uiH).

t s c f = Lbl (Fs f :: Fg c :: Nil) s.

# a full-screen scrim with one centred card on it: the same shape for
# the title, the keys and the two endings
sheet kids =
  Box (Col :: W uiW :: H uiH :: Center :: Mid :: Bga scrim :: Nil)
      (Box (Col :: Pad 30 :: Gap 12 :: Mid :: Round 16 :: Bga card :: Nil) kids :: Nil).

titleTree m =
  sheet (t "DUNGEON" ink 54 ::
         t "a turn-based crawl -- arrows or WASD to step, space to act" dim 17 ::
         t "press any key to begin, H for the keys" accent 17 :: Nil).

helpTree m =
  sheet (t "KEYS" ink 34 ::
         t "arrows / WASD   step and face" dim 18 ::
         t "space           push, unlock, take, exit" dim 18 ::
         t "1-4             use an inventory slot" dim 18 ::
         t "R restart   H help   P screenshot   Q quit" dim 18 ::
         t "" dim 10 ::
         t "any key to go back" accent 16 :: Nil).

overTree m title c =
  sheet (t title c 46 ::
         t "{m.turn} turns, {m.took} treasure, {lenOf m.ens} enemies left" dim 19 ::
         t "R to go again, Q to quit" accent 17 :: Nil).

# the HUD: a status strip along the top, the goal checklist on the left,
# the bag and the log along the bottom
playTree m =
  Box (Col :: W uiW :: H uiH :: Pad 12 :: Gap 10 :: Nil)
      (statusBar m ::
       Box (Row :: Grow :: Gap 10 :: Nil)
           (Box (Col :: W 250 :: Gap 10 :: Nil)
                (goalBox m :: Box (Col :: Grow :: Nil) Nil :: Nil) ::
            Box (Row :: Grow :: Nil) Nil :: Nil) ::
       bagBox m :: Nil).

statusBar m =
  Box (Row :: H 46 :: Pad 10 :: Gap 16 :: Mid :: Round 10 :: Bga panel :: Nil)
      (t "HP {m.hp}/5" (case m.hp > 2 of True -> ink | False -> enemyCol) 20 ::
       t "{stanceName m}" (stanceCol m) 18 ::
       t "turn {m.turn}" dim 17 ::
       t "treasure {m.took}" goldCol 17 ::
       t "enemies {lenOf m.ens}" dim 17 ::
       Box (Row :: Grow :: Nil) Nil ::
       t m.msg accent 17 :: Nil).
stanceCol m = case stanceOf m of
    Untouchable -> (250, 230, 120)
  | Aura -> (240, 160, 250)
  | Armed -> swordCol
  | Bare -> dim.

goalBox m =
  Box (Col :: W 250 :: Pad 10 :: Gap 3 :: Round 10 :: Bga glass :: Nil)
      (t "GOALS" ink 16 :: goalRows m (goalLines m goal0)).
goalRows m Nil = Nil.
goalRows m ((d, s, txt) :: r) =
  c = case Core.strEq s "[x]" of True -> exitCol | False -> dim;
  t "{indent d}{s} {txt}" c 14 :: goalRows m r.
indent 0 = "".
indent n = "  {indent (n - 1)}".

bagBox m =
  Box (Row :: H 56 :: Pad 10 :: Gap 10 :: Mid :: Round 10 :: Bga panel :: Nil)
      (t "BAG" dim 16 :: slotRow m m.inv 1).
slotRow m Nil n | n > 4 = Nil.
slotRow m Nil n = slotBox "{n}" "-" dim :: slotRow m Nil (n + 1).
slotRow m (k :: r) n = slotBox "{n}" (nameOf k) (colOf k) :: slotRow m r (n + 1).
slotBox n s c =
  Box (Row :: Pad 6 :: Gap 6 :: Mid :: Round 8 :: Bg (44, 46, 66) :: Nil)
      (t n dim 14 :: t s c 16 :: Nil).
nameOf Potion = "potion".
nameOf Nuke = "nuke".
nameOf Taunt = "taunt".
nameOf (Key i) = "key {i}".
nameOf k = "?".
colOf Potion = potionCol.
colOf Nuke = nukeCol.
colOf Taunt = tauntCol.
colOf (Key i) = goldCol.
colOf k = dim.

# ---- boot ---------------------------------------------------------------------------------
main =
  me = myself 0;
  clint = device "clint";
  mt = reg32 clint 49144;
  gl = spawn (GL.serve uiW uiH "dungeon" Nil);
  cfg = { env = 0, mt = mt, tick = 160000, input = gl, render = gl };
  r = MV.game me cfg (App init update subs view);
  _ = print "dungeon over";
  r.

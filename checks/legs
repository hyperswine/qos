== native JIT tier (hand-rolled x86-64/A64, no LLVM) == interpreter: f64 + i64 lattice
(
  cd "${FPRISC_ROOT}/sol/examples" &&
  A=$(SOL_GPU=0 timeout 120 "${FPRISC_ROOT}/fpr" sol dispatch.sol 2>/dev/null | grep -a checksum) &&
  B=$(SOL_JIT=0 timeout 300 "${FPRISC_ROOT}/fpr" sol dispatch.sol 2>/dev/null | grep -a checksum) &&
  C=$(SOL_GPU=0 timeout 120 "${FPRISC_ROOT}/fpr" sol handint.sol 2>/dev/null | grep -a checksum) &&
  D=$(SOL_JIT=0 timeout 300 "${FPRISC_ROOT}/fpr" sol handint.sol 2>/dev/null | grep -a checksum) &&
  if [ -n "$A" ] && [ "$A" = "$B" ] && [ -n "$C" ] && [ "$C" = "$D" ]; then
    echo "jit==interp (f64) and jit==interp (i64): $A / $C"
  else
    echo "JIT MISMATCH: [$A|$B] [$C|$D]"; false
  fi
)


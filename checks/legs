# checks/legs -- every leg of the sweep, in the order a serial run takes them.
#
#   == name                 starts a leg; the lines after it are its bash body
#   @ serial                keep it on the one serial lane (real windows, timing)
#   @ with previous         it uses what the leg above built: same tree, right after
#   @ expect fail -- why    it is red on main; the sweep reports it only if it passes
#
# A body runs in a subshell under `set -uo pipefail`, in a tree of its own
# (checks/prelude.sh).  Its exit status is the verdict, so chain required
# successes with && and end on the check, not on a diagnostic echo.
# `ran CMD` is for a stage whose status is not the verdict; `leg_skipped WHY`
# records a skip, which is not a pass.  ${CK_TMP} is the leg's scratch.
# Lines starting with `#` between legs are comments; a body line never
# starts with `== ` or `@ `.

== sweep verdicts: injected failures must fail the sweep
# The runner against a manifest whose verdicts are known (checks/selftest.legs),
# the real leg bodies against stubbed tools (tests/test_legs.py), and what a
# change reaches.  A wrong answer in any of these is silent in a real sweep.
# (A worker's tree has no .git, so files other legs generated count as leaves
# there: the kbdread count is only required to be a narrowing.)
python3 -m unittest discover -s tests -p test_legs.py &&
python3 -m unittest discover -s tests -p test_service_checks.py &&
rm -rf "${CK_TMP}/selftest" "${CK_TMP}/selftest-green" "${CK_TMP}/selftest-strict" &&
{ ./sweep --in-place --manifest checks/selftest.legs --timeout 3 --output "${CK_TMP}/selftest" > "${CK_TMP}/selftest.out" 2>/dev/null; [ $? -eq 1 ]; } &&
grep -q "^SWEEP: 6 passed, 4 failed, 1 skipped (of 11 legs run; 0 not run)" "${CK_TMP}/selftest.out" &&
grep -q "1 of the failures are expected .* 3 are new" "${CK_TMP}/selftest.out" &&
[ "$(grep -c "NEW FAILURE" "${CK_TMP}/selftest.out")" = 3 ] &&
grep -q "NOW PASSES: expected red, but passes" "${CK_TMP}/selftest.out" &&
grep -q "1 leg(s) skipped, which is not a pass" "${CK_TMP}/selftest.out" &&
grep -q "^timeout .*outlives its deadline" "${CK_TMP}/selftest.out" &&
./sweep --in-place --manifest checks/selftest.legs --only "passes" --only "red as expected" --output "${CK_TMP}/selftest-green" > "${CK_TMP}/selftest-green.out" 2>/dev/null &&
grep -q "0 are new" "${CK_TMP}/selftest-green.out" &&
{ ./sweep --in-place --strict --manifest checks/selftest.legs --only "skips" --output "${CK_TMP}/selftest-strict" >/dev/null 2>&1; [ $? -eq 1 ]; } &&
./sweep --list --changed docs/2026-01-01-X.md 2>/dev/null | grep "^sweep: 0 of" >/dev/null &&
./sweep --list --changed programs/mods/editapp.fpr 2>/dev/null | grep "reaches every leg" >/dev/null &&
./sweep --list --changed tools/mkqa.py 2>/dev/null | grep "a makefile names it" >/dev/null &&
./sweep --list --changed tests/no-such-test.fpr 2>/dev/null | grep "no leg names it" >/dev/null &&
./sweep --list --changed tests/kbdread.fpr 2>/dev/null | grep "tests/kbdread.fpr: [0-9]* leg(s)" >/dev/null &&
./sweep --list --changed tests/appsession.fpr 2>/dev/null | grep "Main Profile" >/dev/null


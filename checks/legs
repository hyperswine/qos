== sol as a text tool: grep/sed/awk/sort/uniq/regex/pipe/sh in Sol over one sample (${FPRISC_ROOT}/sol/scripts/text, ${FPRISC_ROOT}/docs/SOL-TEXT.md)
(T=${FPRISC_ROOT}/sol/scripts/text && [ "$(${FPRISC_ROOT}/fpr sol $T/grep.sol ERROR $T/sample.log 2>/dev/null | wc -l | tr -d ' ')" = 3 ] && [ "$(${FPRISC_ROOT}/fpr sol $T/sed.sol p 3 5 $T/sample.log 2>/dev/null | wc -l | tr -d ' ')" = 3 ] && ${FPRISC_ROOT}/fpr sol $T/sed.sol s took= t= $T/sample.log 2>/dev/null | grep >/dev/null -c "t=340ms" && [ "$(${FPRISC_ROOT}/fpr sol $T/sed.sol d INFO $T/sample.log 2>/dev/null | wc -l | tr -d ' ')" = 5 ] && [ "$(${FPRISC_ROOT}/fpr sol $T/awk.sol sum 4 $T/staff.txt 2>/dev/null)" = 6 ] && ${FPRISC_ROOT}/fpr sol $T/awk.sol count 3 $T/staff.txt 2>/dev/null | tr '\n' ' ' | grep >/dev/null -c "admin 2 staff 2" && ${FPRISC_ROOT}/fpr sol $T/sortuniq.sol uniqc $T/staff.txt 2>/dev/null | sed -n 1,1p | grep >/dev/null -c "^1 ana" && [ "$(${FPRISC_ROOT}/fpr sol $T/rx.sol -o 'took=\d+' $T/sample.log 2>/dev/null | tr '\n' ' ')" = "took=340 took=12 took=9 took=910 " ] && [ "$(cat $T/sample.log | ${FPRISC_ROOT}/fpr sol $T/stdin.sol WARN 2>/dev/null | wc -l | tr -d ' ')" = 2 ] && ${FPRISC_ROOT}/fpr sol $T/shell.sol $T 2>/dev/null | grep >/dev/null -Ec "^[0-9]+ entries$" && echo "grep -n, sed p/s/d, awk sum/count, sort|uniq -c, grep -oE (a regex in Sol), a pipe filter and ls -l parsed: all as Sol scripts")


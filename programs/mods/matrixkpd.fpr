# matrixkpd.fpr -- a 4x4 matrix keypad scan over ANY pin surface.
# The pin functions arrive as VALUES (pinW n v / pinR n), so the same
# module drives raw Pin.* in a test, System.qa's capability-gated
# svcPin* in a service, or a remote pin fabric later.  The pin MAP
# (rows, cols) is data too: reconfiguring which pad does what while
# running is just calling scan with a different map.
# keys: rows x cols = "123A / 456B / 789C / *0#D"
nth1 : unsafe List Int -> Int -> Int .
nth1 xs i = case xs of Nil -> 0 - 1 | x :: r -> case i == 1 of True -> x | False -> nth1 r (i - 1).
keyAt r c = charAt "123A456B789C*0#D" ((r - 1) * 4 + c).

# drive one row high, look for a high column; -> key ASCII | 0
scan pinW pinR rows cols = scGo pinW pinR rows cols 1.
scGo : unsafe (Int -> Int -> v285) -> (Int -> Int) -> List Int -> List Int -> Int -> Int .
scGo pinW pinR rows cols r =
  case r > 4 of
    True -> 0
  | False -> scRow pinW pinR rows cols r.
scRow : unsafe (Int -> Int -> w285) -> (Int -> Int) -> List Int -> List Int -> Int -> Int .
scRow pinW pinR rows cols r =
  _ = pinW (nth1 rows r) 1;
  k = scCols pinR cols r 1;
  _ = pinW (nth1 rows r) 0;
  case k == 0 of
    True -> scGo pinW pinR rows cols (r + 1)
  | False -> k.
scCols : unsafe (Int -> Int) -> List Int -> Int -> Int -> Int .
scCols pinR cols r c =
  case c > 4 of
    True -> 0
  | False -> scCol pinR cols r c.
scCol : unsafe (Int -> Int) -> List Int -> Int -> Int -> Int .
scCol pinR cols r c =
  case pinR (nth1 cols c) == 1 of
    True -> keyAt r c
  | False -> scCols pinR cols r (c + 1).

# set up directions once for a map
init pinM rows cols =
  _ = eachM pinM rows 1;
  eachM0 pinM cols.
eachM : unsafe (a286 -> z285 -> b286) -> List a286 -> z285 -> Unit .
eachM pinM ps m = case ps of Nil -> Unit | p :: r -> pinM p m >> eachM pinM r m.
eachM0 : unsafe (c286 -> Int -> d286) -> List c286 -> Unit .
eachM0 pinM ps = case ps of Nil -> Unit | p :: r -> pinM p 0 >> eachM0 pinM r.

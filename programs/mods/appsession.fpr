# Shared transport/lifecycle mechanics. App update/view functions stay named
# in their own modules: this module never accepts an application callback.
unsafe module.
CP = use "apppolicy".
AW = use "appwire".
AJ = use "appjobs".
L = use "shelllayout".
AC = use "std/actor#2de24bf2bdd5cb87".
TC = use "timedcall".
Inbox = Type (Message (Int, Int) AW.Request | JobResult Int (Result AW.Snapshot String) | Idle | Gone).
start me = case bootstrap (AC.nowMs Unit + CP.bootstrapReceiveMs) me of
    Err why -> Err why
  | Ok request -> begin me request.
begin me request =
  (parent, id, (magic, schema, payload)) = request;
  if magic != AW.magic or schema != AW then
    _ = AC.reply (parent, id) ("refused", AW, 0); Err "startup refused"
  else beginPayload me parent id payload.
beginPayload me parent id payload =
  (session, (w, h), (ns, storage, policies, appId)) = payload;
  case session > 0 and L.valid w h of
    False -> _ = AC.reply (parent, id) ("refused", AW, 0); Err "startup refused"
  | True ->
      worker = spawn (AJ.runScoped policies appId me ns storage);
      ctx = {appId = appId, parent = parent, session = session, worker = worker, policies = policies, ns = ns, storage = storage, w = w, h = h, revision = 1, sequence = 0};
      case AC.reply (parent, id) (AW.magic, AW, session) of
        Err why -> _ = finish me ctx; Err "startup refused"
      | Ok u -> Ok ctx.
next me ctx = if not (Sys.alive ctx.parent) then Gone else case receiveFromNow me ctx.parent of
    Ok borrowed ->
      owned = keep borrowed;
      _ = drop borrowed;
      (from, id, request) = owned;
      Message (from, id) request
  | Err why -> case receiveFromNow me ctx.worker of
      Ok borrowed ->
        owned = keep borrowed;
        _ = drop borrowed;
        (case owned of (id, AW.Completed token result) -> JobResult token result | other -> Idle)
    | Err why -> if Sys.alive ctx.parent then
        if Sys.alive ctx.worker then selfResult me else Gone
        else Gone.
# Nothing to do this turn: park until a message reaches the app's mailbox
# or 16 ms pass (Sys.waitInbox, hal/timed_receive.c), so a request, input
# or job result is handled the moment it arrives instead of up to 16 ms
# later.  The deadline still paces the liveness checks in `next` (a parent
# or worker that ends sends nothing).  When the inbox was already non-empty
# (a message `next` does not take) or the wait is unavailable, it naps the
# 16 ms as before: never a spin.
idleMs = 16.
idle me = case Sys.waitInbox me (AC.nowMs Unit + idleMs) of
    2 -> Unit
  | other -> Sys.sleepUs (idleMs * 1000).
valid ctx session sequence = session == ctx.session and sequence > ctx.sequence.
advance ctx sequence = {ctx | revision = ctx.revision + 1, sequence = sequence}.
resized ctx (AW.Resize w h) = if L.valid w h then {ctx | w = w, h = h} else ctx.
resized ctx other = ctx.
issue me ctx Nil = Unit.
issue me ctx (AW.Fetch token job :: rest) =
  _ = case send ctx.worker (me, Sys.nextId Unit, AW.Read token job) of
    Ok u -> Unit
  | Err why -> _ = send me (token, AW.Completed token (Err "app worker: {why}")); Unit;
  issue me ctx rest.
finish me ctx = case CP.current me ctx.policies of
    Err why -> _ = kill ctx.worker; Err "worker forced stop; {why}"
  | Ok snapshot -> finishWithin (CP.workerStopMs (CP.recovery (CP.policy snapshot))) (intMax Unit) me ctx.
finishWithin stopMs until me ctx =
  deadline = case AC.deadlineAfter stopMs of Ok d -> if d < until then d else until | Err why -> AC.nowMs Unit;
  result = case TC.callUntil deadline me ctx.worker AW.Stop of
      Err why -> Err "worker forced stop: {why}"
    | Ok (AW.Stopped result) -> result
    | Ok other -> Err "invalid worker stop acknowledgement";
  _ = kill ctx.worker;
  result.
close me ctx ret session = if session != ctx.session then
    _ = AC.reply ret (AW.Refused "stale session"); True
  else result = finish me ctx; _ = AC.reply ret (AW.Closed session result); False.
closeWithin until stopMs me ctx ret session = case session == ctx.session of
    False -> _ = AC.reply ret (AW.Refused "stale session"); True
  | True ->
      # Closing: no more updates or reads are admitted while awaiting Stop.
      result = finishWithin stopMs until me ctx;
      _ = AC.reply ret (AW.Closed session result);
      False.

selfResult me = case receiveFromNow me me of
    Ok borrowed ->
      owned = keep borrowed;
      _ = drop borrowed;
      (case owned of (id, AW.Completed token result) -> JobResult token result | other -> Idle)
  | other -> Idle.

# the startup request: the first message, or the startup deadline.  It
# parks on the mailbox (Sys.waitInbox); a plane process, which has no timed
# wait until the fprisc pin bump, naps 100 us between looks as before.
bootstrap deadline me = if AC.nowMs Unit >= deadline then Err "startup deadline exceeded" else
  case receiveNow me of
    Ok borrowed -> owned = keep borrowed; _ = drop borrowed; Ok owned
  | Err why -> _ = bootWait deadline me; bootstrap deadline me.
bootWait deadline me = case Sys.waitInbox me deadline of
    0 -> AC.napUntil deadline
  | other -> Unit.

abandon me ctx = case finish me ctx of
    Ok u -> Unit
  | Err why -> _ = Sys.logAt 2 "app owner ended; {why}"; Unit.

# Standard MVU actor loop for desktop apps without custom control/preference
# sidecars. Keeps transport, sequencing, worker dispatch, and shutdown in one place.
run me initVal updateFn viewFn = case start me of
    Err why -> Unit
  | Ok ctx ->
      (initial, commands) = initVal;
      (model, ignored) = updateFn (AW.Resize ctx.w ctx.h) initial;
      _ = issue me ctx commands;
      _ = Sys.loop (ctx, model) (runStep me updateFn viewFn); Unit.
runStep me updateFn viewFn state =
  (ctx, model) = state;
  case next me ctx of
    Idle -> _ = idle me; (True, state)
  | Gone -> _ = abandon me ctx; (False, state)
  | JobResult token result ->
      (fresh, commands) = updateFn (AW.Arrived token result) model;
      _ = issue me ctx commands;
      (True, (advance ctx ctx.sequence, fresh))
  | Message ret request -> case request of
      AW.CloseWith session until stopMs -> (closeWithin until stopMs me ctx ret session, state)
    | AW.Close session -> (close me ctx ret session, state)
    | AW.Event session sequence event -> case valid ctx session sequence of
        False -> _ = AC.reply ret (AW.Refused "stale session or sequence"); (True, state)
      | True ->
          nextCtx = advance (resized ctx event) sequence;
          (fresh, commands) = updateFn event model;
          _ = issue me nextCtx commands;
          (tree, vals) = viewFn (nextCtx.w, nextCtx.h) fresh;
          _ = AC.reply ret (AW.Frame nextCtx.session nextCtx.revision tree vals (AW.status fresh.phase));
          (True, (nextCtx, fresh)).

# Shared transport/lifecycle mechanics. App update/view functions stay named
# in their own modules: this module never accepts an application callback.
unsafe module.
CP = use "apppolicy".
AW = use "appwire".
AJ = use "appjobs".
L = use "shelllayout".
AC = use "std/actor#201a0e9bf98a5154".
Inbox = Type (Message (Int, Int) AW.Request | JobResult Int (Result AW.Snapshot String) | Idle | Gone).
start me = case bootstrap (AC.nowUs Unit + CP.bootstrapReceiveMs * 1000) me of
    Err why -> Err why
  | Ok request -> begin me request.
begin me request =
  (parent, id, (magic, schema, payload)) = request;
  if magic != AW.magic or schema != AW then
    _ = AC.reply (parent, id) ("refused", AW, 0); Err "startup refused"
  else beginPayload me parent id payload.
beginPayload me parent id payload =
  (session, (w, h), (ns, storage, policies)) = payload;
  case session > 0 and L.valid w h of
    False -> _ = AC.reply (parent, id) ("refused", AW, 0); Err "startup refused"
  | True ->
      worker = spawn (AJ.runWithPolicies policies me ns storage);
      ctx = {parent = parent, session = session, worker = worker, policies = policies, w = w, h = h, revision = 1, sequence = 0};
      case AC.reply (parent, id) (AW.magic, AW, session) of
        Err why -> _ = finish me ctx; Err "startup refused"
      | Ok u -> Ok ctx.
next me ctx = if not (Sys.alive ctx.parent) then Gone else case receiveFromNow me ctx.parent of
    Ok borrowed ->
      owned = keep borrowed;
      _ = drop borrowed;
      (from, id, request) = owned;
      Message (from, id) request
  | Err why -> case receiveFromNow me ctx.worker of
      Ok borrowed ->
        owned = keep borrowed;
        _ = drop borrowed;
        (case owned of (id, AW.Completed token result) -> JobResult token result | other -> Idle)
    | Err why -> if Sys.alive ctx.parent then
        if Sys.alive ctx.worker then selfResult me else Gone
        else Gone.
valid ctx session sequence = session == ctx.session and sequence > ctx.sequence.
advance ctx sequence = {ctx | revision = ctx.revision + 1, sequence = sequence}.
resized ctx (AW.Resize w h) = if L.valid w h then {ctx | w = w, h = h} else ctx.
resized ctx other = ctx.
issue me ctx Nil = Unit.
issue me ctx (AW.Fetch token job :: rest) =
  _ = case send ctx.worker (me, Sys.nextId Unit, AW.Read token job) of
    Ok u -> Unit
  | Err why -> _ = send me (token, AW.Completed token (Err "app worker: {why}")); Unit;
  issue me ctx rest.
finish me ctx = case CP.current me ctx.policies of
    Err why -> _ = kill ctx.worker; Err "worker forced stop; {why}"
  | Ok snapshot -> finishWithin (CP.workerStopMs (CP.recovery (CP.policy snapshot))) (intMax Unit) me ctx.
finishWithin stopMs until me ctx =
  deadline = case AC.deadlineAfter stopMs of Ok d -> if d < until then d else until | Err why -> AC.nowUs Unit;
  result = case AC.callUntil deadline me ctx.worker AW.Stop of
      Err why -> Err "worker forced stop: {why}"
    | Ok (AW.Stopped result) -> result
    | Ok other -> Err "invalid worker stop acknowledgement";
  _ = kill ctx.worker;
  result.
close me ctx ret session = if session != ctx.session then
    _ = AC.reply ret (AW.Refused "stale session"); True
  else result = finish me ctx; _ = AC.reply ret (AW.Closed session result); False.
closeWithin until stopMs me ctx ret session = case session == ctx.session of
    False -> _ = AC.reply ret (AW.Refused "stale session"); True
  | True ->
      # Closing: no more updates or reads are admitted while awaiting Stop.
      result = finishWithin stopMs until me ctx;
      _ = AC.reply ret (AW.Closed session result);
      False.

selfResult me = case receiveFromNow me me of
    Ok borrowed ->
      owned = keep borrowed;
      _ = drop borrowed;
      (case owned of (id, AW.Completed token result) -> JobResult token result | other -> Idle)
  | other -> Idle.

bootstrap deadline me = if AC.nowUs Unit >= deadline then Err "startup deadline exceeded" else
  case receiveNow me of
    Ok borrowed -> owned = keep borrowed; _ = drop borrowed; Ok owned
  | Err why -> _ = AC.napUntil deadline; bootstrap deadline me.

abandon me ctx = case finish me ctx of
    Ok u -> Unit
  | Err why -> _ = Sys.logAt 2 "app owner ended; {why}"; Unit.

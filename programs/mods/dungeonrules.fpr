# ============================================================================
# mods/dungeonrules.fpr -- the dungeon's RULES: the whole game as pure
# functions over one immutable model, with no renderer, no actors and no
# IO anywhere in the file.
#
# This is the half of the Java original (github.com/hyperswine/dungeon_game)
# that was spread across a mutable `Dungeon`, an `Entity` inheritance
# tree, JavaFX property listeners and four controllers.  Keeping it
# separate from the shell is not tidiness: it is what lets
# tests/dungeon.fpr play a scripted game and assert the outcome without
# a GPU, a window or a frame loop -- the rules are a function, so the
# test just calls it.
#
#   the model      one record: the board, the player, the enemies, the bag
#   a turn         `key m k` -> a new model; nothing is mutated
#   the goal       a recursive value folded by `goalMet`
#   messages       recorded in `msg`/`log`; the SHELL decides to print
#
# programs/dungeon.fpr is the shell: MVU wiring, the 3D scene, the HUD.
# ============================================================================
unsafe module.

# ---- the world's vocabulary -------------------------------------------------------------
# One type for everything that sits on a tile.  The Java version had a
# class per row of this list and a virtual `interact`; here the variants
# are data and every rule that used to be a method is a function that
# pattern-matches.  `arg` carries a door/key/portal id -- 0 where the
# variant has no id.
Th = Type (Wall | Boulder | Switch | Door id | Portal id | Exit
         | Treasure | Sword | Potion | Nuke | Taunt | Key id).

# a thing on the board: (kind, x, y).  The player's inventory holds the
# same `Th` values, which is why picking something up is a list move.
Ob = Type (Ob kind x y).

# the recursive goal tree -- the Composite pattern's actual shape.
# GAll/GAny are the AND/OR nodes; the leaves are the four win conditions.
Goal = Type (GExit | GEnemies | GBoulders | GTreasure
           | GAll goals | GAny goals).

# what the player is fighting as, derived (never stored)
Stance = Type (Bare | Armed | Untouchable | Aura).

# an enemy: (id, x, y, hp)
En = Type (En id x y hp).

dirUp = 0.
dirDown = 1.
dirLeft = 2.
dirRight = 3.

scTitle = 0.
scPlay = 1.
scWon = 2.
scLost = 3.
scHelp = 4.

# ---- the level --------------------------------------------------------------------------
# Built in code rather than parsed from the Java project's JSON: the same
# room shapes, one screen wide, with every mechanic on the board at once.
# `#` wall, `.` floor, `B` boulder, `S` switch, `D`/`d` doors 1/2,
# `K`/`k` keys 1/2, `P`/`p` portal pair 1, `T` treasure, `W` sword,
# `I` potion, `N` nuke, `U` taunt, `E` exit, `@` player, `M` enemy.
levelW = 19.
levelH = 13.
level0 =
  "###################" ::
  "#@..T....#....M...#" ::
  "#....#...#...####.#" ::
  "#.W..#.K.D....#...#" ::
  "#....#...#....#.T.#" ::
  "####.#####....#...#" ::
  "#..S.....#..I.#####" ::
  "#..B.....#........#" ::
  "#........#.M..N.P.#" ::
  "#..S.B...d........#" ::
  "#........#####.####" ::
  "#.k..M.U.#..T.p..E#" ::
  "###################" :: Nil.

# the goal: collect every treasure AND put a boulder on every switch,
# OR simply neutralise every enemy -- then reach the exit either way.
goal0 = GAll (GAny (GAll (GTreasure :: GBoulders :: Nil) :: GEnemies :: Nil)
              :: GExit :: Nil).

# ---- reading the level into the model ---------------------------------------------------
charAtOf s i = charAt s i.

rowsOf Nil y acc = acc.
rowsOf (r :: rest) y acc = rowsOf rest (y + 1) (cellsOf r 1 y acc).

cellsOf r i y acc | i > strlen r = acc.
cellsOf r i y acc = cellsOf r (i + 1) y (cellOf (charAt r i) (i - 1) y acc).

# acc = (obs, enemies, px, py, nextEnemyId)
cellOf c x y acc =
  (obs, ens, px, py, nid) = acc;
  case c == 35 of                                  # '#'
    True -> (Ob Wall x y :: obs, ens, px, py, nid)
  | False -> cellOf2 c x y acc.
cellOf2 c x y acc =
  (obs, ens, px, py, nid) = acc;
  case c == 64 of                                  # '@'
    True -> (obs, ens, x, y, nid)
  | False -> (case c == 77 of                      # 'M'
        True -> (obs, En nid x y 4 :: ens, px, py, nid + 1)
      | False -> (thingOf c x y obs, ens, px, py, nid)).
thingOf c x y obs = case kindOf c of
    Nil -> obs
  | k :: _ -> Ob k x y :: obs.
# the character table: one place where the level's alphabet is defined
kindOf c | c == 66 = Boulder :: Nil.                # B
kindOf c | c == 83 = Switch :: Nil.                 # S
kindOf c | c == 68 = Door 1 :: Nil.                 # D
kindOf c | c == 100 = Door 2 :: Nil.                # d
kindOf c | c == 75 = Key 1 :: Nil.                  # K
kindOf c | c == 107 = Key 2 :: Nil.                 # k
kindOf c | c == 80 = Portal 1 :: Nil.               # P
kindOf c | c == 112 = Portal 1 :: Nil.              # p
kindOf c | c == 84 = Treasure :: Nil.               # T
kindOf c | c == 87 = Sword :: Nil.                  # W
kindOf c | c == 73 = Potion :: Nil.                 # I
kindOf c | c == 78 = Nuke :: Nil.                   # N
kindOf c | c == 85 = Taunt :: Nil.                  # U
kindOf c | c == 69 = Exit :: Nil.                   # E
kindOf c = Nil.

initModel =
  (obs, ens, px, py, nid) = rowsOf level0 0 (Nil, Nil, 1, 1, 1);
  { w = levelW, h = levelH,
    obs = obs, ens = ens,
    px = px, py = py, dir = dirRight, hp = 5,
    inv = Nil, swings = 0, invT = 0, auraT = 0,
    took = 0,                       # treasure collected
    turn = 0, screen = scTitle, log = Nil, keys = Nil,
    # the camera starts where it will settle, not on the player: it eases
    # a sixth of the way per tick, and easing in from a corner would open
    # the first second of the game onto the void outside the board
    camx = clampI (px * cell) (camMx * cell) ((levelW - 1 - camMx) * cell),
    camz = clampI (py * cell) (camMzN * cell) ((levelH - 1 - camMzS) * cell),
    ms = 0, snap = 0, over = 0, quit = 0, msg = "" }.

# ---- pure queries over the board --------------------------------------------------------
# What the Java `DungeonProbe` did with getEntityAtCoords, as folds.
atOf Nil x y = Nil.
atOf (Ob k ox oy :: r) x y | ox == x and oy == y = k :: atOf r x y.
atOf (Ob k ox oy :: r) x y = atOf r x y.

hasKind Nil k = False.
hasKind (a :: r) k = case sameKind a k of True -> True | False -> hasKind r k.

# structural equality on the parts we branch on (ids included)
sameKind Wall Wall = True.
sameKind Boulder Boulder = True.
sameKind Switch Switch = True.
sameKind Exit Exit = True.
sameKind Treasure Treasure = True.
sameKind Sword Sword = True.
sameKind Potion Potion = True.
sameKind Nuke Nuke = True.
sameKind Taunt Taunt = True.
sameKind (Door a) (Door b) = a == b.
sameKind (Portal a) (Portal b) = a == b.
sameKind (Key a) (Key b) = a == b.
sameKind a b = False.

# a tile the player or an enemy may stand on
blocked m x y | x < 0 or y < 0 or x >= m.w or y >= m.h = True.
blocked m x y = blockedBy (atOf m.obs x y).
blockedBy Nil = False.
blockedBy (Wall :: r) = True.
blockedBy (Boulder :: r) = True.
blockedBy (Door i :: r) = True.
blockedBy (k :: r) = blockedBy r.

enemyAt Nil x y = Nil.
enemyAt (En i ex ey hp :: r) x y | ex == x and ey == y = En i ex ey hp :: Nil.
enemyAt (En i ex ey hp :: r) x y = enemyAt r x y.

# ---- the strategy and decorator patterns, as functions ----------------------------------
# The Java code chose a CombatStrategy object and wrapped it in
# decorators; the stance is simply what the model already says, and the
# stats are a fold over the live effects.  No object, no wrapping, no
# way for the two to disagree.
stanceOf m | m.invT > 0 = Untouchable.
stanceOf m | m.auraT > 0 = Aura.
stanceOf m | m.swings > 0 = Armed.
stanceOf m = Bare.

# (damage dealt, damage taken multiplier as a percent, aura radius)
statsOf m = case stanceOf m of
    Untouchable -> (99, 0, 0)
  | Aura -> (3, 100, 1)
  | Armed -> (3, 100, 0)
  | Bare -> (1, 100, 0).

stanceName m = case stanceOf m of
    Untouchable -> "INVINCIBLE"
  | Aura -> "AURA"
  | Armed -> "SWORD"
  | Bare -> "BARE".

# ---- the goal tree, folded ---------------------------------------------------------------
# The composite's `isComplete()` recursion, as one function over a value.
goalMet m GExit = m.over == 1.
goalMet m GEnemies = lenOf m.ens == 0.
goalMet m GTreasure = countKind m.obs Treasure == 0.
goalMet m GBoulders = allSwitchesOn m m.obs.
goalMet m (GAll gs) = allMet m gs.
goalMet m (GAny gs) = anyMet m gs.
allMet m Nil = True.
allMet m (g :: r) = case goalMet m g of True -> allMet m r | False -> False.
anyMet m Nil = False.
anyMet m (g :: r) = case goalMet m g of True -> True | False -> anyMet m r.

# every switch carries a boulder
allSwitchesOn m Nil = True.
allSwitchesOn m (Ob Switch x y :: r) =
  case hasKind (atOf m.obs x y) Boulder of
    True -> allSwitchesOn m r
  | False -> False.
allSwitchesOn m (o :: r) = allSwitchesOn m r.

countKind Nil k = 0.
countKind (Ob a x y :: r) k =
  case sameKind a k of True -> 1 + countKind r k | False -> countKind r k.

lenOf Nil = 0.
lenOf (x :: r) = 1 + lenOf r.

# the goal tree rendered as the Java version's checklist, one line a leaf
goalLines m g = goalGo m g 0.
goalGo m g d = case g of
    GAll gs -> line d (mark m g) "all of:" :: goalKids m gs (d + 1)
  | GAny gs -> line d (mark m g) "any of:" :: goalKids m gs (d + 1)
  | GExit -> line d (mark m g) "reach the exit" :: Nil
  | GEnemies -> line d (mark m g) "no enemies left ({lenOf m.ens})" :: Nil
  | GBoulders -> line d (mark m g) "boulders on switches" :: Nil
  | GTreasure -> line d (mark m g) "all treasure ({m.took}/{m.took + countKind m.obs Treasure})" :: Nil.
goalKids m Nil d = Nil.
goalKids m (g :: r) d = goalGo m g d + goalKids m r d.
mark m g = case goalMet m g of True -> "[x]" | False -> "[ ]".
line d s t = (d, s, t).

# ---- the turn ----------------------------------------------------------------------------
# One player action = one turn.  Enemies act on every second turn, which
# is the Java `playerMoveTally % 2` rule kept verbatim.
stepDir dirUp0 = (0, 0 - 1).
dxOf d | d == dirUp = (0, 0 - 1).
dxOf d | d == dirDown = (0, 1).
dxOf d | d == dirLeft = (0 - 1, 0).
dxOf d = (1, 0).

# walk: face that way, then move if the tile allows it; walking into an
# enemy is an attack, which is how the original played too
walk m d =
  (dx, dy) = dxOf d;
  nx = m.px + dx;
  ny = m.py + dy;
  m1 = { m | dir = d };
  case enemyAt m1.ens nx ny of
    En i ex ey hp :: _ -> endTurn (hitEnemy m1 i nx ny)
  | Nil -> (case blocked m1 nx ny of
        True -> endTurn (say m1 "blocked")
      | False -> endTurn (arrive { m1 | px = nx, py = ny })).

# stepping onto a tile: portals move you on, floor items are picked up
arrive m =
  ks = atOf m.obs m.px m.py;
  m1 = takeAll m ks;
  portalOf m1 (atOf m1.obs m1.px m1.py).
portalOf m Nil = m.
portalOf m (Portal i :: r) = jump m i.
portalOf m (k :: r) = portalOf m r.
# the paired portal with the same id, anywhere else on the board
jump m i = jumpTo m i m.obs.
jumpTo m i Nil = m.
jumpTo m i (Ob (Portal j) x y :: r) | j == i and (x != m.px or y != m.py) =
  say { m | px = x, py = y } "the portal pulls you through".
jumpTo m i (o :: r) = jumpTo m i r.

# picking things up: treasure counts, a sword arms you, the rest goes in
# the bag.  Each is removed from the board, which is a list filter.
takeAll m Nil = m.
takeAll m (k :: r) = takeAll (takeOne m k) r.
takeOne m Treasure =
  say { m | obs = without m.obs Treasure m.px m.py, took = m.took + 1 } "treasure".
takeOne m Sword =
  say { m | obs = without m.obs Sword m.px m.py, swings = 5 } "a sword: five swings".
takeOne m Potion = bag m Potion "an invincibility potion".
takeOne m Nuke = bag m Nuke "a nuke".
takeOne m Taunt = bag m Taunt "a taunt".
takeOne m (Key i) = bag m (Key i) "key {i}".
takeOne m k = m.
bag m k what =
  say { m | obs = without m.obs k m.px m.py, inv = m.inv + (k :: Nil) } "picked up {what}".

without Nil k x y = Nil.
without (Ob a ox oy :: r) k x y | ox == x and oy == y and sameKind a k = without r k x y.
without (Ob a ox oy :: r) k x y = Ob a ox oy :: without r k x y.

# ---- interacting with the tile you face --------------------------------------------------
# The Java `interactWithEntityFacing`: one method per subclass, here one
# `case` over the things on that tile.
interact m =
  (dx, dy) = dxOf m.dir;
  x = m.px + dx;
  y = m.py + dy;
  endTurn (actOn m (atOf m.obs x y) x y).
actOn m Nil x y = say m "nothing there".
actOn m (Boulder :: r) x y = push m x y.
actOn m (Door i :: r) x y = unlock m i x y.
actOn m (Exit :: r) x y = { m | over = 1, msg = "the exit!" }.
actOn m (k :: r) x y = actOn m r x y.

# a boulder moves one tile further in the same direction, if that tile is
# clear -- and a switch under it is what the BOULDERS goal reads
push m x y =
  (dx, dy) = dxOf m.dir;
  nx = x + dx;
  ny = y + dy;
  case blocked m nx ny or lenOf (enemyAt m.ens nx ny) > 0 of
    True -> say m "the boulder will not budge"
  | False -> say { m | obs = moveOb m.obs Boulder x y nx ny } "you heave the boulder".
moveOb Nil k x y nx ny = Nil.
moveOb (Ob a ox oy :: r) k x y nx ny | ox == x and oy == y and sameKind a k =
  Ob a nx ny :: moveOb r k x y nx ny.
moveOb (Ob a ox oy :: r) k x y nx ny = Ob a ox oy :: moveOb r k x y nx ny.

# a door opens only to the key with its id; the key stays in the bag,
# exactly as the Java version kept it
unlock m i x y = case hasKind m.inv (Key i) of
    True -> say { m | obs = without m.obs (Door i) x y } "key {i} turns the lock"
  | False -> say m "locked -- you need key {i}".

# ---- using an inventory slot -------------------------------------------------------------
useSlot m n =
  case nth m.inv n of
    Nil -> say m "nothing in slot {n + 1}"
  | k :: _ -> endTurn (useItem m k n).
nth Nil n = Nil.
nth (x :: r) 0 = x :: Nil.
nth (x :: r) n = nth r (n - 1).
dropAt Nil n = Nil.
dropAt (x :: r) 0 = r.
dropAt (x :: r) n = x :: dropAt r (n - 1).

# 7, not 6: endTurn decrements on the turn the potion is drunk, so this
# is what makes "six turns" the number the player actually gets
useItem m Potion n =
  say { m | inv = dropAt m.inv n, invT = 7 } "invincible for six turns".
useItem m Nuke n =
  m1 = { m | inv = dropAt m.inv n, ens = farFrom m.ens m.px m.py 1 };
  say m1 "the nuke clears the room".
useItem m Taunt n =
  say { m | inv = dropAt m.inv n } "you taunt -- everything hears you".
useItem m k n = say m "that is not something you use".

# every enemy further than r from (x,y) survives
farFrom Nil x y r = Nil.
farFrom (En i ex ey hp :: rest) x y r | absOf (ex - x) <= r and absOf (ey - y) <= r =
  farFrom rest x y r.
farFrom (En i ex ey hp :: rest) x y r = En i ex ey hp :: farFrom rest x y r.
absOf n | n < 0 = 0 - n.
absOf n = n.

# ---- combat ------------------------------------------------------------------------------
hitEnemy m i x y =
  (dmg, taken, rad) = statsOf m;
  m1 = spend m;
  ens2 = damage m1.ens i dmg;
  gone = lenOf ens2 < lenOf m1.ens;
  m2 = { m1 | ens = ens2 };
  case gone of
    True -> say m2 "the enemy falls"
  | False -> say m2 "you hit for {dmg}".
damage Nil i dmg = Nil.
damage (En j x y hp :: r) i dmg | j == i and hp <= dmg = damage r i dmg.
damage (En j x y hp :: r) i dmg | j == i = En j x y (hp - dmg) :: damage r i dmg.
damage (En j x y hp :: r) i dmg = En j x y hp :: damage r i dmg.
# a swing wears the sword down; the potion and the aura do not
spend m | stanceOf m == Armed = { m | swings = m.swings - 1 }.
spend m = m.

# ---- the enemies' turn -------------------------------------------------------------------
# The Java enemy re-ran A* to the player on every move.  One BFS from the
# player gives every enemy the same answer for one search: step to the
# neighbour with the lower distance, or the higher one while the player
# is untouchable (the original sent them to the opposite corner; running
# away is the same intent and reads better on screen).
enemyTurn m | m.turn % 2 != 0 = m.
enemyTurn m = enemyStep m.
enemyStep m =
  dist = bfs m ((m.px, m.py) :: Nil) ((idxOf m m.px m.py, 0) :: Nil) 1;
  flee = case stanceOf m of Untouchable -> True | s -> False;
  moveEnemies m m.ens dist flee Nil.

idxOf m x y = y * m.w + x.

# a frontier-at-a-time BFS over the passable tiles
bfs m Nil dist d = dist.
bfs m frontier dist d =
  (nf, nd) = expand m frontier dist d Nil;
  bfs m nf nd (d + 1).
expand m Nil dist d acc = (acc, dist).
expand m ((x, y) :: r) dist d acc =
  (a1, d1) = try m (x - 1) y dist d acc;
  (a2, d2) = try m (x + 1) y d1 d a1;
  (a3, d3) = try m x (y - 1) d2 d a2;
  (a4, d4) = try m x (y + 1) d3 d a3;
  expand m r d4 d a4.
try m x y dist d acc | blocked m x y = (acc, dist).
try m x y dist d acc =
  i = idxOf m x y;
  case lookupI dist i of
    Nil -> ((x, y) :: acc, (i, d) :: dist)
  | v :: _ -> (acc, dist).
lookupI Nil i = Nil.
lookupI ((j, d) :: r) i | j == i = d :: Nil.
lookupI ((j, d) :: r) i = lookupI r i.
# unreachable tiles read as very far away, so a cornered enemy holds still
distAt m dist x y | blocked m x y = 9999.
distAt m dist x y = case lookupI dist (idxOf m x y) of
    Nil -> 9999
  | d :: _ -> d.

moveEnemies m Nil dist flee acc = { m | ens = revEn acc Nil }.
moveEnemies m (e :: r) dist flee acc =
  (m1, e2) = moveOne m e dist flee;
  moveEnemies m1 r dist flee (e2 :: acc).
revEn Nil acc = acc.
revEn (x :: r) acc = revEn r (x :: acc).

moveOne m (En i x y hp) dist flee =
  (nx, ny) = bestStep m dist x y flee;
  case nx == m.px and ny == m.py of
    True -> (bite m, En i x y hp)                # walked into you
  | False -> (m, En i nx ny hp).

# the neighbour that improves the distance most (or least, when fleeing)
bestStep m dist x y flee =
  here = distAt m dist x y;
  c1 = (x - 1, y);
  c2 = (x + 1, y);
  c3 = (x, y - 1);
  c4 = (x, y + 1);
  b1 = pick m dist (x, y) here c1 flee;
  b2 = pick m dist b1 (scoreOf m dist b1 flee) c2 flee;
  b3 = pick m dist b2 (scoreOf m dist b2 flee) c3 flee;
  pick m dist b3 (scoreOf m dist b3 flee) c4 flee.
scoreOf m dist p flee = (x, y) = p; distAt m dist x y.
pick m dist best bs (cx, cy) flee | blocked m cx cy = best.
pick m dist best bs (cx, cy) flee | lenOf (enemyAt m.ens cx cy) > 0 = best.
pick m dist best bs (cx, cy) flee =
  cs = distAt m dist cx cy;
  better = case flee of
      True -> cs > bs and cs < 9999
    | False -> cs < bs;
  case better of True -> (cx, cy) | False -> best.

# an enemy reaching you: the potion kills it, otherwise it bites
bite m = case stanceOf m of
    Untouchable -> say m "it burns itself on you"
  | s -> hurt m 2.
died m = { m | hp = 0, screen = scLost, msg = "you died" }.
hurt m n =
  hp = m.hp - n;
  case hp <= 0 of
    True -> died m
  | False -> say { m | hp = hp } "it bites you for {n}".

# ---- ending a turn -----------------------------------------------------------------------
endTurn m =
  m1 = { m | turn = m.turn + 1 };
  m2 = { m1 | invT = down m1.invT, auraT = down m1.auraT };
  m3 = enemyTurn m2;
  win m3.
down n | n > 0 = n - 1.
down n = 0.
win m | m.screen != scPlay = m.
win m = case goalMet m goal0 of
    True -> won m
  | False -> { m | over = 0 }.
won m = { m | screen = scWon, msg = "the dungeon is yours" }.

# pure: the message is recorded, never printed.  The shell prints when
# it changes, which is what keeps these rules callable from a test.
say m s = { m | msg = s, log = firstN (s :: m.log) 6 }.
# NOT `keep`: that is a runtime builtin, and a helper of the same name
# silently joins its clause group
firstN Nil n = Nil.
firstN (x :: r) 0 = Nil.
firstN (x :: r) n = x :: firstN r (n - 1).

# one tile in world units: the rules own it because the camera follow
# below is expressed in the same space
cell = 1000.

# ---- the clock and the key map -----------------------------------------------------------
tickMs = 40.
# A turn is taken on a TICK, never straight off the key event.  The
# shell only buffers what the player pressed; one key comes off the
# queue per tick, which is what gives `follow` frames to ease over and
# what makes a replayed key file play back as a game rather than as a
# single blur of state.
tick m =
  m1 = { m | ms = m.ms + tickMs };
  take (follow m1).
take m = case m.keys of
    Nil -> m
  | k :: r -> key { m | keys = r } k.
# the live window also sends kind-1 characters (negative codes)
enqueue m k | k < 0 = m.
enqueue m k = { m | keys = m.keys + (k :: Nil) }.
# the camera eases toward the player rather than snapping: one sixth of
# the remaining distance each tick is the usual critically-damped feel
# ...and it is clamped to the board, so standing in a corner does not
# fill half the screen with the void outside the level.  The margins are
# roughly what the rig sees at its fixed pitch.
camMx = 7.
camMzN = 5.
camMzS = 4.
clampI v lo hi | v < lo = lo.
clampI v lo hi | v > hi = hi.
clampI v lo hi = v.
follow m =
  tx = clampI (m.px * cell) (camMx * cell) ((m.w - 1 - camMx) * cell);
  tz = clampI (m.py * cell) (camMzN * cell) ((m.h - 1 - camMzS) * cell);
  { m | camx = m.camx + (tx - m.camx) / 6, camz = m.camz + (tz - m.camz) / 6 }.

key m k | k == 16 = { m | quit = 1 }.                         # q
key m k | k == 25 = { m | snap = m.snap + 1 }.                # p: any screen
key m k | m.screen == scTitle = start m.
key m k | m.screen == scHelp = { m | screen = scPlay }.
key m k | m.screen != scPlay = restartKey m k.
key m 105 = walk m dirLeft.
key m 106 = walk m dirRight.
key m 103 = walk m dirUp.
key m 108 = walk m dirDown.
key m 30 = walk m dirLeft.                                    # a
key m 32 = walk m dirRight.                                   # d
key m 17 = walk m dirUp.                                      # w
key m 31 = walk m dirDown.                                    # s
key m 57 = interact m.                                        # space
key m 2 = useSlot m 0.
key m 3 = useSlot m 1.
key m 4 = useSlot m 2.
key m 5 = useSlot m 3.
key m 19 = start m.                                           # r
key m 35 = { m | screen = scHelp }.                           # h
key m k = m.
restartKey m k | k == 19 = start m.
restartKey m k = m.
start m = { initModel | screen = scPlay, snap = m.snap, ms = m.ms, keys = m.keys }.


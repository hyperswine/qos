# mods/arcsvc.fpr — ARC.qa: Arc as a SERVICE, not ambient machinery.
#
# The model (docs/MEMORY.md): the incref/decref MECHANISM stays in the
# HAL (runtime/runtime.c) because it sits on the send/spawn hot path —
# but the POLICY around Arc belongs to one actor, ARC.qa, registered at
# /services/arc when loaded under QOS.  Everything watchful about Arc —
# baselines, audits, leak verdicts, budgets — is a conversation with
# this actor.  Ordinary code should not touch Arc at all: bulk data is
# linear (Vectors, double buffers), tree data is Rc'd within one actor,
# and Arc exists only for message roots that escape — which drop
# discipline returns to zero.
#
# Protocol (one message type per mailbox):
#   (replyTo, 1, 0)  Stats     -> (live,  0)
#   (replyTo, 2, 0)  Baseline  -> (live,  0)  captures live as the baseline
#   (replyTo, 3, 0)  Audit     -> (delta, 0)  live - baseline; 0 = clean
#   (replyTo, n, 0)  anything else -> (0, 1)  the second slot is a status,
#                    which the three known ops always answer as 0
#
# Under QOS the registration is System.qa's job (the same walk-to-the-
# owner resolution every /services/* uses); standalone, spawn it and
# hold the handle — the protocol is identical, which is the point:
# local actor-handle addressing and URL addressing are the same `send`
# at two naming scopes.

Arc = Struct {
  start = fn u -> spawn arcLoop0,
  stats = fn me svc -> ask me svc 1,
  baseline = fn me svc -> ask me svc 2,
  audit = fn me svc -> ask me svc 3
}.

ask me svc op =
  _ = send svc (me, op, 0);
  m = receive me;
  (v, z) = m;
  _ = drop m;
  v .

arcLoop0 : unsafe Int -> r42 .
arcLoop0 me = arcLoop me 0 .
arcLoop : unsafe Int -> Int -> m42 .
arcLoop me base =
  m = receive me;
  (replyTo, op, z) = m;
  _ = drop m;
  arcStep me base replyTo op .

arcStep : unsafe Int -> Int -> Int -> Int -> n42 .
arcStep me base replyTo 1 = send replyTo (arcLive 0, 0) >> arcLoop me base .
arcStep me base replyTo 2 =
  lv = arcLive 0;
  _ = send replyTo (lv, 0);
  arcLoop me lv .
arcStep me base replyTo 3 = send replyTo (arcLive 0 - base, 0) >> arcLoop me base .
# an op this service does not know.  Without this clause the value fell
# through to a runtime "no matching clause" that takes the whole service
# with it -- a dispatcher over Int codes can never be complete, so the
# refusal has to be part of the protocol.
arcStep me base replyTo op = send replyTo (0, 1) >> arcLoop me base .

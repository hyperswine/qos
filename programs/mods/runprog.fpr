# runprog.fpr -- a program as a process of its own: the Editor's Run
# (docs/2026-10-16-EDITOR.md; tests/runprog.fpr checks it in QOS).
#
#   wrap src          the source with the run entry appended (qedRun: wait
#                     for the go, evaluate main, print its value)
#   start qa          the package of `wrap src` (Sys.compile "plugin:..")
#                     attached, its entry spawned as a process of its own --
#                     Sys.spawnApp: a fresh pid, the image freed when that pid
#                     goes quiet -- with its console captured by the CALLING
#                     actor, and only then told to go, so nothing it prints
#                     escapes the capture: Ok (root actor, pid)
#   poll me root pid  what it printed since the last poll, and whether it
#                     still runs (Running) or how it ended (Ended "finished",
#                     a trap's text, "killed")
#   stop root pid     kill it if it still runs: what it printed last
#
# The capture belongs to the actor that called start: only it drains or
# releases it, and its end releases it (qos/appside/hal.c).  This is not
# isolation: the program is given no namespace (and has no grants), but
# devices are not gated per process; a stop ends its root actor only; and a
# program that exhausts the machine (its stack past what can grow, the
# heap) still stops the machine.
unsafe module.
Plug = use "plug".

Sys.pidOf : Int -> Int .
Sys.alive : Int -> Bool .

Run = Type (Running | Ended String).

# The entry goes in after the header line (`unsafe program.`, `profile
# base.`), or first when there is none -- never after the program, where an
# unfinished last definition would swallow it and the error would point at a
# line nobody wrote.  One line, so a diagnostic's line maps back by one
# (userLine).  No signature: the safety analysis decides what it is, from
# main's.
entry = "qedRun me = go = receive me; _ = drop go; v = main; _ = print v; Unit.".
wrap src = (off, k) = place src;
  strcat (strcat (substr src 0 off) (if off > 0 and charAt src (off - 1) != 10 then "\n" else ""))
    (strcat (strcat entry "\n") (substr src off (strlen src - off))).
# a line of `wrap src`, as a line of src (the entry's own line is where it went)
userLine src n = (off, k) = place src; if n > k + 1 then n - 1 else n.
# the line of `wrap src` that is the entry
entryLine src = (off, k) = place src; k + 1.
# where the entry goes: (the byte after the header line, the lines up to it),
# or (0, 0) when the first code line is not a header
place src = placeGo src 0 0 (strlen src).
placeGo src i line n = if i >= n then (0, 0) else
  e = lineEnd src i n;
  l = trim (substr src i (e - i));
  if strlen l == 0 or charAt l 0 == 35 then placeGo src (e + 1) (line + 1) n
  else if header l then (if e < n then e + 1 else n, line + 1) else (0, 0).
lineEnd src i n = if i >= n or charAt src i == 10 then i else lineEnd src (i + 1) n.
header l = (startsWith "unsafe " l or startsWith "profile " l) and endsWith "." l
  and strIndexOf "=" l < 0 and strIndexOf ":" l < 0.
trim s = trimEnd (trimStart s).
trimStart s = if strlen s > 0 and blank (charAt s 0) then trimStart (substr s 1 (strlen s - 1)) else s.
trimEnd s = if strlen s > 0 and blank (charAt s (strlen s - 1)) then trimEnd (substr s 0 (strlen s - 1)) else s.
blank c = c == 32 or c == 9 or c == 13.
endsWith suffix s = strlen s >= strlen suffix and substr s (strlen s - strlen suffix) (strlen suffix) == suffix.

# a file with a main to run: a line that starts with it
hasMain Nil = False.
hasMain (l :: rest) = startsWith "main " l or startsWith "main=" l or hasMain rest.
startsWith prefix s = strlen s >= strlen prefix and substr s 0 (strlen prefix) == prefix.

start qa = case Plug.attach qa of
    Err why -> Err "could not load it: {why}"
  | Ok u ->
      # the newest table is the package's: out of the registry at once (a
      # program is a process, not a binding -- std/loader's launch)
      found = Mod.findAt (Mod.plugs 0 - 1) "qedRun";
      _ = Mod.detachLast Unit;
      spawned found.
spawned found = case found of
    (ok, f) -> if ok != 1 then Err "the package has no entry" else
      h = Sys.spawnApp f;
      pid = Sys.pidOf h;
      case Sys.captureConsole pid of
        Err why -> _ = kill h; Err why
      | Ok u -> case send h 1 of
          Err why -> _ = kill h; _ = Sys.releaseConsole pid; Err why
        | Ok u2 -> Ok (h, pid).

poll me root pid =
  text = taken pid;
  case receiveFromNow me root of
    Ok borrowed -> _ = drop borrowed; (text, Running)
  | Err why -> if why == "empty" then (text, Running) else
      rest = taken pid;
      _ = Sys.releaseConsole pid;
      (strcat text rest, Ended (endedHow why)).

stop root pid =
  _ = (if Sys.alive root then kill root else Unit);
  last = taken pid;
  _ = Sys.releaseConsole pid;
  last.

taken pid = case Sys.takeConsole pid of Ok text -> text | Err why -> "".
# the end, from the root actor's death: a return, a trap, a kill
endedHow why = if why == "dead actor" then "finished"
  else if strlen why > 12 and substr why 0 12 == "dead actor: " then substr why 12 (strlen why - 12)
  else why.

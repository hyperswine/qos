# plug.fpr -- attach a plugin: the archive is interpreted HERE, in the app.
#
#   Plug.attach qa  ->  Ok "" | Err reason        (qa = the .qa BYTES, read
#                                                  off qosp.disk with mods/qlog)
#
# QOS Portable's host used to parse the plugin's archive itself, in C
# (qos/portable/qa.c) -- a second container parser and a third manifest
# parser, reached from an app thread where the host's own FP-RISC cannot
# run.  Native never worked that way: Sys.loadImageAt takes section extents
# that system.fpr computed with QAR.  This is the same shape: the app reads
# the archive with the modules the kernel and the host launch with, and
# places the image itself; the host parses nothing, and that was the last
# C archive parser.  (../fprisc/docs/2026-09-19-C-REDUCTION.md)

QAR = use "qar".
M   = use "manifest".
QI  = use "qaimg".

# this module's one foreign primitive (qos/appside/entry.c): id, abi stamp,
# the sha LOAD claims for IMAGE, LOAD's numbers [base, entry, execsz, rwoff,
# memsz] as mods/qaimg.fpr read them, and the sections [IMAGE, RELOC,
# IMPORT].  The app places the plugin in its own heap, moves it there and
# completes its imports by name (docs/2026-10-01-IMPORT-TABLE.md); the host
# only makes its code executable.
Sys.attachImage : String -> String -> String -> List Int -> List String -> Result String String .

attach : String -> Result String String .
attach qa = case M.parseQa qa of
    Err e -> Err e
  | Ok man -> attachLoad qa man (QAR.sectionBytes qa "LOAD").

attachLoad qa man r = case r of
    Err e -> Err e
  | Ok load -> attachImg qa man load (QAR.sectionBytes qa "IMAGE").

attachImg qa man load r = case r of
    Err e -> Err e
  | Ok img -> attachRel qa man load img (QAR.sectionBytes qa "RELOC").

attachRel qa man load img r = case r of
    Err e -> Err "not a relocatable plugin (no RELOC section: linked for a fixed slot): rebuild it"
  | Ok rel -> attachImp man load img rel (QAR.sectionBytes qa "IMPORT").

attachImp man load img rel r = case r of
    Err e -> Err "not a relocatable plugin (no IMPORT section): rebuild it"
  | Ok imp -> attachChecked man img rel imp (QI.load load img).

# an inconsistent LOAD is refused HERE, by name, before anything is placed
attachChecked man img rel imp r = case r of
    Err e -> Err e
  | Ok m -> Sys.attachImage (M.id man) (M.abi man) (QI.sha m) (QI.nums m) (img :: rel :: imp :: Nil).

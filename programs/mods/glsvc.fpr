# glsvc.fpr -- the GPU tier as Graphics.qa's backend, and `serve`: one
# program alone with the display, as before.
#
# The service is mods/graphics.fpr: sessions, focus, input routing, the
# lifetimes.  This module is what it draws WITH: the GLES scene walker
# (hal/unix/gfx.c) as the backend record -- glInit once, one glRender per
# frame, inputPoll for the drain, glMesh for program-carried geometry,
# glSavePpm for a snapshot.  The context is thread-bound and the service
# actor is its only caller: the backend is functions, not an actor, so the
# scene is walked from the frame message itself, no copy.
#
# A program that is alone (a test under Xvfb, a standalone game):
#
#   gl = spawn (GL.serve 960 600 "terra2" models);
#   cfg = { env = 0, mt = mt, tick = 160000, input = gl, render = gl };
#   MV.game me cfg (App init update subs view)
#
# is a private Graphics.qa with this backend, and the program its one
# session, admitted on its first frame.  Under a system that claims
# /services/graphics the same program opens a session there instead
# (GX.attach) and shares the display with the others.
#
# view's value is (scene, ui, snap): the Scene the walker draws; a 2D
# layer over it as (ents, dist) -- scene2d's entities in its pixel space
# and the Int camera distance (S2.camAt vh), or (Nil, 0) for none; and a
# snapshot counter -- when it changes, the frame just drawn is read back
# to /tmp/<tag>-<snap>.ppm (glSavePpm).  That is how a headless run
# under Xvfb proves what it drew, and how a key becomes a screenshot in
# a live window.  snap 0 = never.

unsafe module.

GX = use "graphics".

# the backend: the walker's primitives, in the shape graphics.fpr draws with
glBackend = { init = glInit, mesh = glMesh, render = glRenderWith, poll = glPoll, snap = glSavePpm }.
glRenderWith : unsafe _ -> _ -> Int -> (Int, Int) .
glRenderWith scene ents dist = case dist == 0 of
    True -> glRender scene
  | False -> glRenderUi scene ents dist.
glPoll u = inputPoll 0.

# serve w h tag meshes: a private service, this program its one session
# (tagged for its snapshots).  serveWith is the same without meshes.
serve : unsafe Int -> Int -> String -> List (String, String) -> Int -> a .
serve w h tag meshes me = GX.serviceAs w h glBackend meshes tag me.
serveWith : unsafe Int -> Int -> String -> Int -> a .
serveWith w h tag me = GX.serviceAs w h glBackend Nil tag me.

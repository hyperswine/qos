# Recursive MVU: viewport, focus and pointer capture are model values.
unsafe module.
AW = use "appwire".
AS = use "appsession".
AV = use "appview".
L = use "shelllayout".
ST = use "scrolltext".
AK = use "appkit".

init = ({sev = 0, wanted = 0, rows = Nil, total = "", paused = False, token = 1, busy = True, ticks = 0, phase = AW.Loading, w = 960, h = 530, focused = True, down = False, capture = 0 - 1, wheel = 0, scroll = 0, dragY = 0, dragScroll = 0, dragged = False}, [AW.Fetch 1 (AW.Logs 0)]).
fetch m = if m.busy then (m, Nil) else
  ({m | rows = (if m.sev == m.wanted then m.rows else Nil), scroll = (if m.sev == m.wanted then m.scroll else 0), total = (if m.sev == m.wanted then m.total else ""), sev = m.wanted, token = m.token + 1, busy = True, ticks = 0, phase = AW.Loading}, [AW.Fetch (m.token + 1) (AW.Logs m.wanted)]).
update (AW.Resize w h) m = fresh = AV.resize w h m; (AV.seek (rows fresh) fresh.scroll fresh, Nil).
update (AW.Focus active) m = (AV.focus active m, Nil).
update AW.Cancel m = (AV.focus m.focused m, Nil).
update AW.Tick m | not m.focused = (m, Nil).

update (AW.Wheel dy dx) m = (AV.wheel (rows m) dy m, Nil).
update (AW.Pointer x y buttons) m = (AV.pointer (rows m) x y buttons m, Nil).
update (AW.Key k) m = if k == AW.keyN or k == AW.keyW or k == AW.keyE or k == AW.keyH then
  fetch {m | wanted = (if k == AW.keyN then 0 else if k == AW.keyW then 1 else if k == AW.keyE then 2 else 3)}
  else if k == AW.keyR then fetch m else if k == AW.keyP then ({m | paused = not m.paused}, Nil) else (AV.navigate (rows m) k m, Nil).
update AW.Tick m = case m.phase of
    AW.Ready -> if m.paused then (m, Nil) else if m.ticks >= 9 then fetch m else ({m | ticks = m.ticks + 1}, Nil)
  | other -> (m, Nil).
update (AW.Arrived token result) m = if token != m.token or not m.busy then (m, Nil) else
  if m.sev != m.wanted then fetch {m | busy = False} else case result of
    Ok (AW.Lines lines total) -> fresh = {m | rows = lines, total = total, busy = False, phase = AW.Ready};
      (AV.seek (rows fresh) m.scroll fresh, Nil)
  | Err why -> ({m | busy = False, phase = AW.Failed why}, Nil)
  | other -> ({m | busy = False, phase = AW.Failed "invalid logs result"}, Nil).
update other m = (m, Nil).
rows m = ST.wrapLinesWith (AV.metrics m) m.rows.
sevPath 0 = "/logs/normal".
sevPath 1 = "/logs/warns".
sevPath 2 = "/logs/errors".
sevPath other = "/logs/host".
view vp m = (AV.frame vp "Logs" "{sevPath m.sev}   {m.total}   {ST.count m.rows} lines, newest first   {if m.paused then "PAUSED (P resumes)" else "N W E H severity   P pause"}" (rows m) m.scroll, Nil, AW.status m.phase).

run me = AS.run me init update view.

# logsapp.fpr -- Logs.qa over the /logs severity axis: n/w/e/h switch
# between /logs/normal, /logs/warns, /logs/errors, /logs/host (sev 3:
# the UNIFIED LOG PLANE -- every qos_hostlog line the host emits, DRM
# probes, evdev opens, plugin ranges, replayed boot story included).
# Snapshots come
# straight from the runtime ring (Sys.logSnap) -- fresh copies in THIS
# worker's pool, dead with the frame; the capability service remains
# the WRITE path for app actors.
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("LOGS", "/LOGS RINGS").
appInit self env = 0.
appUpdate self env k sev | k == 49 = 0.       # n
appUpdate self env k sev | k == 17 = 1.       # w
appUpdate self env k sev | k == 18 = 2.       # e
appUpdate self env k sev | k == 35 = 3.       # h
appUpdate self env k sev = sev.

lgLine i =
  Box [Row, Pad 1] [ Slot [Fg (930, 940, 960)] i 44 ].

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "LOGS"
        , Slot [Fg (999, 800, 300)] 0 14
        , Box [Grow] Nil
        , Slot [Fg (560, 590, 650)] 9 14 ]
    , Box [Col, Gap 2, Grow, Bord (150, 165, 200), Pad 3]
        [ lgLine 1, lgLine 2, lgLine 3, lgLine 4
        , lgLine 5, lgLine 6, lgLine 7, lgLine 8 ]
    , Lbl [Fg (560, 590, 650)] "N NORMAL  W WARNS  E ERRORS  H HOST  ESC BACK" ].

sevPath 0 = "/logs/normal".
sevPath 1 = "/logs/warns".
sevPath 2 = "/logs/errors".
sevPath 3 = "/logs/host".

appVals self env sev =
  sn = Sys.logSnap sev;
  [ sevPath sev
  , lgNth sn 0, lgNth sn 1, lgNth sn 2, lgNth sn 3
  , lgNth sn 4, lgNth sn 5, lgNth sn 6, lgNth sn 7
  , "{Sys.logSeq sev} TOTAL" ].

lgNth Nil i = "".
lgNth (v :: r) 0 = v.
lgNth (v :: r) i = lgNth r (i - 1).

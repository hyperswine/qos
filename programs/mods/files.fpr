# Files.qa: one disk owner, namespace endpoints for named log records.
# /services/files/<record>/{latest,replay,stats,append,delete}
# Only System (pid 0) may compact the whole log. Apps receive grants to
# their record prefix; opening a record does not give them a raw disk.
unsafe module.
Endpoint = use "epservice#e8bce05a1ddf73db".
EP = use "ep#c66ad65e68dd97f5".
Storage = use "std/storageclient".
SP = use "std/storageprotocol".
AC = use "std/actor#201a0e9bf98a5154".

serve fs me = Endpoint.simpleUntil (readRecordUntil fs) (writeRecordUntil fs) me.
result (Ok text) = Ok (EP.IStr text).
result (Err why) = Err (SP.message why).
request me fs op = Storage.request me (Storage.Owner fs) op.
requestUntil until me fs op = Storage.requestUntil until me (Storage.Owner fs) op.

readRecord fs me client url | EP.strEq url "/services/files/status" = Ok (EP.IInt (case fs == 0 of True -> 0 | False -> 1)).
readRecord fs me client url | EP.strEq url "/services/files/schema" = Ok (EP.IStr (SP.schema SP.FilesAdapter)).
readRecord 0 _ _ _ = Err "no disk".
readRecord fs me client url =
  (key, op) = recordOp url;
  readOp fs me key op.
readOp fs me key "latest" = request me fs (SP.ReadLatest key) |> result.
readOp fs me key "replay" = request me fs (SP.Replay key) |> result.
readOp fs me key "stats" = request me fs (SP.Stats key) |> result.
readOp _ _ _ _ = Err "unknown file read operation".

writeRecord fs me client url value | EP.strEq url "/services/files/schema" = Err "storage schema is read-only".
writeRecord 0 _ _ _ _ = Err "no disk".
writeRecord fs me client url value | EP.strEq url "/services/files/compact" =
  case Sys.pidOf client == 0 of
    True -> request me fs SP.Compact |> result
  | False -> Err "compaction is system-only".
writeRecord fs me client url (EP.IStr text) =
  (key, op) = recordOp url;
  writeOp fs me key op text.
writeRecord _ _ _ _ _ = Err "file writes require bytes".
writeOp fs me key "append" text = request me fs (SP.Append key text) |> result.
writeOp fs me key "delete" _ = request me fs (SP.Delete key) |> result.
writeOp _ _ _ _ _ = Err "unknown file write operation".

recordOp url =
  rest = substr url 16 (strlen url - 16);
  split rest (strlen rest - 1).
split text i | i < 0 = ("", "").
split text i | charAt text i == 47 = (substr text 0 i, substr text (i + 1) (strlen text - i - 1)).
split text i = split text (i - 1).

readRecordUntil fs until me client url | EP.strEq url "/services/files/status" = Ok (EP.IInt (if fs == 0 then 0 else 1)).
readRecordUntil fs until me client url | EP.strEq url "/services/files/schema" = Ok (EP.IStr (SP.schema SP.FilesAdapter)).
readRecordUntil 0 _ _ _ _ = Err "no disk".
readRecordUntil fs until me client url =
  (key, op) = recordOp url;
  case op of
      "latest" -> result (requestUntil until me fs (SP.ReadLatest key))
    | "replay" -> result (requestUntil until me fs (SP.Replay key))
    | "stats" -> result (requestUntil until me fs (SP.Stats key))
    | other -> Err "unknown file read operation".
writeRecordUntil fs until me client url value | EP.strEq url "/services/files/schema" = Err "storage schema is read-only".
writeRecordUntil 0 _ _ _ _ _ = Err "no disk".
writeRecordUntil fs until me client url value | EP.strEq url "/services/files/compact" =
  if Sys.pidOf client == 0 then result (requestUntil until me fs SP.Compact) else Err "compaction is system-only".
writeRecordUntil fs until me client url (EP.IStr text) =
  (key, op) = recordOp url;
  case op of
      "append" -> result (requestUntil until me fs (SP.Append key text))
    | "delete" -> result (requestUntil until me fs (SP.Delete key))
    | other -> Err "unknown file write operation".
writeRecordUntil _ _ _ _ _ _ = Err "file writes require bytes".

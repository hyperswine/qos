# ============================================================================
# cliapp.fpr -- CLI.qa.  A command line whose entire world is the URL
# namespace: `ls` is VfsList, `cat` is Read, `write` is Write, and each
# of those is a message to whichever actor owns the path -- for a real
# file, one of System.qa's per-file actors.  The CLI holds no file
# handles, no working directory, and no privileges: it has the
# resolver capability from its env, and that is the whole story.
#
# Commands run in appUpdate, which the launcher runs in the SHELL
# actor -- so a command may hold a conversation with a service, which
# is precisely why the contract passes self and env there.
# ============================================================================

S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("CLI", "COMMAND LINE").

# state = (input, output lines newest-first)
appInit self env = ("", banner 0 :: Nil).

appUpdate self env k st | k == 14 =
  (inp, out) = st;
  (clDropLast inp, out).
appUpdate self env k st | k == 28 = clRun self env st.
appUpdate self env k st =
  (inp, out) = st;
  (clType inp k, out).

clType inp k | strlen inp > 40 = inp.
clType inp k = strcat inp (AK.keyChar k).
clDropLast s | strlen s < 2 = "".
clDropLast s = substr s 1 (strlen s - 1).

banner u = "qsh -- try: help".

# ---- the command line ------------------------------------------------------

clRun self env (inp, out) | strlen inp == 0 = ("", out).
clRun self env (inp, out) =
  outs = clDo self env (clWord inp) (clRest inp);
  ("", clPush out (clCat outs ("$ {inp}" :: Nil))).
# newest-first: the echoed command goes on last so it sits ABOVE its
# own output when the view reverses nothing
clPush out add = clCat add out.
clCat Nil b = b.
clCat (a :: r) b = a :: clCat r b.

clDo self env cmd rest | strEq cmd "help" =
  "write <path> <text>  ps  clear" :: "commands: help  ls  cat <path>" :: Nil.
clDo self env cmd rest | strEq cmd "ls" = clLs self env rest.
clDo self env cmd rest | strEq cmd "cat" = clCat1 self env rest.
clDo self env cmd rest | strEq cmd "write" = clWrite self env rest.
clDo self env cmd rest | strEq cmd "ps" = clPs 0.
clDo self env cmd rest | strEq cmd "clear" = Nil.
clDo self env cmd rest = "{cmd}: no such command" :: Nil.

# ls [prefix]: the namespace, optionally filtered -- "directories" are
# a filter over a flat set, which is all they ever were
clLs self env pre =
  ents = AK.vfsList self (AK.envVfs env);
  ls = clRev (clPaths ents pre) Nil;
  _ = drop ents;
  ls.
clPaths Nil pre = Nil.
clPaths ((p, k) :: r) pre =
  case clStarts p pre of
    True -> "{clKind k} {p}" :: clPaths r pre
  | False -> clPaths r pre.
clKind 0 = "virt".
clKind 1 = "data".
clKind 2 = "file".
clStarts p pre | strlen pre == 0 = True.
clStarts p pre | strlen p < strlen pre = False.
clStarts p pre = strEqS (substr p 1 (strlen pre)) pre.

clCat1 self env path | strlen path == 0 = "cat: need a path" :: Nil.
clCat1 self env path =
  txt = AK.vfsRead self (AK.envVfs env) path;
  ls = clRev (clLines txt) Nil;
  _ = drop txt;
  ls.

clWrite self env rest | strlen rest == 0 = "write: need a path" :: Nil.
clWrite self env rest =
  path = clWord rest;
  text = clRest rest;
  r = AK.vfsWrite self (AK.envVfs env) path "{text}\n";
  out = "{r}" :: Nil;
  _ = drop r;
  out.

clPs u =
  (g, mb) = Sys.memStats 0;
  "arena: {g} grows, {mb} MiB granted" :: "{Sys.actLive 0} actors live" :: Nil.

# ---- strings ---------------------------------------------------------------

strEqS a b | strlen a == strlen b = strEqGo a b 1 (strlen a).
strEqS a b = False.
strEqGo a b i n | i > n = True.
strEqGo a b i n | charAt a i == charAt b i = strEqGo a b (i + 1) n.
strEqGo a b i n = False.
strEq : unsafe String -> String -> Bool .
strEq a b = strEqS a b.

clWord s = clWordGo s 1.
clWordGo s i | i > strlen s = s.
clWordGo s i | charAt s i == 32 = substr s 1 (i - 1).
clWordGo s i = clWordGo s (i + 1).
clRest s = clRestGo s 1.
clRestGo s i | i > strlen s = "".
clRestGo s i | charAt s i == 32 = substr s (i + 1) (strlen s - i).
clRestGo s i = clRestGo s (i + 1).

clLines s = clSplit s 1 1 Nil.
clSplit s i st acc | i > strlen s = clSeg s st i acc.
clSplit s i st acc | charAt s i == 10 = clSplit s (i + 1) (i + 1) (clSeg s st i acc).
clSplit s i st acc = clSplit s (i + 1) st acc.
clSeg s st i acc | i > st = substr s st (i - st) :: acc.
clSeg s st i acc = acc.
clRev Nil acc = acc.
clRev (x :: r) acc = clRev r (x :: acc).

clNth Nil i = "".
clNth (v :: r) 0 = v.
clNth (v :: r) i = clNth r (i - 1).

# ---- view ------------------------------------------------------------------

clRow i =
  Box [Row, Pad 1] [ Slot [Fg (930, 940, 960)] i 46 ].

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "CLI"
        , Lbl [Fg (560, 590, 650)] "everything is a URL"
        , Box [Grow] Nil
        , Slot [Fg (560, 590, 650)] 10 10 ]
    , Box [Col, Gap 2, Grow, Bord (150, 165, 200), Pad 3]
        [ clRow 9, clRow 8, clRow 7, clRow 6, clRow 5
        , clRow 4, clRow 3, clRow 2, clRow 1 ]
    , Box [Row, Pad 4, Gap 4, Bord (330, 720, 999), Bg (92, 104, 130)]
        [ Lbl [Fg (999, 800, 300)] "$"
        , Slot [Fg (930, 940, 960)] 0 40 ]
    , Lbl [Fg (560, 590, 650)] "ENTER RUN  BKSP DELETE  ESC HOME  F12 SNAP" ].

appVals self env st =
  (inp, out) = st;
  [ "{inp}_"
  , clNth out 0, clNth out 1, clNth out 2, clNth out 3
  , clNth out 4, clNth out 5, clNth out 6, clNth out 7
  , clNth out 8
  , "{clLen out} LINES" ].
clLen Nil = 0.
clLen (x :: r) = 1 + clLen r.

# ============================================================================
# qsys.fpr -- QOS Portable's System layer as a MODULE: the service actors
# the shell needs, each the OWNER of the urls it claims in the namespace
# (mods/ep.fpr).  Storage is mods/qlog over `device "blk"` (qosp.disk);
# QLog records are URL-KEYED natively, so a file actor is
# readLatest/replayAll/appendRec on its own url and nothing else.
#
# What lives here:
#   boot                the namespace (Endpoint.namespace) and its lister at "/",
#                       then every service below, each claiming its url
#   QL.actor            (spawned by boot) the ONE disk writer -- svc's
#                       Rpc protocol, tags 1 latest / 2 append /
#                       3 replay / 4 tombstone / 5 stats
#   logActor            LogAdd / LogSnap, appkit's log capability (an actor
#                       handle apps are given, not a url)
#   /services/log, /logs/{normal,warns,errors}
#                       a stateless endpoint over the C severity rings:
#                       read the lines, write one
#   /services/storage/<record url>
#                       the log's records as urls: read latest, write append
#   /tmp, /home         the file namespaces: filesMgr spawns one fileActor
#                       per path (create-on-write), registers the path so
#                       later opens go to the file directly, and REDIRECTS
#                       the open that created it -- the namespace is never
#                       in a read or a write
#   /apps, /apps/<id>   the loaded apps, from their manifests
#   /apps/<id>.qa       each loaded app's image bytes (mods/appsep.fpr)
#   attachAll           DISK ENUMERATION: read apps/index, then per id
#                       read apps/<id>.qa and Plug.attach the bytes --
#                       installing an app is appending records, no
#                       shell rebuild
#   qaManifest          minimal QAR2 manifest reader (id, name): app
#                       metadata comes from the archive itself
#
# No namespace table lives in this file: a service that wants a url
# claims it (EP.register), the shell's own included.  Until 2026-10-02 this
# module held a (path, kind, owner) list and relayed every read and write
# through a vfs actor; the audit (docs/2026-10-02-QOS-AUDIT.md) names that
# as the thing to remove.
#
# Permission gate: the namespace checks a process's grants at open
# (EP.grant, registered by the launcher); the shell's own actors are pid 0.
# ============================================================================

FS = use "std/fs#84826bc9e8ddb4b5".
Storage = use "std/storageclient".
SP = use "std/storageprotocol".
Lifecycle = use "std/lifecycle#6e7bea28db71815a".
AK  = use "appkit".
BlockEP = use "blockep#bd295a609815dadd".
SVC = use "svc#75479fb6d5f34670".
EP  = use "ep#c66ad65e68dd97f5".
Core = use "coreutil".
QAR = use "qar".
Plug = use "plug".
AppsEP = use "appsep".
Endpoint = use "epservice#e8bce05a1ddf73db".
AC = use "std/actor#201a0e9bf98a5154".
GX = use "graphics".
GL = use "glsvc".
Wire = use "std/storage#a8f7ee14e1efae76".
FP = use "filepolicy".

glHas : Int -> Int .

Rpc     = SVC.Rpc.
LogAdd  = AK.LogAdd.
LogSnap = AK.LogSnap.
Open = EP.Open. Read = EP.Read. Write = EP.Write. Close = EP.Close.
Opened = EP.Opened. Refused = EP.Refused. Redirect = EP.Redirect.
IStr = EP.IStr. IInt = EP.IInt.

# a discovered app: manifest id + name + its module-table index
App = Type (App String String Int).

# the boot record boot returns (a declared constructor: the ABI has
# Tup2/Tup3 only, and this crosses units).  sys and vfs are both the
# namespace: the names stay for the callers that destructure this.
Qsys = Type (Qsys sys st vfs log apps).

# ---- small helpers ----------------------------------------------------------

strEq : unsafe String -> String -> Bool .
strEq a b = Core.strEq a b.

okOr r alt = case r of Ok s -> s | Err e -> alt.
emptyAs s alt = case strlen s == 0 of True -> alt | False -> s.

# one request, one reply -- std/actor's correlated protocol, which every
# service actor here answers: the request is (me, id, q), the reply
# (id, r).  `call` is Ok r, or Err when the request was refused or the
# service ended before answering -- never a caller left waiting, and
# never an unrelated message read as the reply.
call : unsafe Int -> Int -> q -> Result r String .
call me a q = AC.call me a q.
# the storage actor's protocol (svc's Rpc; reply is a bare Result, and the
# storage actor sends its callers nothing else): the send is checked and
# a storage actor that has ended is an Err, like any storage failure
rpc : unsafe Int -> Int -> Int -> String -> String -> Result String String .
rpc me st tag url pay = FS.rpc me st tag url pay.
# New internal calls carry operations; rpc remains the legacy public adapter.
storage me st op = SP.legacyResult (Storage.request me (Storage.Owner st) op).
storageUntil until me st op = SP.legacyResult (Storage.requestUntil until me (Storage.Owner st) op).

hasPrefix : unsafe String -> String -> Bool .
hasPrefix s pre = EP.startsWith pre s.

# newline-split, used on apps/index ("id1\nid2\n")
lines : unsafe String -> List String .
lines s = Core.lines s.

cat : unsafe List a -> List a -> List a .
cat l b = Core.listAppend l b.
lenL : unsafe List a -> Int .
lenL l = Core.listLen l.

claim : unsafe Int -> Int -> String -> Int -> Unit .
claim me ns url a = case EP.register me ns url a of
    Ok n -> Unit
  | Err e -> error "qsys boot: could not claim {url}: {e}".
spawnD f = AC.spawnWith (AC.Dynamic 64) f.

# ---- QAR2 manifest reading --------------------------------------------------
# "QAR2\n" <table lines "NAME off len"> "\n" <payloads>.  We only need
# the MANIFEST section and only its id/name fields -- app identity
# comes from the archive, not from a hardcoded list.

# `key = "value"` line scan inside the manifest slice
mfField : unsafe String -> String -> String .
mfField man key = mfGo man (strcat key " = ") 0 (strlen man).
mfGo : unsafe String -> String -> Int -> Int -> String .
mfGo man pre i n = case i >= n of
    True -> ""
  | False -> mfTry man pre i n.
mfTry : unsafe String -> String -> Int -> Int -> String .
mfTry man pre i n =
  pl = strlen pre;
  case i + pl >= n of
    True -> ""
  | False -> case strEq (substr man i pl) pre of
      True -> mfVal man (i + pl) n
    | False -> mfSkip man pre i n.
mfSkip : unsafe String -> String -> Int -> Int -> String .
mfSkip man pre i n = case charAt man i == 10 of
    True -> mfGo man pre (i + 1) n
  | False -> mfSkip man pre (i + 1) n.
mfVal : unsafe String -> Int -> Int -> String .
mfVal man i n = case charAt man i == 34 of
    True -> mfQ man (i + 1) n ""
  | False -> "".
mfQ : unsafe String -> Int -> Int -> String -> String .
mfQ man i n acc = case i >= n of
    True -> acc
  | False -> case charAt man i == 34 of
      True -> acc
    | False -> mfQ man (i + 1) n (strcat acc (chr (charAt man i))).

# (id, name) from the .qa bytes; ("", "") when unreadable
qaManifest bytes =
  case QAR.manifestOf bytes of
    Err e -> ("", "")
  | Ok man -> qaMan2 man.
qaMan2 man = (mfField man "id", mfField man "name").

# ---- the log: LogAdd/LogSnap for app capabilities; /logs as an endpoint ------
sevOfPath : unsafe String -> Int .
sevOfPath p = case strEq p "/logs/warns" of
    True -> 1
  | False -> case strEq p "/logs/errors" of True -> 2 | False -> 0.
joinNl : unsafe List String -> String .
joinNl l = case l of Nil -> "(empty)" | x :: r -> joinGo x r.
joinGo : unsafe String -> List String -> String .
joinGo acc l = case l of Nil -> acc | x :: r -> joinGo "{acc}\n{x}" r.

logActor : unsafe Int -> a .
logActor me =
  # No local state survives a request; replies are copied before this turn.
  _ = Sys.poolReset 0;
  m = receive me;
  (replyTo, id, q) = m;
  logMsg me (replyTo, id) q.
logMsg : unsafe Int -> (Int, Int) -> AK.Ak -> a .
logMsg me ret q = case q of
    LogAdd sev line -> logDo me ret sev line
  | LogSnap sev -> AC.reply ret (Sys.logSnap sev) >> logActor me.
logDo : unsafe Int -> (Int, Int) -> Int -> String -> a .
logDo me ret sev line =
  _ = Sys.logAt sev line;
  AC.reply ret 0 >> logActor me.

# the endpoint: a read is the ring's lines, a write logs one line
logR : unsafe Int -> Int -> String -> Result EP.IoV String .
logR me client url = Ok (IStr (joinNl (Sys.logSnap (sevOfPath url)))).
logW : unsafe Int -> Int -> String -> EP.IoV -> Result EP.IoV String .
logW me client url v = case v of
    IStr line -> Sys.logAt (sevOfPath url) line >> Ok (IInt 0)
  | o -> Err "{url} wants IStr".

# ---- storage records as urls: /services/storage/<record url> ------------------
stR : unsafe Int -> Int -> Int -> String -> Result EP.IoV String .
stR st me client url = stOn st me url SP.ReadLatest.
stW : unsafe Int -> Int -> Int -> String -> EP.IoV -> Result EP.IoV String .
stW st me client url v = case v of
    IStr pay -> stOn st me url (fn key -> SP.Append key pay)
  | o -> Err "{url} wants IStr".
stOn : unsafe Int -> Int -> String -> (String -> SP.StorageOp) -> Result EP.IoV String .
stOn st me url make =
  rec = EP.segAfter url 18;
  case strlen rec == 0 of
    True -> Err "name a record: /services/storage/<url>"
  | False -> (case storage me st (make (substr url 18 (strlen url - 18))) of
      Ok s -> Ok (IStr s)
    | Err e -> Err e).

storageSchema me client url = if strEq url "/services/storage-schema" then Ok (IStr (SP.schema SP.FilesOwner)) else Err "unknown storage schema endpoint".

# ---- files: one actor per real file, url-native over the qlog ---------------
# The file IS the replay of its url's records; a write is one appended
# record.  The storage actor stays the single writer -- the file actor
# routes its append through Rpc rather than touching the device.
#
# The cached body only ever changes the way the disk did: a write that
# storage refused leaves it as it was.  Until a replay has succeeded the
# body is unknown (Err), and the actor says so instead of serving "" as
# the file.  Handles are (handle, client) leases: a Read/Write with an
# unknown handle, or one another client holds, is refused with
# "no such handle"; Close is idempotent.  Clients that have ended are
# swept on every message.  The last close ends the actor -- its cached
# body is re-read from storage on the next open -- so closed files free
# the manager's 64-live-actor budget instead of holding it until reboot.

fileActor st path me = fileActorOf 0 st path me.
# a file actor its manager (filesMgr) spawned: it does not end on its own
# when its last handle goes (see fileRetire), the manager retires it
fileActorOf mgr st path me = fileServe mgr st path me (storage me st (SP.Replay path)) 1 Nil.
fileServe : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> Unit .
fileServe mgr st path me body next hs =
  borrowed = receive me;
  m = keep borrowed;
  _ = drop borrowed;
  case m of
    (replyTo, id, q) -> fileMsg mgr st path me body next (fileSwept mgr me hs) (replyTo, id) replyTo q
  | stale -> fileServe mgr st path me body next (fileSwept mgr me hs).
# the leases of clients that have ended go; when that empties the list, the
# manager hears this actor is idle (so a client that died without Close
# does not hold the file's slot for ever)
fileSwept : unsafe Int -> Int -> List (Int, Int) -> List (Int, Int) .
fileSwept mgr me hs = live = sweepDead hs;
  _ = (case hs of Nil -> Unit | h :: rest -> (case live of Nil -> fileIdle mgr me | k :: more -> Unit));
  live.
fileIdle : unsafe Int -> Int -> Unit .
fileIdle mgr me = if mgr > 0 then _ = spawn (fileIdleNote mgr me); Unit else Unit.
# sent from an actor of its own: the manager may be waiting on a reply
# from the file actor itself (filesRetireAsk), and a note from the same
# sender would be read as that reply
fileIdleNote mgr file me = case send mgr (file, 0, Close (0 - 1)) of Ok u -> Unit | Err e -> Unit.
hOwner hs h = case hs of
    Nil -> 0
  | (k, c) :: rest -> if k == h then c else hOwner rest h.
hDrop2 hs h c = case hs of
    Nil -> Nil
  | (k, o) :: rest -> if k == h and o == c then hDrop2 rest h c else (k, o) :: hDrop2 rest h c.
sweepDead : unsafe List (Int, Int) -> List (Int, Int) .
sweepDead hs = case hs of
    Nil -> Nil
  | (k, c) :: rest -> if Sys.alive c then (k, c) :: sweepDead rest else sweepDead rest.
# no live handles left.  A file actor of its own (mgr 0) ends here and
# frees its slot.  One a manager spawned must NOT end on its own: the
# manager may already have handed it the next Open, which would then never
# be answered.  It tells the manager it is idle and keeps serving; the
# manager, which forwards every Open, asks it to retire (fileRetireAsk)
# while no Open can be in flight.
fileRetire : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> Unit .
fileRetire mgr st path me body next hs = case hs of
    Nil -> (if mgr > 0 then fileIdle mgr me >> fileServe mgr st path me body next hs else Unit)
  | h :: rest -> fileServe mgr st path me body next hs.
# Private retirement: Timed Write -1 (IInt marginMs); legacy Timed Close -1
# uses the default margin. Retire
# if no lease is held.  It ends only when the request is well inside its
# deadline, so the manager is still waiting for the answer and has
# forwarded nothing since; anything else answers "busy" (Ok 0).  A forged
# request can at most retire an idle actor (clients are not authenticated:
# see filesMgr).
fileRetireAsk : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> Int -> Int -> Unit .
fileRetireAsk mgr st path me body next hs ret sender until =
  fileRetireWith (FP.marginMs FP.defaults) mgr st path me body next hs ret sender until.
fileRetireWith margin mgr st path me body next hs ret sender until =
  idle = case hs of Nil -> True | h :: rest -> False;
  if mgr > 0 and sender == mgr and idle and margin > 0 and margin <= intMax Unit / 1000 and until - AC.nowUs Unit > margin * 1000
  then AC.reply ret (Ok 1) >> Unit
  else AC.reply ret (Ok 0) >> fileServe mgr st path me body next hs.
# not loaded yet (storage was unreachable): try again on this request
fileLoaded : unsafe Int -> String -> Int -> Result String String -> Result String String .
fileLoaded st path me body = case body of
    Ok b -> body
  | Err e -> storage me st (SP.Replay path).
fileMsg : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> Int -> EP.Ep -> Unit .
fileMsg mgr st path me body next hs ret sender q = case q of
    EP.Timed until command -> fileTimed mgr until st path me body next hs ret sender command
  | Open url mode -> if strEq mode "replace" then fileTruncate mgr st path me body next hs ret sender
      else _ = AC.reply ret (Opened next); fileServe mgr st path me body (next + 1) ((next, sender) :: hs)
  | Read h n -> if hOwner hs h != sender then AC.reply ret (Err "no such handle") >> fileRetire mgr st path me body next hs
      else loaded = fileLoaded st path me body; AC.reply ret (fileText path loaded) >> fileServe mgr st path me loaded next hs
  | Write h v -> if hOwner hs h != sender then AC.reply ret (Err "no such handle") >> fileRetire mgr st path me body next hs
      else fileWr mgr st path me (fileLoaded st path me body) next hs ret sender v
  | Close h -> if h < 0 then AC.reply ret (Ok 0) >> fileServe mgr st path me body next hs
      else _ = AC.reply ret (Ok 0); fileRetire mgr st path me body next (hDrop2 hs h sender).
# open "replace": the file is emptied now (its records tombstoned), and what
# the handle writes is its whole text -- open(2)'s O_TRUNC
fileTruncate : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> Int -> Unit .
fileTruncate mgr st path me body next hs ret sender = case storage me st (SP.Delete path) of
    Ok u -> AC.reply ret (Opened next) >> fileServe mgr st path me (Ok "") (next + 1) ((next, sender) :: hs)
  | Err why -> AC.reply ret (Refused "replace {path}: {why}") >> fileServe mgr st path me body next hs.
fileTimed : unsafe Int -> Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> Int -> EP.Ep -> Unit .
fileTimed mgr until st path me body next hs ret sender q =
  if AC.nowUs Unit >= until then AC.reply ret (Err "endpoint: deadline exceeded before execution") >> fileServe mgr st path me body next hs else
  case q of
      Write h (IInt margin) -> if h == 0 - 1 then fileRetireWith margin mgr st path me body next hs ret sender until
        else fileMsg mgr st path me body next hs ret sender (Write h (IInt margin))
    | Read h n -> if hOwner hs h != sender then AC.reply ret (Err "no such handle") >> fileRetire mgr st path me body next hs
        else loaded = fileLoadedUntil until st path me body; AC.reply ret (fileText path loaded) >> fileServe mgr st path me loaded next hs
    | Write h (IStr text) -> if hOwner hs h != sender then AC.reply ret (Err "no such handle") >> fileRetire mgr st path me body next hs
        else loaded = fileLoadedUntil until st path me body; (case loaded of
        Err why -> AC.reply ret (Err "write failed: {path} could not be read ({why})") >> fileServe mgr st path me loaded next hs
      | Ok bytes -> fileWr2 mgr st path me bytes next hs ret text (storageUntil until me st (SP.Append path text)))
    | Close h -> if h < 0 then fileRetireAsk mgr st path me body next hs ret sender until
        else _ = AC.reply ret (Ok 0); fileRetire mgr st path me body next (hDrop2 hs h sender)
    | EP.Timed other command -> fileTimed mgr (if other < until then other else until) st path me body next hs ret sender command
    | command -> fileMsg mgr st path me body next hs ret sender command.
fileLoadedUntil until st path me body = case body of Ok bytes -> body | Err why -> storageUntil until me st (SP.Replay path).
fileText : unsafe String -> Result String String -> Result EP.IoV String .
fileText path body = case body of
    Ok b -> Ok (IStr b)          # an empty file reads as "", like any other text
  | Err e -> Err "read failed: {path} ({e})".
fileWr : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> Int -> EP.IoV -> Unit .
fileWr mgr st path me body next hs ret sender v = case v of
    IStr text -> fileWr1 mgr st path me body next hs ret text
  | o -> AC.reply ret (Err "write failed: {path} wants IStr") >> fileServe mgr st path me body next hs.
fileWr1 : unsafe Int -> Int -> String -> Int -> Result String String -> Int -> List (Int, Int) -> (Int, Int) -> String -> Unit .
fileWr1 mgr st path me body next hs ret text = case body of
    Err e -> AC.reply ret (Err "write failed: {path} could not be read ({e})") >> fileServe mgr st path me body next hs
  | Ok b -> fileWr2 mgr st path me b next hs ret text (storage me st (SP.Append path text)).
fileWr2 : unsafe Int -> Int -> String -> Int -> String -> Int -> List (Int, Int) -> (Int, Int) -> String -> Result String String -> Unit .
fileWr2 mgr st path me b next hs ret text r = case r of
    Ok u -> AC.reply ret (Ok (IInt (strlen text))) >> fileServe mgr st path me (Ok (strcat b text)) next hs
  | Err e -> AC.reply ret (Err "write failed: {e}") >> fileServe mgr st path me
      (if strIndexOf "outcome unknown" e >= 0 then Err "write outcome unknown: {e}" else Ok b) next hs.

# the manager owns the file NAMESPACES (/tmp, /home) and every file in them.
#
# Leases and identity: a lease is (handle, client), where the client is
# the replyTo the request names.  The actor IPC does not tell a receiver
# who sent a message, so that name is the client's own claim: a client
# that learns another's handle and actor id can use its lease.  Binding
# leases to an authenticated sender needs the runtime to report the
# sender of a receive (and the manager to vouch for it when it forwards
# an Open) -- an IPC change, not one this module can make.
#
# File actors are retired by the manager, never on their own: one that
# holds no lease says so (fileIdle) and the manager asks it to retire while
# no Open can be in flight (filesRetireAsk). At the configured actor budget
# the manager tries to release one idle live actor under one shared deadline.
# A file's path is registered in the namespace with the MANAGER as its
# owner, so an open comes here and the manager hands it to the file's
# actor -- spawned on the first open: a known file costs one namespace
# entry until it is used, and the manager may withdraw the path (delete).
#
# The set of files survives a reboot as the record `sys/files`: one line
# per change, "+<path>" or "-<path>", replayed and folded at boot
# (filesKnownAtBoot), so every file a previous boot made is listed and
# openable again.  A path the record does not know but storage holds (a
# file from before the record existed) is adopted on its first open.  A
# read or delete of a path that does not exist is refused; a write creates
# it.  (docs/2026-10-16-EDITOR.md)
filesIndex = "sys/files".
filesMgr : unsafe Int -> Int -> List String -> Int -> a .
# Compatibility entry for callers constructing a private namespace manager.
filesMgr st ns known me = filesServe (FilesCtx st ns FP.defaults 0 0) me (filesEntries known).
FilesCtx = Type (FilesCtx Int Int FP.Policy Int Int).
# The normal boot entry exposes a leased endpoint; the manager owns the only
# policy copy and revision. The adapter carries the original deadline/client.
filesManaged st ns known me =
  admin = Wire.spawn 8 Wire.inboxBytes (Endpoint.simpleUntil (filesPolicyRead me) (filesPolicyWrite me));
  _ = claim me ns FP.url admin;
  _ = claim me ns FP.schemaUrl admin;
  filesServe (FilesCtx st ns FP.defaults 0 admin) me (filesEntries known).
filesPolicyRead mgr until me client url =
  if strEq url FP.schemaUrl then Ok (IStr FP.schema)
  else if strEq url FP.url then filesPolicyCall until me mgr (Read client 0)
  else Err "no such file-policy endpoint".
filesPolicyWrite mgr until me client url value =
  if not (strEq url FP.url) then Err "file-policy schema is read-only"
  else if Sys.pidOf client != 0 then Err "file policy: updates are system-only"
  else filesPolicyCall until me mgr (Write client value).
filesPolicyCall until me mgr command = case AC.callUntil until me mgr (EP.Timed until command) of
    Ok result -> result
  | Err why -> Err "file policy: {why}; read current revision before retrying".
filesConfigure until ctx me act ret client value =
  FilesCtx st ns policy revision admin = ctx;
  if Sys.pidOf client != 0 then AC.reply ret (Err "file policy: updates are system-only") >> filesServe ctx me act
  else case value of
    IStr text -> (case FP.parse text of
        Err why -> AC.reply ret (Err (FP.message why)) >> filesServe ctx me act
      | Ok update -> (case FP.apply revision (filesLive act) update of
          Err why -> AC.reply ret (Err (FP.message why)) >> filesServe ctx me act
        | Ok next -> filesCommit until ctx me act ret next))
  | other -> AC.reply ret (Err "file policy: update wants IStr") >> filesServe ctx me act.
filesCommit until ctx me act ret next =
  FilesCtx st ns policy revision admin = ctx;
  case AC.deadlineAfter (FP.reclaimMs next) of
    Err why -> AC.reply ret (Err "file policy: reclaim deadline would overflow") >> filesServe ctx me act
  | Ok deadline -> if AC.nowUs Unit >= until then AC.reply ret (Err "file policy: deadline exceeded before update") >> filesServe ctx me act
      else _ = AC.reply ret (Ok (IStr (FP.snapshot (revision + 1) next (filesLive act))));
        filesServe (FilesCtx st ns next (revision + 1) admin) me act.
filesEntries Nil = Nil.
filesEntries (p :: rest) = (p, 0) :: filesEntries rest.
# boot: the files the record names (and the seeded two), registered for mgr
filesKnownAtBoot : unsafe Int -> Int -> List String .
filesKnownAtBoot me st = case storage me st (SP.Replay filesIndex) of
    Ok log -> filesFold (lines log) ["/home/notes.txt", "/tmp/scratch.txt"]
  | Err why -> _ = Sys.logAt 1 "system: file index unreadable ({why}); only seeded files listed"; ["/home/notes.txt", "/tmp/scratch.txt"].
filesFold : unsafe List String -> List String -> List String .
filesFold changes acc = case changes of
    Nil -> acc
  | c :: rest -> filesFold rest (filesApply c acc).
filesApply c acc = if strlen c < 2 then acc else
  path = substr c 1 (strlen c - 1);
  if charAt c 0 == 43 then (if filesHas acc path then acc else cat acc [path])
  else if charAt c 0 == 45 then filesWithout acc path else acc.
filesHas Nil p = False.
filesHas (q :: rest) p = strEq q p or filesHas rest p.
filesWithout Nil p = Nil.
filesWithout (q :: rest) p = if strEq q p then filesWithout rest p else q :: filesWithout rest p.
filesRegister : unsafe Int -> Int -> Int -> List String -> Unit .
filesRegister me ns mgr known = case known of
    Nil -> Unit
  | p :: rest -> _ = (case EP.register me ns p mgr of Ok u -> Unit | Err why -> Sys.logAt 1 "system: {p}: {why}"); filesRegister me ns mgr rest.
# one change to the record; a failure is logged, the file itself is unaffected
filesNote : unsafe Int -> Int -> String -> Unit .
filesNote st me change = case storage me st (SP.Append filesIndex "{change}\n") of
    Ok u -> Unit
  | Err why -> Sys.logAt 1 "system: file index not updated ({change}: {why})".

filesServe : unsafe FilesCtx -> Int -> List (String, Int) -> a .
filesServe ctx me act =
  m = receive me;
  case m of
      (from, id, q) -> filesMsg (intMax Unit) ctx me act (from, id) from q
    | stale -> filesServe ctx me act.   # e.g. a retire answer that came after its deadline
filesMsg : unsafe Int -> FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> Int -> EP.Ep -> a .
filesMsg deadline ctx me act ret from q =
  FilesCtx st ns policy revision admin = ctx;
  case q of
    EP.Timed until command -> if AC.nowUs Unit >= until then AC.reply ret (Err "endpoint: deadline exceeded before execution") >> filesServe ctx me act else filesMsg (if until < deadline then until else deadline) ctx me act ret from command
  | Open url mode -> filesOpen ctx me act ret from url mode
  | Read h n -> if from == admin and admin > 0 then AC.reply ret (Ok (IStr (FP.snapshot revision policy (filesLive act)))) >> filesServe ctx me act
      else AC.reply ret (Err "a file namespace: open a path under it") >> filesServe ctx me act
  | Write h v -> if from == admin and admin > 0 then filesConfigure deadline ctx me act ret h v
      else AC.reply ret (Err "a file namespace: open a path under it") >> filesServe ctx me act
  | Close h -> if h < 0 then filesIdle ctx me act from else AC.reply ret (Ok 0) >> filesServe ctx me act.
# a file actor says it holds no lease (fileIdle).  Only a hint: the
# manager asks the actor itself, and retires it only on its own yes.
filesIdle : unsafe FilesCtx -> Int -> List (String, Int) -> Int -> a .
filesIdle ctx me act a =
  FilesCtx st ns policy revision admin = ctx;
  case filesUrlOf act a of
    Nil -> filesServe ctx me act
  | url :: none -> filesServe ctx me (if filesRetireWith policy (filesDeadline policy) me a then filesSet act url 0 else act).
filesUrlOf : unsafe List (String, Int) -> Int -> List String .
filesUrlOf act a = case act of
    Nil -> Nil
  | (p, b) :: rest -> if b == a and a > 0 then [p] else filesUrlOf rest a.
# ask one file actor to retire; the manager waits for the answer, so no
# Open is forwarded to it meanwhile, and one forwarded before is already
# ahead of this request in its mailbox (it then holds a lease and says
# no).  True: it has ended (or had already).  A late or missing answer is
# "no": the actor is kept, and asked again when it is next idle.
# A clock near exhaustion cannot start another pass. Never wrap a deadline.
filesDeadline policy = case AC.deadlineAfter (FP.reclaimMs policy) of Ok until -> until | Err why -> AC.nowUs Unit.
filesRetireAsk : unsafe Int -> Int -> Bool .
filesRetireAsk me a = filesRetireWith FP.defaults (filesDeadline FP.defaults) me a.
filesRetireAskUntil : unsafe Int -> Int -> Int -> Bool .
filesRetireAskUntil until me a = filesRetireWith FP.defaults until me a.
filesRetireWith policy until me a = if not (Sys.alive a) then True else
  case AC.callUntil until me a (EP.Timed until (Write (0 - 1) (IInt (FP.marginMs policy)))) of
      Ok answer -> (case answer of Ok n -> n == 1 | Err why -> False)
    | Err why -> not (Sys.alive a).
# At the budget, one new Open needs one live slot. Share the configured
# deadline across the entire pass, rather than renewing it for each actor.
# A timeout retains the owner; the existing retirement margin still applies.
# Dead entries already cost no live slot, so clearing one must not stop the
# search for a live actor that can release capacity.
filesReclaim : unsafe Int -> List (String, Int) -> List (String, Int) .
filesReclaim me act = filesReclaimWith FP.defaults (filesDeadline FP.defaults) me act.
filesReclaimUntil : unsafe Int -> Int -> List (String, Int) -> List (String, Int) .
filesReclaimUntil until me act = filesReclaimWith FP.defaults until me act.
filesReclaimWith policy until me act = if AC.nowUs Unit >= until then act else case act of
    Nil -> Nil
  | (p, a) :: rest ->
      if a <= 0 then (p, a) :: filesReclaimWith policy until me rest
      else if not (Sys.alive a) then (p, 0) :: filesReclaimWith policy until me rest
      else if filesRetireWith policy until me a then (p, 0) :: rest
      else (p, a) :: filesReclaimWith policy until me rest.
# the entry for a path: -1 unknown, 0 known with no actor, else its actor
filesEntry : unsafe List (String, Int) -> String -> Int .
filesEntry act url = case act of
    Nil -> 0 - 1
  | (p, a) :: rest -> if strEq p url then a else filesEntry rest url.
filesSet : unsafe List (String, Int) -> String -> Int -> List (String, Int) .
filesSet act url a = case act of
    Nil -> [(strcat url "", a)]
  | (p, b) :: rest -> if strEq p url then (p, a) :: rest else (p, b) :: filesSet rest url a.
filesDrop : unsafe List (String, Int) -> String -> List (String, Int) .
filesDrop act url = case act of
    Nil -> Nil
  | (p, b) :: rest -> if strEq p url then rest else (p, b) :: filesDrop rest url.
filesOpen : unsafe FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> Int -> String -> String -> a .
filesOpen ctx me act ret from url mode =
  FilesCtx st ns policy revision admin = ctx;
  a0 = filesEntry act url;
  reading = strEq mode "read";
  deleting = strEq mode "delete";
  if a0 > 0 and Sys.alive a0 then
    (if deleting then filesDelete ctx me act ret url a0 else filesHand ctx me act ret from url mode a0)
  else if a0 >= 0 then
    (if deleting then filesDelete ctx me act ret url 0 else filesSpawn ctx me act ret from url mode)
  else if not reading and not deleting then filesMake ctx me act ret from url mode
  else if filesStored st me url then
    # a file older than the record: adopt it, then serve this open
    _ = Sys.logAt 0 "system: adopting {url}";
    _ = EP.register me ns url 0;
    _ = filesNote st me "+{url}";
    next = filesSet act url 0;
    (if deleting then filesDelete ctx me next ret url 0 else filesSpawn ctx me next ret from url mode)
  else AC.reply ret (Refused "no such file: {url}") >> filesServe ctx me act.
# does storage hold records for the path? (stats: "... url-records=N ...")
filesStored : unsafe Int -> Int -> String -> Bool .
filesStored st me url = case storage me st (SP.Stats url) of
    Ok text -> filesRecords text > 0
  | Err why -> False.
filesRecords text = at = strIndexOf "url-records=" text;
  if at < 0 then 0 else parseInt (substr text (at + 12) (strlen text - at - 12)).
# delete: the file's actor ends, its path leaves the namespace and the
# record, its records leave the log
filesDelete : unsafe FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> String -> Int -> a .
filesDelete ctx me act ret url a =
  FilesCtx st ns policy revision admin = ctx;
  # the actor may already have retired on its last close: only kill it live
  _ = (if a > 0 and Sys.alive a then kill a else Unit);
  _ = EP.unregister me ns url;
  deleted = storage me st (SP.Delete url);
  _ = (if filesTransient url then Unit else filesNote st me "-{url}");
  _ = (if filesTransient url then Unit else Sys.logAt 0 "system: deleted {url}");
  case deleted of
    Ok u -> AC.reply ret (Opened 0) >> filesServe ctx me (filesDrop act url)
  | Err why -> AC.reply ret (Refused "delete {url}: {why}") >> filesServe ctx me (filesDrop act url).
# a new path: registered, recorded, then served like a known one
filesMake : unsafe FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> Int -> String -> String -> a .
filesMake ctx me act ret from url mode =
  FilesCtx st ns policy revision admin = ctx;
  if strlen url > FP.maxPath policy then AC.reply ret (Refused "path longer than {FP.maxPath policy} bytes") >> filesServe ctx me act else
  _ = (if filesTransient url then Unit else Sys.logAt 0 "system: creating {url}");
  _ = EP.register me ns url 0;
  _ = (if filesTransient url then Unit else filesNote st me "+{url}");
  filesSpawn ctx me (filesSet act url 0) ret from url mode.
# an editor's safety copy lives only for one save: never in the record
filesTransient url = strlen url > 6 and strEq (substr url (strlen url - 6) 6) ".~save".
# a known path's actor, on its first open (live actors are bounded: each
# caches its file's text; known files cost only their namespace entry)
filesSpawn : unsafe FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> Int -> String -> String -> a .
filesSpawn ctx me act ret from url mode =
  FilesCtx st ns policy revision admin = ctx;
  act2 = if filesLive act >= FP.maxLive policy then filesReclaimWith policy (filesDeadline policy) me act else act;
  if filesLive act2 >= FP.maxLive policy then AC.reply ret (Refused "file actor budget exhausted ({FP.maxLive policy} live files)") >> filesServe ctx me act2 else
  p2 = strcat url "";      # OWN COPY: curried into the actor + the set
  a = Wire.spawn 8 Wire.inboxBytes (fileActorOf me st p2);
  filesHand ctx me (filesSet act2 p2 a) ret from url mode a.
filesLive Nil = 0.
filesLive ((p, a) :: rest) = (if a > 0 and Sys.alive a then 1 else 0) + filesLive rest.
# forward the client's own envelope to the file and point the client at it
filesHand : unsafe FilesCtx -> Int -> List (String, Int) -> (Int, Int) -> Int -> String -> String -> Int -> a .
filesHand ctx me act ret from url mode a =
  (f, id) = ret;
  _ = case send a (from, id, Open url mode) of
      Ok u -> AC.reply ret (Redirect a)
    | Err e -> AC.reply ret (Refused "{url}: its file actor {e}");
  filesServe ctx me act.

# ---- apps: /apps/<id> names a loaded table, /apps/<id>.qa is its image -------
# the image bytes are the disk's record; without a disk there are none
qaFetch : unsafe Int -> Int -> String -> Result String String .
qaFetch st me id = case st == 0 of
    True -> Err "storage offline"
  | False -> storage me st (SP.ReadLatest "apps/{id}.qa").
appsText : unsafe List App -> String -> String .
appsText apps path = case apps of
    Nil -> (case strEq path "/apps" of True -> "the loaded apps: /apps/<id>" | False -> "no such app")
  | a :: r -> appsHit r path a.
appsHit : unsafe List App -> String -> App -> String .
appsHit r path a = case a of App aid anm ati ->
  case strEq path "/apps/{aid}" of
    True -> "{anm} ({aid}): module table #{ati}, loaded from apps/{aid}.qa"
  | False -> appsText r path.

# ---- disk enumeration: apps/index -> attach each ------------------------------
# Installing an app = appending its records (mkdisk.py or, later, a
# runtime installer).  A missing or partial .qa is logged and skipped;
# the boot continues -- absence is data.

attachAll me st = attachIdx me st (storage me st (SP.ReadLatest "apps/index")).
attachIdx me st r = case r of
    Err e -> attachNone e
  | Ok idx -> attachIds me st (lines idx).
attachNone e =
  _ = Sys.logAt 1 "system: no apps/index on the disk ({e})";
  Nil.
attachIds : unsafe Int -> Int -> List String -> List App .
attachIds me st ids = case ids of
    Nil -> Nil
  | id :: r -> attachOne me st r id.
attachOne : unsafe Int -> Int -> List String -> String -> List App .
attachOne me st r id =
  b = storage me st (SP.ReadLatest "apps/{id}.qa");
  case b of
    Err e -> attachMiss me st r id e
  | Ok bytes -> attachGo me st r id bytes.
attachMiss : unsafe Int -> Int -> List String -> String -> String -> List App .
attachMiss me st r id e =
  _ = Sys.logAt 1 "system: apps/{id}.qa unreadable ({e}), skipped";
  attachIds me st r.
attachGo : unsafe Int -> Int -> List String -> String -> String -> List App .
attachGo me st r id bytes =
  ti = Mod.plugs 0;
  (aid, anm) = qaManifest bytes;
  a = Plug.attach bytes;
  case a of
    Err e -> attachErr me st r id e
  | Ok u -> attachOk me st r id aid anm ti.
attachErr : unsafe Int -> Int -> List String -> String -> String -> List App .
attachErr me st r id e =
  _ = Sys.logAt 1 "system: attach {id} failed ({e}), skipped";
  attachIds me st r.
attachOk : unsafe Int -> Int -> List String -> String -> String -> String -> Int -> List App .
attachOk me st r id aid anm ti =
  _ = Sys.logAt 0 "system: app {aid} ({anm}) -> table #{ti}";
  App aid anm ti :: attachIds me st r.

appIds : unsafe List App -> String .
appIds apps = case apps of
    Nil -> ""
  | a :: r -> aiStep r a.
aiStep : unsafe List App -> App -> String .
aiStep r a = case a of App aid anm ati ->
  case r of
    Nil -> aid
  | x :: y -> "{aid},{appIds r}".

# ---- boot: bring the System layer up ------------------------------------------
# Returns Qsys ns st ns log apps.  Degrades honestly without a disk:
# storage 0, no apps, the namespace still serves /logs.

# The coordinator keeps the administrator identity while the shell blocks
# on input or an app. Callers retaining ctx can also request a normal stop.
boot me =
  (q, ctx) = bootManagedSized me 0 0;
  q.
bootSized me w h =
  (q, ctx) = bootManagedSized me w h;
  q.
bootManagedSized me w h =
  ctx = case Lifecycle.start me of Ok value -> value | Err why -> error why;
  block = Lifecycle.block ctx;
  st = Lifecycle.files ctx;
  _ = case st == 0 of True -> Sys.logAt 1 "system: storage and apps offline" | False -> Unit;
  apps = case st == 0 of True -> Nil | False -> attachAll me st;
  (bootWireSizedBlock w h me st apps block, ctx).
stop me ctx = Lifecycle.stop me ctx.
ready ctx = case Lifecycle.files ctx == 0 of True -> Unit | False -> Sys.ready Unit.
bootNoDisk me =
  _ = Sys.logAt 1 "system: no disk -- storage and apps offline";
  bootWire me 0 Nil.
bootWire : unsafe Int -> Int -> List App -> Qsys .
bootWire me st apps = bootWireBlock me st apps 0.
bootWireBlock : unsafe Int -> Int -> List App -> Int -> Qsys .
bootWireBlock me st apps block = bootWireSizedBlock 0 0 me st apps block.
bootWireSized : unsafe Int -> Int -> Int -> Int -> List App -> Qsys .
bootWireSized w h me st apps = bootWireSizedBlock w h me st apps 0.
bootWireSizedBlock : unsafe Int -> Int -> Int -> Int -> List App -> Int -> Qsys .
bootWireSizedBlock w h me st apps block =
  ns = spawnD Endpoint.namespace;
  _ = claim me ns "/" (spawnD (Endpoint.lister ns));
  _ = case block == 0 of True -> Unit | False -> claim me ns "/services/block" (spawnD (BlockEP.serve block));
  _ = claim me ns "/services/storage-schema" (spawnD (Endpoint.simple storageSchema EP.noWrite));
  logA = spawnD logActor;
  logs = spawnD (Endpoint.simple logR logW);
  _ = claim me ns "/services/log" logs;
  _ = claim me ns "/logs" logs;
  appsA = spawnD (Endpoint.simple (AppsEP.images (qaFetch st) (appsText apps)) EP.noWrite);
  _ = claim me ns "/apps" appsA;
  # the display, when this host has one: Graphics.qa owns it; programs
  # open sessions at /services/graphics/<tag> (mods/graphics.fpr)
  # EGL contexts stay current on the creating OS thread. Pin the owner
  # to hart 0 so waking it on another worker cannot strand that binding.
  _ = case glHas 0 == 1 of
      True -> claim me ns "/services/graphics" (AC.spawnWithOn 0 (AC.Dynamic 64) (GX.service w h GL.glBackend Nil))
    | False -> Unit;
  _ = claimApps me ns appsA apps;
  _ = case st == 0 of
      True -> Unit
    | False -> bootDiskUrls me ns st;
  Qsys ns st ns logA apps.
claimApps : unsafe Int -> Int -> Int -> List App -> Unit .
claimApps me ns appsA apps = case apps of
    Nil -> Unit
  | a :: r -> caStep me ns appsA r a.
caStep : unsafe Int -> Int -> Int -> List App -> App -> Unit .
caStep me ns appsA r a = case a of App aid anm ati ->
  claim me ns "/apps/{aid}" appsA >> claim me ns (AppsEP.qaUrl aid) appsA >> claimApps me ns appsA r.
# with a disk: the records as urls, and the file namespaces with two
# files that have always been there
bootDiskUrls : unsafe Int -> Int -> Int -> Unit .
bootDiskUrls me ns st =
  _ = claim me ns "/services/storage" (Wire.spawn 8 Wire.inboxBytes (Endpoint.simple (stR st) (stW st)));
  known = filesKnownAtBoot me st;
  mgr = Wire.spawn 8 Wire.inboxBytes (filesManaged st ns known);
  _ = claim me ns "/tmp" mgr;
  _ = claim me ns "/home" mgr;
  # every file a previous boot made (and the two seeded ones), owned by the
  # manager: its actor is spawned on the first open
  filesRegister me ns mgr known.

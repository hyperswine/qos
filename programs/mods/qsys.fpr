# ============================================================================
# qsys.fpr -- QOS Portable's System layer as a MODULE: the service
# actors the old pshell carried inline, extracted -- and SIMPLIFIED,
# because storage is now mods/qlog over `device "blk"` (qosp.disk).
# QLog records are URL-KEYED natively, so the old kv-era machinery
# (paths encoded inside payloads, tag-5 index walks, FSMapper) does not
# survive the move: a file actor is readLatest/replayAll/appendRec on
# its own url and nothing else.
#
# What lives here:
#   sysActor            the URL registry: Lookup / Reg, append forever
#   QL.actor            (spawned by boot) the ONE disk writer -- svc's
#                       Rpc protocol, tags 1 latest / 2 append /
#                       3 replay / 4 tombstone / 5 stats
#   logActor            stateless facade over the C severity rings,
#                       serving /logs(/normal|warns|errors)
#   filesActor/fileActor  one actor per real file, spawned lazily;
#                       content cached after one replay; writes append
#   vfsActor            the root namespace: entries (path, kind, owner)
#                       kind 0 service / 1 data / 2 file; resolution is
#                       a walk to the owner; create-on-write in the
#                       file namespaces (/home/, /tmp/)
#   attachAll           DISK ENUMERATION: read apps/index, then per id
#                       read apps/<id>.qa and Sys.attachQa the bytes --
#                       installing an app is appending records, no
#                       shell rebuild
#   qaManifest          minimal QAR2 manifest reader (id, name): app
#                       metadata comes from the archive itself
#
# PROTOCOL INTEROP: the namespace verbs are appkit's Ak constructors
# (Read/Write/VfsList/LogAdd/LogSnap) -- tids are per (unit, type), so
# using appkit's type is what lets app plugins compiled against appkit
# pattern-match here.  Only the registry protocol (Sq) is local.
#
# Permission gate: NOT yet enforced on this path (stated).  The
# manifest is parsed for identity; converging the plugin contract with
# the process model's [permissions.*] gate is the named next step.
# ============================================================================

AK  = use "appkit".
QL  = use "qlog".
SVC = use "svc".
Core = use "coreutil".
QAR = use "qar".

Rpc     = SVC.Rpc.
Read    = AK.Read.
Write   = AK.Write.
VfsList = AK.VfsList.
LogAdd  = AK.LogAdd.
LogSnap = AK.LogSnap.

# the registry protocol (local: only shell-side code talks to it)
Sq = Type (Lookup url | Reg reg).

# a discovered app: manifest id + name + its module-table index
App = Type (App aid anm ati).

# the boot record boot returns (a declared constructor: the ABI has
# Tup2/Tup3 only, and this crosses units)
Qsys = Type (Qsys sys st vfs log apps).

# ---- small helpers ----------------------------------------------------------

strEq a b = Core.strEq a b.

okOr r alt = case r of Ok s -> s | Err e -> alt.
emptyAs s alt = case strlen s == 0 of True -> alt | False -> s.

# one request, one reply -- the (me, q) tuple protocol every service
# actor here answers
call me a q = _ = send a (me, q); receive me.
# the storage actor's protocol (svc's Rpc; reply is a bare Result)
rpc me st tag url pay = _ = send st (Rpc me tag url pay); receiveFrom me st.

hasPrefix s pre = case strlen s < strlen pre of
    True -> False
  | False -> strEq (substr s 1 (strlen pre)) pre.

# newline-split, used on apps/index ("id1\nid2\n")
lines : unsafe String -> List String .
lines s = Core.lines s.

cat : unsafe List a -> List a -> List a .
cat l b = Core.listAppend l b.
lenL : unsafe List a -> Int .
lenL l = Core.listLen l.

# ---- QAR2 manifest reading --------------------------------------------------
# "QAR2\n" <table lines "NAME off len"> "\n" <payloads>.  We only need
# the MANIFEST section and only its id/name fields -- app identity
# comes from the archive, not from a hardcoded list.

# `key = "value"` line scan inside the manifest slice
mfField : unsafe String -> String -> String .
mfField man key = mfGo man (strcat key " = ") 1 (strlen man).
mfGo : unsafe String -> String -> Int -> Int -> String .
mfGo man pre i n = case i > n of
    True -> ""
  | False -> mfTry man pre i n.
mfTry : unsafe String -> String -> Int -> Int -> String .
mfTry man pre i n =
  pl = strlen pre;
  case i + pl > n of
    True -> ""
  | False -> case strEq (substr man i pl) pre of
      True -> mfVal man (i + pl) n
    | False -> mfSkip man pre i n.
mfSkip : unsafe String -> String -> Int -> Int -> String .
mfSkip man pre i n = case charAt man i == 10 of
    True -> mfGo man pre (i + 1) n
  | False -> mfSkip man pre (i + 1) n.
mfVal : unsafe String -> Int -> Int -> String .
mfVal man i n = case charAt man i == 34 of
    True -> mfQ man (i + 1) n ""
  | False -> "".
mfQ : unsafe String -> Int -> Int -> String -> String .
mfQ man i n acc = case i > n of
    True -> acc
  | False -> case charAt man i == 34 of
      True -> acc
    | False -> mfQ man (i + 1) n (strcat acc (chr (charAt man i))).

# (id, name) from the .qa bytes; ("", "") when unreadable
qaManifest bytes =
  case QAR.manifestOf bytes of
    Err e -> ("", "")
  | Ok man -> qaMan2 man.
qaMan2 man = (mfField man "id", mfField man "name").

# ---- the registry: one loop, forever ----------------------------------------
# Lookups answered, registrations APPENDED -- a service can register at
# any time.  Received roots are destructure-then-dead (autodrop).

findSvc : unsafe List (String, Int) -> String -> Int .
findSvc reg url = case reg of
    Nil -> 0
  | e :: r -> fsStep r url e.
fsStep : unsafe List (String, Int) -> String -> (String, Int) -> Int .
fsStep r url e = case e of (u, a) ->
  case strEq u url of True -> a | False -> findSvc r url.

sysActor me = sysLoop me Nil.
sysLoop : unsafe Int -> List (String, Int) -> a .
sysLoop me reg0 =
  m = receive me;
  (replyTo, q) = m;
  sysMsg me reg0 replyTo q.
sysMsg : unsafe Int -> List (String, Int) -> Int -> Sq -> a .
sysMsg me reg0 replyTo q = case q of
    Lookup url -> send replyTo (findSvc reg0 url) >> sysLoop me reg0
  | Reg reg -> send replyTo 1 >> sysLoop me (cat reg reg0).

svcLookup me sys url = call me sys (Lookup url).

# ---- the log service: /logs, a stateless facade over the C rings ------------
sevOfPath p = case strEq p "/logs/warns" of
    True -> 1
  | False -> case strEq p "/logs/errors" of True -> 2 | False -> 0.
joinNl : unsafe List String -> String .
joinNl l = case l of Nil -> "(empty)" | x :: r -> joinGo x r.
joinGo : unsafe String -> List String -> String .
joinGo acc l = case l of Nil -> acc | x :: r -> joinGo "{acc}\n{x}" r.

logActor : unsafe Int -> a .
logActor me =
  m = receive me;
  (replyTo, q) = m;
  logMsg me replyTo q.
logMsg : unsafe Int -> Int -> b -> a .
logMsg me replyTo q = case q of
    LogAdd sev line -> logDo me replyTo sev line
  | LogSnap sev -> send replyTo (Sys.logSnap sev) >> logActor me
  | Read path -> send replyTo (joinNl (Sys.logSnap (sevOfPath path))) >> logActor me
  | _ -> error "qsys log: unexpected message".
logDo : unsafe Int -> Int -> Int -> String -> a .
logDo me replyTo sev line =
  _ = Sys.logAt sev line;
  send replyTo 0 >> logActor me.

# ---- files: one actor per real file, url-native over the qlog ---------------
# The file IS the replay of its url's records; a write is one appended
# record.  The storage actor stays the single writer -- the file actor
# routes its append through Rpc rather than touching the device.

fileActor st path me =
  fileServe st path me (okOr (rpc me st 3 path "") "").
fileServe : unsafe Int -> String -> Int -> String -> a .
fileServe st path me body =
  m = receive me;
  (replyTo, q) = m;
  fileMsg st path me body replyTo q.
fileMsg : unsafe Int -> String -> Int -> String -> Int -> b -> a .
fileMsg st path me body replyTo q = case q of
    Read p -> send replyTo (emptyAs body "(empty file)") >> fileServe st path me body
  | Write p text -> fileWr st path me body replyTo text
  | _ -> error "qsys file: unexpected message".
fileWr : unsafe Int -> String -> Int -> String -> Int -> String -> a .
fileWr st path me body replyTo text =
  r = rpc me st 2 path text;
  _ = send replyTo (fileWrMsg path text r);
  fileServe st path me (strcat body text).
fileWrMsg path text r = case r of
    Ok u -> "wrote {strlen text} bytes to {path}"
  | Err e -> "write failed: {e}".

# the manager: [(path, actor)], find-or-spawn (the lazy part is visible
# in /logs: "system: opening <path>")
filesActor st me = filesServe st me Nil.
filesServe : unsafe Int -> Int -> List (String, Int) -> a .
filesServe st me act =
  m = receive me;
  (replyTo, q) = m;
  filesMsg st me act replyTo q.
filesMsg : unsafe Int -> Int -> List (String, Int) -> Int -> b -> a .
filesMsg st me act replyTo q = case q of
    Read path -> filesFwd st me act replyTo (Read path) path
  | Write path text -> filesFwd st me act replyTo (Write path text) path
  | _ -> error "qsys files: unexpected message".
filesFwd : unsafe Int -> Int -> List (String, Int) -> Int -> b -> String -> a .
filesFwd st me act replyTo q path =
  (a, act2) = fileOf st me act path;
  r = call me a q;
  _ = send replyTo r;
  _ = drop r;               # forward then release our ref (pshell law)
  filesServe st me act2.
fileOf st me act path = fileOf2 st me act path (findSvc act path).
fileOf2 st me act path a0 = case a0 == 0 of
    False -> (a0, act)
  | True -> fileSpawn st me act path.
fileSpawn st me act path =
  _ = Sys.logAt 0 "system: opening {path}";
  p2 = strcat path "";      # OWN COPY: curried into the actor + the set
  a = spawn (fileActor st p2);
  (a, (p2, a) :: act).

# ---- apps: /apps/<id> names a loaded table ----------------------------------
appsActor : unsafe List App -> Int -> a .
appsActor apps me =
  m = receive me;
  (replyTo, Read path) = m;
  _ = send replyTo (appsText apps path);
  appsActor apps me.
appsText : unsafe List App -> String -> String .
appsText apps path = case apps of
    Nil -> "no such app"
  | a :: r -> appsHit r path a.
appsHit : unsafe List App -> String -> App -> String .
appsHit r path a = case a of App aid anm ati ->
  case strEq path "/apps/{aid}" of
    True -> "{anm} ({aid}): module table #{ati}, loaded from apps/{aid}.qa"
  | False -> appsText r path.

# ---- the resolver: the root, such as it is -----------------------------------
# entries (path, kind, owner): kind 0 = service endpoint, 1 = readable,
# 2 = file (actor-backed, writable).  Prefixes are a display idea.

vfsActor ents me = vfsServe ents me.
vfsServe : unsafe List (String, Int, Int) -> Int -> a .
vfsServe ents me =
  m = receive me;
  (replyTo, q) = m;
  vfsMsg ents me replyTo q.
vfsMsg : unsafe List (String, Int, Int) -> Int -> Int -> b -> a .
vfsMsg ents me replyTo q = case q of
    VfsList u -> send replyTo (listCopy ents) >> vfsServe ents me
  | Read path -> vfsRead ents ents me replyTo path >> vfsServe ents me
  | Write path text -> vfsWr ents me replyTo path text
  | _ -> error "qsys vfs: unexpected message".
vfsWr : unsafe List (String, Int, Int) -> Int -> Int -> String -> String -> a .
vfsWr ents me replyTo path text =
  ents2 = vfsEnsure ents path;
  _ = vfsWrite ents2 ents2 me replyTo path text;
  vfsServe ents2 me.

listCopy : unsafe List (String, Int, Int) -> List (String, Int) .
listCopy ents = case ents of
    Nil -> Nil
  | e :: r -> lcStep r e.
lcStep : unsafe List (String, Int, Int) -> (String, Int, Int) -> List (String, Int) .
lcStep r e = case e of (p, k, o) -> (p, k) :: listCopy r.

# create-on-write: a path in a file namespace that nobody has named yet
# gets an entry here; its actor spawns on first touch
fileSpace path = case hasPrefix path "/tmp/" of
    True -> True
  | False -> hasPrefix path "/home/".
hasPath : unsafe List (String, Int, Int) -> String -> Bool .
hasPath ents path = case ents of
    Nil -> False
  | e :: r -> hpStep r path e.
hpStep : unsafe List (String, Int, Int) -> String -> (String, Int, Int) -> Bool .
hpStep r path e = case e of (p, k, o) ->
  case strEq p path of True -> True | False -> hasPath r path.
filesOf : unsafe List (String, Int, Int) -> Int .
filesOf ents = case ents of
    Nil -> 0
  | e :: r -> foStep r e.
foStep : unsafe List (String, Int, Int) -> (String, Int, Int) -> Int .
foStep r e = case e of (p, k, o) ->
  case k == 2 of True -> o | False -> filesOf r.
vfsEnsure ents path = case hasPath ents path of
    True -> ents
  | False -> vfsEnsure2 ents path.
vfsEnsure2 ents path = case fileSpace path of
    False -> ents
  | True -> vfsMk ents path.
vfsMk ents path =
  _ = Sys.logAt 0 "system: creating {path}";
  p2 = strcat path "";      # OWN COPY before it enters long-lived state
  cat ents ((p2, 2, filesOf ents) :: Nil).

# resolution = walk to the owner and relay
vfsRead : unsafe List (String, Int, Int) -> List (String, Int, Int) -> Int -> Int -> String -> Unit .
vfsRead ents all me replyTo path = case ents of
    Nil -> send replyTo "no such path"
  | e :: r -> vrStep r all me replyTo path e.
vrStep : unsafe List (String, Int, Int) -> List (String, Int, Int) -> Int -> Int -> String -> (String, Int, Int) -> Unit .
vrStep r all me replyTo path e = case e of (p, k, o) ->
  case strEq p path of
    True -> vfsServeOne k o me replyTo path
  | False -> vfsRead r all me replyTo path.
vfsServeOne k o me replyTo path = case k == 0 of
    True -> send replyTo "service endpoint (an actor)\nsend it a message; it has no bytes"
  | False -> relay me o replyTo (Read path).
vfsWrite : unsafe List (String, Int, Int) -> List (String, Int, Int) -> Int -> Int -> String -> String -> Unit .
vfsWrite ents all me replyTo path text = case ents of
    Nil -> send replyTo "no such path"
  | e :: r -> vwStep r all me replyTo path text e.
vwStep : unsafe List (String, Int, Int) -> List (String, Int, Int) -> Int -> Int -> String -> String -> (String, Int, Int) -> Unit .
vwStep r all me replyTo path text e = case e of (p, k, o) ->
  case strEq p path of
    True -> vfsWriteOne k o me replyTo path text
  | False -> vfsWrite r all me replyTo path text.
vfsWriteOne k o me replyTo path text = case k == 2 of
    True -> relay me o replyTo (Write path text)
  | False -> send replyTo "not writable (kind {k})".
relay me a replyTo q =
  r = call me a q;
  _ = send replyTo r;
  drop r.

# ---- disk enumeration: apps/index -> attach each ------------------------------
# Installing an app = appending its records (mkdisk.py or, later, a
# runtime installer).  A missing or partial .qa is logged and skipped;
# the boot continues -- absence is data.

attachAll me st = attachIdx me st (rpc me st 1 "apps/index" "").
attachIdx me st r = case r of
    Err e -> attachNone e
  | Ok idx -> attachIds me st (lines idx).
attachNone e =
  _ = Sys.logAt 1 "system: no apps/index on the disk ({e})";
  Nil.
attachIds : unsafe Int -> Int -> List String -> List App .
attachIds me st ids = case ids of
    Nil -> Nil
  | id :: r -> attachOne me st r id.
attachOne : unsafe Int -> Int -> List String -> String -> List App .
attachOne me st r id =
  b = rpc me st 1 "apps/{id}.qa" "";
  case b of
    Err e -> attachMiss me st r id e
  | Ok bytes -> attachGo me st r id bytes.
attachMiss : unsafe Int -> Int -> List String -> String -> String -> List App .
attachMiss me st r id e =
  _ = Sys.logAt 1 "system: apps/{id}.qa unreadable ({e}), skipped";
  attachIds me st r.
attachGo : unsafe Int -> Int -> List String -> String -> String -> List App .
attachGo me st r id bytes =
  ti = Mod.plugs 0;
  (aid, anm) = qaManifest bytes;
  a = Sys.attachQa bytes;
  case a of
    Err e -> attachErr me st r id e
  | Ok u -> attachOk me st r id aid anm ti.
attachErr : unsafe Int -> Int -> List String -> String -> String -> List App .
attachErr me st r id e =
  _ = Sys.logAt 1 "system: attach {id} failed ({e}), skipped";
  attachIds me st r.
attachOk : unsafe Int -> Int -> List String -> String -> String -> String -> Int -> List App .
attachOk me st r id aid anm ti =
  _ = Sys.logAt 0 "system: app {aid} ({anm}) -> table #{ti}";
  App aid anm ti :: attachIds me st r.

appIds : unsafe List App -> String .
appIds apps = case apps of
    Nil -> ""
  | a :: r -> aiStep r a.
aiStep : unsafe List App -> App -> String .
aiStep r a = case a of App aid anm ati ->
  case r of
    Nil -> aid
  | x :: y -> "{aid},{appIds r}".

appEnts : unsafe List App -> Int -> List (String, Int, Int) .
appEnts apps appsA = case apps of
    Nil -> Nil
  | a :: r -> aeStep r appsA a.
aeStep : unsafe List App -> Int -> App -> List (String, Int, Int) .
aeStep r appsA a = case a of App aid anm ati ->
  ("/apps/{aid}", 1, appsA) :: appEnts r appsA.

# ---- boot: bring the System layer up ------------------------------------------
# Returns Qsys sys st vfs log apps.  Degrades honestly without a disk:
# storage 0, no apps, the namespace still serves /logs.

boot me = boot2 me (blkPages (device "blk")).
boot2 me n = case n == 0 of
    True -> bootNoDisk me
  | False -> bootDisk me.
bootNoDisk me =
  _ = Sys.logAt 1 "system: no disk -- storage and apps offline";
  bootWire me 0 Nil.
bootDisk me =
  st = spawn (QL.actor (device "blk"));
  bootWire me st (attachAll me st).
bootWire me st apps =
  sys = spawn sysActor;
  logA = spawn logActor;
  appsA = spawn (appsActor apps);
  ents0 = ("/services/log", 0, logA)
       :: ("/logs/normal", 1, logA)
       :: ("/logs/warns", 1, logA)
       :: ("/logs/errors", 1, logA) :: Nil;
  ents1 = bootFileEnts st;
  vfs = spawn (vfsActor (cat ents0 (cat ents1 (appEnts apps appsA))));
  reg = ("/services/vfs", vfs)
     :: ("/services/log", logA)
     :: ("/services/storage", st) :: Nil;
  _ = call me sys (Reg reg);
  Qsys sys st vfs logA apps.
bootFileEnts st = case st == 0 of
    True -> Nil
  | False -> bootFileEnts2 (spawn (filesActor st)).
bootFileEnts2 filesA =
  ("/home/notes.txt", 2, filesA)
    :: ("/tmp/scratch.txt", 2, filesA) :: Nil.

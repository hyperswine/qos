Text = use "policytext".
Path = use "fileaccesspolicy".
History = use "preferencehistory".
EditorPreferences = Type (Preferences Int Int String History.Retention).
Snapshot = Type (Snapshot Int EditorPreferences).
defaults = Preferences 200 400 "/home/.editor/session" History.KeepNewest.
undoDepth (Preferences n _ _ _) = n.
outputLines (Preferences _ n _ _) = n.
recoveryPath (Preferences _ _ p _) = p.
retention (Preferences _ _ _ r) = r.
revision (Snapshot r _) = r.
preferences (Snapshot _ p) = p.
validate p = if undoDepth p < 0 or outputLines p < 1 then Err "undoDepth must be nonnegative; outputLines must be positive" else
  path = recoveryPath p;
  if not (Path.canonical path and Path.starts "/home/.editor/" path) or Path.ends "/" path or strIndexOf " " path >= 0 or Path.ends ".~save" path then Err "recoveryPath must be a canonical file below /home/.editor/, without whitespace or .~save suffix" else Ok p.
encode rev p = "revision={rev} undoDepth={undoDepth p} outputLines={outputLines p} recoveryPath={recoveryPath p} history={History.name (retention p)}".
render (Snapshot rev p) = encode rev p.
checked rev p = case validate p of Err why -> Err why | Ok valid -> Ok (Snapshot rev valid).
parse text = if strlen text > 1536 then Err "update exceeds 1536 bytes" else case Text.tokens text 0 of
    [r, u, o, path, h] -> (case (Text.field "revision=" r, Text.field "undoDepth=" u, Text.field "outputLines=" o) of
        (Ok rev, Ok undo, Ok out) -> (case Path.stringField "recoveryPath=" path of
          Err why -> Err why
        | Ok name -> case History.parse h of Err why -> Err why | Ok retention -> checked rev (Preferences undo out name retention))
      | other -> Err "expected revision, undoDepth and outputLines as unsigned decimals")
  | other -> Err "expected revision undoDepth outputLines recoveryPath history in that order".
schema = "type=EditorPreferences version=1\ndefaults={encode 0 defaults}\nwrite=complete listed fields; expected preference revision; atomic; system-process-only\nundoDepth=0..IntMax; zero disables undo; redo is bounded by the same depth\noutputLines=1..IntMax; complete output lines (not a byte quota)\nhistory=preserve refuses reductions below live use; keep-newest immediately drops oldest undo/redo/output entries\nrecoveryPath=canonical file below /home/.editor/; at most 1024 bytes; no whitespace or .~save suffix\nrecoveryBoundary=refuse path changes while restore, save or recovery jobs are pending; keep the previous file; with disk, copy recovery before persisting the new path; diskless mode writes on next tick\nrecoveryCommit=with disk, acknowledgement follows recovery migration and settings append; ambiguous failure requires inspecting saved defaults before retry\nin-flight=existing requests keep their captured paths; buffer, dirty state and pending jobs are never overwritten\npersistence=with disk, shared defaults survive restart; load before recovery; savedDefaults=/services/preferences/editor; schema=/services/preferences/schema; without disk, session-only\n".

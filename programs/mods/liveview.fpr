# ============================================================================
# liveview.fpr -- LV.server: the BROWSER driver for std.MVU's App.
#
# The same four functions that MVU.game runs against a render service
# run here against a browser:
#
#   main = LV.server (MV.App init update subs view).
#
# view returns a gen_view tree (mods/genview.fpr); this module is the
# missing server half of that stack -- an HTTP server written in
# FPRISC over the policy-free socket tier (netPoll/netRead/netWrite/
# netClose; hal/virt/net.c on virt, hal/unix/net_raw.c under qosp,
# port FPR_PORT default 8000):
#
#   GET  /            the first paint: generated CSS (cfg.css over the
#                     current tree), <div id=lv-root>, window.__LV__ =
#                     {s, d} (genview's statics/dynamics split), the
#                     livejs client inline, and -- iff subs(model) has
#                     STick ms -- a poll script that fetches deltas
#                     every ms.
#   POST /live/event  {"msg":m,"arg":a} from the client becomes
#                     update env (EMsg m a) model; the response is
#                     LiveView's wire: {"d":{i:new}} while the statics
#                     match (genview.deltaJson against what THIS client
#                     last saw), {"s":[..],"d":[..]} on a reshape.
#                     msg "__poll" skips update and just flushes what
#                     server-side ticks changed.
#
# SUBSCRIPTIONS: STick ms ticks the model server-side while the
# socket is idle (the same wall clock MVU.game paces on), and turns on
# the client's poll loop; without it the server sleeps between
# requests and update hears only browser events.  SKeys means nothing
# here (a browser has no evdev; key events would arrive as EMsg from
# a client-side listener -- future work, like push over SSE instead
# of the poll script).
#
# MULTI-CLIENT (net tier v6): netPoll 0 returns the next connection
# id with buffered bytes, and each connection accumulates its request
# in its own buffer.  CLIENT identity is a cookie: GET / mints (or
# re-reads) lvsid and Set-Cookie carries it; the browser sends it back
# on every fetch, so a client's delta is computed against what THAT
# client last saw while the MODEL is shared by everyone -- one bump
# from client A is the delta client B's next poll flushes.  Sessions
# are capped (oldest evicted; an evicted client just gets one full
# render).  Responses still carry Connection: close -- connections are
# per-request, sessions are per-client.  MQuit from update answers the
# in-flight request, closes, and returns the run's result string.
# ============================================================================

MV = use "std/mvu".
G  = use "genview".
LJ = use "livejs".

App = MV.App.
EMsg = MV.EMsg.
ETick = MV.ETick.
STick = MV.STick.
MQuit = MV.MQuit.
MLog = MV.MLog.

# ---- small helpers ----------------------------------------------------------

cr = chr 13.
lf = chr 10.
crlf = strcat (chr 13) (chr 10).

# index just PAST pat's first match at/after i; 0 = no match
findSub s pat i = fsGo s pat i (strlen s) (strlen pat).
fsGo : unsafe String -> String -> Int -> Int -> Int -> Int .
fsGo s pat i n pn | i + pn - 1 > n = 0.
fsGo s pat i n pn | G.strEq (substr s i pn) pat = i + pn.
fsGo s pat i n pn = fsGo s pat (i + 1) n pn.

digits : unsafe String -> Int -> Int -> Int .
digits s i acc | i > strlen s = acc.
digits s i acc = digCh s i acc (charAt s i).
digCh : unsafe String -> Int -> Int -> Int -> Int .
digCh s i acc c | and2 (c >= 48) (c <= 57) = digits s (i + 1) (acc * 10 + (c - 48)).
digCh s i acc c = acc.
and2 a b = case a of True -> b | False -> False.

# characters until the delimiter, from i
until : unsafe String -> Int -> Int -> String -> String .
until s i dl acc | i > strlen s = acc.
until s i dl acc | charAt s i == dl = acc.
until s i dl acc = until s (i + 1) dl (strcat acc (chr (charAt s i))).

# ---- HTTP parsing -----------------------------------------------------------

# body start (just past the blank line); 0 while the head is partial
headEnd req = findSub req "{cr}{lf}{cr}{lf}" 1.

method req = until req 1 32 "".
path req = until req (strlen (method req) + 2) 32 "".

contentLen req = clAt req (findSub req "Content-Length: " 1).
clAt req 0 = 0.
clAt req i = digits req i 0.

# a request is complete when the head is in and, for POST, the body is
complete req = cDone req (headEnd req).
cDone req 0 = 0.
cDone req he | G.strEq (method req) "POST" = cBody req he.
cDone req he = 1.
cBody req he = case strlen req - he + 1 >= contentLen req of
    True -> 1
  | False -> 0.

bodyOf req = bAt req (headEnd req).
bAt req 0 = "".
bAt req he = substr req he (strlen req - he + 1).

# {"msg":"x","arg":"y"} -> the named field (no unescaping: PoC wire)
jStr s key = jAt s (findSub s "\"{key}\":\"" 1).
jAt s 0 = "".
jAt s i = until s i 34 "".

httpResp code ctype body =
  "HTTP/1.1 {code}{crlf}Content-Type: {ctype}{crlf}Content-Length: {strlen body}{crlf}Connection: close{crlf}{crlf}{body}".
httpRespC code ctype sid body =
  "HTTP/1.1 {code}{crlf}Content-Type: {ctype}{crlf}Content-Length: {strlen body}{crlf}Set-Cookie: lvsid={sid}; Path=/{crlf}Connection: close{crlf}{crlf}{body}".

# the client's session id off the Cookie header (0 = none)
cookieSid req = csAt req (findSub req "lvsid=" 1).
csAt req 0 = 0.
csAt req i = digits req i 0.

# ---- the page ---------------------------------------------------------------

pollJs 0 = "".
pollJs ms = "<script>var lvp=false;setInterval(function()\{if(lvp)return;lvp=true;fetch('/live/event',\{method:'POST',body:JSON.stringify(\{msg:'__poll',arg:''})}).then(function(r)\{return r.json()}).then(function(res)\{if(res.s)\{location.reload();return}for(var k in res.d)\{var el=document.querySelector('[data-slot=\"'+k+'\"]');if(el)el.textContent=res.d[k]}}).catch(function()\{}).finally(function()\{lvp=false})},{ms});</script>".

page css tree s d tickMs =
  "<!doctype html><html><head><meta charset=\"utf-8\"><style>{css tree}</style></head><body><div id=\"lv-root\"></div><script>window.__LV__=\{s:{G.jarr s},d:{G.jarr d}};</script><script>{LJ.src 0}</script>{pollJs tickMs}</body></html>".

# ---- subscriptions ----------------------------------------------------------

tickMsOf : unsafe List MV.Sub -> Int .
tickMsOf Nil = 0.
tickMsOf (s :: r) = tmOne r s.
tmOne : unsafe List MV.Sub -> MV.Sub -> Int .
tmOne r s = case s of
    STick ms -> ms
  | o -> tickMsOf r.

# ---- commands ---------------------------------------------------------------

quitOf : unsafe List MV.MC -> Int -> Int .
quitOf Nil q = q.
quitOf (MQuit :: r) q = quitOf r 1.
quitOf (MLog s :: r) q = _ = Sys.logAt 0 s; quitOf r q.
quitOf (c :: r) q = quitOf r q.

# ---- sessions + per-connection buffers --------------------------------------
# sessions: (sid, lastS, lastD) per CLIENT, newest first, capped at 8
# (deltas are diffs against what that client last saw); bufs: partial
# request bytes per CONNECTION id.

maxSess = 8.

sessGet : unsafe List (Int, List String, List String) -> Int -> _ .
sessGet Nil sid = (0, Nil, Nil).
sessGet ((i, ls, ld) :: r) sid | i == sid = (1, ls, ld).
sessGet (e :: r) sid = sessGet r sid.

sessPut : unsafe List (Int, List String, List String) -> Int -> List String -> List String -> _ .
sessPut ss sid ls ld = sessTrim ((sid, ls, ld) :: sessDel ss sid) maxSess.
sessDel : unsafe List (Int, List String, List String) -> Int -> _ .
sessDel Nil sid = Nil.
sessDel ((i, ls, ld) :: r) sid | i == sid = sessDel r sid.
sessDel (e :: r) sid = e :: sessDel r sid.
sessTrim : unsafe List a -> Int -> List a .
sessTrim Nil n = Nil.
sessTrim (e :: r) 0 = Nil.
sessTrim (e :: r) n = e :: sessTrim r (n - 1).

bufGet : unsafe List (Int, String) -> Int -> String .
bufGet Nil cid = "".
bufGet ((i, b) :: r) cid | i == cid = b.
bufGet (e :: r) cid = bufGet r cid.
bufPut : unsafe List (Int, String) -> Int -> String -> _ .
bufPut bs cid b = (cid, b) :: bufDel bs cid.
bufDel : unsafe List (Int, String) -> Int -> _ .
bufDel Nil cid = Nil.
bufDel ((i, b) :: r) cid | i == cid = bufDel r cid.
bufDel (e :: r) cid = e :: bufDel r cid.

# ---- the server -------------------------------------------------------------
# state: Sv model sessions nsid ltt bufs

Sv = Type (Sv model sess nsid ltt bufs).

server app = serve { env = 0, css = G.cssFor } app.

serve cfg app =
  App ini upd sbs vw = app;
  nic = device "net";              # brings the listener up (FPR_PORT / slirp)
  clint = device "clint";
  mt = reg32 clint 49144;
  m0 = ini cfg.env;
  srvLoop mt cfg app (Sv m0 Nil 1 (read mt) Nil).

srvLoop : unsafe Int -> _ -> App -> Sv -> String .
srvLoop mt cfg app sv = srvPoll mt cfg app sv (netPoll 0).
srvPoll : unsafe Int -> _ -> App -> Sv -> Int -> String .
srvPoll mt cfg app sv cid = case cid == 0 of
    True -> srvIdle mt cfg app sv
  | False -> srvData mt cfg app sv cid.

# idle: run a due server-side tick, else sleep a beat off the socket
srvIdle : unsafe Int -> _ -> App -> Sv -> String .
srvIdle mt cfg app sv =
  App ini upd sbs vw = app;
  Sv model sess nsid ltt bufs = sv;
  srvTick mt cfg app sv (tickMsOf (sbs model)) (read mt).
srvTick : unsafe Int -> _ -> App -> Sv -> Int -> Int -> String .
srvTick mt cfg app sv tickMs now =
  Sv model sess nsid ltt bufs = sv;
  case and2 (tickMs > 0) (now - ltt >= tickMs * 10000) of
    True -> srvTickUp mt cfg app sv now
  | False -> srvNap mt cfg app sv.
srvNap : unsafe Int -> _ -> App -> Sv -> String .
srvNap mt cfg app sv =
  _ = Sys.sleepUs 2000;
  srvLoop mt cfg app sv.
srvTickUp : unsafe Int -> _ -> App -> Sv -> Int -> String .
srvTickUp mt cfg app sv now =
  App ini upd sbs vw = app;
  Sv model sess nsid ltt bufs = sv;
  (m2, cs) = upd cfg.env ETick model;
  srvAfterTick mt cfg app (Sv m2 sess nsid now bufs) (quitOf cs 0).
srvAfterTick : unsafe Int -> _ -> App -> Sv -> Int -> String .
srvAfterTick mt cfg app sv 1 = srvBye sv.
srvAfterTick mt cfg app sv q = srvLoop mt cfg app sv.

# data: accumulate into THIS connection's buffer; answer when complete
srvData : unsafe Int -> _ -> App -> Sv -> Int -> String .
srvData mt cfg app sv cid =
  Sv model sess nsid ltt bufs = sv;
  srvBytes mt cfg app sv cid (netRead cid).
# an empty read: the peer went away (net tier v7); forget its half request
srvBytes : unsafe Int -> _ -> App -> Sv -> Int -> String -> String .
srvBytes mt cfg app sv cid "" =
  Sv model sess nsid ltt bufs = sv;
  srvLoop mt cfg app (Sv model sess nsid ltt (bufDel bufs cid)).
srvBytes mt cfg app sv cid bytes =
  Sv model sess nsid ltt bufs = sv;
  req = strcat (bufGet bufs cid) bytes;
  srvHave mt cfg app (Sv model sess nsid ltt (bufPut bufs cid req)) cid req (complete req).
srvHave : unsafe Int -> _ -> App -> Sv -> Int -> String -> Int -> String .
srvHave mt cfg app sv cid req 0 = srvLoop mt cfg app sv.
srvHave mt cfg app sv cid req done = srvRoute2 mt cfg app sv cid req (method req) (path req).

srvRoute2 : unsafe Int -> _ -> App -> Sv -> Int -> String -> String -> String -> String .
srvRoute2 mt cfg app sv cid req mth pth | G.strEq pth "/" = srvPage mt cfg app sv cid req.
srvRoute2 mt cfg app sv cid req mth pth | G.strEq pth "/live/event" = srvEvent mt cfg app sv cid req.
srvRoute2 mt cfg app sv cid req mth pth =
  srvSend mt cfg app sv cid (httpResp "404 Not Found" "text/plain" "no such route") 0.

# GET /: mint (or re-read) the client's session, render the CURRENT
# model, remember what THIS client now has, ship page + cookie
srvPage : unsafe Int -> _ -> App -> Sv -> Int -> String -> String .
srvPage mt cfg app sv cid req =
  App ini upd sbs vw = app;
  Sv model sess nsid ltt bufs = sv;
  sid0 = cookieSid req;
  sid = case sid0 > 0 of True -> sid0 | False -> nsid;
  nsid2 = case sid0 > 0 of True -> nsid | False -> nsid + 1;
  tree = vw model;
  (s, d) = G.render tree;
  html = page cfg.css tree s d (tickMsOf (sbs model));
  srvSend mt cfg app (Sv model (sessPut sess sid s d) nsid2 ltt bufs)
          cid (httpRespC "200 OK" "text/html" sid html) 0.

# POST /live/event: update (unless __poll), diff against what THIS
# client (the lvsid cookie) last saw, reply delta or full
srvEvent : unsafe Int -> _ -> App -> Sv -> Int -> String -> String .
srvEvent mt cfg app sv cid req =
  body = bodyOf req;
  srvEv2 mt cfg app sv cid (cookieSid req) (jStr body "msg") (jStr body "arg").
srvEv2 : unsafe Int -> _ -> App -> Sv -> Int -> Int -> String -> String -> String .
srvEv2 mt cfg app sv cid sid msg arg | G.strEq msg "__poll" = srvReply mt cfg app sv cid sid 0.
srvEv2 mt cfg app sv cid sid msg arg =
  App ini upd sbs vw = app;
  Sv model sess nsid ltt bufs = sv;
  (m2, cs) = upd cfg.env (EMsg msg arg) model;
  srvReply mt cfg app (Sv m2 sess nsid ltt bufs) cid sid (quitOf cs 0).
srvReply : unsafe Int -> _ -> App -> Sv -> Int -> Int -> Int -> String .
srvReply mt cfg app sv cid sid quit =
  App ini upd sbs vw = app;
  Sv model sess nsid ltt bufs = sv;
  (s2, d2) = G.render (vw model);
  (found, ls, ld) = sessGet sess sid;
  sv2 = Sv model (sessPut sess sid s2 d2) nsid ltt bufs;
  case found == 1 of
    False -> srvFull mt cfg app sv2 cid s2 d2 quit
  | True -> (case G.sameStatics ls s2 of
      True -> srvSend mt cfg app sv2 cid (httpResp "200 OK" "application/json" "\{\"d\":{G.deltaJson ld d2}}") quit
    | False -> srvFull mt cfg app sv2 cid s2 d2 quit).
srvFull : unsafe Int -> _ -> App -> Sv -> Int -> List String -> List String -> Int -> String .
srvFull mt cfg app sv2 cid s2 d2 quit =
  srvSend mt cfg app sv2 cid (httpResp "200 OK" "application/json" "\{\"s\":{G.jarr s2},\"d\":{G.jarr d2}}") quit.

# ship the response, release THIS connection, forget its buffer
srvSend : unsafe Int -> _ -> App -> Sv -> Int -> String -> Int -> String .
srvSend mt cfg app sv cid resp quit =
  Sv model sess nsid ltt bufs = sv;
  _ = netWrite cid resp;
  _ = netClose cid;
  srvNext mt cfg app (Sv model sess nsid ltt (bufDel bufs cid)) quit.
srvNext : unsafe Int -> _ -> App -> Sv -> Int -> String .
srvNext mt cfg app sv 1 = srvBye sv.
srvNext mt cfg app sv q = srvLoop mt cfg app sv.

srvBye sv =
  Sv model sess nsid ltt bufs = sv;
  "lv: server closed ({lvLen sess} client session(s))".
lvLen : unsafe List a -> Int .
lvLen Nil = 0.
lvLen (x :: r) = 1 + lvLen r.

# Recursive MVU: viewport, focus and pointer capture are model values.
unsafe module.
AW = use "appwire".
AS = use "appsession".
AV = use "appview".
L = use "shelllayout".
ST = use "scrolltext".
AK = use "appkit".
AC = use "std/actor#201a0e9bf98a5154".

init = ({rows = Nil, token = 1, busy = True, ticks = 0, phase = AW.Loading, w = 960, h = 530, focused = True, down = False, capture = 0 - 1, wheel = 0, scroll = 0, dragY = 0, dragScroll = 0, dragged = False}, [AW.Fetch 1 AW.Disk]).
fetch m = if m.busy then (m, Nil) else
  ({m | token = m.token + 1, busy = True, ticks = 0, phase = AW.Loading}, [AW.Fetch (m.token + 1) AW.Disk]).
update (AW.Resize w h) m = fresh = AV.resize w h m; (AV.seek (rows fresh) fresh.scroll fresh, Nil).
update (AW.Focus active) m = (AV.focus active m, Nil).
update AW.Cancel m = (AV.focus m.focused m, Nil).
update AW.Tick m | not m.focused = (m, Nil).

update (AW.Key 19) m = fetch m.
update (AW.Wheel dy dx) m = (AV.wheel (rows m) dy m, Nil).
update (AW.Pointer x y buttons) m = (AV.pointer (rows m) x y buttons m, Nil).
update (AW.Key k) m = (navigate k m, Nil).
update AW.Tick m = case m.phase of
    AW.Ready -> if m.ticks >= 9 then fetch m else ({m | ticks = m.ticks + 1}, Nil)
  | other -> (m, Nil).
update (AW.Arrived token result) m = if token != m.token or not m.busy then (m, Nil) else case result of
    Ok (AW.Lines lines label) -> fresh = {m | rows = lines, busy = False, phase = AW.Ready};
      (AV.seek (rows fresh) m.scroll fresh, Nil)
  | Err why -> ({m | busy = False, phase = AW.Failed why}, Nil)
  | other -> ({m | busy = False, phase = AW.Failed "invalid storage result"}, Nil).
update other m = (m, Nil).
rows m = ST.wrapLinesWith (AV.metrics m) m.rows.
navigate 103 m = AV.scroll (rows m) (0 - 1) m.
navigate 108 m = AV.scroll (rows m) 1 m.
navigate 104 m = spec = AV.metrics m; AV.scroll (rows m) (0 - spec.visible) m.
navigate 109 m = spec = AV.metrics m; AV.scroll (rows m) spec.visible m.
navigate 102 m = AV.seek (rows m) 0 m.
navigate 107 m = AV.seek (rows m) (ST.count (rows m)) m.
navigate other m = m.
view vp m = (AV.frame vp "Disk" "Read-only storage statistics" (rows m) m.scroll, Nil).

# This actor owns the child model. Transport and effects exchange data only.
run me = case AS.start me of
    Err why -> Unit
  | Ok ctx ->
      (initial, commands) = init;
      (model, ignored) = update (AW.Resize ctx.w ctx.h) initial;
      _ = AS.issue me ctx commands;
      _ = Sys.loop (ctx, model) (step me); Unit.
step me state =
  (ctx, model) = state;
  case AS.next me ctx of
    AS.Idle -> _ = Sys.sleepUs 1000; (True, state)
  | AS.Gone -> _ = AS.abandon me ctx; (False, state)
  | AS.JobResult token result ->
      (fresh, commands) = update (AW.Arrived token result) model;
      _ = AS.issue me ctx commands;
      (True, (AS.advance ctx ctx.sequence, fresh))
  | AS.Message ret request -> case request of
      AW.Close session -> (AS.close me ctx ret session, state)
    | AW.Event session sequence event -> case AS.valid ctx session sequence of
        False -> _ = AC.reply ret (AW.Refused "stale session or sequence"); (True, state)
      | True ->
          next = AS.advance (AS.resized ctx event) sequence;
          (fresh, commands) = update event model;
          _ = AS.issue me next commands;
          (tree, vals) = view (next.w, next.h) fresh;
          _ = AC.reply ret (AW.Frame next.session next.revision tree vals (AW.status fresh.phase));
          (True, (next, fresh)).

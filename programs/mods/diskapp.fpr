# Recursive MVU: cached model, pure update/view, explicit effect messages.
unsafe module.
AW = use "appwire".
AS = use "appsession".
AC = use "std/actor#201a0e9bf98a5154".
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.


init = ({rows = Nil, token = 1, busy = True, ticks = 0, phase = AW.Loading}, [AW.Fetch 1 AW.Disk]).
fetch m = if m.busy then (m, Nil) else
  ({m | token = m.token + 1, busy = True, ticks = 0, phase = AW.Loading}, [AW.Fetch (m.token + 1) AW.Disk]).
update (AW.Key 19) m = fetch m.
update AW.Tick m = case m.phase of
    AW.Ready -> if m.ticks >= 9 then fetch m else ({m | ticks = m.ticks + 1}, Nil)
  | other -> (m, Nil).
update (AW.Arrived token result) m = if token != m.token or not m.busy then (m, Nil) else case result of
    Ok (AW.Lines rows label) -> ({m | rows = rows, busy = False, phase = AW.Ready}, Nil)
  | Err why -> ({m | busy = False, phase = AW.Failed why}, Nil)
  | other -> ({m | busy = False, phase = AW.Failed "invalid storage result"}, Nil).
update other m = (m, Nil).
view vp m = (tree vp, "STORAGE STATS" :: dkPad (dkTail m.rows 9) 9).

dkRow i =
  Box [Row, Pad 1] [ Slot [Fg (930, 940, 960)] i 46 ].

tree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "DISK"
        , Lbl [Fg (560, 590, 650)] "/services/storage"
        , Box [Grow] Nil
        , Slot [Fg (999, 800, 300)] 0 16 ]
    , Box [Row, Gap 4]
        [ Lbl [Fg (560, 590, 650)] "SEQ"
        , Lbl [Fg (560, 590, 650)] "OFF"
        , Lbl [Fg (560, 590, 650)] "LEN" ]
    , Box [Col, Gap 2, Grow, Bord (150, 165, 200), Pad 3]
        [ dkRow 1, dkRow 2, dkRow 3, dkRow 4, dkRow 5
        , dkRow 6, dkRow 7, dkRow 8, dkRow 9 ]
    , Lbl [Fg (560, 590, 650)] "READ-ONLY STATS   R REFRESH / RETRY   ESC BACK" ].

dkSplit s i st acc | i >= strlen s = dkRev acc Nil.
dkSplit s i st acc | charAt s i == 10 =
  case i > st of
    True -> dkSplit s (i + 1) (i + 1) (substr s st (i - st) :: acc)
  | False -> dkSplit s (i + 1) (i + 1) acc.
dkSplit s i st acc = dkSplit s (i + 1) st acc.
dkRev Nil acc = acc.
dkRev (x :: r) acc = dkRev r (x :: acc).

dkLen Nil = 0.
dkLen (x :: r) = 1 + dkLen r.
dkPad l n | n == 0 = Nil.
dkPad Nil n = "" :: dkPad Nil (n - 1).
dkPad (x :: r) n = x :: dkPad r (n - 1).

# newest records last; keep the tail that fits
dkTail l n | dkLen l <= n = l.
dkTail Nil n = Nil.
dkTail (x :: r) n = dkTail r n.

# This actor owns the child model. Transport and effects exchange data only.
run me = case AS.start me of
    Err why -> Unit
  | Ok ctx ->
      (model, commands) = init;
      _ = AS.issue me ctx commands;
      _ = Sys.loop (ctx, model) (step me); Unit.
step me state =
  (ctx, model) = state;
  case AS.next me ctx of
    AS.Idle -> _ = Sys.sleepUs 1000; (True, state)
  | AS.Gone -> _ = AS.abandon me ctx; (False, state)
  | AS.JobResult token result ->
      (fresh, commands) = update (AW.Arrived token result) model;
      _ = AS.issue me ctx commands;
      (True, (AS.advance ctx ctx.sequence, fresh))
  | AS.Message ret request -> case request of
      AW.Close session -> (AS.close me ctx ret session, state)
    | AW.Event session sequence event -> case AS.valid ctx session sequence of
        False -> _ = AC.reply ret (AW.Refused "stale session or sequence"); (True, state)
      | True ->
          next = AS.advance (AS.resized ctx event) sequence;
          (fresh, commands) = update event model;
          _ = AS.issue me next commands;
          (tree, vals) = view (next.w, next.h) fresh;
          _ = AC.reply ret (AW.Frame next.session next.revision tree vals (AW.status fresh.phase));
          (True, (next, fresh)).

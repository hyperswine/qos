# oled.fpr -- an SSD1306-style SPI OLED over bbspi: the /services/oled
# shape, pure FPRISC.  A DC pin selects command (0) vs data (1); the
# init sequence and blits are just byte streams down the bit-banged
# bus, so the whole driver is testable by decoding the pin WAVEFORM
# (tests/bbspi.fpr) -- no panel required.  On silicon the same module
# runs over real GPIO, or the bus swaps for hardware SPI behind the
# same pin-function values.
# the ABI has Tup2/Tup3 only: the 4-slot pin bundle is a constructor
Pins = Type (Pins sck mosi cs dc).

S = use "bbspi".
# pins = Pins sck mosi cs dc; miso unused by the panel (pass any in-pin)
init pinM pinW pins miso =
  Pins sck mosi cs dc = pins;
  _ = S.init pinM sck mosi cs miso;
  pinM dc 1.
cmd pinW pinR pins miso bytes =
  Pins sck mosi cs dc = pins;
  _ = pinW dc 0;
  _ = S.csLow pinW cs;
  _ = S.xfer (S.Bus pinW pinR sck mosi miso) bytes;
  _ = S.csHigh pinW cs;
  pinW dc 1.
dat pinW pinR pins miso bytes =
  Pins sck mosi cs dc = pins;
  _ = S.csLow pinW cs;
  _ = S.xfer (S.Bus pinW pinR sck mosi miso) bytes;
  S.csHigh pinW cs.
# the canonical SSD1306 wake: display-off, charge pump on, display-on
initSeq u = strcat (chr 174) (strcat (chr 141) (strcat (chr 20) (chr 175))).

# hardware reset: RES low, wait, high, wait.  `wait` is a value
# (Unit -> Unit): a no-op in the sim, ~10ms of cycles on silicon.
reset pinM pinW res wait =
  _ = pinM res 1;
  _ = pinW res 0;
  _ = wait Unit;
  _ = pinW res 1;
  wait Unit.
# first-silicon smoke commands: A5 = all pixels on (no RAM writes
# needed -- the whole panel lights), A4 = resume normal display
allOn u = chr 165.
allOff u = chr 164.
dispOn u = chr 175.
dispOff u = chr 174.

# qar.fpr -- QAR2 container parsing shared by system and qsys.
# Manifest interpretation and loading policy stay with their callers.

strEq : unsafe String -> String -> Bool .
strEq a b | strlen a == strlen b = eqGo a b 1 (strlen a).
strEq a b = False.
eqGo : unsafe String -> String -> Int -> Int -> Bool .
eqGo a b i n | i > n = True.
eqGo a b i n | charAt a i == charAt b i = eqGo a b (i + 1) n.
eqGo a b i n = False.

tableEnd : unsafe String -> Int -> Int .
tableEnd qa i | i + 1 > strlen qa = 0.
tableEnd qa i | charAt qa i == 10 = tableNl qa i (charAt qa (i + 1)).
tableEnd qa i = tableEnd qa (i + 1).
tableNl qa i c | c == 10 = i.
tableNl qa i c = tableEnd qa (i + 1).

lineEnd : unsafe String -> Int -> Int -> Int .
lineEnd qa i limit | i >= limit = limit.
lineEnd qa i limit | charAt qa i == 10 = i.
lineEnd qa i limit = lineEnd qa (i + 1) limit.

skipSpace : unsafe String -> Int -> Int -> Int .
skipSpace qa i limit | i >= limit = i.
skipSpace qa i limit | charAt qa i == 32 = skipSpace qa (i + 1) limit.
skipSpace qa i limit = i.

wordAt : unsafe String -> Int -> Int -> (String, Int) .
wordAt qa i limit = wordGo qa (skipSpace qa i limit) limit "".
wordGo : unsafe String -> Int -> Int -> String -> (String, Int) .
wordGo qa i limit acc | i >= limit = (acc, i).
wordGo qa i limit acc | charAt qa i == 32 = (acc, i).
wordGo qa i limit acc = wordGo qa (i + 1) limit (strcat acc (chr (charAt qa i))).

parseNat : unsafe String -> Result Int String .
parseNat s | strlen s == 0 = Err "empty section number".
parseNat s = natGo s 1 (strlen s) 0.
natGo : unsafe String -> Int -> Int -> Int -> Result Int String .
natGo s i n acc | i > n = Ok acc.
natGo s i n acc = natCh s i n acc (charAt s i).
natCh : unsafe String -> Int -> Int -> Int -> Int -> Result Int String .
natCh s i n acc c | c < 48 = Err "invalid section number".
natCh s i n acc c | c > 57 = Err "invalid section number".
natCh s i n acc c = natGo s (i + 1) n (acc * 10 + (c - 48)).

# Absolute 1-based payload position and byte length.
extent : unsafe String -> String -> Result (Int, Int) String .
extent qa name | strlen qa < 7 = Err "not a QAR2 archive".
extent qa name | strEq (substr qa 1 5) "QAR2\n" = extentTable qa name (tableEnd qa 5).
extent qa name = Err "not a QAR2 archive".
extentTable qa name blank | blank == 0 = Err "unterminated QAR2 table".
extentTable qa name blank = findSection qa name 6 blank (blank + 2).

findSection : unsafe String -> String -> Int -> Int -> Int -> Result (Int, Int) String .
findSection qa name i blank payload0 | i >= blank = Err "no such section".
findSection qa name i blank payload0 = findLine qa name i blank payload0 (lineEnd qa i blank).
findLine : unsafe String -> String -> Int -> Int -> Int -> Int -> Result (Int, Int) String .
findLine qa name i blank payload0 e =
  (nm, a1) = wordAt qa i e;
  (offS, a2) = wordAt qa a1 e;
  (lenS, a3) = wordAt qa a2 e;
  findNamed qa name blank payload0 e nm offS lenS.
findNamed qa name blank payload0 e nm offS lenS | strEq nm name = sectionNums qa payload0 offS lenS.
findNamed qa name blank payload0 e nm offS lenS = findSection qa name (e + 1) blank payload0.

sectionNums : unsafe String -> Int -> String -> String -> Result (Int, Int) String .
sectionNums qa payload0 offS lenS = case parseNat offS of
    Err e -> Err e
  | Ok off -> case parseNat lenS of
      Err e -> Err e
    | Ok len -> sectionBounds qa (payload0 + off) len.
sectionBounds qa pos len | len == 0 = emptyBounds qa pos len.
sectionBounds qa pos len | pos + len - 1 <= strlen qa = Ok (pos, len).
sectionBounds qa pos len = Err "section outside archive".
emptyBounds qa pos len | pos <= strlen qa + 1 = Ok (pos, len).
emptyBounds qa pos len = Err "section outside archive".

sectionBytes : unsafe String -> String -> Result String String .
sectionBytes qa name = case extent qa name of
    Err e -> Err e
  | Ok r -> sectionSlice qa r.
sectionSlice qa r = case r of (pos, len) -> sectionSliceAt qa pos len.
sectionSliceAt qa pos len | len == 0 = Ok "".
sectionSliceAt qa pos len = Ok (substr qa pos len).

manifestOf : unsafe String -> Result String String .
manifestOf qa = sectionBytes qa "MANIFEST".
# ============================================================================
# procapp.fpr -- the process-app service layer, as a `use` module.
#
# A loaded process links its own runtime+HAL, so its "services" are its
# own code -- gated by the capability blob System.qa passed through the
# entry ABI (read back with `Sys.caps`).  This module is that layer:
# caps parsing + the console/keyboard/clock surface + kv storage via
# the syscall channel (Sys.storeReq: tag 2 append, tag 3 replay --
# scoped server-side to THIS app's kv url; a process cannot name any
# other).  Same trust model as System.qa's own svc helpers: the grant
# is the app's only story about what it may touch.
# ============================================================================

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
isOdd v = Int.mod v 2 == 1.

# ---- capability blob: "appid\nurl mode\n..." --------------------------------
hasGrant s url mode = hgGo s 1 (strlen s) (strcat url (strcat " " mode)).
hgGo s i n want =
  case i > n of
    True -> False
  | False -> hgLine s i n want (lineEnd s i n).
hgLine s i n want e =
  case lineEq s i (e - 1) want of
    True -> True
  | False -> hgGo s (e + 1) n want.
lineEnd s i n = case i > n of True -> n | False -> case charAt s i == 10 of True -> i | False -> lineEnd s (i + 1) n.
lineEq s i j want =
  case (j - i + 1) == strlen want of
    True -> leGo s i j want 1
  | False -> False.
leGo s i j want k =
  case i > j of
    True -> True
  | False -> case charAt s i == charAt want k of
      True -> leGo s (i + 1) j want (k + 1)
    | False -> False.

# ---- console / keyboard / clock (the process's own HAL) ---------------------
openCon u = (reg8 (device "uart") 5, reg8 (device "uart") 0).
openClk u = reg32 (device "clint") 49144.

putc : unsafe (Int, Int) -> Int -> Unit .
putc con c = pcW con c.
pcW con c = case con of (lsr, dat) -> pcV lsr dat c (read lsr).
pcV lsr dat c v = case isOdd (v / 32) of True -> write dat c | False -> pcV lsr dat c (read lsr).
puts : unsafe (Int, Int) -> String -> Unit .
puts con s = psGo con s 1 (strlen s).
psGo con s i n = case i > n of True -> Unit | False -> putc con (charAt s i) >> psGo con s (i + 1) n.
nl con = putc con 13 >> putc con 10.
putLn con s = puts con s >> nl con.

getc : unsafe Int -> (Int, Int) -> Int .
getc me con = case con of (lsr, dat) -> gcW me lsr dat.
gcW me lsr dat = gcV me lsr dat (read lsr).
gcV me lsr dat v = case isOdd v of True -> read dat | False -> yield me >> gcW me lsr dat.
pollKey con = case con of (lsr, dat) -> pkV lsr dat (read lsr).
pkV lsr dat v = case isOdd v of True -> read dat | False -> 0.

secsOf ticks = ticks / 10000000.
showI : unsafe Int -> String .
showI n = case n < 10 of True -> chr (48 + n) | False -> strcat (showI (n / 10)) (chr (48 + n - (n / 10) * 10)).
pad2 n = case n < 10 of True -> strcat "0" (showI n) | False -> showI n.

# ---- app-scoped kv over the syscall channel ---------------------------------
kvAppend line = Sys.storeReq 2 (strcat line (chr 10)).
kvReplay u = Sys.storeReq 3 "".

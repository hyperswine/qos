# clockapp.fpr -- the TUIClock port: big time, ticking every frame.
# State = key count (proof appUpdate runs); the time itself is read in
# the frame worker (appVals), same effect discipline as the shell.
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("CLOCK", "CLOCK.QA").
appInit self env = 0.
appUpdate self env k n = n + 1.

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 8, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "CLOCK"
        , Lbl [Fg (560, 590, 650)] "clock.qa" ]
    , Box [Grow] Nil
    , Box [Row]
        [ Box [Grow] Nil
        , Slot [Sc 4, Fg (930, 940, 960)] 0 5
        , Box [Grow] Nil ]
    , Box [Grow] Nil
    , Box [Row, Gap 6]
        [ Slot [Fg (560, 590, 650)] 1 20
        , Box [Grow] Nil
        , Lbl [Fg (560, 590, 650)] "ESC BACK" ] ].

appVals self env n =
  [ AK.clockStr (AK.envMt env), "{n} KEYS SEEN" ].

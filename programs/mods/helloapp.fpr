# helloapp.fpr -- the HelloProc port, and the MULTI-ACTOR proof: its
# init SPAWNS a child actor which talks to the world only through the
# capabilities it was handed -- five lines into the /services/log
# capability (appkit's LogAdd), paced on the mtime handle.  Nothing
# here calls print: an app actor's output IS a message to a service.
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("HELLO", "SPAWNS ACTOR").

appInit self env =
  _ = spawn (helloChild env);
  0.

helloChild env self =
  helloGo self (AK.envLog env) (AK.envMt env) 1.
# after the five lines: PARK (receive with no senders) -- the actor
# stays alive and BLOCKED, which is exactly what the monitor should
# attribute to hello.qa's sub-slot.  A real app actor would serve
# requests here; the parked state is the honest minimum of that.
helloGo self log mt i | i > 5 = receive self.
helloGo self log mt i =
  _ = AK.logAdd self log "HELLO {i} FROM CHILD ACTOR";
  _ = helloWarn self log i;
  _ = AK.waitTicks mt (read mt) 4000;
  helloGo self log mt (i + 1).
# one warn and one error through the same capability: the severity
# axis exists to be exercised, not admired
helloWarn self log i | i == 3 =
  AK.logAddAt self log 1 "HELLO 3 WAS A WARNING".
helloWarn self log i | i == 5 =
  AK.logAddAt self log 2 "HELLO 5 WAS AN ERROR".
helloWarn self log i = 0.

appUpdate self env k n = n + 1.

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 8, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "HELLO"
        , Lbl [Fg (560, 590, 650)] "hello.qa" ]
    , Box [Col, Gap 4, Grow, Bord (150, 165, 200), Pad 6]
        [ Lbl [Fg (930, 940, 960)] "A CHILD ACTOR WAS SPAWNED AT INIT."
        , Lbl [Fg (930, 940, 960)] "IT LOGS VIA THE /SERVICES/LOG"
        , Lbl [Fg (930, 940, 960)] "CAPABILITY -- SEE THE LOGS APP."
        , Slot [Fg (999, 800, 300)] 0 24 ]
    , Lbl [Fg (560, 590, 650)] "ANY KEY COUNTS   ESC BACK" ].

appVals self env n =
  [ "{n} KEYS SINCE LAUNCH" ].

# A small Main Profile shell over the existing System/Graphics and appkit ABI.
# Cooperative app plugins run inside this shell; this is not process isolation.
unsafe module.
QS = use "qsys".
GX = use "graphics".
EP = use "ep#c66ad65e68dd97f5".
AK = use "appkit".
S2 = use "scene2d".
ST = use "scrolltext".
PN = use "panemvu".
PJ = use "panejobs".
AP = use "appclient".
AW = use "appwire".
FS = use "std/fs#84826bc9e8ddb4b5".
AC = use "std/actor#201a0e9bf98a5154".
MV = use "std/mvu".

Box = S2.Box. Lbl = S2.Lbl.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Fs = S2.Fs.
Bg = S2.Bg. Fg = S2.Fg. Round = S2.Round. Center = S2.Center. Mid = S2.Mid.
Tile = Type (Tile id title hint table).
width = 960. height = 600. pageSize = 6.
serviceBudgetMs = 5000.
ink = (940, 950, 990). dim = (530, 610, 750).
accent = (380, 800, 980).

count Nil = 0.
count (_ :: r) = 1 + count r.
cat Nil ys = ys.
cat (x :: r) ys = x :: cat r ys.
at (x :: r) 0 = x.
at (x :: r) n = at r (n - 1).
at Nil n = Tile "" "" "" (0 - 1).
clamp lo hi n | n < lo = lo.
clamp lo hi n | n > hi = hi.
clamp lo hi n = n.
pages ts = (count ts + pageSize - 1) / pageSize.

shortcuts = [Tile "clock" "Clock" "A moment of calm" (0 - 1),
             Tile "files" "Files" "Explore your onboard URLs" (0 - 2),
             Tile "logs" "Logs" "See what QOS is doing" (0 - 3),
             Tile "about" "About QOS" "Small language. Open system." (0 - 4)].
installed me st apps = case st == 0 of
    True -> Nil
  | False -> case FS.readLatest me st "apps/index" of
      Err why -> _ = Sys.logAt (if FS.missing why then 1 else 2) "shell: app index unavailable ({why})"; Nil
    | Ok s -> diskTiles (AK.lines s) apps.
diskTiles Nil apps = Nil.
diskTiles (id :: rest) apps = diskTile id apps :: diskTiles rest apps.
diskTile id Nil = Tile id id "Archive could not be attached" (0 - 100).
diskTile id (QS.App aid name ti :: rest) = case id == aid of
    True -> Tile id name "Onboard .qa application" ti
  | False -> diskTile id rest.


init env = {page = 0, selected = 0, active = 0, inner = AW.Frame 0 0 (Box Nil Nil) Nil "", appFailed = False, appCommands = Nil, status = "Ready when you are", snap = 0, pane = PN.init, commands = Nil}.
staticKey m = 0.
staticView vp m = 0.
done m = "shell ended".
subscriptions port m = MV.SPort port :: subs m.
subs m = [MV.STick 100, MV.SKeys].
update me env (MV.EKey 16) m | m.active == 0 = (m, [MV.MQuit]).
update me env (MV.EKey k) m = effects me env (key env k m).
update me env (MV.EWheel dy dx) m | scrollable m.active =
  effects me env (scrollBy env m (0 - dy * 3 / 10)).
update me env MV.ETick m = effects me env (if m.active > 0 and not m.appFailed then
  {m | appCommands = [AP.Deliver AW.Tick]} else paneUpdate PN.Tick m).
update me env (MV.EMsg "quit" _) m = (m, [MV.MQuit]).
update me env (MV.EMsg tag body) m = case PJ.decode tag body of
    Err why -> (m, Nil)
  | Ok msg ->
      next = paneUpdate msg m;
      _ = case PN.loading m.pane and not (PN.loading next.pane) and next.pane.source != 0 and (m.pane.rows == Nil or (case next.pane.phase of PN.Failed why -> True | other -> False)) of
          True -> print "shell: pane {next.pane.source} {PN.status next.pane}"
        | False -> Unit;
      effects me env next.
update me env ev m = (m, Nil).
# Child commands are values, interpreted outside the pure pane update/view.
paneUpdate msg m =
  (pane, commands) = PN.update msg m.pane;
  {m | pane = pane, commands = cat m.commands commands}.
effects me env m =
  (q, tiles, mt, jobs, sessions) = env;
  applied = appEffects me sessions m m.appCommands;
  cleared = {applied | commands = Nil, appCommands = Nil};
  case PJ.run me jobs applied.commands of
      Ok u -> (cleared, Nil)
    | Err why -> (paneUpdate (PN.Complete m.pane.generation m.pane.source (Err why)) cleared, Nil).
key env 1 m =
  _ = print "shell: home";
  paneUpdate PN.Leave {m | active = 0, appCommands = [AP.Home], status = "Welcome home", snap = m.snap + 1}.
key env 25 m =
  _ = print "shell: snapshot {m.snap + 1}";
  {m | snap = m.snap + 1}.
key env k m | k >= 1000000 = pointer env k m.
key env 19 m | scrollable m.active = paneUpdate PN.Refresh m.
key env k m | m.active != 0 = appKey env k m.
key env 106 m = select env m (m.selected + 1).
key env 105 m = select env m (m.selected - 1).
key env 108 m = select env m (m.selected + 3).
key env 103 m = select env m (m.selected - 3).
key env 109 m = page env m 1.
key env 104 m = page env m (0 - 1).
key env 28 m = openTile env m.
key env 57 m = openTile env m.
key env k m = m.
select env m n =
  (q, tiles, mt, jobs, sessions) = env;
  s = clamp 0 (count tiles - 1) n;
  {m | selected = s, page = s / pageSize}.
page env m delta =
  (q, tiles, mt, jobs, sessions) = env;
  p = clamp 0 (pages tiles - 1) (m.page + delta);
  _ = print "shell: page {p + 1}";
  {m | page = p, selected = p * pageSize}.

# Pointer adapter emits bounded virtual coordinates. A press launches, a move
# selects. The service only delivers input while this shell has graphics focus.
pointer env k m =
  press = k >= 2000000;
  pos = k - (case press of True -> 2000000 | False -> 1000000);
  x = pos % width; y = pos / width;
  case m.active != 0 of
    True -> (case press and y >= 530 of True -> key env (case scrollable m.active and x < width / 2 of True -> 19 | False -> 1) m | False ->
      case press and scrollable m.active and x >= 886 and x < 898 and y >= 236 and y < 470 of
        True -> scrollClick env m (y - 236)
      | False -> m)
  | False -> pointerHome env m press x y.
pointerHome env m press x y | y >= 530 =
  case press of True -> page env m (case x < width / 2 of True -> 0 - 1 | False -> 1) | False -> m.
pointerHome env m press x y | x < 42 or x >= 918 or y < 140 or y >= 476 = m.
pointerHome env m press x y =
  col = (x - 42) / 296; row = (y - 140) / 178;
  case (x - 42) % 296 >= 284 or (y - 140) % 178 >= 158 of
    True -> m
  | False ->
      (q, ts, mt, jobs, sessions) = env;
      n = m.page * pageSize + row * 3 + col;
      case n >= count ts of True -> m | False ->
        m2 = {m | selected = n};
        case press of True -> openTile env m2 | False -> m2.

openTile env m =
  (q, tiles, mt, jobs, sessions) = env;
  Tile id title hint ti = at tiles m.selected;
  _ = print "shell: open {id}";
  case ti == 0 - 100 of
    True -> {m | status = "Cannot open {id}: archive load was refused"}
  | False -> case ti < 0 of
      True ->
        next = {m | active = ti, status = title};
        (case scrollable ti of
          True -> paneUpdate (PN.Open (case ti == 0 - 2 of True -> 1 | False -> 2)) next
        | False -> paneUpdate PN.Leave next)
    | False -> {m | active = ti + 1, appFailed = False, appCommands = [AP.Open ti],
        inner = AW.Frame 0 0 (Box Nil Nil) Nil "Loading", status = title}.

scrollable a = a == 0 - 2 or a == 0 - 3.
scrollBy env m delta = paneUpdate (PN.Scroll delta) m.
scrollTo env m requested = paneUpdate (PN.Seek requested) m.
scrollClick env m y = paneUpdate (PN.Click y) m.
appKey env 103 m | scrollable m.active = scrollBy env m (0 - 1).
appKey env 108 m | scrollable m.active = scrollBy env m 1.
appKey env 104 m | scrollable m.active = scrollBy env m (0 - ST.visible).
appKey env 109 m | scrollable m.active = scrollBy env m ST.visible.
appKey env 102 m | scrollable m.active = scrollTo env m 0.
appKey env 107 m | scrollable m.active = scrollTo env m 1000000.
appKey env k m | m.active < 0 = m.
appKey env 19 m | m.appFailed = {m | appCommands = [AP.Open (m.active - 1)], appFailed = False}.
appKey env k m | m.appFailed = m.
appKey env k m = {m | appCommands = [AP.Deliver (AW.Key k)]}.
appEffects me sessions m Nil = m.
appEffects me sessions m (command :: rest) =
  next = case AP.call me sessions command of
      Err why -> _ = Sys.logAt 2 "shell app: {why}";
        {m | appFailed = True, status = "{why} - R RETRY / ESC HOME"}
    | Ok (AW.Frame sid revision tree vals status) -> {m | inner = AW.Frame sid revision tree vals status, appFailed = False}
    | Ok (AW.Closed sid result) -> m
    | Ok other -> {m | appFailed = True, status = "Invalid app session reply - R RETRY / ESC HOME"};
  appEffects me sessions next rest.

text s c size = Lbl [Fs size, Fg c] s.
spacer = Box [Grow] Nil.
header = Box [Row, H 82, Mid, Gap 20]
  [Box [Col, Gap 7] [text "QOS" ink 34, text "MAIN PROFILE" dim 12], spacer,
   text "Your space, ready." accent 16].
color n = case n % 4 of
    0 -> (230, 580, 900)
  | 1 -> (290, 750, 590)
  | 2 -> (690, 470, 900)
  | _ -> (920, 570, 350).
tile ts m n | n >= count ts = Box [W 284, H 158] Nil.
tile ts m n =
  Tile id title hint ti = at ts n;
  Box [Col, W 284, H 158, Pad 15, Gap 8, Round 20,
       Bg (case n == m.selected of True -> (130, 210, 320) | False -> (65, 98, 155))]
    [Box [Row, Gap 13, Mid]
      [Box [W 56, H 56, Round 16, Bg (color n), Center, Mid]
        [text (substr title 0 1) ink 28], text title ink 21],
     text hint dim 13,
     text (case ti == 0 - 100 of True -> ".QA REFUSED" | False ->
       case ti < 0 of True -> "SHORTCUT" | False -> ".QA APP") accent 11].
grid ts m =
  base = m.page * pageSize;
  Box [Col, Gap 20]
    [Box [Row, Gap 12] [tile ts m base, tile ts m (base + 1), tile ts m (base + 2)],
     Box [Row, Gap 12] [tile ts m (base + 3), tile ts m (base + 4), tile ts m (base + 5)]].
home ts m = Box [Col, W width, H height, Pad 42, Gap 16, Bg (18, 30, 60)]
  [header, grid ts m, spacer,
   Box [Row, Mid] [text "< PREVIOUS" dim 13, spacer,
     text "PAGE {m.page + 1} / {pages ts}" ink 14, spacer, text "NEXT >" dim 13],
   text m.status accent 13].
sheet title body = Box [Col, W width, H height, Pad 42, Gap 24, Bg (18, 30, 60)]
  [header, Box [Col, Grow, Pad 26, Gap 20, Round 24, Bg (65, 98, 155)]
    (text title ink 30 :: body), text "ESC OR CLICK HERE TO GO HOME     P SNAPSHOT" dim 14].
builtin self env m =
  (q, tiles, mt, jobs, sessions) = env;
  QS.Qsys ns st vfs log apps = q;
  case scrollable m.active of
    True -> scrollSheet (case m.active == 0 - 2 of True -> "Files & services" | False -> "System log")
      (PN.status m.pane) m.pane.rows m.pane.scroll
  | False -> builtinTree self ns mt m.active.
scrollSheet title subtitle rows off =
  Box [Col, W width, H height, Pad 42, Gap 16, Bg (18, 30, 60)]
    [header,
     Box [Col, W 876, H 378, Pad 20, Gap 12, Round 24, Bg (65, 98, 155)]
       [text title ink 30, text subtitle accent 14, ST.pane rows off,
        Box [Row, W 836, Mid]
          [text (ST.range rows off) accent 12, spacer,
           text "UP / DOWN   PGUP / PGDN   HOME / END" dim 12]],
     text "R REFRESH / RETRY (CLICK LEFT)   ESC HOME (CLICK RIGHT)" dim 14].
builtinTree self ns mt a | a == 0 - 1 = sheet "Take your time" [text (AK.clockStr mt) ink 70, text "QOS runtime clock" dim 17].
builtinTree self ns mt a = sheet "Welcome to QOS" [text "An actor system, written in FP-RISC." ink 20,
       text "Apps come from the onboard disk. Shortcuts live here." dim 16,
       text "ARROWS select   ENTER open   PGUP / PGDN pages" accent 16,
       text "Mouse: move to select, click to open." accent 16].
view self env vp m =
  (q, tiles, mt, jobs, sessions) = env;
  tree = case m.active == 0 of
      True -> home tiles m
    | False -> case m.active < 0 of
        True -> builtin self env m
      | False -> appTree m;
  (es, slots) = S2.buildW (width, height) tree;
  vals = case m.active > 0 of
      True -> (case m.inner of AW.Frame sid revision tree vals status -> vals | other -> Nil)
    | False -> Nil;
  # The overlay walks text as well as geometry every frame. The 3D static
  # mesh cache does not retain proportional glyphs, so UI belongs here.
  (S2.sceneAt height Nil Nil, (cat es (S2.dyns slots vals), S2.camAt height), m.snap).

appTree m = case m.inner of
    AW.Frame sid revision tree vals status -> if m.appFailed and sid == 0 then
      sheet "Application unavailable" [text (substr m.status 0 110) accent 14, text "R RETRY     ESC HOME" ink 16]
      else Box [Col, W width, H height, Bg (62, 70, 88)]
      [tree, text (substr (if m.appFailed then m.status else "{status}    ESC HOME") 0 110) accent 12]
  | other -> sheet "Application unavailable" [text m.status accent 14].

input graphics w h me = inputLoop graphics w h me (width / 2) (height / 2) 0.
inputLoop graphics w h me x y buttons =
  (from, MV.Poll _) = receive me;
  case MV.svcCallRes me graphics (MV.Poll 0) of
      Err why -> Unit
    | Ok ev -> (kind, a, b) = ev;
               inputEvent graphics w h me from x y buttons kind a b.
inputEvent graphics w h me from x y buttons 2 dx dy =
  xx = clamp 0 (width - 1) (x + dx * width / w);
  yy = clamp 0 (height - 1) (y - dy * height / h);
  _ = send from (4, 1000000 + yy * width + xx, 1);
  _ = Sys.poolReset 0;
  inputLoop graphics w h me xx yy buttons.
inputEvent graphics w h me from x y buttons 7 px py =
  xx = clamp 0 (width - 1) (px * width / w);
  yy = clamp 0 (height - 1) (py * height / h);
  _ = send from (4, 1000000 + yy * width + xx, 1);
  _ = Sys.poolReset 0;
  inputLoop graphics w h me xx yy buttons.
inputEvent graphics w h me from x y buttons 3 next _ =
  code = case band next 1 != 0 and band buttons 1 == 0 of
      True -> (4, 2000000 + y * width + x, 1)
    | False -> (4, 0, 0);
  _ = send from code;
  _ = Sys.poolReset 0;
  inputLoop graphics w h me x y next.
inputEvent graphics w h me from x y buttons kind a b =
  _ = send from (kind, a, b);
  _ = Sys.poolReset 0;
  inputLoop graphics w h me x y buttons.

main = run "qos-shell".
run tag =
  runWith tag update.
# Validation entries can wrap updates while sharing the real boot/lifecycle.
runWith tag upd =
  me = myself 0;
  (q, lifecycle) = QS.bootManagedSized me width height;
  QS.Qsys ns st vfs log apps = q;
  tiles = cat shortcuts (installed me st apps);
  mt = reg32 (device "clint") 49144;
  attached = GX.attach me ns tag;
  case attached of
      Err why -> finishUnattached me lifecycle (Err "shell graphics: {why}")
    | Ok ep -> runAttached me upd q lifecycle tiles mt ep.
runAttached me upd q lifecycle tiles mt ep =
  (graphics, h) = ep;
  calls = spawn (AC.session me);
  dimsResult = case AC.deadlineAfter serviceBudgetMs of
      Err why -> Err why
    | Ok deadline -> AC.sessionCallUntil deadline me calls graphics (fn ret -> (ret, MV.Dims 0));
  _ = kill calls;
  case dimsResult of
      Err why -> finishSession me lifecycle ep (Err "shell dimensions: {why}")
    | Ok dims -> runSized me upd q lifecycle tiles mt ep dims.
runSized me upd q lifecycle tiles mt ep dims =
  QS.Qsys ns st vfs log apps = q;
  (graphics, h) = ep;
  (w, hh) = dims;
  inp = spawn (input graphics w hh);
  _ = print "shell: Main Profile ready ({count tiles} shortcuts, {pages tiles} pages)";
  port = spawn MV.port;
  jobs = spawn (PJ.owner ns port serviceBudgetMs);
  sessions = spawn (AP.run me ns st width (height - 32));
  cfg = {env = (q, tiles, mt, jobs, sessions), mt = mt, tick = 333330, input = inp, render = graphics};
  app = MV.MApp init upd staticKey staticView view done (subscriptions port);
  _ = QS.ready lifecycle;
  result = MV.runResultWithin serviceBudgetMs me cfg app;
  appsStopped = AP.stop me sessions;
  _ = kill sessions;
  stopped = PJ.stop me jobs;
  _ = kill jobs;
  _ = kill inp;
  _ = kill port;
  finishSession me lifecycle ep (withCleanup (withCleanup result "app sessions close" appsStopped) "pane worker close" stopped).
finishSession me lifecycle ep result =
  _ = Sys.shutdownBegin Unit;
  (graphics, h) = ep;
  closed = EP.flat (AC.callWithin serviceBudgetMs me graphics (EP.Close h));
  finishUnattached me lifecycle (withCleanup result "graphics close" closed).
finishUnattached me lifecycle result =
  _ = Sys.shutdownBegin Unit;
  stopped = QS.stop me lifecycle;
  _ = case stopped of Ok value -> print "shell: {value}" | Err why -> Unit;
  case withCleanup result "shell shutdown" stopped of
      Ok value -> value
    | Err why ->
        _ = Sys.logAt 2 "shell stopped: {why}";
        _ = Sys.shutdownComplete 1;
        error "shell stopped: {why}".
withCleanup result label cleanup = case cleanup of
    Ok value -> result
  | Err why -> case result of
        Ok value -> Err "{label}: {why}"
      | Err primary -> Err "{primary}; {label}: {why}".

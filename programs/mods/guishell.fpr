# A small Main Profile shell over the existing System/Graphics and appkit ABI.
# Cooperative app plugins run inside this shell; this is not process isolation.
unsafe module.
QS = use "qsys".
GX = use "graphics".
EP = use "ep#c66ad65e68dd97f5".
AK = use "appkit".
S2 = use "scene2d".
ST = use "scrolltext".
PN = use "panemvu".
PJ = use "panejobs".
AP = use "appclient".
AW = use "appwire".
L = use "shelllayout".
SI = use "shellinput".
FS = use "std/fs#84826bc9e8ddb4b5".
AC = use "std/actor#201a0e9bf98a5154".
MV = use "std/mvu".

Box = S2.Box. Lbl = S2.Lbl.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Fs = S2.Fs.
Bg = S2.Bg. Fg = S2.Fg. Round = S2.Round. Center = S2.Center. Mid = S2.Mid.
Tile = Type (Tile id title hint table).
width = 960. height = 600.
serviceBudgetMs = 5000.
ink = (940, 950, 990). dim = (530, 610, 750).
accent = (380, 800, 980).

count Nil = 0.
count (_ :: r) = 1 + count r.
cat Nil ys = ys.
cat (x :: r) ys = x :: cat r ys.
at (x :: r) 0 = x.
at (x :: r) n = at r (n - 1).
at Nil n = Tile "" "" "" (0 - 1).
clamp lo hi n | n < lo = lo.
clamp lo hi n | n > hi = hi.
clamp lo hi n = n.
pages ts = L.pages (L.layout width height) (count ts).
pagesAt m ts = L.pages m.layout (count ts).

shortcuts = [Tile "clock" "Clock" "A moment of calm" (0 - 1),
             Tile "files" "Files" "Explore your onboard URLs" (0 - 2),
             Tile "logs" "Logs" "See what QOS is doing" (0 - 3),
             Tile "about" "About QOS" "Small language. Open system." (0 - 4)].
installed me st apps = case st == 0 of
    True -> Nil
  | False -> case FS.readLatest me st "apps/index" of
      Err why -> _ = Sys.logAt (if FS.missing why then 1 else 2) "shell: app index unavailable ({why})"; Nil
    | Ok s -> diskTiles (AK.lines s) apps.
diskTiles Nil apps = Nil.
diskTiles (id :: rest) apps = diskTile id apps :: diskTiles rest apps.
diskTile id Nil = Tile id id "Archive could not be attached" (0 - 100).
diskTile id (QS.App aid name ti :: rest) = case id == aid of
    True -> Tile id name "Onboard .qa application" ti
  | False -> diskTile id rest.


init env = {page = 0, selected = 0, active = 0, inner = AW.Frame 0 0 (Box Nil Nil) Nil "", appFailed = False, appCommands = Nil, status = "Ready when you are", snap = 0, pane = PN.init, commands = Nil, layout = L.layout width height, focus = L.Tile 0, hover = L.None, inputActive = True, pointerX = 0, pointerY = 0, down = False, capture = L.None, wheel = 0, dragY = 0, dragScroll = 0, clock = "00:00", renderVersion = 0}.
staticKey m = m.renderVersion + m.snap.
staticView vp m = 0.
done m = "shell ended".
subscriptions port m = MV.SPort port :: subs m.
subs m = [MV.STick 100, MV.SKeys].
# Visible child state determines a monotonic render revision. Idle ticks and
# motion within one hover target keep it. Input still runs at the usual pace;
# all visible facts arrive through ordinary recursive MVU updates.
update me env event m =
  (next, commands) = updateModel me env event m;
  (reviseView m next, commands).
visualKey m = (m.page, m.selected, m.active, (if m.active > 0 then frameKey m.inner else (0, Box Nil Nil, Nil, "")),
  m.appFailed, m.status, m.pane.phase, m.pane.rows, m.pane.metrics, m.pane.scroll,
  m.layout, m.focus, m.hover, m.inputActive, m.clock).
# Transport revisions acknowledge messages, not pixels. Dynamic slot values
# and child status remain part of the visible key even when the tree is shared.
frameKey (AW.Frame sid revision tree vals status) = (sid, tree, vals, status).
frameKey other = (0, Box Nil Nil, Nil, "").
reviseView previous next = if visualKey previous == visualKey next then next else
  {next | renderVersion = previous.renderVersion + 1}.
updateModel me env (MV.EKey 16) m | m.active == 0 and m.inputActive = (m, [MV.MQuit]).
updateModel me env (MV.EKey k) m = effects me env (key env k m).
updateModel me env (MV.EResize w h) m = effects me env (resize env w h m).
updateModel me env (MV.EWheel dy dx) m = effects me env (wheel env dy dx m).
updateModel me env MV.ETick m = effects me env (if m.active > 0 and not m.appFailed and m.inputActive then
  {m | appCommands = [AP.Deliver AW.Tick]} else paneUpdate PN.Tick m).
updateModel me env (MV.EMsg "quit" _) m = (m, [MV.MQuit]).
updateModel me env (MV.EMsg tag body) m = case PJ.decode tag body of
    Err why -> (m, Nil)
  | Ok msg ->
      next = paneUpdate msg m;
      _ = case PN.loading m.pane and not (PN.loading next.pane) and next.pane.source != 0 and (m.pane.rows == Nil or (case next.pane.phase of PN.Failed why -> True | other -> False)) of
          True -> print "shell: pane {next.pane.source} {PN.status next.pane}"
        | False -> Unit;
      effects me env next.
updateModel me env ev m = (m, Nil).
# Child commands are values, interpreted outside the pure pane update/view.
paneUpdate msg m =
  (pane, commands) = PN.update msg m.pane;
  {m | pane = pane, commands = cat m.commands commands}.
effects me env m =
  (q, tiles, mt, jobs, sessions) = env;
  applied = appEffects me sessions m m.appCommands;
  seconds = if m.active == 0 - 1 then Sys.mtime Unit / 10000000 else 0;
  clock = if m.active == 0 - 1 then "{AK.pad2 (seconds / 60 % 60)}:{AK.pad2 (seconds % 60)}" else applied.clock;
  cleared = {applied | commands = Nil, appCommands = Nil, clock = clock};
  case PJ.run me jobs applied.commands of
      Ok u -> (cleared, Nil)
    | Err why -> (paneUpdate (PN.Complete m.pane.generation m.pane.source (Err why)) cleared, Nil).
# Pure recursive input policy. A click commits on release over its captured
# target; resize, focus loss and keyboard navigation revoke that capture.
resize env w h m = if not (L.valid w h) then m else
  l = L.layout w h;
  r = L.pane l;
  next = paneUpdate (PN.Resize r.w r.h (L.px l 16) (L.px l 26)) m;
  {next | layout = l, page = m.selected / l.capacity, down = False, capture = L.None, hover = L.None, wheel = 0,
    appCommands = [AP.Resize w l.footer]}.
key env k m = routeInput env (SI.decode k) m.
routeInput env (SI.Focus active) m =
  {m | inputActive = active, down = False, capture = L.None, hover = L.None, wheel = 0,
    appCommands = (if m.active > 0 and not m.appFailed then [AP.Deliver (AW.Focus active)] else Nil)}.
routeInput env SI.Cancel m = {m | down = False, capture = L.None, hover = L.None,
  appCommands = (if m.active > 0 and not m.appFailed then [AP.Deliver AW.Cancel] else Nil)}.
routeInput env ev m | not m.inputActive = m.
routeInput env (SI.Move x y) m = pointerEvent env 0 x y m.
routeInput env (SI.Down x y) m = pointerEvent env 1 x y m.
routeInput env (SI.Up x y) m = pointerEvent env 2 x y m.
routeInput env (SI.Key k) m =
  next = keyCode env k {m | down = False, capture = L.None};
  if m.active > 0 and m.down and not m.appFailed and next.active > 0 then
    {next | appCommands = AP.Deliver AW.Cancel :: next.appCommands} else next.
keyCode env 1 m =
  _ = print "shell: home";
  paneUpdate PN.Leave {m | active = 0, appCommands = [AP.Home], status = "Welcome home",
    inner = AW.Frame 0 0 (Box Nil Nil) Nil "", focus = L.Tile m.selected, hover = L.None, down = False, capture = L.None, wheel = 0}.
# P snapshots from the home grid and the shortcuts; while an app is open a
# typed p is the app's, and ctrl-P (the input tier's +4000 bias) snapshots
keyCode env 25 m | m.active <= 0 = _ = print "shell: snapshot {m.snap + 1}"; {m | snap = m.snap + 1}.
keyCode env 4025 m = _ = print "shell: snapshot {m.snap + 1}"; {m | snap = m.snap + 1}.
keyCode env 15 m = tab False m.
keyCode env 1015 m = tab True m.
# Enter activates the focused control; so does Space, except inside an
# open app's content, where a space is a typed character
keyCode env k m | k == 28 or (k == 57 and not (m.active > 0 and m.focus == L.Content)) = activate env m.focus {m | down = False, capture = L.None}.
keyCode env 19 m | scrollable m.active = paneUpdate PN.Refresh m.
keyCode env 19 m | m.active > 0 = appKey env 19 m.
keyCode env k m | m.active != 0 = if m.focus == L.Content or m.focus == L.Scrollbar then appKey env k m else m.
keyCode env 106 m = select env m (m.selected + 1).
keyCode env 105 m = select env m (m.selected - 1).
keyCode env 108 m = select env m (m.selected + m.layout.cols).
keyCode env 103 m = select env m (m.selected - m.layout.cols).
keyCode env 109 m = page env m 1.
keyCode env 104 m = page env m (0 - 1).
keyCode env 102 m = select env m 0.
keyCode env 107 m = (q, tiles, mt, jobs, sessions) = env; select env m (count tiles - 1).
keyCode env k m = m.
tab reverse m =
  target = if m.active == 0 then (case m.focus of
      L.Previous -> if reverse then L.Tile m.selected else L.Next
    | L.Next -> if reverse then L.Previous else L.Tile m.selected
    | other -> if reverse then L.Next else L.Previous)
    else (case m.focus of
      L.Refresh -> if reverse then L.Content else L.Home
    | L.Home -> if reverse then L.Refresh else L.Content
    | other -> if reverse then L.Home else L.Refresh);
  {m | focus = target, capture = L.None, down = False, hover = L.None}.
activate env (L.Tile index) m = openTile env (select env m index).
activate env L.Previous m = next = page env m (0 - 1); {next | focus = L.Previous}.
activate env L.Next m = next = page env m 1; {next | focus = L.Next}.
activate env L.Home m = keyCode env 1 m.
activate env L.Refresh m = if scrollable m.active then paneUpdate PN.Refresh m else appKey env 19 m.
activate env L.Content m = if m.active > 0 then appKey env 28 m else m.
activate env target m = m.
select env m n =
  (q, tiles, mt, jobs, sessions) = env;
  selected = clamp 0 (L.max 0 (count tiles - 1)) n;
  {m | selected = selected, page = selected / m.layout.capacity, focus = L.Tile selected, capture = L.None, down = False, hover = L.None}.
page env m delta =
  (q, tiles, mt, jobs, sessions) = env;
  p = clamp 0 (pagesAt m tiles - 1) (m.page + delta);
  _ = print "shell: page {p + 1}";
  select env m (p * m.layout.capacity).
# The compatibility entry decodes the adapter's fixed-stride virtual key.
pointer env k m = routeInput env (SI.decode k) m.
hit env m x y =
  (q, tiles, mt, jobs, sessions) = env;
  if m.active == 0 then L.hitHome m.layout m.page (count tiles) x y else
    if scrollable m.active then L.hitPane m.layout x y else L.hitApp m.layout x y.
pointerEvent env kind x y m =
  target = hit env m x y;
  moved = {m | pointerX = x, pointerY = y, hover = target};
  if kind == 1 then if m.down then moved else
    chosen = case target of L.Tile index -> select env moved index | other -> moved;
    pressed = {chosen | down = True, capture = target, dragY = y, dragScroll = m.pane.scroll, focus = (if target == L.None then m.focus else target)};
    pointerContent env x y 1 pressed
  else if kind == 2 then
    released = pointerContent env x y 0 {moved | down = False};
    fresh = {released | capture = L.None};
    if m.down and m.capture == target and target != L.Content and target != L.Scrollbar then activate env target fresh else fresh
  else pointerContent env x y (if m.down then 1 else 0) moved.
pointerContent env x y buttons m =
  if m.capture == L.Scrollbar and buttons == 1 then
    r = L.pane m.layout; paneUpdate (PN.Click (y - r.y)) m
  else if scrollable m.active and m.capture == L.Content and buttons == 1 then
    paneUpdate (PN.Seek (m.dragScroll + (m.dragY - y) / m.pane.metrics.pitch)) m
  else if m.active > 0 and not m.appFailed and (m.capture == L.Content or m.hover == L.Content) then
    {m | appCommands = [AP.Deliver (AW.Pointer x y buttons)]}
  else m.
wheel env dy dx m = if not m.inputActive or (m.focus != L.Content and m.focus != L.Scrollbar) then m else
  if scrollable m.active then
    amount = m.wheel - dy * 3;
    scrollBy env {m | wheel = amount % 10, down = False, capture = L.None} (amount / 10)
  else if m.active > 0 and not m.appFailed then {m | down = False, capture = L.None, appCommands =
    (if m.down then [AP.Deliver AW.Cancel, AP.Deliver (AW.Wheel dy dx)] else [AP.Deliver (AW.Wheel dy dx)])} else m.

openTile env m =
  (q, tiles, mt, jobs, sessions) = env;
  Tile id title hint ti = at tiles m.selected;
  _ = print "shell: open {id}";
  case ti == 0 - 100 of
    True -> {m | status = "Cannot open {id}: archive load was refused"}
  | False -> case ti < 0 of
      True ->
        next = {m | active = ti, status = title, focus = L.Content, down = False, capture = L.None, wheel = 0};
        (case scrollable ti of
          True -> paneUpdate (PN.Open (case ti == 0 - 2 of True -> 1 | False -> 2)) next
        | False -> paneUpdate PN.Leave next)
    | False -> {m | active = ti + 1, appFailed = False, appCommands = [AP.Open ti],
        inner = AW.Frame 0 0 (Box Nil Nil) Nil "Loading", status = title, focus = L.Content, down = False, capture = L.None, wheel = 0}.

scrollable a = a == 0 - 2 or a == 0 - 3.
scrollBy env m delta = paneUpdate (PN.Scroll delta) m.
scrollTo env m requested = paneUpdate (PN.Seek requested) m.
scrollClick env m y = paneUpdate (PN.Click y) m.
appKey env 103 m | scrollable m.active = scrollBy env m (0 - 1).
appKey env 108 m | scrollable m.active = scrollBy env m 1.
appKey env 104 m | scrollable m.active = scrollBy env m (0 - m.pane.metrics.visible).
appKey env 109 m | scrollable m.active = scrollBy env m m.pane.metrics.visible.
appKey env 102 m | scrollable m.active = scrollTo env m 0.
appKey env 107 m | scrollable m.active = scrollTo env m 1000000.
appKey env k m | m.active < 0 = m.
appKey env 19 m | m.appFailed = {m | appCommands = [AP.Open (m.active - 1)], appFailed = False}.
appKey env k m | m.appFailed = m.
appKey env k m = {m | appCommands = [AP.Deliver (AW.Key k)]}.
appEffects me sessions m Nil = m.
appEffects me sessions m (command :: rest) =
  next = case AP.call me sessions command of
      Err why -> _ = Sys.logAt 2 "shell app: {why}";
        {m | appFailed = True, status = "{why} - R RETRY / ESC HOME"}
    | Ok (AW.Frame sid revision tree vals status) -> {m | inner = AW.Frame sid revision tree vals status, appFailed = False}
    | Ok (AW.Closed sid result) -> m
    | Ok other -> {m | appFailed = True, status = "Invalid app session reply - R RETRY / ESC HOME"};
  appEffects me sessions next rest.

text s c size = Lbl [Fs size, Fg c] s.
spacer = Box [Grow] Nil.
label l s c size width = Lbl [Fs (L.px l size), Fg c, S2.Ellip width] s.
header l = Box [Row, W l.content, H l.header, Mid, Gap (L.px l 20)]
  [Box [Col, Gap (L.px l 7)] [text "QOS" ink (L.px l 34), text "MAIN PROFILE" dim (L.px l 12)], spacer,
   label l (if l.w < 800 then "" else "Your space, ready.") accent 16 (l.content / 2)].
color n = case n % 4 of 0 -> (230, 580, 900) | 1 -> (290, 750, 590) | 2 -> (690, 470, 900) | other -> (920, 570, 350).
tile ts m n | n >= count ts = Box [W m.layout.tileW, H m.layout.tileH] Nil.
tile ts m n =
  l = m.layout;
  Tile id title hint ti = at ts n;
  focused = m.inputActive and m.focus == L.Tile n;
  Box [Col, W l.tileW, H l.tileH, Pad (L.px l 15), Gap (L.px l 8), Round (L.px l 20), S2.Clip,
       S2.Bord (if focused then accent else (65, 98, 155)),
       Bg (if focused or m.hover == L.Tile n then (130, 210, 320) else (65, 98, 155))]
    [Box [Row, Gap (L.px l 13), Mid]
      [Box [W (L.px l 56), H (L.px l 56), Round (L.px l 16), Bg (color n), Center, Mid]
        [text (substr title 0 1) ink (L.px l 28)], label l title ink 21 (L.max 1 (l.tileW - L.px l 100))],
     label l hint dim 13 (l.tileW - L.px l 30),
     text (if ti == 0 - 100 then ".QA REFUSED" else if ti < 0 then "SHORTCUT" else ".QA APP") accent (L.px l 11)].
grid ts m =
  l = m.layout;
  Box [Col, W l.content, H (l.rows * l.tileH + (l.rows - 1) * l.rowGap), Gap l.rowGap]
    (gridRows ts m 0).
gridRows ts m row = if row >= m.layout.rows then Nil else
  Box [Row, Gap m.layout.gap] (gridCols ts m row 0) :: gridRows ts m (row + 1).
gridCols ts m row col = if col >= m.layout.cols then Nil else
  tile ts m (m.page * m.layout.capacity + row * m.layout.cols + col) :: gridCols ts m row (col + 1).
button m target title width =
  l = m.layout;
  Box [Col, W width, H (L.px l 44), Pad (L.px l 10), Round (L.px l 8),
    S2.Bord (if m.inputActive and m.focus == target then accent else (18, 30, 60)),
    Bg (if m.hover == target then (65, 98, 155) else (18, 30, 60))]
    [label l title (if m.inputActive and m.focus == target then ink else dim) 14 (width - L.px l 20)].
footer m leftTarget leftTitle rightTarget rightTitle =
  l = m.layout;
  Box [Row, W l.content, H (L.px l 44)]
    [button m leftTarget leftTitle (l.content / 2), button m rightTarget rightTitle (l.content - l.content / 2)].
surface m body leftTarget leftTitle rightTarget rightTitle status =
  l = m.layout;
  Box [Col, W l.w, H l.h, Bg (18, 30, 60), S2.Clip]
    [Box [H l.margin] Nil,
     Box [Row, W l.w, H (l.h - l.margin)] [Box [W l.margin] Nil,
       Box [Col, W l.content, H (l.h - l.margin)]
        [header l, Box [H (L.px l 16)] Nil, body, spacer,
         footer m leftTarget leftTitle rightTarget rightTitle,
         Box [H (L.px l 16)] [label l status accent 12 l.content], Box [H (L.px l 10)] Nil]]].
home ts m = surface m (grid ts m) L.Previous "< PREVIOUS PAGE" L.Next "NEXT PAGE >"
  "PAGE {m.page + 1} / {pagesAt m ts}   {m.status}".
sheet m title body =
  l = m.layout; p = L.panel l;
  surface m (Box [Col, W p.w, H p.h, Pad (L.px l 20), Gap (L.px l 12), Round (L.px l 24), Bg (65, 98, 155), S2.Clip]
    (label l title ink 30 (p.w - L.px l 40) :: body)) L.Refresh "R REFRESH / RETRY" L.Home "ESC HOME" "TAB FOCUS   ENTER ACTIVATE   P SNAPSHOT".
builtin self env m =
  (q, tiles, mt, jobs, sessions) = env;
  QS.Qsys ns st vfs log apps = q;
  if scrollable m.active then scrollSheet m (if m.active == 0 - 2 then "Files & services" else "System log")
    else builtinTree self ns mt m.
scrollSheet m title =
  l = m.layout; p = L.panel l; metrics = m.pane.metrics;
  surface m (Box [Col, W p.w, H p.h, Pad (L.px l 20), Round (L.px l 24), Bg (65, 98, 155),
    S2.Bord (if m.inputActive and (m.focus == L.Content or m.focus == L.Scrollbar) then accent else (65, 98, 155))]
    [Box [H (L.px l 36)] [label l title ink 30 metrics.w], Box [H (L.px l 8)] Nil,
     Box [H (L.px l 20)] [label l (PN.status m.pane) accent 14 metrics.w], Box [H (L.px l 12)] Nil,
     ST.paneWith metrics m.pane.rows m.pane.scroll, Box [H (L.px l 12)] Nil,
     Box [H (L.px l 16)] [label l (ST.rangeWith metrics m.pane.rows m.pane.scroll) accent 12 metrics.w]])
    L.Refresh "R REFRESH / RETRY" L.Home "ESC HOME" "UP/DOWN   PGUP/PGDN   HOME/END   TAB FOCUS".
builtinTree self ns mt m | m.active == 0 - 1 = sheet m "Take your time"
  [text m.clock ink (L.px m.layout 70), text "QOS runtime clock" dim (L.px m.layout 17)].
builtinTree self ns mt m = sheet m "Welcome to QOS"
  [label m.layout "An actor system, written in FP-RISC." ink 20 (m.layout.content - 40),
   label m.layout "ARROWS select   ENTER open   TAB focus" accent 16 (m.layout.content - 40),
   label m.layout "Mouse or touch: press and release to open." accent 16 (m.layout.content - 40)].
view self env vp m =
  (q, tiles, mt, jobs, sessions) = env;
  l = m.layout;
  tree = if m.active == 0 then home tiles m else if m.active < 0 then builtin self env m else appTree m;
  (es, slots) = S2.buildW (l.w, l.h) tree;
  vals = if m.active > 0 then (case m.inner of AW.Frame sid revision tree vals status -> vals | other -> Nil) else Nil;
  (S2.sceneAt l.h Nil Nil, (cat es (S2.dyns slots vals), S2.camAt l.h), m.snap).
appTree m = case m.inner of
    AW.Frame sid revision tree vals status -> if m.appFailed and sid == 0 then
      sheet m "Application unavailable" [label m.layout m.status accent 14 (m.layout.content - 40)]
      else l = m.layout;
        Box [Col, W l.w, H l.h, Bg (18, 30, 60), S2.Clip]
          [Box [W l.w, H l.footer, S2.Clip] [tree],
           Box [Row] [Box [W l.margin] Nil, footer m L.Refresh "R REFRESH / RETRY" L.Home "ESC HOME"],
           Box [Row, H (L.px l 16)] [Box [W l.margin] Nil, label l (if m.appFailed then m.status else status) accent 12 l.content]]
  | other -> sheet m "Application unavailable" [text m.status accent 14].

# The native service is only a source of facts. This persistent adapter owns
# position/buttons and translates them into the existing driver's event wire.
input graphics w h me = _ = Sys.loop (SI.init w h) (inputStep graphics me); Unit.
inputStep graphics me state =
  (from, MV.Poll _) = receive me;
  case MV.svcCallRes me graphics (MV.Poll 0) of
    Err why -> (False, state)
  | Ok (kind, a, b) ->
      (event, next) = SI.adapt kind a b state;
      _ = send from event;
      (True, next).

main = run "qos-shell".
run tag =
  runWith tag update.
# Validation entries can wrap updates while sharing the real boot/lifecycle.
runWith tag upd = runWindow tag upd 0 0.
runWindow tag upd requestedW requestedH =
  runProgram tag (MV.MApp init upd staticKey staticView view done subs) requestedW requestedH.
# A diagnostic entry is an ordinary MVU program over its own model. The
# shell still owns the same boot, ports, deadlines and shutdown sequence.
runProgram tag app requestedW requestedH =
  me = myself 0;
  (q, lifecycle) = QS.bootManagedSized me requestedW requestedH;
  QS.Qsys ns st vfs log apps = q;
  tiles = cat shortcuts (installed me st apps);
  mt = reg32 (device "clint") 49144;
  attached = GX.attach me ns tag;
  case attached of
      Err why -> finishUnattached me lifecycle (Err "shell graphics: {why}")
    | Ok ep -> runAttached me app q lifecycle tiles mt ep.
runAttached me app q lifecycle tiles mt ep =
  (graphics, h) = ep;
  calls = spawn (AC.session me);
  dimsResult = case AC.deadlineAfter serviceBudgetMs of
      Err why -> Err why
    | Ok deadline -> AC.sessionCallUntil deadline me calls graphics (fn ret -> (ret, MV.Dims 0));
  _ = kill calls;
  case dimsResult of
      Err why -> finishSession me lifecycle ep (Err "shell dimensions: {why}")
    | Ok dims -> runSized me app q lifecycle tiles mt ep dims.
runSized me program q lifecycle tiles mt ep dims =
  QS.Qsys ns st vfs log apps = q;
  (graphics, h) = ep;
  (w, hh) = dims;
  layout = L.layout w hh;
  inp = spawn (input graphics w hh);
  _ = print "shell: Main Profile ready ({count tiles} shortcuts, {L.pages (L.layout w hh) (count tiles)} pages)";
  port = spawn MV.port;
  jobs = spawn (PJ.owner ns port serviceBudgetMs);
  sessions = spawn (AP.run me ns st w layout.footer);
  cfg = {env = (q, tiles, mt, jobs, sessions), mt = mt, tick = 333330, input = inp, render = graphics};
  app = withPort port program;
  _ = QS.ready lifecycle;
  result = MV.runRetainedResultWithin serviceBudgetMs me cfg app;
  appsStopped = AP.stop me sessions;
  _ = kill sessions;
  stopped = PJ.stop me jobs;
  _ = kill jobs;
  _ = kill inp;
  _ = kill port;
  finishSession me lifecycle ep (withCleanup (withCleanup result "app sessions close" appsStopped) "pane worker close" stopped).
withPort port (MV.MApp ini upd sk vw vl dn sbs) = MV.MApp ini upd sk vw vl dn (portSubs port sbs).
portSubs port sbs model = MV.SPort port :: sbs model.
finishSession me lifecycle ep result =
  _ = Sys.shutdownBegin Unit;
  (graphics, h) = ep;
  closed = EP.flat (AC.callWithin serviceBudgetMs me graphics (EP.Close h));
  finishUnattached me lifecycle (withCleanup result "graphics close" closed).
finishUnattached me lifecycle result =
  _ = Sys.shutdownBegin Unit;
  stopped = QS.stop me lifecycle;
  _ = case stopped of Ok value -> print "shell: {value}" | Err why -> Unit;
  case withCleanup result "shell shutdown" stopped of
      Ok value -> value
    | Err why ->
        _ = Sys.logAt 2 "shell stopped: {why}";
        _ = Sys.shutdownComplete 1;
        error "shell stopped: {why}".
withCleanup result label cleanup = case cleanup of
    Ok value -> result
  | Err why -> case result of
        Ok value -> Err "{label}: {why}"
      | Err primary -> Err "{primary}; {label}: {why}".

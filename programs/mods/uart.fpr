# ============================================================================
# uart.fpr -- UART.qa: the UART main actor.  ONE actor owns the 16550;
# everything else in the system talks to it in messages, and the
# DEVICE talks to it in interrupts.
#
#   * TX is "DMA-shaped": a client's write ENQUEUES bytes into the
#     actor's outgoing buffer and returns immediately; the actor
#     drains the buffer into the THR FIFO on transmit interrupts
#     (IER.THRE), not by spinning on LSR.  flush is the completion
#     round trip.
#   * RX interrupts (IER.RDA) interrupt THIS ACTOR ONLY: the irq
#     arrives as a plain Int message (Sys.irqBind, actors.c), the
#     actor reads RBR until LSR.DR clears, appends to its rx buffer,
#     re-arms the source (Sys.irqAck), and hands data DOWNSTREAM as
#     ordinary messages -- a subscriber gets (URx bytes) pushes, a
#     poller gets them from UGet.
#   * On QOS Portable there is no PLIC: irqBind/irqAck are weak
#     no-ops, LSR.THRE is always ready (the host tty never fills),
#     so TX drains synchronously at the kick and RX drains at every
#     message -- the SAME protocol, a synchronous backend.
#
# The message surface (RPC envelope: send svc (me, <msg>)):
#   UOpen              -> UOk        claim the device (one owner at a time)
#   UParams div        -> UOk        divisor latch (DLAB dance)
#   UBuf cap           -> UOk        outgoing-buffer byte budget
#   UArm               -> UOk        enable interrupts, bind irq, go live
#   UWrite s           -> UOkI n     enqueue n=strlen s (0 = budget full)
#   UFlush             -> UOk        answered when the tx buffer is EMPTY
#   UGet               -> UOkS s     take the rx buffer (may be "")
#   USub a             -> UOk        push future rx chunks to a as (URx s)
#   UClose             -> UOk        release the device, unsubscribe
#   UShare             -> UOk        owner opts into SHARED writes: any
#                                    capability-routed caller may
#                                    UWrite/UFlush/UGet (System.qa's
#                                    /services/uart tier; config stays
#                                    owner-only)
# and the DEVICE's own arm: a bare Int (the irq number).
#
# Protocol safety lives in std/uart.fpr's LINEAR PHASE-TYPED handle;
# this actor still answers UErr honestly if spoken to out of order
# (a raw-message caller is not type-checked).
# ============================================================================

UMsg = Type (UOpen | UParams d | UBuf n | UArm | UWrite s | UFlush
             | UGet | USub a | UClose | UShare).
URep = Type (UOk | UOkI n | UOkS s | UErr e).
URx  = Type (URx s).

# 16550 registers (byte offsets off device "uart")
#   0 RBR/THR/DLL   1 IER/DLM   2 IIR/FCR   3 LCR   5 LSR
# LSR bits: 0 DR (rx data ready)  5 THRE (tx holding empty)

uartIrq = 10.   # QEMU virt: UART0 is PLIC source 10

# ---- device helpers --------------------------------------------------------

lsrDR v = BITTEST v 0.
lsrTHRE v = BITTEST v 5.

# ---- the actor state machine ----------------------------------------------
# St dev owner cap txq txn rxs sub flushers
#   dev      the uart Device (0 before UOpen probes it)
#   owner    0 = unclaimed; else the client actor
#   cap      outgoing-buffer budget (bytes)
#   txq      pending outgoing bytes, oldest first (String)
#   rxs      received bytes not yet taken (String)
#   sub      0 = no subscriber; else the downstream actor
#   fl       0 = nobody waiting on flush; else the flusher's actor

St = Type (St dev owner cap txq rxs sub fl armed).

actor : unsafe Int -> a .
actor me = loop me (St 0 0 4096 "" "" 0 0 0).

loop : unsafe Int -> St -> a .
loop me st =
  m = receive me;
  case m of
    (from, req) -> dispatch me st from req
  | irq -> onIrq me st irq.

dispatch : unsafe Int -> St -> Int -> UMsg -> a .
dispatch me st from req =
  St dev owner cap txq rxs sub fl armed = st;
  case req of
    UOpen -> doOpen me st from
  | UParams d -> doParams me st from d
  | UBuf n -> reply me from UOk (St dev owner n txq rxs sub fl armed)
  | UArm -> doArm me st from
  | UWrite s -> doWrite me st from s
  | UFlush -> doFlush me st from
  | UGet -> doGet me st from
  | USub a -> reply me from UOk (St dev owner cap txq rxs a fl armed)
  | UClose -> doClose me st from
  | UShare -> doShare me st from.

# take the rx buffer; the POLL drain first covers the portable tier
# (no irqs there -- LSR.DR is only ever noticed inside a service call)
doGet : unsafe Int -> St -> Int -> a .
doGet me st from =
  St dev owner cap txq rxs sub fl armed = st;
  case ownerOk owner from of
    False -> reply me from (UErr "not the owner") st
  | True -> doGet2 me st from.
doGet2 : unsafe Int -> St -> Int -> a .
doGet2 me st from =
  st2 = rxDrain st;
  St dev owner cap txq rxs sub fl armed = st2;
  reply me from (UOkS rxs) (St dev owner cap txq "" sub fl armed).

# owner -1 = shared: any caller may move data (never reconfigure)
ownerOk o from = case o == from of True -> True | False -> o == 0 - 1.

doShare : unsafe Int -> St -> Int -> a .
doShare me st from =
  St dev owner cap txq rxs sub fl armed = st;
  case owner == from of
    False -> reply me from (UErr "not the owner") st
  | True -> reply me from UOk (St dev (0 - 1) cap txq rxs sub fl armed).

reply : unsafe Int -> Int -> URep -> St -> a .
reply me from r st = send from r >> loop me st.

doOpen : unsafe Int -> St -> Int -> a .
doOpen me st from =
  St dev owner cap txq rxs sub fl armed = st;
  case owner == 0 of
    False -> reply me from (UErr "uart is claimed") st
  | True -> doOpen2 me st from.
doOpen2 : unsafe Int -> St -> Int -> a .
doOpen2 me st from =
  St dev owner cap txq rxs sub fl armed = st;
  d2 = device "uart";
  # 8N1, interrupts off until UArm.  NO FCR write: setting the FIFO
  # enable RESETS the rx fifo, and on the System tier open() runs at
  # boot while the user's first keystrokes may already be buffered --
  # the lost-y bug ate one permission answer and shifted the rest.
  # QEMU's fifo is on regardless; a real 16550 bring-up would enable
  # it in a context that owns the device from reset.
  _ = write (reg8 d2 3) 3;
  _ = write (reg8 d2 1) 0;
  reply me from UOk (St d2 from cap txq rxs sub fl 0).

# divisor latch: DLAB on, DLL/DLM, DLAB off (8N1 restored)
doParams : unsafe Int -> St -> Int -> Int -> a .
doParams me st from d =
  St dev owner cap txq rxs sub fl armed = st;
  case owner == from of
    False -> reply me from (UErr "not the owner") st
  | True -> doParams2 me st from d.
doParams2 : unsafe Int -> St -> Int -> Int -> a .
doParams2 me st from d =
  St dev owner cap txq rxs sub fl armed = st;
  _ = write (reg8 dev 3) 131;
  _ = write (reg8 dev 0) (band d 255);
  _ = write (reg8 dev 1) (BITSHIFTR d 8);
  _ = write (reg8 dev 3) 3;
  reply me from UOk st.

# go live: bind the PLIC source to THIS actor, enable RDA (rx); THRE
# joins whenever tx bytes are pending (see irqSet)
doArm : unsafe Int -> St -> Int -> a .
doArm me st from =
  St dev owner cap txq rxs sub fl armed = st;
  case owner == from of
    False -> reply me from (UErr "not the owner") st
  | True -> doArm2 me st from.
doArm2 : unsafe Int -> St -> Int -> a .
doArm2 me st from =
  St dev owner cap txq rxs sub fl armed = st;
  _ = Sys.irqBind uartIrq me;
  st2 = St dev owner cap txq rxs sub fl 1;
  _ = irqSet st2;
  reply me from UOk st2.

# IER follows the state: RDA always (armed), THRE while tx pends
irqSet : unsafe St -> Unit .
irqSet st =
  St dev owner cap txq rxs sub fl armed = st;
  case armed == 1 of
    False -> Unit
  | True -> write (reg8 dev 1) (rdaBits (strlen txq)).
rdaBits pend = case pend > 0 of True -> 3 | False -> 1.

# enqueue-and-kick: the DMA-shaped write.  The kick moves bytes only
# while THRE says the FIFO has room; the rest drains on interrupts.
doWrite : unsafe Int -> St -> Int -> String -> a .
doWrite me st from s =
  St dev owner cap txq rxs sub fl armed = st;
  case ownerOk owner from of
    False -> reply me from (UErr "not the owner") st
  | True -> case strlen txq + strlen s > cap of
      True -> reply me from (UOkI 0) st
    | False -> doWrite2 me st from s.
doWrite2 : unsafe Int -> St -> Int -> String -> a .
doWrite2 me st from s =
  St dev owner cap txq rxs sub fl armed = st;
  st2 = txDrain (St dev owner cap (strcat txq s) rxs sub fl armed);
  _ = irqSet st2;
  reply me from (UOkI (strlen s)) st2.

# move pending bytes into THR while the FIFO reports room.  The drain
# walks an INDEX over txq and slices the unsent remainder ONCE at the
# end -- the old shape substr'd the whole queue per byte (quadratic:
# fine at 4KB, the wrong shape for a real ring).
txDrain : unsafe St -> St .
txDrain st =
  St dev owner cap txq rxs sub fl armed = st;
  case strlen txq == 0 of
    True -> st
  | False -> txDrainGo st 1 (strlen txq).
txDrainGo : unsafe St -> Int -> Int -> St .
txDrainGo st i n =
  St dev owner cap txq rxs sub fl armed = st;
  case i > n of
    True -> St dev owner cap "" rxs sub fl armed
  | False -> case lsrTHRE (read (reg8 dev 5)) of
      False -> St dev owner cap (substr txq i (n - i + 1)) rxs sub fl armed
    | True -> write (reg8 dev 0) (charAt txq i) >> txDrainGo st (i + 1) n.

doFlush : unsafe Int -> St -> Int -> a .
doFlush me st from =
  st0 = st;
  St dev owner cap txq rxs sub fl armed = st0;
  case ownerOk owner from of
    False -> reply me from (UErr "not the owner") st0
  | True -> doFlush2 me st0 from.
doFlush2 : unsafe Int -> St -> Int -> a .
doFlush2 me st from =
  st2 = txDrain st;
  St dev owner cap txq rxs sub fl armed = st2;
  case strlen txq == 0 of
    True -> reply me from UOk st2
  | False -> case armed == 1 of
      True -> loop me (St dev owner cap txq rxs sub from armed)
                     # ^ parked: answered from the irq path when empty
    | False -> doFlush2 me st2 from.
                     # ^ unarmed (no THRE irq will come): spin the
                     #   drain -- LSR progress bounds it

doClose : unsafe Int -> St -> Int -> a .
doClose me st from =
  St dev owner cap txq rxs sub fl armed = st;
  _ = irqOff st;
  reply me from UOk (St dev 0 cap "" "" 0 0 0).
irqOff : unsafe St -> Unit .
irqOff st =
  St dev owner cap txq rxs sub fl armed = st;
  case armed == 1 of True -> write (reg8 dev 1) 0 | False -> Unit.

# ---- the interrupt path ----------------------------------------------------
# One Int message per claimed-and-masked source: service the device
# fully (rx drain + tx refill), re-arm, deliver downstream.

onIrq : unsafe Int -> St -> Int -> a .
onIrq me st irq =
  st2 = txDrain (rxDrain st);
  _ = irqSet st2;
  _ = Sys.irqAck irq;
  St dev owner cap txq rxs sub fl armed = st2;
  case and2 (fl > 0) (strlen txq == 0) of
    True -> send fl UOk >> irqPush me (St dev owner cap txq rxs sub 0 armed)
  | False -> irqPush me st2.
and2 a b = case a of True -> b | False -> False.

# push freshly received bytes to the subscriber, then keep looping
irqPush : unsafe Int -> St -> a .
irqPush me st =
  St dev owner cap txq rxs sub fl armed = st;
  case and2 (sub > 0) (strlen rxs > 0) of
    True -> send sub (URx rxs) >> loop me (St dev owner cap txq "" sub fl armed)
  | False -> loop me st.

rxDrain : unsafe St -> St .
rxDrain st =
  St dev owner cap txq rxs sub fl armed = st;
  case owner == 0 of
    True -> st
  | False -> case lsrDR (read (reg8 dev 5)) of
      False -> st
    | True -> rxDrain1 st.
rxDrain1 : unsafe St -> St .
rxDrain1 st =
  St dev owner cap txq rxs sub fl armed = st;
  b = read (reg8 dev 0);
  rxDrain (St dev owner cap txq (strcat rxs (chr b)) sub fl armed).

# bbspi.fpr -- SPI mode 0, BIT-BANGED over any pin surface (raw Pin.*
# in tests, System.qa's svcPin* in services, real GPIO on silicon).
# Pin functions and the pin map are values, like matrixkpd.  Mode 0:
# clock idles low, data changes on the falling edge, is sampled on the
# rising edge.  Full duplex: miso is sampled at each rising edge, so a
# mosi->miso jumper echoes bytes exactly.
# the ABI has Tup2/Tup3 only: the 5-slot bus is a declared constructor
Bus = Type (Bus pinW pinR sck mosi miso).

init pinM sck mosi cs miso =
  _ = pinM sck 1;
  _ = pinM mosi 1;
  _ = pinM cs 1;
  pinM miso 0.
csLow pinW cs = pinW cs 0.
csHigh pinW cs = pinW cs 1.

# the BUS is one value: Bus pinW pinR sck mosi miso -- which also
# keeps every arity within the 8-arg ABI
xferByte bus b = xbGo bus b 7 0.
xbGo bus b i acc =
  case i < 0 of
    True -> acc
  | False -> xbBit bus b i acc.
xbBit bus b i acc =
  Bus pinW pinR sck mosi miso = bus;
  _ = pinW mosi (bitOf b i);       # data valid while clock low
  _ = pinW sck 1;                  # rising edge: both sides sample
  r = pinR miso;
  _ = pinW sck 0;                  # falling edge: next bit may change
  xbGo bus b (i - 1) (acc * 2 + r).
bitOf b i = (b / pow2 i) - ((b / pow2 i) / 2) * 2.
pow2 : unsafe Int -> Int .
pow2 i = case i <= 0 of True -> 1 | False -> 2 * pow2 (i - 1).

# transfer a whole string; returns the echoed string
xfer bus s = xfGo bus s 1 (strlen s) "".
xfGo bus s i n acc =
  case i > n of
    True -> acc
  | False -> xfGo bus s (i + 1) n
      (strcat acc (chr (xferByte bus (charAt s i)))).

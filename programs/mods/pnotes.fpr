# ============================================================================
# pnotes.fpr -- the Notes app, on the app-plugin contract (see appkit).
# State = (notes, input); persistence = the shell's kv append log
# (Sys.storeReq 2 append / 3 replay -- appInit and appUpdate run in the
# shell actor, so storage effects are theirs to make).
# ============================================================================

S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("NOTES", "PNOTES.QA").

# the notes file is not ours: it belongs to an actor inside System.qa.
# We ask the namespace for it, exactly like any other client would.
notesPath = "/home/notes.txt".
appInit self env = (pnLoad self env, "").

appUpdate self env k st | k == 14 =
  (notes, inp) = st;
  (notes, pnDropLast inp).
appUpdate self env k st | k == 28 = pnCommit self env st.
appUpdate self env k st =
  (notes, inp) = st;
  (notes, pnType inp k).

pnCommit self env (notes, inp) | strlen inp > 0 =
  _ = AK.vfsWrite self (AK.envVfs env) notesPath "{inp}\n";
  (inp :: notes, "").
pnCommit self env st = st.

pnType inp k | strlen inp > 29 = inp.
pnType inp k = strcat inp (AK.keyChar k).

pnDropLast s | strlen s < 2 = "".
pnDropLast s = substr s 1 (strlen s - 1).

pnLoad self env =
  txt = AK.vfsRead self (AK.envVfs env) notesPath;
  ls = pnSplit txt 1 1 Nil;
  _ = drop txt;
  ls.
pnSplit s i st acc | i > strlen s = acc.
pnSplit s i st acc | charAt s i == 10 =
  case i > st of
    True -> pnSplit s (i + 1) (i + 1) (substr s st (i - st) :: acc)
  | False -> pnSplit s (i + 1) (i + 1) acc.
pnSplit s i st acc = pnSplit s (i + 1) st acc.

# ---- view ------------------------------------------------------------------

pnLine i =
  Box [Row, Pad 2] [ Slot [Fg (930, 940, 960)] i 40 ].

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "PNOTES"
        , Lbl [Fg (560, 590, 650)] "loaded .qa"
        , Box [Grow] Nil
        , Slot [Fg (560, 590, 650)] 0 12 ]
    , Box [Col, Gap 2, Grow, Bord (420, 900, 560), Pad 3]
        [ pnLine 1, pnLine 2, pnLine 3
        , pnLine 4, pnLine 5, pnLine 6 ]
    , Box [Row, Pad 4, Gap 4, Bord (330, 720, 999), Bg (92, 104, 130)]
        [ Lbl [Fg (999, 800, 300)] ">"
        , Slot [Fg (930, 940, 960)] 7 36 ]
    , Lbl [Fg (560, 590, 650)] "ENTER SAVE   ESC BACK   SERVED BY PNOTES.QA" ].

appVals self env st =
  (notes, input) = st;
  six = pnLastSix notes;
  [ "{pnLen notes} SAVED"
  , pnNth six 0, pnNth six 1, pnNth six 2
  , pnNth six 3, pnNth six 4, pnNth six 5
  , "{input}_"
  , "" ].

pnLen Nil = 0.
pnLen (x :: r) = 1 + pnLen r.
pnNth Nil i = "".
pnNth (v :: r) 0 = v.
pnNth (v :: r) i = pnNth r (i - 1).
pnTakeN Nil n = Nil.
pnTakeN l 0 = Nil.
pnTakeN (x :: r) n = x :: pnTakeN r (n - 1).
pnRev Nil acc = acc.
pnRev (x :: r) acc = pnRev r (x :: acc).
pnApnd Nil x = x :: Nil.
pnApnd (a :: r) x = a :: pnApnd r x.
pnPadTo l n | pnLen l >= n = l.
pnPadTo l n = pnPadTo (pnApnd l "") n.
pnLastSix notes = pnPadTo (pnRev (pnTakeN notes 6) Nil) 6.

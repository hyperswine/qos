       :: (1, 900, 500, 35, 220, 0) :: (1, 900, 500, 35, 220, 55) :: (1, 900, 500, 35, 220, 110) :: (1, 900, 500, 35, 220, 165) :: Nil.
cannon  = (3, 0, 0, 180, 800, 60) :: (0, 70, 40, 320, 900, 60) :: (4, 200, 60, 260, 420, 70) :: Nil.
hit     = (3, 0, 0, 60, 520, 0) :: (1, 120, 60, 90, 480, 0) :: Nil.
kill    = (3, 0, 0, 260, 620, 0) :: (4, 170, 40, 320, 520, 0) :: Nil.
hqHit   = (0, 85, 50, 320, 900, 0) :: (3, 0, 0, 220, 480, 0) :: Nil.

# sfx.fpr -- sound effects as DATA: a riff is a list of tones, a tone is
# (wave, f0, f1, ms, vol, delay) for the host's synthesizer (sndPlay,
# hal/unix/snd_raw.h).  No samples, no files: every cue below is a few
# integers, the way the glyph font is a few bits per letter.
#
#   wave  0 sine  1 square  2 triangle  3 noise  4 saw
#   f0/f1 Hz, swept linearly over ms      vol 0..1000      delay ms
#
#   Sfx.play Sfx.hit             one riff
#   Sfx.playAll riffs            a frame's worth, in order
#
# The cues are the vocabulary a card game needs: the UI ticks (cursor,
# pick, cancel, refuse), the table (call, attack, hit, destroyed, the HQ
# struck, shots and ambushes), the clock (your turn, the enemy's, turn
# over), and the frame (the game opening, ending, closing).

unsafe module.

play tones = tones |> List.fold (fn t n -> n + (case sndPlay t < 0 of True -> 0 | False -> 1)) 0.
playAll riffs = riffs |> List.fold (fn r n -> n + play r) 0.
# the same, every frequency scaled by a few percent from a seed (the
# clock): four rifle cracks in a row are four cracks, not one four times
playVar seed tones =
  k = 960 + (seed * 7919 / 1000) % 81;
  tones |> List.fold (fn t n -> n + (case sndPlay (vary t k) < 0 of True -> 0 | False -> 1)) 0.
vary (w, f0, f1, ms, vol, delay) k = (w, f0 * k / 1000, f1 * k / 1000, ms, vol, delay).
playAllVar seed riffs = riffs |> List.fold (fn r n -> n + playVar (seed + n * 37) r) 0.

# ---- the UI ------------------------------------------------------------------
cursor  = (1, 880, 880, 22, 180, 0) :: Nil.
pick    = (2, 660, 990, 60, 380, 0) :: Nil.
cancel  = (2, 520, 300, 70, 320, 0) :: Nil.
refuse  = (1, 190, 140, 130, 420, 0) :: Nil.
toggle  = (2, 440, 440, 45, 320, 0) :: (2, 560, 560, 45, 320, 55) :: Nil.

# ---- the table ---------------------------------------------------------------
call    = (0, 330, 660, 90, 450, 0) :: (0, 660, 990, 120, 400, 70) :: Nil.

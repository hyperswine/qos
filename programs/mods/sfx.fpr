ambush  = (4, 280, 900, 160, 480, 0) :: (3, 0, 0, 120, 400, 60) :: Nil.
intercept = (1, 720, 720, 40, 420, 0) :: (3, 0, 0, 70, 380, 30) :: Nil.
move    = (2, 300, 420, 140, 300, 0) :: Nil.

# ---- the clock ---------------------------------------------------------------
yourTurn  = (2, 523, 523, 110, 400, 0) :: (2, 659, 659, 110, 400, 120) :: (2, 784, 784, 200, 420, 240) :: Nil.
enemyTurn = (2, 392, 392, 130, 380, 0) :: (2, 311, 311, 220, 380, 140) :: Nil.

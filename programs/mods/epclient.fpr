# ============================================================================
# epclient.fpr -- the client side of ep.fpr with OWNED endpoints.
#
# ep.fpr's open answers (owner, handle): two Ints anyone may copy, keep after
# close, or forget, while the owner actor keeps the handle until Close.  Here
# an open endpoint is a linear `Endpoint`, so the compiler refuses one that is
# never closed, closed twice, or used after it was closed.  read and write
# hand it back; close consumes it.  The messages are ep.fpr's own (the same
# pinned version), so this speaks to every namespace and owner unchanged.
#
# A ROUTE is for a holder that keeps an endpoint open for a long time and
# hands copies around: System's builtin launch keeps five for the launcher's
# lifetime, in its capability set, and closes them when the launcher returns.
# A route is plain data.  A read or write on a route whose endpoint was closed
# is answered by the owner as any unknown handle is; NoRoute answers
# "not opened".
#
# The Endpoint constructor is visible, as every QOS type's is: the same
# cooperative trust as ep.fpr's namespace (docs/2026-10-02-QOS-AUDIT.md).
# ============================================================================

EP = use "ep#d65056c9d7dc9c18".
AC = use "std/actor#2de24bf2bdd5cb87".
ED = use "epdeadline#96e69ecbbd8c7fce".

IoV = EP.IoV.
NsOpen = EP.NsOpen.
Read = EP.Read. Write = EP.Write. Close = EP.Close.
Opened = EP.Opened. Refused = EP.Refused. Redirect = EP.Redirect.

Endpoint 1 = Type (Endpoint Int Int).

# Ok the endpoint, or why not
open : unsafe Int -> Int -> String -> String -> Result Endpoint String .
open me ns url mode = case AC.call me ns (NsOpen url mode) of
    Err e -> Err "namespace: {e}"
  | Ok r -> openRes me r.
openRes : unsafe Int -> Result (Int, Int) String -> Result Endpoint String .
openRes me r = case r of
    Err e -> Err e
  | Ok p -> openAt me p.
openAt : unsafe Int -> (Int, Int) -> Result Endpoint String .
openAt me p =
  (owner, id2) = p;
  openAwait me owner id2.
# the owner's answer to the forwarded envelope: it may hand us on
openAwait : unsafe Int -> Int -> Int -> Result Endpoint String .
openAwait me owner id2 = case AC.awaitReply me owner id2 of
    Err e -> Err "the owner {e} before answering open"
  | Ok rep -> openRep me owner id2 rep.
openRep : unsafe Int -> Int -> Int -> EP.OpenRep -> Result Endpoint String .
openRep me owner id2 rep = case rep of
    Opened h -> Ok (Endpoint owner h)
  | Refused why -> Err why
  | Redirect a -> openAwait me a id2.

read : unsafe Int -> Endpoint -> Int -> (Result IoV String, Endpoint) .
read me ep n =
  Endpoint o h = ep;
  (callFlat me o (Read h n), Endpoint o h).
write : unsafe Int -> Endpoint -> IoV -> (Result IoV String, Endpoint) .
write me ep v =
  Endpoint o h = ep;
  (callFlat me o (Write h v), Endpoint o h).
close : unsafe Int -> Endpoint -> Result Int String .
close me ep =
  Endpoint o h = ep;
  callFlat me o (Close h).

# The held-endpoint fast path: EP.flat (AC.call me o q) without the two
# Results between them.  AC.call answers Ok (keep r) and EP.flat unwraps it
# again; here the owner's own `Result r String` is kept and returned as is,
# so a successful operation allocates no wrapper.  Same wire, same
# correlation id, same stale-reply drop and the same errors as
# EP.flat (AC.call ..): a refused send or a dead owner is
# Err "the owner {why}".  No deadline, so no clock read.
callFlat : unsafe Int -> Int -> q -> Result r String .
callFlat me o q =
  id = Sys.nextId Unit;
  case send o (me, id, q) of
    Err why -> Err "the owner {why}"
  | Ok u -> awaitFlat me o id.
awaitFlat : unsafe Int -> Int -> Int -> Result r String .
awaitFlat me o id = case receiveFromRes me o of
    Err why -> Err "the owner {why}"
  | Ok m -> flatOf me o id m.
flatOf : unsafe Int -> Int -> Int -> (Int, Result r String) -> Result r String .
flatOf me o id m =
  (rid, r) = m;
  if rid == id then flatKept m r else
    _ = drop m;
    awaitFlat me o id.
flatKept m r =
  v = keep r;
  _ = drop m;
  v.
# close, giving up after ms milliseconds (a shutdown path that must not hang)
closeWithin : Int -> Int -> Endpoint -> Result Int String .
closeWithin ms me ep =
  Endpoint o h = ep;
  EP.flat (AC.callWithin ms me o (Close h)).
# the actor that serves it (to send it other traffic, or to watch it)
owner : Endpoint -> (Int, Endpoint) .
owner ep =
  Endpoint o h = ep;
  (o, Endpoint o h).

# Deadline-aware forms (ep's Timed protocol, as epdeadline.fpr): every call
# gives up at `until` (Wire.now microseconds) instead of waiting.
openUntil : Int -> Int -> Int -> String -> String -> Result Endpoint String .
openUntil until me ns url mode = case ED.openUntil until me ns url mode of
    Err why -> Err why
  | Ok p -> openedPair p.
openedPair : (Int, Int) -> Result Endpoint String .
openedPair p =
  (o, h) = p;
  Ok (Endpoint o h).
readUntil : unsafe Int -> Int -> Endpoint -> Int -> (Result IoV String, Endpoint) .
readUntil until me ep n =
  Endpoint o h = ep;
  (EP.flat (AC.callUntil until me o (EP.Timed until (Read h n))), Endpoint o h).
writeUntil : unsafe Int -> Int -> Endpoint -> IoV -> (Result IoV String, Endpoint) .
writeUntil until me ep v =
  Endpoint o h = ep;
  (EP.flat (AC.callUntil until me o (EP.Timed until (Write h v))), Endpoint o h).
closeUntil : unsafe Int -> Int -> Endpoint -> Result Int String .
closeUntil until me ep =
  Endpoint o h = ep;
  EP.flat (AC.callUntil until me o (EP.Timed until (Close h))).

# one operation, then close
readClose : unsafe Int -> Endpoint -> Result IoV String .
readClose me ep =
  (r, kept) = read me ep 0;
  _ = close me kept;
  r.
writeClose : unsafe Int -> Endpoint -> IoV -> Result IoV String .
writeClose me ep v =
  (r, kept) = write me ep v;
  _ = close me kept;
  r.

Route = Type (NoRoute | Route Int Int).
routeOf : Endpoint -> (Route, Endpoint) .
routeOf ep =
  Endpoint o h = ep;
  (Route o h, Endpoint o h).
readRoute : unsafe Int -> Route -> Int -> Result IoV String .
readRoute me route n = case route of
    NoRoute -> Err "not opened"
  | Route o h -> callFlat me o (Read h n).
writeRoute : unsafe Int -> Route -> IoV -> Result IoV String .
writeRoute me route v = case route of
    NoRoute -> Err "not opened"
  | Route o h -> callFlat me o (Write h v).

# ============================================================================
# fprlive.fpr -- FPRLive: LiveView over a real websocket, for FP-RISC apps
# on the socket tier (qosp / virt).  The browser driver for a
# per-SESSION MVU app:
#
#   main = FL.serve { env = e, css = G.cssFor } (FL.App init update view subs).
#
#   init   env                    -> model                (shared by every client)
#   update env (Ev) model         -> (model, List MC)     Ev = EMsg sid msg arg
#                                                            | ETick | EGone sid
#   view   sid model              -> genview tree         rendered PER SESSION
#   subs   model                  -> List MV.Sub          STick ms drives server ticks
#
# A session id (sid) is minted per websocket and never reused; EGone sid
# arrives when its socket closes (a close frame, or the peer vanishing:
# the socket tier reports that as an empty read), so update can forget
# it.  sid 0 renders the page for a browser that has not connected yet.
#
# THE SHAPE (BEAM's): an ACCEPTOR actor polls the socket tier and hands
# each connection's bytes to that connection's OWN actor; a connection
# actor owns its session (buffer, statics, dynamics, sid), parses its
# frames, sends events to the REGISTER actor -- the model's single
# writer -- and renders and pushes its own deltas when the register
# broadcasts a new model.  A slow or hostile peer stalls only its own
# actor; sessions scale with memory, not with a table.
#
# The wire (docs/FPRLIVE.md):
#   GET /            the page: generated CSS, <div id=lv-root>, the client
#   GET /ws          RFC 6455 upgrade (Sec-WebSocket-Accept = base64(sha1
#                    (key ++ GUID)), both implemented here in FPRISC)
#   client -> server text frames  {"msg":"buy","arg":"2"}
#   server -> client text frames  {"s":[..],"d":[..]}  full render (on
#                                 connect and on a reshape)
#                                 {"d":{"3":"..."}}     a delta, computed
#                                 against what THIS session last saw
#   every update (any client's event, or a tick) is PUSHED to every open
#   session -- one register, many screens, each with its own view.
#   ping -> pong; close -> close; binary / fragmented / unmasked / oversize
#   frames are refused with the RFC's close codes (1003 / 1002 / 1009).
#
# Limits that are the socket tier's, not this module's: 1024 connection
# slots (QOS_NET_MAXCONN), 8 KiB receive buffer per connection, 1 KiB
# per netRead call, a 256 KiB unsent tail per peer before it is dropped.
# Frames above 4096 bytes are refused (1009).
# ============================================================================

MV = use "std/mvu".
G  = use "std/view".
LJ = use "std/livejs".
Core = use "coreutil".
AC = use "std/actor".

STick = MV.STick.
MQuit = MV.MQuit.
MLog = MV.MLog.

Ev = Type (EMsg sid msg arg | ETick | EGone sid).
App = Type (App ini upd vw sbs).

# ---- bytes and small helpers ------------------------------------------------

crlf = strcat (chr 13) (chr 10).
and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.

# index just PAST pat's first match at/after i; 0 = no match
findSub s pat i = fsGo s pat i (strlen s) (strlen pat).
fsGo : unsafe String -> String -> Int -> Int -> Int -> Int .
fsGo s pat i n pn | i + pn - 1 > n = 0.
fsGo s pat i n pn | G.strEq (substr s i pn) pat = i + pn.
fsGo s pat i n pn = fsGo s pat (i + 1) n pn.

digits : unsafe String -> Int -> Int -> Int .
digits s i acc | i > strlen s = acc.
digits s i acc = digCh s i acc (charAt s i).
digCh : unsafe String -> Int -> Int -> Int -> Int .
digCh s i acc c | and2 (c >= 48) (c <= 57) = digits s (i + 1) (acc * 10 + (c - 48)).
digCh s i acc c = acc.

# characters until the delimiter, from i
until : unsafe String -> Int -> Int -> String -> String .
until s i dl acc | i > strlen s = acc.
until s i dl acc | charAt s i == dl = acc.
until s i dl acc = until s (i + 1) dl (strcat acc (chr (charAt s i))).

# ---- HTTP -----------------------------------------------------------------------

headEnd req = findSub req "{crlf}{crlf}" 1.
method req = until req 1 32 "".
path req = until req (strlen (method req) + 2) 32 "".

# the value of a header, "" when absent (case-sensitive: browsers send
# canonical names; a client sending odd casing gets a 400, by design)
header req name = hAt req (findSub req "{crlf}{name}: " 1).
hAt req 0 = "".
hAt req i = until req i 13 "".

httpResp code ctype body =
  "HTTP/1.1 {code}{crlf}Content-Type: {ctype}{crlf}Content-Length: {strlen body}{crlf}Connection: close{crlf}{crlf}{body}".

# ---- SHA-1 (RFC 3174) over a byte string, for the upgrade handshake ---------------
# 32-bit arithmetic on the 63-bit Int: every intermediate stays below 2^63
# because operands are masked to 32 bits before each shift or add.

m32 = 4294967295.
w32 x = band x m32.
rotl n x = w32 (bor (BITSHIFTL x n) (BITSHIFTR x (32 - n))).
add32 a b = w32 (a + b).
bnot32 x = bxor x m32.

# the padded message as a list of 32-bit words (big-endian)
padWords s = wordsOf (padded s).
padded s =
  n = strlen s;
  zeros = padZeros ((56 - (n + 1) % 64 + 64) % 64);
  "{s}{chr 128}{zeros}{be64 (n * 8)}".
padZeros : unsafe Int -> String .
padZeros 0 = "".
padZeros k = strcat (chr 0) (padZeros (k - 1)).
be64 n = "{chr 0}{chr 0}{chr 0}{chr 0}{chr (band (BITSHIFTR n 24) 255)}{chr (band (BITSHIFTR n 16) 255)}{chr (band (BITSHIFTR n 8) 255)}{chr (band n 255)}".
wordsOf : unsafe String -> List Int .
wordsOf s = woGo s 1 (strlen s).
woGo : unsafe String -> Int -> Int -> List Int .
woGo s i n | i > n = Nil.
woGo s i n = (charAt s i * 16777216 + charAt s (i + 1) * 65536 + charAt s (i + 2) * 256 + charAt s (i + 3)) :: woGo s (i + 4) n.

# 80-word schedule from a 16-word block (kept as a reversed list while extending)
sched : unsafe List Int -> Int -> List Int .
sched rw 80 = rw.
sched rw t = sched (rotl 1 (bxor (bxor (nth rw 3) (nth rw 8)) (bxor (nth rw 14) (nth rw 16))) :: rw) (t + 1).
nth : unsafe List Int -> Int -> Int .
nth (x :: r) 1 = x.
nth (x :: r) k = nth r (k - 1).
nth Nil k = 0.

take16 : unsafe List Int -> Int -> List Int .
take16 ws 0 = Nil.
take16 (w :: r) k = w :: take16 r (k - 1).
take16 Nil k = Nil.
drop16 : unsafe List Int -> Int -> List Int .
drop16 ws 0 = ws.
drop16 (w :: r) k = drop16 r (k - 1).
drop16 Nil k = Nil.
rev : unsafe List Int -> List Int -> List Int .
rev Nil acc = acc.
rev (x :: r) acc = rev r (x :: acc).

# one block: fold the 80 rounds
block h ws =
  w = rev (sched (rev (take16 ws 16) Nil) 16) Nil;
  rounds h w 0 h.
rounds : unsafe List Int -> List Int -> Int -> List Int -> List Int .
rounds h0 Nil t h = addH h0 h.
rounds h0 (w :: wr) t h =
  (a, b, c, d, e) = five h;
  f = fOf t b c d;
  k = kOf t;
  temp = add32 (add32 (add32 (add32 (rotl 5 a) f) e) k) w;
  rounds h0 wr (t + 1) (temp :: a :: rotl 30 b :: c :: d :: Nil).
five (a :: b :: c :: d :: e :: Nil) = (a, b, c, d, e).
five _ = (0, 0, 0, 0, 0).
fOf t b c d | t < 20 = w32 (bor (band b c) (band (bnot32 b) d)).
fOf t b c d | t < 40 = bxor (bxor b c) d.
fOf t b c d | t < 60 = w32 (bor (bor (band b c) (band b d)) (band c d)).
fOf t b c d = bxor (bxor b c) d.
kOf t | t < 20 = 1518500249.
kOf t | t < 40 = 1859775393.
kOf t | t < 60 = 2400959708.
kOf t = 3395469782.
addH : unsafe List Int -> List Int -> List Int .
addH Nil Nil = Nil.
addH (x :: xr) (y :: yr) = add32 x y :: addH xr yr.
addH a b = Nil.

sha1 s = shaBlocks (1732584193 :: 4023233417 :: 2562383102 :: 271733878 :: 3285377520 :: Nil) (padWords s).
shaBlocks : unsafe List Int -> List Int -> List Int .
shaBlocks h Nil = h.
shaBlocks h ws = shaBlocks (block h ws) (drop16 ws 16).

# the 20-byte digest as bytes
digestBytes : unsafe List Int -> String .
digestBytes Nil = "".
digestBytes (w :: r) = "{chr (band (BITSHIFTR w 24) 255)}{chr (band (BITSHIFTR w 16) 255)}{chr (band (BITSHIFTR w 8) 255)}{chr (band w 255)}{digestBytes r}".

# ---- base64 ----------------------------------------------------------------------

b64c i = charAt "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/" (i + 1).
base64 s = b64Go s 1 (strlen s) "".
b64Go : unsafe String -> Int -> Int -> String -> String .
b64Go s i n acc | i > n = acc.
b64Go s i n acc | i + 2 <= n =
  x = charAt s i * 65536 + charAt s (i + 1) * 256 + charAt s (i + 2);
  b64Go s (i + 3) n "{acc}{chr (b64c (BITSHIFTR x 18))}{chr (b64c (band (BITSHIFTR x 12) 63))}{chr (b64c (band (BITSHIFTR x 6) 63))}{chr (b64c (band x 63))}".
b64Go s i n acc | i + 1 <= n =
  x = charAt s i * 65536 + charAt s (i + 1) * 256;
  "{acc}{chr (b64c (BITSHIFTR x 18))}{chr (b64c (band (BITSHIFTR x 12) 63))}{chr (b64c (band (BITSHIFTR x 6) 63))}=".
b64Go s i n acc =
  x = charAt s i * 65536;
  "{acc}{chr (b64c (BITSHIFTR x 18))}{chr (b64c (band (BITSHIFTR x 12) 63))}==".

acceptKey key = base64 (digestBytes (sha1 (strcat key "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"))).

# ---- websocket frames --------------------------------------------------------------
# a parsed client frame: (state, op, payload, consumed)
#   state 0 = incomplete (need more bytes), 1 = frame, 2 = protocol error
#   (unmasked / fragmented / reserved bits), 3 = too big

maxFrame = 4096.

frame b = frHead b (strlen b).
frHead b n | n < 2 = (0, 0, "", 0).
frHead b n =
  b0 = charAt b 1;
  b1 = charAt b 2;
  fin = band b0 128;
  rsv = band b0 112;
  op = band b0 15;
  masked = band b1 128;
  l7 = band b1 127;
  frLen b n fin rsv op masked l7.
frLen b n fin rsv op masked l7 | or2 (fin == 0) (or2 (rsv != 0) (or2 (masked == 0) (op == 0))) = (2, op, "", 0).
frLen b n fin rsv op masked l7 | l7 < 126 = frBody b n op l7 3.
frLen b n fin rsv op masked l7 | l7 == 126 = frLen16 b n op.
frLen b n fin rsv op masked l7 = (3, op, "", 0).           # 64-bit length: always over the cap
frLen16 b n op | n < 4 = (0, 0, "", 0).
frLen16 b n op = frBody b n op (charAt b 3 * 256 + charAt b 4) 5.
frBody b n op len hdr | len > maxFrame = (3, op, "", 0).
frBody b n op len hdr | n < hdr + 3 + len = (0, 0, "", 0).
frBody b n op len hdr =
  key = substr b hdr 4;
  (1, op, unmask (substr b (hdr + 4) len) key 1 "", hdr + 3 + len).
# unmasked in 32-byte pieces joined pairwise: a byte-at-a-time accumulator
# on a 4 KiB frame would leave megabytes of garbage in the turn
unmask : unsafe String -> String -> Int -> String -> String .
unmask p key i acc = Core.concat (umPieces p key 1 (strlen p) Nil).
umPieces : unsafe String -> String -> Int -> Int -> List String -> List String .
umPieces p key i n acc | i > n = revS acc Nil.
umPieces p key i n acc = umPieces p key (i + 32) n (umRun p key i (min2 (i + 31) n) "" :: acc).
umRun : unsafe String -> String -> Int -> Int -> String -> String .
umRun p key i e acc | i > e = acc.
umRun p key i e acc = umRun p key (i + 1) e (strcat acc (chr (bxor (charAt p i) (charAt key ((i - 1) % 4 + 1))))).
min2 a b = case a < b of True -> a | False -> b.
revS : unsafe List String -> List String -> List String .
revS Nil acc = acc.
revS (x :: r) acc = revS r (x :: acc).

# a server frame: unmasked, one of text (1), close (8), pong (10)
wsFrame op payload = "{chr (128 + op)}{lenBytes (strlen payload)}{payload}".
lenBytes n | n < 126 = chr n.
lenBytes n | n < 65536 = "{chr 126}{chr (BITSHIFTR n 8)}{chr (band n 255)}".
lenBytes n = "{chr 127}{chr 0}{chr 0}{chr 0}{chr 0}{chr (band (BITSHIFTR n 24) 255)}{chr (band (BITSHIFTR n 16) 255)}{chr (band (BITSHIFTR n 8) 255)}{chr (band n 255)}".
closeFrame code reason = wsFrame 8 "{chr (BITSHIFTR code 8)}{chr (band code 255)}{reason}".

# ---- JSON: {"msg":"...","arg":"..."} with the string escapes decoded -----------------

# tolerant of whitespace around the colon (JSON.stringify emits none,
# other encoders do); a non-string value reads as ""
jStr s key = jAt s (findSub s "\"{key}\"" 1) (strlen s).
jAt s 0 n = "".
jAt s i n = jColon s (skipSp s i n) n.
jColon s i n | and2 (i <= n) (charAt s i == 58) = jQuote s (skipSp s (i + 1) n) n.
jColon s i n = "".
jQuote s i n | and2 (i <= n) (charAt s i == 34) = jRun s (i + 1) n "".
jQuote s i n = "".
skipSp : unsafe String -> Int -> Int -> Int .
skipSp s i n | and2 (i <= n) (charAt s i == 32) = skipSp s (i + 1) n.
skipSp s i n = i.
# plain runs are copied whole; only an escape costs a piece
jRun : unsafe String -> Int -> Int -> String -> String .
jRun s i n acc = jRunAt s i i n acc.
jRunAt : unsafe String -> Int -> Int -> Int -> String -> String .
jRunAt s st i n acc | i > n = strcat acc (substr s st (i - st)).
jRunAt s st i n acc | charAt s i == 34 = strcat acc (substr s st (i - st)).
jRunAt s st i n acc | and2 (charAt s i == 92) (i < n) = jEsc s i n (strcat acc (substr s st (i - st))) (charAt s (i + 1)).
jRunAt s st i n acc = jRunAt s st (i + 1) n acc.
jEsc : unsafe String -> Int -> Int -> String -> Int -> String .
jEsc s i n acc 110 = jRun s (i + 2) n (strcat acc (chr 10)).
jEsc s i n acc 116 = jRun s (i + 2) n (strcat acc (chr 9)).
jEsc s i n acc 114 = jRun s (i + 2) n (strcat acc (chr 13)).
jEsc s i n acc 117 | i + 5 <= n = jRun s (i + 6) n (strcat acc (utf8 (hex4 s (i + 2)))).
jEsc s i n acc 117 = acc.
jEsc s i n acc c = jRun s (i + 2) n (strcat acc (chr c)).  # \" \\ \/
hex4 s i = hexv (charAt s i) * 4096 + hexv (charAt s (i + 1)) * 256 + hexv (charAt s (i + 2)) * 16 + hexv (charAt s (i + 3)).
hexv c | and2 (c >= 48) (c <= 57) = c - 48.
hexv c | and2 (c >= 97) (c <= 102) = c - 87.
hexv c | and2 (c >= 65) (c <= 70) = c - 55.
hexv c = 0.
# a code point as UTF-8; a lone surrogate (a JSON \uD83D pair half) is marked
utf8 cp | cp < 128 = chr cp.
utf8 cp | cp < 2048 = "{chr (192 + cp / 64)}{chr (128 + cp % 64)}".
utf8 cp | and2 (cp >= 55296) (cp < 57344) = "?".
utf8 cp = "{chr (224 + cp / 4096)}{chr (128 + (cp / 64) % 64)}{chr (128 + cp % 64)}".

# ---- the page ------------------------------------------------------------------------

page css tree s d =
  "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>{css tree}</style></head><body><div id=\"lv-root\"></div><script>window.__LV__=\{s:{G.jarr s},d:{G.jarr d}};</script><script>{LJ.src 0}</script></body></html>".

# ---- subscriptions / commands -----------------------------------------------------------

tickMsOf : unsafe List MV.Sub -> Int .
tickMsOf Nil = 0.
tickMsOf (s :: r) = tmOne r s.
tmOne : unsafe List MV.Sub -> MV.Sub -> Int .
tmOne r s = case s of
    STick ms -> ms
  | o -> tickMsOf r.

quitOf : unsafe List MV.MC -> Int -> Int .
quitOf Nil q = q.
quitOf (MQuit :: r) q = quitOf r 1.
quitOf (MLog s :: r) q = _ = Sys.logAt 0 s; quitOf r q.
quitOf (c :: r) q = quitOf r q.

# ---- messages and states ----------------------------------------------------------------

Msg = Type (Data b | Ask who | Join who | Hello sid m | Model m
          | Ev sid msg arg | Gone sid | Tick | Bye).
Rs = Type (Rs cfg app model sess nev ns).                  # the register
As = Type (As reg port cfg app map k ltt mt tickMs).        # the acceptor
Cs = Type (Cs reg port cfg app cid mode buf sid ls ld model). # one connection

# THE FRAME BOUNDARY (docs/MEMORY.md): an actor's pool is reclaimed only
# by a reset, so a loop that ran for a day in one pool would keep every
# string it ever made.  Each turn sends its whole state to itself, resets
# the pool -- every temporary of the turn dies -- and reads the state
# back into the fresh pool (keep: a service reply's receive would
# otherwise free the message under a borrow).  A few KB per turn.
# (one copy per state type: a top-level function is typed once)
boundaryR : unsafe Int -> Rs -> Rs .
boundaryR me st =
  _ = send me st;
  _ = Sys.poolReset 0;
  m = receiveFrom me me;
  st2 = keep m;
  _ = drop m;
  st2.
boundaryA : unsafe Int -> As -> As .
boundaryA me st =
  _ = send me st;
  _ = Sys.poolReset 0;
  m = receiveFrom me me;
  st2 = keep m;
  _ = drop m;
  st2.
boundaryC : unsafe Int -> Cs -> Cs .
boundaryC me st =
  _ = send me st;
  _ = Sys.poolReset 0;
  m = receiveFrom me me;
  st2 = keep m;
  _ = drop m;
  st2.

# ---- the register: the model's single writer (the main actor) ----------------------------

serve cfg app =
  App ini upd vw sbs = app;
  me = myself 0;
  nic = device "net";
  m0 = ini cfg.env;
  port = spawn MV.port;                        # connection actors queue their close here
  acc = spawnAcc me port cfg app (tickMsOf (sbs m0));
  regLoop me (Rs cfg app m0 Nil 0 0).

spawnAcc reg port cfg app tickMs = case Sys.harts Unit > 1 of
    True -> AC.spawnWithOn 1 (AC.Dynamic 64) (acceptor reg port cfg app tickMs)
  | False -> AC.spawnWith (AC.Dynamic 64) (acceptor reg port cfg app tickMs).

regLoop : unsafe Int -> Rs -> String .
regLoop me st =
  st2 = boundaryR me st;
  regMsg me st2 (receive me).
regMsg : unsafe Int -> Rs -> Msg -> String .
regMsg me st m =
  _ = drop m;                                  # parked until the next receive: the arms borrow
  case m of
    Ask a -> regAsk me st a
  | Join a -> regJoin me st a
  | Ev sid msg arg -> regEv me st (EMsg sid msg arg)
  | Gone sid -> regEv me (regForget st sid) (EGone sid)
  | Tick -> regEv me st ETick
  | o -> regLoop me st.
# a page fetch wants the model once, without becoming a session
regAsk me st a =
  Rs cfg app model sess nev ns = st;
  _ = send a (Hello 0 model);
  regLoop me st.
# a websocket: a fresh sid, never reused, and every broadcast from now on
regJoin me st a =
  Rs cfg app model sess nev ns = st;
  _ = send a (Hello (ns + 1) model);
  regLoop me (Rs cfg app model ((ns + 1, a) :: sess) nev (ns + 1)).
regForget st sid =
  Rs cfg app model sess nev ns = st;
  Rs cfg app model (sDel sess sid) nev ns.
# (accumulator loops: a thousand sessions must not mean a thousand frames)
sDel : unsafe List (Int, Int) -> Int -> List (Int, Int) .
sDel sess sid = sDelGo sess sid Nil.
sDelGo : unsafe List (Int, Int) -> Int -> List (Int, Int) -> List (Int, Int) .
sDelGo Nil sid acc = acc.
sDelGo ((i, a) :: r) sid acc | i == sid = sDelGo r sid acc.
sDelGo (e :: r) sid acc = sDelGo r sid (e :: acc).
sLen : unsafe List (Int, Int) -> Int .
sLen Nil = 0.
sLen (e :: r) = 1 + sLen r.
# one event through update, then the new model to EVERY session actor
regEv : unsafe Int -> Rs -> Ev -> String .
regEv me st ev =
  Rs cfg app model sess nev ns = st;
  App ini upd vw sbs = app;
  (m2, cs) = upd cfg.env ev model;
  _ = broadcast sess (Model m2);
  regAfter me (Rs cfg app m2 sess (nev + 1) ns) (quitOf cs 0).
regAfter : unsafe Int -> Rs -> Int -> String .
regAfter me st 1 = regBye st.
regAfter me st q = regLoop me st.
# shutdown: every session actor is told, and each says Gone once its
# close frame is written; the acceptor then closes the sockets while the
# register waits a moment -- returning earlier would end the process
# with 1001 frames still in flight
regBye st =
  Rs cfg app model sess nev ns = st;
  _ = broadcast sess Bye;
  _ = regDrain (sLen sess) (myself 0);
  _ = Sys.sleepUs 50000;
  "fprlive: server closed after {nev} event(s), {ns} session(s)".
regDrain : unsafe Int -> Int -> Int .
regDrain 0 me = 0.
regDrain n me =
  m = receive me;
  _ = drop m;
  case m of
    Gone sid -> regDrain (n - 1) me
  | o -> regDrain n me.
broadcast : unsafe List (Int, Int) -> Msg -> Int .
broadcast Nil m = 0.
broadcast ((sid, a) :: r) m = _ = send a m; broadcast r m.

# ---- the acceptor: the only actor that polls, spawns, and closes sockets --------------------

acceptor reg port cfg app tickMs me =
  clint = device "clint";
  mt = reg32 clint 49144;
  accLoop me (As reg port cfg app Nil 0 (read mt) mt tickMs).

accLoop : unsafe Int -> As -> Int .
accLoop me st =
  As reg port cfg app map k ltt mt tickMs = st;
  map2 = closeAll map (drainPort me port);
  accPoll me (As reg port cfg app map2 k ltt mt tickMs) (netPoll 0).
accPoll : unsafe Int -> As -> Int -> Int .
accPoll me st 0 = accIdle me st.
accPoll me st cid =
  As reg port cfg app map k ltt mt tickMs = st;
  bytes = netRead cid;
  (a, map2) = actorFor reg port cfg app map cid k;
  _ = send a (Data bytes);
  map3 = case strlen bytes == 0 of True -> mDel map2 cid | False -> map2;   # EOF: the slot is free
  accNext me (As reg port cfg app map3 (k + 1) ltt mt tickMs).
# idle: a due tick for the register, else give the hart away for a moment
accIdle : unsafe Int -> As -> Int .
accIdle me st =
  As reg port cfg app map k ltt mt tickMs = st;
  now = read mt;
  ltt2 = case and2 (tickMs > 0) (now - ltt >= tickMs * 10000) of
      True -> _ = send reg Tick; now
    | False -> ltt;
  _ = yield me;
  _ = Sys.sleepUs 100;
  accNext me (As reg port cfg app map (k + 1) ltt2 mt tickMs).
accNext : unsafe Int -> As -> Int .
accNext me st =
  As reg port cfg app map k ltt mt tickMs = st;
  case k >= 64 of
    True -> accLoop me (boundaryA me (As reg port cfg app map 0 ltt mt tickMs))
  | False -> accLoop me st.

# a connection's actor, spawned on first bytes; peers are spread over the
# harts above 0 (the register is actor 0, on hart 0)
actorFor : unsafe Int -> Int -> _ -> App -> List (Int, Int) -> Int -> Int -> (Int, List (Int, Int)) .
actorFor reg port cfg app map cid k = afGo reg port cfg app map cid k map.
afGo : unsafe Int -> Int -> _ -> App -> List (Int, Int) -> Int -> Int -> List (Int, Int) -> (Int, List (Int, Int)) .
afGo reg port cfg app Nil cid k map =
  a = AC.spawnWithOn (hartFor k) (AC.Dynamic 64) (conn reg port cfg app cid);
  (a, (cid, a) :: map).
afGo reg port cfg app ((i, a) :: r) cid k map | i == cid = (a, map).
afGo reg port cfg app (e :: r) cid k map = afGo reg port cfg app r cid k map.
hartFor k = case Sys.harts Unit > 1 of
    True -> 1 + k % (Sys.harts Unit - 1)
  | False -> 0.
mDel : unsafe List (Int, Int) -> Int -> List (Int, Int) .
mDel map cid = sDelGo map cid Nil.
# the close queue: connection actors post the cid they are done with
drainPort : unsafe Int -> Int -> List Int .
drainPort me port =
  _ = send port (MV.PDrain me);
  ms = receiveFrom me port;
  cids = intsOf ms Nil;
  _ = drop ms;
  cids.
intsOf : unsafe List _ -> List Int -> List Int .
intsOf Nil acc = acc.
intsOf (c :: r) acc = intsOf r (c :: acc).
closeAll : unsafe List (Int, Int) -> List Int -> List (Int, Int) .
closeAll map Nil = map.
closeAll map (cid :: r) = _ = netClose cid; closeAll (mDel map cid) r.

# ---- a connection's actor ------------------------------------------------------------------

conn reg port cfg app cid me = connLoop me (Cs reg port cfg app cid 0 "" 0 Nil Nil 0).

connLoop : unsafe Int -> Cs -> Int .
connLoop me st =
  st2 = boundaryC me st;
  connMsg me st2 (receive me).
connMsg : unsafe Int -> Cs -> Msg -> Int .
connMsg me st m =
  _ = drop m;
  case m of
    Data b -> connData me st b
  | Model m2 -> connModel me st m2
  | Bye -> connBye me st
  | o -> connLoop me st.

# bytes: append, then act by mode; an EMPTY read is the socket tier's
# notice that the peer has gone (its slot is already free)
connData : unsafe Int -> Cs -> String -> Int .
connData me st b | strlen b == 0 = connGone me st.
connData me st b =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  connBytes me (Cs reg port cfg app cid mode (strcat buf b) sid ls ld model) mode.
connBytes : unsafe Int -> Cs -> Int -> Int .
connBytes me st 1 = connFrames me st.
connBytes me st m =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  connHttp me st buf (headEnd buf).
connGone me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  case mode == 1 of
    True -> _ = send reg (Gone sid); 0
  | False -> 0.
# done with the socket: the acceptor closes it and forgets the cid
connDone me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = send port cid;
  0.

# ---- HTTP: the page, the upgrade, or 404 ------------------------------------------------

connHttp : unsafe Int -> Cs -> String -> Int -> Int .
connHttp me st req 0 | strlen req > 8000 = connHttpBad me st "431 Request Header Fields Too Large".
connHttp me st req 0 = connLoop me st.                       # head still partial
connHttp me st req he = connRoute me st req (method req) (path req).
connRoute : unsafe Int -> Cs -> String -> String -> String -> Int .
connRoute me st req mth pth | and2 (G.strEq mth "GET") (G.strEq pth "/") = connPage me st.
connRoute me st req mth pth | and2 (G.strEq mth "GET") (G.strEq pth "/ws") = connUpgrade me st (header req "Sec-WebSocket-Key") (bodyOf req (headEnd req)).
connRoute me st req mth pth = connHttpBad me st "404 Not Found".
bodyOf req he = substr req he (strlen req - he + 1).
connHttpBad me st code =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = netWrite cid (httpResp code "text/plain" code);
  connDone me st.

# GET /: ask the register for the model once, render the not-yet-connected view
connPage me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  App ini upd vw sbs = app;
  _ = send reg (Ask me);
  h = receiveFrom me reg;
  Hello z m0 = h;
  tree = vw 0 m0;
  (s, d) = G.render tree;
  _ = netWrite cid (httpResp "200 OK" "text/html" (page cfg.css tree s d));
  connDone me st.

# GET /ws: the handshake, then JOIN (a fresh sid + the model), the first
# full render, and any frames the client sent right behind its head
connUpgrade me st key rest | strlen key != 24 = connHttpBad me st "400 Bad Request".
connUpgrade me st key rest =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = netWrite cid "HTTP/1.1 101 Switching Protocols{crlf}Upgrade: websocket{crlf}Connection: Upgrade{crlf}Sec-WebSocket-Accept: {acceptKey key}{crlf}{crlf}";
  _ = send reg (Join me);
  h = receiveFrom me reg;
  Hello sid2 m0 = h;
  st2 = pushOne (Cs reg port cfg app cid 1 rest sid2 ("<fresh>" :: Nil) Nil m0);   # never matches: full render
  connFrames me st2.

# ---- the model moved: render this session, ship a delta or a full render ----------------

connModel : unsafe Int -> Cs -> _ -> Int .
connModel me st m2 =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  case mode == 1 of
    True -> connLoop me (pushOne (Cs reg port cfg app cid mode buf sid ls ld m2))
  | False -> connLoop me (Cs reg port cfg app cid mode buf sid ls ld m2).
pushOne st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  App ini upd vw sbs = app;
  (s2, d2) = G.render (vw sid model);
  _ = case G.sameStatics ls s2 of
      True -> pushDelta cid (G.deltaJson ld d2)
    | False -> _ = netWrite cid (wsFrame 1 "\{\"s\":{G.jarr s2},\"d\":{G.jarr d2}}"); 0;
  Cs reg port cfg app cid mode buf sid s2 d2 model.
pushDelta cid dj | G.strEq dj "\{}" = 0.           # nothing changed for this session
pushDelta cid dj = _ = netWrite cid (wsFrame 1 "\{\"d\":{dj}}"); 0.

# ---- websocket: drain every complete frame in the buffer --------------------------------

connFrames : unsafe Int -> Cs -> Int .
connFrames me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  (fst, op, payload, used) = frame buf;
  connFrame me st fst op payload used.
connFrame : unsafe Int -> Cs -> Int -> Int -> String -> Int -> Int .
connFrame me st 0 op payload used = connFrameWait me st.
connFrame me st 2 op payload used = connClose me st 1002 "protocol error".
connFrame me st 3 op payload used = connClose me st 1009 "frame too big".
connFrame me st 1 op payload used = connOp me (consume st used) op payload.
# an incomplete frame: keep the bytes unless the buffer is already absurd
connFrameWait me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  case strlen buf > maxFrame + 16 of
    True -> connClose me st 1009 "frame too big"
  | False -> connLoop me st.
consume st used =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  Cs reg port cfg app cid mode (substr buf (used + 1) (strlen buf - used)) sid ls ld model.
connOp : unsafe Int -> Cs -> Int -> String -> Int .
connOp me st 1 payload = connEvent me st (jStr payload "msg") (jStr payload "arg").
connOp me st 9 payload = _ = netWrite (cidOf st) (wsFrame 10 payload); connFrames me st.
connOp me st 10 payload = connFrames me st.
connOp me st 8 payload = connClose me st 1000 "bye".
connOp me st op payload = connClose me st 1003 "text frames only".
cidOf (Cs reg port cfg app cid mode buf sid ls ld model) = cid.
# an event goes to the register; the push comes back as a Model broadcast
connEvent : unsafe Int -> Cs -> String -> String -> Int .
connEvent me st msg arg | G.strEq msg "" = connFrames me st.
connEvent me st msg arg =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = send reg (Ev sid msg arg);
  connFrames me st.
connClose me st code reason =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = netWrite cid (closeFrame code reason);
  _ = send reg (Gone sid);
  connDone me st.
connBye me st =
  Cs reg port cfg app cid mode buf sid ls ld model = st;
  _ = netWrite cid (closeFrame 1001 "server going away");
  _ = send reg (Gone sid);
  connDone me st.

# fontm.fpr -- metrics of the walker's text face (DejaVuSans-Bold.ttf), generated by
# tools/mkfont.py.  Advances in milli-em; a line is ascent + descent.
# Layout code (scene2d) sums these so it can size and center text
# without ever seeing a glyph; the host draws from the same table.

ascent = 950.
descent = 250.
line = 1200.


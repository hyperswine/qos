# ============================================================================
# appkit.fpr -- the SHARED vocabulary between pshell and its app plugins.
#
# Everything two separately compiled images exchange must be built from
# constructors THEY BOTH COMPILED FROM THE SAME SOURCE: tids are
# hash-derived per (module, type), so this module appearing in the
# shell AND in every app is what makes a LogAdd built in hello.qa
# pattern-match in the shell's log actor.  Keep it small and stable --
# editing it changes the hash, which obliges rebuilding the shell and
# every app together.
#
# The app contract (each app plugin exports exactly these names;
# the launcher resolves them PER TABLE with Mod.findAt):
#   appMeta u            -> (title, subtitle)     tile text
#   appInit env          -> st                    runs in the shell actor;
#                                                 may spawn the app's own
#                                                 actors, replay storage
#   appUpdate k st       -> st                    a key for the focused app
#                                                 (esc/p/q are the shell's)
#   appTree vw           -> scene2d tree
#   appVals self env st  -> vals                  runs in the frame worker
#                                                 actor; may svcCall
# env = (log, mt): the log-service capability and the mtime handle --
# capabilities are PASSED, never ambient.
# ============================================================================

# sev: 0 normal, 1 warn, 2 error -- the /logs/{normal,warns,errors} axis
#
# Read/VfsList are the ROOT NAMESPACE protocol.  There is no root
# filesystem: the root is what the registry KNOWS -- a flat set of URL
# paths, most naming virtual resources (a service, an actor inside
# one, an app), a few naming stored bytes.  "Directories" are just
# shared path prefixes, computed by whoever displays them.  Resolution
# is a walk to the path's OWNER: the vfs actor forwards Read to it and
# relays what comes back, so serving a path is a capability an actor
# holds, never a table of file contents.
# Write is the same walk as Read: the resolver hands it to the path's
# OWNER, and what "writing" means is that actor's business -- for a
# file it is a delta appended to the log and a cache updated; for
# something else it could be an ordinary message.  The namespace is a
# VIEW; writability is a property of the owner, not of the path.
Ak = Type (LogAdd sev line | LogSnap sev | VfsList u | Read path
         | Write path text).

# ---- service call (one request, one reply) ---------------------------------
call me a q = _ = send a (me, q); receive me.

# capability-routed logging (through /services -- an app actor's print)
logAdd me log line = call me log (LogAdd 0 line).
logAddAt me log sev line = call me log (LogAdd sev line).

# env = (log, mt, (titles, vfs)): the log capability, the mtime handle,
# the launcher's app-title list (attach order == sub-slot order by
# construction of apps-qa; the monitor leans on that), and the root
# namespace resolver.  ALWAYS go through these accessors -- the shape
# is packed to stay inside the tuple arities.
envLog (log, mt, rest) = log.
envMt (log, mt, rest) = mt.
envTitles (log, mt, rest) =
  (ts, vfs) = rest;
  ts.
envVfs (log, mt, rest) =
  (ts, vfs) = rest;
  vfs.

# the root namespace, through the resolver capability
vfsList me vfs = call me vfs (VfsList 0).
vfsRead me vfs path = call me vfs (Read path).
vfsWrite me vfs path text = call me vfs (Write path text).

# the plugin window: sub-slot attribution for entry-code addresses
plugBase u = 17314086912.            # 0x408000000
plugSlot u = 4194304.                # 4 MiB

# ---- keys ------------------------------------------------------------------
# The full US layout, unshifted and shifted.  The input tier reports a
# held shift by BIASING the keycode (+1000), so this stays two plain
# tables and nothing upstream carries modifier state.  Ctrl (+4000)
# and alt (+8000) arrive the same way and fall through to "" here --
# an app that wants chords matches those codes itself.
keyChar 57 = " ".
keyChar 30 = "a". keyChar 48 = "b". keyChar 46 = "c". keyChar 32 = "d".
keyChar 18 = "e". keyChar 33 = "f". keyChar 34 = "g". keyChar 35 = "h".
keyChar 23 = "i". keyChar 36 = "j". keyChar 37 = "k". keyChar 38 = "l".
keyChar 50 = "m". keyChar 49 = "n". keyChar 24 = "o". keyChar 25 = "p".
keyChar 16 = "q". keyChar 19 = "r". keyChar 31 = "s". keyChar 20 = "t".
keyChar 22 = "u". keyChar 47 = "v". keyChar 17 = "w". keyChar 45 = "x".
keyChar 21 = "y". keyChar 44 = "z".
keyChar 11 = "0". keyChar 2 = "1". keyChar 3 = "2". keyChar 4 = "3".
keyChar 5 = "4". keyChar 6 = "5". keyChar 7 = "6". keyChar 8 = "7".
keyChar 9 = "8". keyChar 10 = "9".
# the punctuation block, in keycode order
keyChar 12 = "-". keyChar 13 = "=". keyChar 26 = "[". keyChar 27 = "]".
keyChar 39 = ";". keyChar 40 = "'". keyChar 41 = "`". keyChar 43 = "\\".
keyChar 51 = ",". keyChar 52 = ".". keyChar 53 = "/".
# keypad, for the numeric block
keyChar 55 = "*". keyChar 74 = "-". keyChar 78 = "+". keyChar 98 = "/".
keyChar 71 = "7". keyChar 72 = "8". keyChar 73 = "9".
keyChar 75 = "4". keyChar 76 = "5". keyChar 77 = "6".
keyChar 79 = "1". keyChar 80 = "2". keyChar 81 = "3".
keyChar 82 = "0". keyChar 83 = ".".
# ---- shifted (code + 1000) -------------------------------------------------
keyChar 1057 = " ".
keyChar 1030 = "A". keyChar 1048 = "B". keyChar 1046 = "C". keyChar 1032 = "D".
keyChar 1018 = "E". keyChar 1033 = "F". keyChar 1034 = "G". keyChar 1035 = "H".
keyChar 1023 = "I". keyChar 1036 = "J". keyChar 1037 = "K". keyChar 1038 = "L".
keyChar 1050 = "M". keyChar 1049 = "N". keyChar 1024 = "O". keyChar 1025 = "P".
keyChar 1016 = "Q". keyChar 1019 = "R". keyChar 1031 = "S". keyChar 1020 = "T".
keyChar 1022 = "U". keyChar 1047 = "V". keyChar 1017 = "W". keyChar 1045 = "X".
keyChar 1021 = "Y". keyChar 1044 = "Z".
keyChar 1011 = ")". keyChar 1002 = "!". keyChar 1003 = "@". keyChar 1004 = "#".
keyChar 1005 = "$". keyChar 1006 = "%". keyChar 1007 = "^". keyChar 1008 = "&".
keyChar 1009 = "*". keyChar 1010 = "(".
keyChar 1012 = "_". keyChar 1013 = "+". keyChar 1026 = "{". keyChar 1027 = "}".
keyChar 1039 = ":". keyChar 1040 = "\"". keyChar 1041 = "~". keyChar 1043 = "|".
keyChar 1051 = "<". keyChar 1052 = ">". keyChar 1053 = "?".
keyChar c | c < 0 = chr (0 - c).    # stdin literal (the tty tier)
keyChar c = "".

# the shift bias, for apps that want to know
keyBase c | c >= 8000 = c - 8000.
keyBase c | c >= 4000 = c - 4000.
keyBase c | c >= 1000 = c - 1000.
keyBase c = c.

# ---- time ------------------------------------------------------------------
imodK a b = a - (a / b) * b.
pad2 n | n < 10 = "0{n}".
pad2 n = "{n}".
clockStr mt =
  t = read mt / 10000000;           # 10 MHz clint -> seconds
  "{pad2 (imodK (t / 60) 100)}:{pad2 (imodK t 60)}".

# spin until `ticks` clint units pass (an app actor's crude pacing)
waitTicks mt t0 n | read mt - t0 >= n = read mt.
waitTicks mt t0 n = waitTicks mt t0 n.

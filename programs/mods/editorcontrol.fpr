# Session-local inspection and prompt transitions, over ordinary leased
# endpoints. A parked watcher removes the endpoints if the Editor dies.
unsafe module.
State = use "editorstate".
EP = use "ep#c66ad65e68dd97f5".
Endpoint = use "epservice#e8bce05a1ddf73db".
AC = use "std/actor#201a0e9bf98a5154".
Request = Type (Inspect Int | Change Int Int Int State.Action).
controlMs = 250.
url session = "/apps/editor/{session}/state".
schemaUrl session = "{url session}/schema".
start me ns session = if ns == 0 then Ok 0 else
  actor = spawn (serve me ns session);
  case receiveFromRes me actor of
    Ok borrowed -> answer = keep borrowed; _ = drop borrowed; answer
  | Err why -> Err "editor inspection: {why}".
# Private shutdown uses a reserved handle outside the positive lease range.
# Only the watcher may send it, keeping the Editor's reply channel homogeneous.
stopHandle = 0 - 1.
stop me adapter = if adapter == 0 then Unit else _ = send adapter (me, 0, EP.Close stopHandle); Unit.
watch owner adapter me = _ = receiveFromRes me owner; stop me adapter.
register until me ns path owner = EP.flat (AC.callUntil until me ns (EP.NsReg path owner)).
# Registration replies and forwarded opens both come FROM the namespace.
# A separate registrar keeps its correlated replies off the endpoint mailbox.
claim owner ns session me =
  until = AC.nowUs Unit + controlMs * 1000;
  result = case register until me ns (url session) owner of Err why -> Err why
    | Ok u -> register until me ns (schemaUrl session) owner;
  _ = send owner result; Unit.
withdraw me ns session =
  until = AC.nowUs Unit + controlMs * 1000;
  # Queue withdrawals before exit. No synchronous reply wait on this mixed
  # namespace channel: pending opens may precede the acknowledgements.
  _ = report (AC.sendSureUntil until me ns (me, Sys.nextId Unit, EP.NsUnreg (url session)));
  report (AC.sendSureUntil until me ns (me, Sys.nextId Unit, EP.NsUnreg (schemaUrl session))).
report (Ok u) = Unit.
report (Err why) = _ = Sys.logAt 2 "Editor endpoint withdrawal failed: {why}"; Unit.
serve owner ns session me =
  registrar = spawn (claim me ns session);
  registered = case receiveFromRes me registrar of
    Ok borrowed -> answer = keep borrowed; _ = drop borrowed; answer
  | Err why -> Err why;
  case registered of
    Err why -> _ = withdraw me ns session; _ = send owner (Err "editor inspection registration: {why}"); Unit
  | Ok u ->
      watcher = spawn (watch owner me);
      _ = send owner (Ok me);
      _ = Sys.loop (Nil, 1) (step owner watcher session me);
      _ = kill watcher;
      withdraw me ns session.
step owner watcher session me state =
  (handles, next) = state;
  message = receive me;
  result = case message of
    (from, id, command) ->
      stopping = case command of EP.Close h -> h == stopHandle and from == watcher | other -> False;
      if stopping then (False, state) else
        live = Endpoint.liveLeases (AC.nowUs Unit) handles;
        changed = Endpoint.untilDispatch (read owner session) (write owner session) me live next (from, id) from command;
        (True, changed)
  | stale -> (True, state);
  _ = drop message;
  result.
read owner session until me client path =
  if path == schemaUrl session then Ok (EP.IStr "{State.schema}controlMs={controlMs}; registration and removal transport bound\n")
  else if path == url session then answer (AC.callUntil until me owner (Inspect until))
  else Err "no such Editor state endpoint".
write owner session until me client path value =
  if path != url session then Err "Editor state schema is read-only" else
  case value of
    EP.IStr text -> (case State.parse text of Err why -> Err why
      | Ok (revision, action) -> answer (AC.callUntil until me owner (Change until client revision action)))
  | other -> Err "Editor command wants IStr".
answer (Err why) = Err "editor state: {why}; inspect the revision before retrying".
answer (Ok (Err why)) = Err why.
answer (Ok (Ok snapshot)) = Ok (EP.IStr (State.render snapshot)).

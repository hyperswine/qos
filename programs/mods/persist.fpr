# persist.fpr -- Persist a: a named durable value, MVU-style.
#
#   store = P.spawnStore Unit;            # ONE writer for all keys
#   u = P.save store (P.Persist "docsite/recent" v);
#   v = P.load store me "docsite/recent" dflt;
#
# The FPRISC analogue of Sol's `Persistent a`: the value is addressed by
# a URL-shaped key and owned by a single store actor (the MVU rule --
# one linear writer, readers go through messages). BACKENDS: this
# module's store actor holds the working set in its own slab and calls
# `sink` on every save; the in-image sink here is a no-op (state lives
# for the server's life -- what a hosted posix image can offer), and on
# QOS native the same shape binds sink to the qlog append/readLatest
# rpc (svc.fpr's Rpc to /services/storage), which is where kill -9
# durability comes from. The APP code is identical either way -- that
# is the point of the type.

Core = use "coreutil".

Persist = Type (Persist url v).
PReq = Type (PGet me url | PSet url v).

# ---- the store actor: assoc list, last write wins ---------------------------

spawnStore u = spawn (fn me -> psLoop me Nil).
psLoop me kv = psServe me kv (receive me).
psServe me kv (PSet url v) = psLoop me (psPut kv url v).
psServe me kv (PGet who url) =
  u = send who (psFind kv url);
  psLoop me kv.

psPut Nil url v = (url, v) :: Nil.
psPut ((k, o) :: r) url v | strEq k url = (url, v) :: r.
psPut (e :: r) url v = e :: psPut r url v.

psFind Nil url = Err "unset".
psFind ((k, v) :: r) url | strEq k url = Ok v.
psFind (e :: r) url = psFind r url.

strEq a b = Core.strEq a b.

# ---- the value API ----------------------------------------------------------

save store (Persist url v) = send store (PSet url v).

load store me url dflt =
  u = send store (PGet me url);
  loadRes dflt (receiveRes me).
loadRes dflt (Ok v) = v.
loadRes dflt (Err e) = dflt.

# Recursive MVU: viewport, focus and pointer capture are model values.
unsafe module.
AW = use "appwire".
AS = use "appsession".
AV = use "appview".
L = use "shelllayout".
ST = use "scrolltext".
AK = use "appkit".
AC = use "std/actor#201a0e9bf98a5154".

# A directory is a prefix of the flat namespace: `dir` is the prefix being
# shown ("" is the root), `all` every url, `paths` what is directly under
# the prefix -- a deeper path shows as its next segment with a "/" (kind 1).
init = ({cursor = 0, mode = 0, dir = "", all = Nil, paths = Nil, text = "", lines = Nil, path = "", token = 1, busy = True, stale = False, phase = AW.Loading, w = 960, h = 530, focused = True, down = False, capture = 0 - 1, wheel = 0, scroll = 0, dragY = 0, dragScroll = 0, dragged = False}, [AW.Fetch 1 AW.ListRoot]).
fetch job m = if m.busy then (m, Nil) else
  ({m | token = m.token + 1, busy = True, stale = False, phase = AW.Loading}, [AW.Fetch (m.token + 1) job]).
update (AW.Resize w h) m = (move 0 (AV.resize w h m), Nil).
update (AW.Focus active) m = (AV.focus active m, Nil).
update AW.Cancel m = (AV.focus m.focused m, Nil).
update AW.Tick m | not m.focused = (m, Nil).

update (AW.Key 14) m = if m.mode == 0 then (up m, Nil) else
  ({m | mode = 0, scroll = 0, stale = m.busy, phase = AW.Ready, down = False, capture = 0 - 1}, Nil).
update (AW.Key 103) m = (move (0 - 1) m, Nil).
update (AW.Key 108) m = (move 1 m, Nil).
update (AW.Key 104) m = spec = AV.metrics m; (move (0 - spec.visible) m, Nil).
update (AW.Key 109) m = spec = AV.metrics m; (move spec.visible m, Nil).
update (AW.Key 102) m = (move (0 - ST.count (rows m)) m, Nil).
update (AW.Key 107) m = (move (ST.count (rows m)) m, Nil).
update (AW.Key 28) m = open m.
update (AW.Key 19) m = fetch (if m.mode == 0 then AW.ListRoot else AW.ReadPath m.path) m.
update (AW.Wheel dy dx) m = amount = m.wheel - dy * 3; (move (amount / 10) {m | wheel = amount % 10}, Nil).
update (AW.Pointer x y buttons) m =
  if L.inside (AV.bar m) x y or m.capture == 0 - 2 or m.capture == 0 - 3 then (AV.pointer (rows m) x y buttons m, Nil) else
  index = AV.rowAt m x y;
  valid = m.mode == 0 and index >= 0 and index < ST.count m.paths;
  if buttons == 1 then if m.down then
    spec = AV.metrics m;
    if y - m.dragY > spec.em / 2 or m.dragY - y > spec.em / 2 then
      (AV.pointer (rows m) x y buttons {m | capture = 0 - 3}, Nil) else (m, Nil)
    else
    ({m | down = True, dragY = y, dragScroll = m.scroll, dragged = False, capture = (if valid then index else 0 - 1), cursor = (if valid then index else m.cursor)}, Nil)
  else fresh = {m | down = False, capture = 0 - 1};
    if m.down and valid and not m.dragged and m.capture == index then open fresh else (fresh, Nil).
update (AW.Arrived token result) m = if token != m.token or not m.busy then (m, Nil) else
  if m.stale then ({m | busy = False, stale = False}, Nil) else case result of
    Ok (AW.Lines lines total) -> paths = children lines m.dir;
      ({m | all = lines, paths = paths, cursor = clamp m.cursor (ST.count paths), busy = False, phase = AW.Ready}, Nil)
  | Ok (AW.Text text) -> ({m | text = text, lines = ST.lines text, busy = False, phase = AW.Ready}, Nil)
  | Err why -> ({m | busy = False, phase = AW.Failed why}, Nil)
  | other -> ({m | busy = False, phase = AW.Failed "invalid browser result"}, Nil).
update other m = (m, Nil).
open m = if m.busy or m.paths == Nil or m.mode != 0 then (m, Nil) else
  (name, kind) = nth m.paths m.cursor;
  path = "{m.dir}/{name}";
  if kind == 1 then ({m | dir = path, paths = children m.all path, cursor = 0, scroll = 0}, Nil)
  else fetch (AW.ReadPath path) {m | mode = 1, path = path, text = "", lines = Nil, scroll = 0}.
# Backspace in a directory: its parent, with the cursor on the directory left
up m = if m.dir == "" then m else
  parent = parentOf m.dir;
  paths = children m.all parent;
  {m | dir = parent, paths = paths, cursor = indexOf (strcat (segAfter m.dir parent) "/") paths 0, scroll = 0}.
parentOf dir = case lastSlash dir (strlen dir - 1) of
    0 -> ""
  | i -> substr dir 0 i.
lastSlash : String -> (i : Int | measure (i + 1)) -> Int .
lastSlash s i = if i <= 0 then 0 else if charAt s i == 47 then i else lastSlash s (i - 1).
segAfter path parent = substr path (strlen parent + 1) (strlen path - strlen parent - 1).
indexOf name Nil i = 0.
indexOf name ((n, k) :: rest) i = if n == name then i else indexOf name rest (i + 1).
# what is directly under a prefix, folders first then files, each once; a
# name that is both a registered url and a prefix (/home, the manager, and
# /home/notes under it) shows as the folder
children all dir =
  pre = strcat dir "/";
  entries = entriesUnder all pre Nil;
  folderNames = uniqSorted (sortBy 1 entries);
  append folderNames (notFolders (uniqSorted (sortBy 0 entries)) folderNames).
notFolders Nil fs = Nil.
notFolders ((n, k) :: rest) fs = if isFolder n fs then notFolders rest fs else (n, k) :: notFolders rest fs.
isFolder n Nil = False.
isFolder n ((f, k) :: rest) = if n == f then True else isFolder n rest.
entriesUnder Nil pre acc = acc.
entriesUnder (u :: rest) pre acc =
  if strlen u > strlen pre and substr u 0 (strlen pre) == pre then
    tail = substr u (strlen pre) (strlen u - strlen pre);
    i = strIndexOf "/" tail;
    entriesUnder rest pre ((if i < 0 then (tail, 0) else (substr tail 0 i, 1)) :: acc)
  else entriesUnder rest pre acc.
sortBy kind entries = sortNames (names kind entries).
names kind Nil = Nil.
names kind ((n, k) :: rest) = if k == kind then (n, k) :: names kind rest else names kind rest.
sortNames Nil = Nil.
sortNames (x :: rest) = insertName x (sortNames rest).
insertName x Nil = x :: Nil.
insertName x (y :: rest) = (n, k) = x; (n2, k2) = y; if strCmp n n2 <= 0 then x :: y :: rest else y :: insertName x rest.
uniqSorted Nil = Nil.
uniqSorted (x :: Nil) = x :: Nil.
uniqSorted (x :: y :: rest) = (n, k) = x; (n2, k2) = y; if n == n2 then uniqSorted (y :: rest) else x :: uniqSorted (y :: rest).
append Nil ys = ys.
append (x :: r) ys = x :: append r ys.
folders Nil = 0.
folders ((n, k) :: rest) = k + folders rest.
move delta m = if m.mode == 1 then AV.scroll (rows m) delta m else
  c = clamp (m.cursor + delta) (ST.count m.paths); spec = AV.metrics m;
  off = if c < m.scroll then c else if c >= m.scroll + spec.visible then c - spec.visible + 1 else m.scroll;
  {m | cursor = c, scroll = ST.offsetWith spec (ST.count m.paths) off}.
clamp c n = L.clamp 0 (L.max 0 (n - 1)) c.
nth Nil n = ("", 0).
nth (x :: rest) 0 = x.
nth (x :: rest) n = nth rest (n - 1).
pathRows Nil cursor index = Nil.
pathRows ((name, kind) :: rest) cursor index =
  "{if index == cursor then "> " else "  "}{name}{if kind == 1 then "/" else ""}" :: pathRows rest cursor (index + 1).
rows m = if m.mode == 0 then pathRows m.paths m.cursor 0 else ST.wrapWith (AV.metrics m) m.text.
view vp m = (AV.frame vp "Files" (if m.mode == 0 then
    "{if m.dir == "" then "/" else m.dir}   {folders m.paths} folders, {ST.count m.paths - folders m.paths} files   ENTER OPEN   BKSP UP   R REFRESH"
    else "{m.path}   {ST.count m.lines} lines, {strlen m.text} bytes   BKSP BACK") (rows m) m.scroll, Nil).

# This actor owns the child model. Transport and effects exchange data only.
run me = case AS.start me of
    Err why -> Unit
  | Ok ctx ->
      (initial, commands) = init;
      (model, ignored) = update (AW.Resize ctx.w ctx.h) initial;
      _ = AS.issue me ctx commands;
      _ = Sys.loop (ctx, model) (step me); Unit.
step me state =
  (ctx, model) = state;
  case AS.next me ctx of
    AS.Idle -> _ = Sys.sleepUs 1000; (True, state)
  | AS.Gone -> _ = AS.abandon me ctx; (False, state)
  | AS.JobResult token result ->
      (fresh, commands) = update (AW.Arrived token result) model;
      _ = AS.issue me ctx commands;
      (True, (AS.advance ctx ctx.sequence, fresh))
  | AS.Message ret request -> case request of
      AW.CloseWith session until stopMs -> (AS.closeWithin until stopMs me ctx ret session, state)
    | AW.Close session -> (AS.close me ctx ret session, state)
    | AW.Event session sequence event -> case AS.valid ctx session sequence of
        False -> _ = AC.reply ret (AW.Refused "stale session or sequence"); (True, state)
      | True ->
          next = AS.advance (AS.resized ctx event) sequence;
          (fresh, commands) = update event model;
          _ = AS.issue me next commands;
          (tree, vals) = view (next.w, next.h) fresh;
          _ = AC.reply ret (AW.Frame next.session next.revision tree vals (AW.status fresh.phase));
          (True, (next, fresh)).

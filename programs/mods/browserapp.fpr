# ============================================================================
# browserapp.fpr -- FileBrowser.qa: a UI over the ROOT NAMESPACE.
#
# There is no filesystem here to browse.  The list comes from what the
# system knows how to name -- registry entries, one line each -- and
# "directories" are nothing but shared prefixes this view groups by.
# Most rows resolve to virtual things (a service, an app, an actor
# inside one); a few resolve to bytes, and for those ENTER asks the
# resolver, which walks to the owner and relays what it serves.  The
# distinction the user sees (VIRT vs DATA) is the entry's kind, not a
# property of any storage.
# ============================================================================
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("FILES", "ROOT NAMESPACE").

# state = (cursor, mode): mode 0 = the namespace, 1 = a resolved path
appInit self env = (0, 0).
appUpdate self env k st | k == 108 = brMove st 1.       # down
appUpdate self env k st | k == 103 = brMove st (0 - 1). # up
appUpdate self env k st | k == 28 = brOpen st.          # enter: resolve
appUpdate self env k st | k == 14 = brBack st.          # backspace: back to list
appUpdate self env k st = st.
brMove (c, m) d | m == 1 = (c, m).
brMove (c, m) d | c + d < 0 = (c, m).
brMove (c, m) d = (c + d, m).
brOpen (c, m) = (c, 1).
brBack (c, m) = (c, 0).

brRow i =
  Box [Row, Pad 1] [ Slot [Fg (930, 940, 960)] i 46 ].

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "FILES"
        , Slot [Fg (999, 800, 300)] 0 26
        , Box [Grow] Nil
        , Slot [Fg (560, 590, 650)] 11 12 ]
    , Box [Col, Gap 2, Grow, Bord (150, 165, 200), Pad 3]
        [ brRow 1, brRow 2, brRow 3, brRow 4, brRow 5
        , brRow 6, brRow 7, brRow 8, brRow 9, brRow 10 ]
    , Lbl [Fg (560, 590, 650)] "UP/DOWN MOVE  ENTER RESOLVE  BKSP BACK  ESC HOME" ].

# ---- helpers ---------------------------------------------------------------

brLen Nil = 0.
brLen (x :: r) = 1 + brLen r.
brNth Nil i = ("", 0).
brNth (x :: r) 0 = x.
brNth (x :: r) i = brNth r (i - 1).
brClamp c n | n == 0 = 0.
brClamp c n | c > n - 1 = n - 1.
brClamp c n = c.

kindTag 0 = "VIRT".
kindTag k = "DATA".

# rows: a window of 10 around the cursor, marked
brRows Nil i c = Nil.
brRows ((p, k) :: r) i c | i == c = "> {kindTag k} {p}" :: brRows r (i + 1) c.
brRows ((p, k) :: r) i c = "  {kindTag k} {p}" :: brRows r (i + 1) c.

brWindow l start | start == 0 = l.
brWindow Nil start = Nil.
brWindow (x :: r) start = brWindow r (start - 1).
brStart c | c > 9 = c - 9.
brStart c = 0.

# split served text into lines for the rows
brLines s = brSplit s 1 1 Nil.
brSplit s i st acc | i > strlen s = brRev (brSeg s st i :: acc) Nil.
brSplit s i st acc | charAt s i == 10 =
  brSplit s (i + 1) (i + 1) (brSeg s st i :: acc).
brSplit s i st acc = brSplit s (i + 1) st acc.
brSeg s st i | i > st = substr s st (i - st).
brSeg s st i = "".
brRev Nil acc = acc.
brRev (x :: r) acc = brRev r (x :: acc).

brPad l n | n == 0 = Nil.
brPad Nil n = "" :: brPad Nil (n - 1).
brPad (x :: r) n = x :: brPad r (n - 1).

appVals self env st =
  (c0, mode) = st;
  vfs = AK.envVfs env;
  ents = AK.vfsList self vfs;
  n = brLen ents;
  c = brClamp c0 n;
  (p, k) = brNth ents c;
  vs = brBody self vfs mode ents c p;
  _ = drop ents;
  vs.

brBody self vfs 0 ents c p =
  n = brLen ents;
  "/  ({n} paths)"
    :: brPad (brRows (brWindow ents (brStart c)) (brStart c) c) 10
    |> brAppend "{c + 1}/{n}".
brBody self vfs mode ents c p =
  txt = AK.vfsRead self vfs p;
  ls = brLines txt;
  _ = drop txt;
  p :: brPad ls 10 |> brAppend "RESOLVED".

brAppend x l = brCat l (x :: Nil).
brCat Nil b = b.
brCat (a :: r) b = a :: brCat r b.

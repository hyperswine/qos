# ============================================================================
# timer.fpr -- Timer.qa: the time service.  ONE actor owns the CLINT
# driver and the timer interrupt; everything else asks it in messages.
#
#   * The actor binds itself to the machine's timer bridge at startup
#     (Sys.timerBind, actors.c).  On native QOS that bridge is REAL:
#     Timer.qa arms one CLINT deadline at a time (Sys.timerArm, a
#     delta in ticks), the IRQ HART -- the last live hart, an
#     auxiliary hart, never hart 0 -- pops out of wfi on MTIP and
#     delivers a bare Int message when the deadline is due.  ALL
#     interrupt and CLINT driver work stays inside this one actor.
#   * On QOS Portable Sys.timerBind answers 0 (no hardware timer):
#     the SAME actor instead spawns a sleeper child per request
#     (Sys.sleepUs then a bare-Int poke) -- the same protocol, a
#     hosted backend.
#   * A client does `std.timer.after svc ms` -- one SEND, no reply
#     round trip.  When the deadline passes, Timer.qa sends TFire to
#     the CALLER's mailbox: a blocked receiver moves from the backlog
#     into the ready zone under the scheduler's ordinary admission
#     bounds (RQ_CAP batches, aging) and runs soon after.  sleep is
#     the blocking wrapper (after + receive the fire).
#
# The message surface (RPC envelope: send svc (me, <msg>)):
#   TAfter ms          -> (nothing now; TFire to the SENDER later)
#   TPing              -> TOkI nat   liveness probe; nat = 1 iff the
#                                    hardware bridge is live
# and the BRIDGE's arm: a bare Int (a due CLINT deadline, or a sleeper
# child's poke).
#
# State: the pending set as a deadline-sorted list of (deadline, who),
# in LOW-WORD mtime ticks (10 MHz: 10000 ticks per ms) -- the same
# 32-bit clock every /services/clock reader sees.  The hardware arm
# re-derives its delta from the clock at arm time, so the C side keeps
# full-width absolute time internally.
# ============================================================================

TMsg = Type (TAfter ms | TPing).
TRep = Type (TOkI n | TFire).

ticksPerMs = 10000.   # CLINT runs at 10 MHz on virt and qosp alike

actor : unsafe Int -> a .
actor me =
  cl = device "clint";
  clk = reg32 cl 49144;
  nat = Sys.timerBind me;
  loop me clk nat Nil.

loop : unsafe Int -> Int -> Int -> List (Int, Int) -> a .
loop me clk nat pend =
  m = receive me;
  case m of
    (from, req) -> dispatch me clk nat pend from req
  | k -> fireDue me clk nat pend.
    # ^ bare Int: the bridge's CLINT fire or a sleeper's poke --
    #   matched by fallthrough (the uart actor's irq shape)

dispatch : unsafe Int -> Int -> Int -> List (Int, Int) -> Int -> TMsg -> a .
dispatch me clk nat pend from req =
  case req of
    TAfter ms -> doAfter me clk nat pend from ms
  | TPing -> send from (TOkI nat) >> loop me clk nat pend.

doAfter : unsafe Int -> Int -> Int -> List (Int, Int) -> Int -> Int -> a .
doAfter me clk nat pend from ms =
  dl = Mmio.read clk + ms * ticksPerMs;
  pend2 = insert dl from pend;
  _ = case nat == 1 of
        True -> armNearest clk pend2
      | False -> sleepChild me ms;
  fireDue me clk nat pend2.
  # ^ fire immediately-due entries (ms = 0, or a deadline that passed
  #   while we were parked) instead of waiting for the next poke

# deadline-sorted insert, oldest deadline first
insert : unsafe Int -> Int -> List (Int, Int) -> List (Int, Int) .
insert dl who pend =
  case pend of
    Nil -> (dl, who) :: Nil
  | p :: rest -> case p of (d2, w2) ->
      case dl < d2 of
        True -> (dl, who) :: pend
      | False -> (d2, w2) :: insert dl who rest.

# hardware mode: ONE armed deadline, always the nearest pending
armNearest : unsafe Int -> List (Int, Int) -> Unit .
armNearest clk pend =
  case pend of
    Nil -> Unit
  | p :: rest -> case p of (dl, w) -> Sys.timerArm (dl - Mmio.read clk).

# hosted mode: a child sleeps the interval and pokes us (bare Int).
# An early poke (host sleep undershot) just re-sleeps the remainder
# via the rearm path below.
sleepChild : unsafe Int -> Int -> Unit .
sleepChild me ms =
  c = spawn (sleeper me ms);
  Unit.
sleeper : unsafe Int -> Int -> Int -> a .
sleeper t ms me2 =
  _ = Sys.sleepUs (ms * 1000);
  send t 0.

# pop everything due, notify the waiters, re-arm for the remainder
fireDue : unsafe Int -> Int -> Int -> List (Int, Int) -> a .
fireDue me clk nat pend =
  case pend of
    Nil -> loop me clk nat pend
  | p :: rest -> case p of (dl, who) ->
      case Mmio.read clk >= dl of
        True -> send who TFire >> fireDue me clk nat rest
      | False -> rearm me clk nat pend dl.
rearm : unsafe Int -> Int -> Int -> List (Int, Int) -> Int -> a .
rearm me clk nat pend dl =
  _ = case nat == 1 of
        True -> Sys.timerArm (dl - Mmio.read clk)
      | False -> sleepChild me ((dl - Mmio.read clk) / ticksPerMs + 1);
  loop me clk nat pend.

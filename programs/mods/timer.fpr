# ============================================================================
# timer.fpr -- Timer.qa: the time service.  ONE actor owns the CLINT
# driver and the timer interrupt; everything else asks it in messages.
#
#   * The actor binds itself to the machine's timer bridge at startup
#     (Sys.timerBind, actors.c).  On native QOS that bridge is REAL:
#     Timer.qa arms one CLINT deadline at a time (Sys.timerArm, a
#     delta in ticks), the IRQ HART -- the last live hart, an
#     auxiliary hart, never hart 0 -- pops out of wfi on MTIP and
#     delivers a bare Int message when the deadline is due.  ALL
#     interrupt and CLINT driver work stays inside this one actor.
#   * On QOS Portable Sys.timerBind answers 0 (no hardware timer):
#     the SAME actor instead spawns a sleeper child per request
#     (Sys.sleepUs then a bare-Int poke) -- the same protocol, a
#     hosted backend.
#   * A client does `std.timer.after svc ms` -- one SEND, no reply
#     round trip.  When the deadline passes, Timer.qa sends TFire to
#     the CALLER's mailbox: a blocked receiver moves from the backlog
#     into the ready zone under the scheduler's ordinary admission
#     bounds (RQ_CAP batches, aging) and runs soon after.  sleep is
#     the blocking wrapper (after + receive the fire).
#
# The message surface (RPC envelope: send svc (me, <msg>)):
#   TAfter ms          -> (nothing now; TFire to the SENDER later)
#   TPing              -> TOkI nat   liveness probe; nat = 1 iff the
#                                    hardware bridge is live
# and the BRIDGE's arm: a bare Int (a due CLINT deadline, or a sleeper
# child's poke).
#
# State: the pending set as a deadline-sorted list of (deadline, who),
# in milliseconds since boot (Sys.uptimeMs, the clock /services/clock
# answers): a 31-bit RV32 Int holds it for 12.4 days, where the old
# low-word CLINT ticks wrapped after 107 s.  The hardware arm converts
# at most ARM_MAX_MS to ticks and a hosted sleeper sleeps at most
# SLEEP_MAX_MS; a longer wait is re-armed for the remainder when it
# fires early, the same path an undershooting host sleep takes.
# ============================================================================

TMsg = Type (TAfter ms | TPing).
TRep = Type (TOkI n | TFire).

ticksPerMs = 10000.   # CLINT runs at 10 MHz on virt and qosp alike
armMaxMs = 100000.     # 1e9 ticks: inside a 31-bit Int
sleepMaxMs = 1000000.  # 1e9 microseconds: inside a 31-bit Int
nowMs u = Sys.uptimeMs u.
# the largest deadline an Int holds; a later one waits there (12.4 days on RV32)
intMax u = 1073741823.
armTicks left = (if left < 0 then 0 else if left > armMaxMs then armMaxMs else left) * ticksPerMs.

actor : unsafe Int -> Unit .
actor me =
  cl = device "clint";
  clk = reg32 cl 49144;
  nat = Sys.timerBind me;
  slp = case nat == 1 of True -> 0 | False -> spawn (sleeperActor me);
  _ = Sys.loop Nil (turn me clk nat slp);
  Unit.

turn : unsafe Int -> Int -> Int -> Int -> List (Int, Int) -> (Bool, List (Int, Int)) .
turn me clk nat slp pend =
  m = receive me;
  pend2 = case m of
      (from, req) -> dispatch me clk nat slp pend from req
    | k -> fireDue me clk nat slp pend;
  (True, pend2).
    # ^ bare Int: the bridge's CLINT fire or a sleeper's poke --
    #   matched by fallthrough (the uart actor's irq shape)

dispatch : unsafe Int -> Int -> Int -> Int -> List (Int, Int) -> Int -> TMsg -> List (Int, Int) .
dispatch me clk nat slp pend from req =
  case req of
    TAfter ms -> doAfter me clk nat slp pend from ms
  | TPing -> send from (TOkI nat) >> pend.

doAfter : unsafe Int -> Int -> Int -> Int -> List (Int, Int) -> Int -> Int -> List (Int, Int) .
doAfter me clk nat slp pend from ms =
  now = nowMs Unit;
  dl = if ms <= 0 then now else if ms > intMax Unit - now then intMax Unit else now + ms;
  pend2 = insert dl from pend;
  _ = case nat == 1 of
        True -> armNearest clk pend2
      | False -> armSleeper slp pend2;
  fireDue me clk nat slp pend2.
  # ^ fire immediately-due entries (ms = 0, or a deadline that passed
  #   while we were parked) instead of waiting for the next poke

# deadline-sorted insert, oldest deadline first
insert : unsafe Int -> Int -> List (Int, Int) -> List (Int, Int) .
insert dl who pend =
  case pend of
    Nil -> (dl, who) :: Nil
  | p :: rest -> case p of (d2, w2) ->
      case dl < d2 of
        True -> (dl, who) :: pend
      | False -> (d2, w2) :: insert dl who rest.

# hardware mode: ONE armed deadline, always the nearest pending
armNearest : unsafe Int -> List (Int, Int) -> Unit .
armNearest clk pend =
  case pend of
    Nil -> Unit
  | p :: rest -> case p of (dl, w) -> Sys.timerArm (armTicks (dl - nowMs Unit)).

# hosted mode: one reusable sleeper actor woken with the nearest deadline.
# Parks in blocking receive when idle (0) and slices long sleeps to 10 ms so
# newly arrived shorter deadlines are picked up promptly without spawning.
armSleeper : unsafe Int -> List (Int, Int) -> Unit .
armSleeper slp pend =
  case pend of
    Nil -> Unit
  | p :: rest -> case p of (dl, w) -> _ = send slp dl; Unit.

sleeperActor : unsafe Int -> Int -> Unit .
sleeperActor t me2 = _ = Sys.loop 0 (sleeperTurn t me2); Unit.

sleeperDrain : unsafe Int -> Int -> Int .
sleeperDrain me2 dl = case receiveNow me2 of
    Err why -> dl
  | Ok next ->
      best = if dl == 0 or (next > 0 and next < dl) then next else dl;
      sleeperDrain me2 best.

sleeperTurn : unsafe Int -> Int -> Int -> (Bool, Int) .
sleeperTurn t me2 dl =
  d0 = if dl == 0 then receive me2 else dl;
  d1 = sleeperDrain me2 d0;
  if d1 <= 0 then (True, 0) else
    left = d1 - nowMs Unit;
    if left <= 0 then _ = send t 0; (True, 0) else
      slice = if left > 10 then 10 else left;
      _ = Sys.sleepUs (slice * 1000);
      (True, d1).

# pop everything due, notify the waiters, re-arm for the remainder
fireDue : unsafe Int -> Int -> Int -> Int -> List (Int, Int) -> List (Int, Int) .
fireDue me clk nat slp pend =
  case pend of
    Nil -> pend
  | p :: rest -> case p of (dl, who) ->
      case nowMs Unit >= dl of
        True -> send who TFire >> fireDue me clk nat slp rest
      | False -> rearm me clk nat slp pend dl.
rearm : unsafe Int -> Int -> Int -> Int -> List (Int, Int) -> Int -> List (Int, Int) .
rearm me clk nat slp pend dl =
  _ = case nat == 1 of
        True -> Sys.timerArm (armTicks (dl - nowMs Unit))
      | False -> _ = send slp dl; Unit;
  pend.

# ============================================================================
# monitorapp.fpr -- Monitor.qa: the system monitor.  A live tree of
# what is RUNNING: the shell process and every loaded app, each with
# the actors it owns.  Ownership is derived, not declared: an actor's
# entry-code address inside a plugin sub-slot names the app that
# spawned it (the shell's own actors -- and every frame worker --
# resolve to the shell image below the plugin window).  Rows carry
# id, state, and the spawner's id: the parent links ARE the tree.
# ============================================================================
S2 = use "scene2d".
AK = use "appkit".
Box = S2.Box. Lbl = S2.Lbl. Slot = S2.Slot.
Row = S2.Row. Col = S2.Col. Pad = S2.Pad. Gap = S2.Gap.
W = S2.W. H = S2.H. Grow = S2.Grow. Sc = S2.Sc.
Bg = S2.Bg. Fg = S2.Fg. Bord = S2.Bord.

appMeta u = ("MONITOR", "ACTOR TREE").
appInit self env = 0.
appUpdate self env k st = st.

mnLine i =
  Box [Row, Pad 1] [ Slot [Fg (930, 940, 960)] i 46 ].

appTree vp =
  (vw, vh) = vp;
  Box [Col, Pad 8, Gap 4, W vw, H vh, Bg (62, 70, 88)]
    [ Box [Row, Gap 6]
        [ Lbl [Sc 2, Fg (420, 900, 560)] "MONITOR"
        , Lbl [Fg (560, 590, 650)] "processes / actors"
        , Box [Grow] Nil
        , Slot [Fg (999, 800, 300)] 0 12 ]
    , Box [Col, Gap 2, Grow, Bord (150, 165, 200), Pad 3]
        [ mnLine 1, mnLine 2, mnLine 3, mnLine 4, mnLine 5
        , mnLine 6, mnLine 7, mnLine 8, mnLine 9, mnLine 10
        , mnLine 11, mnLine 12 ]
    , Lbl [Fg (560, 590, 650)] "OWNER FROM ENTRY-CODE IMAGE   ESC BACK" ].

# ---- gather: [ [id, st, parent, code] .. ] sorted by id --------------------

gather i n | i >= n = Nil.
gather i n = Sys.actInfo i :: gather (i + 1) n.

mnId (id :: r) = id.
mnSt (id :: st :: r) = st.
mnPa (id :: st :: pa :: r) = pa.
mnCo (id :: st :: pa :: co :: r) = co.

insert x Nil = x :: Nil.
insert x (y :: r) | mnId x <= mnId y = x :: y :: r.
insert x (y :: r) = y :: insert x r.
sortById Nil = Nil.
sortById (x :: r) = insert x (sortById r).

# owner: 0 = the shell image, 1+i = app sub-slot i
ownerOf co | co < AK.plugBase 0 = 0.
ownerOf co | co >= AK.plugBase 0 + 8 * AK.plugSlot 0 = 0.
ownerOf co = 1 + (co - AK.plugBase 0) / AK.plugSlot 0.

stStr 0 = "RUN".
stStr s = "BLK".

# one row per actor under its owner section, sections in owner order
rowsFor own Nil ts = Nil.
rowsFor own (a :: r) ts | ownerOf (mnCo a) == own =
  "  #{mnId a} {stStr (mnSt a)} p#{mnPa a}" :: rowsFor own r ts.
rowsFor own (a :: r) ts = rowsFor own r ts.

secTitle 0 ts = "PSHELL (system)".
secTitle o ts = "{mnNth ts (o - 1)} (slot {o - 1})".
mnNth Nil i = "APP".
mnNth (t :: r) 0 = t.
mnNth (t :: r) i = mnNth r (i - 1).

hasOwn own Nil = 0.
hasOwn own (a :: r) | ownerOf (mnCo a) == own = 1.
hasOwn own (a :: r) = hasOwn own r.

sections own acts ts | own > 8 = Nil.
sections own acts ts =
  case hasOwn own acts of
    1 -> mnCat (secTitle own ts :: rowsFor own acts ts)
                (sections (own + 1) acts ts)
  | _ -> sections (own + 1) acts ts.
mnCat Nil b = b.
mnCat (a :: r) b = a :: mnCat r b.

padRows rows n | n == 0 = Nil.
padRows Nil n = "" :: padRows Nil (n - 1).
padRows (x :: r) n = x :: padRows r (n - 1).

appVals self env st =
  n = Sys.actLive 0;
  acts = sortById (gather 0 n);
  rows = sections 0 acts (AK.envTitles env);
  "{n} LIVE" :: padRows rows 12.

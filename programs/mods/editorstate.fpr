# Editor control state. Job kinds describe outstanding work, not settings that
# may be overwritten while a reply is in flight.
Run = use "runpolicy".
Text = use "policytext".
JobKind = Type (OpenDocument | ListDocuments | SaveDocument | KeepSession | BuildSource | RunSource | RestoreSession | CheckSource | ProgramRequest).
PromptMode = Type (Editing | OpenPrompt | SaveAsPrompt | FindPrompt | GotoPrompt).
Confirmation = Type (NoConfirmation | DiscardForOpen String | DiscardForNew).
EditKind = Type (NoEdit | Typing | LineBreak | Clipboard | Structural | Deleting).
Action = Type (ShowOpen | ShowSaveAs String | ShowFind String | ShowGoto String | CancelPrompt).
PendingJob = Type (PendingJob Int JobKind Int).
Snapshot = Type (Snapshot Int PromptMode String Confirmation EditKind Bool Run.Admission (List PendingJob)).
jobName OpenDocument = "open-document".
jobName ListDocuments = "list-documents".
jobName SaveDocument = "save-document".
jobName KeepSession = "keep-session".
jobName BuildSource = "build-source".
jobName RunSource = "run-source".
jobName RestoreSession = "restore-session".
jobName CheckSource = "check-source".
jobName ProgramRequest = "program-request".
promptName Editing = "editing".
promptName OpenPrompt = "open".
promptName SaveAsPrompt = "save-as".
promptName FindPrompt = "find".
promptName GotoPrompt = "goto".
confirmationName NoConfirmation = "none".
confirmationName (DiscardForOpen path) = "discard-for-open {path}".
confirmationName DiscardForNew = "discard-for-new".
editName NoEdit = "none".
editName Typing = "typing".
editName LineBreak = "line-break".
editName Clipboard = "clipboard".
editName Structural = "structural".
editName Deleting = "deleting".
coalesces Typing = True.
coalesces Deleting = True.
coalesces other = False.
render (Snapshot revision mode query confirmation edit dirty admission jobs) =
  "revision={revision}\nprompt={promptName mode}\nquery={query}\nconfirmation={confirmationName confirmation}\neditKind={editName edit}\ndirty={dirty}\nrunPolicyRevision={Run.admittedRevision admission}\nrunBudgetBytes={Run.bytes admission}\n{renderJobs jobs}".
renderJobs Nil = "".
renderJobs (PendingJob token kind version :: rest) = "job token={token} kind={jobName kind} version={version}\n{renderJobs rest}".
schema = "type=EditorState version=1\nprompts=editing,open,save-as,find,goto\njobs=open-document,list-documents,save-document,keep-session,build-source,run-source,restore-session,check-source,program-request\nedits=none,typing,line-break,clipboard,structural,deleting\nwrite=revision=N open | revision=N save-as QUERY | revision=N find QUERY | revision=N goto QUERY | revision=N cancel\ncommand=at most 2048 bytes; optional LF or CRLF terminator; single line; query spaces preserved\ntransitions=show or cancel a prompt through the normal Editor transition; never submit, save, discard or rewrite pending jobs\nrevision=app-state revision; includes events and completed jobs; stale writes refused\nconfirmation=none,discard-for-open PATH,discard-for-new; changes of target require fresh confirmation\nauthorization=system-process-only, cooperative caller identity\nlifetime=one Editor session; endpoints removed on normal exit or owner death\n".
# Preserve the query verbatim after the command's first separator.
parse : unsafe String -> Result (Int, Action) String .
parse raw = if strlen raw > 2048 then Err "command exceeds 2048 bytes" else
  s = line raw;
  if strIndexOf "\n" s >= 0 or strIndexOf "\r" s >= 0 then Err "expected a single-line command" else parseLine s.
# Terminal writes append a line terminator. Remove exactly one LF or CRLF,
# without trimming meaningful leading/trailing spaces from the query.
line s = n = strlen s;
  if n > 0 and charAt s (n - 1) == 10 then
    width = if n > 1 and charAt s (n - 2) == 13 then 2 else 1;
    substr s 0 (n - width)
  else s.
parseLine : unsafe String -> Result (Int, Action) String .
parseLine s =
  first = strIndexOf " " s;
  if first < 0 then Err "expected revision=N COMMAND" else
  case Text.field "revision=" (substr s 0 first) of
    Err why -> Err why
  | Ok revision -> tail = substr s (first + 1) (strlen s - first - 1);
      case parseAction tail of Err why -> Err why | Ok action -> Ok (revision, action).
parseAction "open" = Ok ShowOpen.
parseAction "cancel" = Ok CancelPrompt.
parseAction s = first = strIndexOf " " s;
  command = if first < 0 then s else substr s 0 first;
  query = if first < 0 then "" else substr s (first + 1) (strlen s - first - 1);
  case command of
    "save-as" -> Ok (ShowSaveAs query)
  | "find" -> Ok (ShowFind query)
  | "goto" -> Ok (ShowGoto query)
  | other -> Err "unknown Editor prompt command".

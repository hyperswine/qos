# One persistent I/O worker owned by one app model actor. Endpoint
# cleanup has its own budget; uncertain opens block further endpoint reads.
unsafe module.
AW = use "appwire".
EP = use "ep#c66ad65e68dd97f5".
ED = use "epdeadline".
ES = use "endpointstate".
AC = use "std/actor#201a0e9bf98a5154".
FS = use "std/fs#84826bc9e8ddb4b5".
AK = use "appkit".
run owner ns storage me =
  final = Sys.loop ES.Vacant (step owner ns storage me); ES.ended final.
step owner ns storage me state = case receiveFromRes me owner of
    Err why -> (closed, next) = ES.cleanup me state; (False, next)
  | Ok borrowed ->
      request = keep borrowed;
      _ = drop borrowed;
      (from, token, command) = request;
      case command of
        AW.Inspect -> (snapshot, next) = ES.inspect state; _ = AC.reply (from, token) snapshot; (True, next)
      | AW.Stop -> (closed, next) = ES.cleanup me state; _ = AC.reply (from, token) (AW.Stopped closed); (False, next)
      | AW.Read tag job ->
          (result, next) = execute me ns storage job state;
          _ = AC.reply (from, token) (AW.Completed tag result);
          (True, next).
execute : unsafe Int -> Int -> Int -> AW.Job -> ES.State -> (Result AW.Snapshot String, ES.State) .
execute me ns storage AW.Clock state = (Ok (AW.Time (Sys.mtime Unit / 10000000)), state).
execute me ns storage (AW.Logs sev) state =
  (Ok (AW.Lines (Sys.logSnap sev) "{Sys.logSeq sev} TOTAL"), state).
execute me ns storage AW.ListRoot state =
  result = EP.flat (AC.callWithin 500 me ns (EP.NsList "/"));
  (case result of Ok text -> Ok (AW.Lines (AK.lines text) "") | Err why -> Err why, state).
execute me ns storage AW.Disk state =
  result = FS.rpcWithin 500 me storage 5 "" "";
  (case result of Ok text -> Ok (AW.Lines (AK.lines text) "STORAGE STATS") | Err why -> Err why, state).
# the file namespaces: an append is open "write"/write/close, a replace the
# same with the "replace" mode (the file emptied at the open), a delete an
# open in the "delete" mode that the manager answers by removing the file
execute me ns storage (AW.AppendPath path text) state = writePath me ns path "write" text state.
execute me ns storage (AW.WritePath path text) state = writePath me ns path "replace" text state.
# a save that cannot lose the text: the safety copy, the file, the file read
# back and compared -- the copy goes only after that
execute me ns storage (AW.SaveFile path text) state =
  copy = strcat path ".~save";
  case writePath me ns copy "replace" text state of
    (Err why, s1) -> (Err "save {path}: the safety copy failed ({why}); the file is unchanged", s1)
  | (Ok u, s1) -> case writePath me ns path "replace" text s1 of
      (Err why, s2) -> (Err "save {path} failed ({why}); your text is safe in {copy}", s2)
    | (Ok u2, s2) -> case execute me ns storage (AW.ReadPath path) s2 of
        (Ok (AW.Text back), s3) -> if back == text then
            (removed, s4) = deletePath me ns copy s3;
            (Ok (AW.Done "saved {path} ({strlen text} bytes)"), s4)
          else (Err "save {path}: it read back differently; your text is safe in {copy}", s3)
      | (Ok other, s3) -> (Err "save {path}: it did not read back as text; your text is safe in {copy}", s3)
      | (Err why, s3) -> (Err "save {path}: could not read it back ({why}); your text is safe in {copy}", s3).
# the host compiler (tools/fprd.py through Sys.compile): this actor parks
# while the host's worker compiles, and holds no hart
execute me ns storage (AW.Compile profile src) state =
  (case Sys.compile profile src of Ok out -> Ok (AW.Text out) | Err why -> Err why, state).
execute me ns storage (AW.DeletePath path) state =
  case deletePath me ns path state of
    (Err why, next) -> (Err why, next)
  | (Ok u, next) -> (Ok (AW.Done "deleted {path}"), next).
execute me ns storage (AW.ReadPath path) state =
  (cleaned, ready) = ES.cleanup me state;
  case cleaned of
    Err why -> (Err why, ready)
  | Ok u -> ES.Vacant = ready; case AC.deadlineAfter 500 of
      Err why -> (Err why, ES.Vacant)
    | Ok deadline -> case openTracked deadline me ns path "read" of
        Err failure -> ES.failed failure
      | Ok ep ->
          result = ED.readUntil deadline me ep 0;
          (closed, next) = ES.cleanup me (ES.acquired ep);
          (case closed of
              Err why -> Err "{readError result}; {why}"
            | Ok u -> case result of
                Err why -> Err why
              | Ok (EP.IStr text) -> Ok (AW.Text text)
              | Ok other -> Err "endpoint did not return text", next).
readError (Ok value) = "read completed".
readError (Err why) = why.
writePath me ns path mode text state =
  (cleaned, ready) = ES.cleanup me state;
  case cleaned of
    Err why -> (Err why, ready)
  | Ok u -> ES.Vacant = ready; case AC.deadlineAfter 2000 of
      Err why -> (Err why, ES.Vacant)
    | Ok deadline -> case openTracked deadline me ns path mode of
        Err failure -> ES.failed failure
      | Ok ep ->
          result = ED.writeUntil deadline me ep (EP.IStr text);
          (closed, next) = ES.cleanup me (ES.acquired ep);
          (case closed of
              Err why -> Err "{readError result}; {why}"
            | Ok u -> case result of
                Err why -> Err why
              | Ok (EP.IInt n) -> Ok (AW.Done "wrote {n} bytes to {path}")
              | Ok other -> Ok (AW.Done "wrote to {path}"), next).
deletePath me ns path state =
  (cleaned, ready) = ES.cleanup me state;
  case cleaned of
    Err why -> (Err why, ready)
  | Ok u -> ES.Vacant = ready; case AC.deadlineAfter 1000 of
      Err why -> (Err why, ES.Vacant)
    | Ok deadline -> case openTracked deadline me ns path "delete" of
        Err failure -> ES.failed failure
      | Ok ep ->
          ES.cleanup me (ES.acquired ep).
# Explicit refusals prove no handle was granted. Transport timeouts cannot.
openTracked deadline me ns path mode = case AC.callUntil deadline me ns (EP.NsOpen path mode) of
    Err why -> Err (ES.Unconfirmed "namespace: {why}")
  | Ok (Err why) -> Err (ES.Refused why)
  | Ok (Ok (owner, id)) -> awaitTracked deadline me owner id.
awaitTracked deadline me owner id = case AC.awaitReplyUntil deadline me owner id of
    Err why -> Err (ES.Unconfirmed why)
  | Ok (EP.Refused why) -> Err (ES.Refused why)
  | Ok (EP.Opened handle) -> Ok (owner, handle)
  | Ok (EP.Redirect other) -> awaitTracked deadline me other id.

# ttp229.fpr -- the TTP229 16-key capacitive touch pad, 2-wire serial.
# Not a matrix: the chip scans itself; we pulse SCL and sample SDO
# after each falling edge, one bit per key, MSB-ordered key 1 first.
# Works identically in 8-key mode (keys 9-16 just never assert).
# `act` is the pressed level (0 on most boards in 16-key mode, some
# vendors ship active-high): flip ONE argument at bring-up if keys
# read inverted -- the parameter the sim test sweeps both ways.
init pinM scl sdo =
  _ = pinM scl 1;
  _ = pinM sdo 0;
  pinM scl 1.
# hold SCL high between reads (idle); >=2ms between reads on silicon
readMap pinW pinR scl sdo = rmGo pinW pinR scl sdo 0 0.
rmGo pinW pinR scl sdo i acc =
  case i >= 16 of
    True -> acc
  | False -> rmBit pinW pinR scl sdo i acc.
rmBit pinW pinR scl sdo i acc =
  _ = pinW scl 0;                  # falling edge: chip shifts next bit
  b = pinR sdo;
  _ = pinW scl 1;
  rmGo pinW pinR scl sdo (i + 1) (acc * 2 + b).
# first pressed key (1..16) at active level `act`, else 0
key pinW pinR scl sdo act = kFind (readMap pinW pinR scl sdo) act 1.
kFind m act k =
  case k > 16 of
    True -> 0
  | False -> kBit m act k.
kBit m act k =
  case bitAt m (16 - k) == act of
    True -> k
  | False -> kFind m act (k + 1).
bitAt m i = (m / pow2 i) - ((m / pow2 i) / 2) * 2.
pow2 i = case i <= 0 of True -> 1 | False -> 2 * pow2 (i - 1).

# maapp.fpr -- a Ma app on gen_view: the whole app is init/update/view,
# and the view is COMPONENT composition, not markup.  Server state
# (count, toast text, theme) rides Dyn slots and the model; client
# state (active tab, accordion sections, toast visibility) lives in
# locals and never round-trips.
#
# The main below is the MVU cycle run as a harness: it prints the full
# first paint (HTML + generated CSS) between MABEGIN/MAEND markers,
# then drives update with messages and prints what the wire would
# carry -- deltas for count/toast (same statics), a full re-render for
# the theme flip (statics change: the reshape path, exercised on
# purpose).
G  = use "./mods/genview".
Ma = use "./mods/ma".

M = {count : Int, toastN : Int, night : Int}.

init = {count = 0, toastN = 0, night = 0}.

update m msg arg = upd m msg arg.
upd m "bump" arg   = {count = m.count + arg, toastN = m.toastN, night = m.night}.
upd m "save" arg   = {count = m.count, toastN = m.toastN + 1, night = m.night}.
upd m "theme" arg  = {count = m.count, toastN = m.toastN, night = 1 - m.night}.
upd m msg arg = m.

themeCls m = case m.night == 1 of True -> "night" | False -> "day".
themeBtnLabel m = case m.night == 1 of True -> "day mode" | False -> "night mode".

view m =
  Ma.page (themeCls m)
    ( Ma.vstack 6
        ( header m
          :: Ma.navBar "tab" [Ma.navTab "tab" "1" "Overview", Ma.navTab "tab" "2" "Tokens", Ma.navTab "tab" "3" "About"]
          :: overview m
          :: tokensTab
          :: aboutTab
          :: Ma.toast "toast {m.toastN} -- saved"
          :: Nil )
      :: Nil ).

header m =
  Ma.hstack 4
    ( Ma.vstack 1 [Ma.display "Ma", Ma.caption "empty space as a first-class element"]
      :: Ma.spacer
      :: Ma.chip "gen_view native"
      :: Ma.button (themeBtnLabel m) "theme" "0"
      :: Nil ).

overview m =
  G.El "div" [G.ShowIf "tab:1"]
    ( Ma.vstack 5
        ( Ma.breadcrumb "ma" "demo" "overview"
          :: Ma.cardGrid
               ( counterCell m
                 :: Ma.gridCell [Ma.heading "Reserved roles", Ma.body "colors that keep their meaning", badges]
                 :: Ma.gridCell [Ma.heading "Toast", Ma.body "server text, client dismiss", Ma.buttonPrimary "save" "save" "0"]
                 :: Nil )
          :: Ma.accordion "acc1" "Why stacks only"
               ( Ma.body "gridAllowed is false in tokens.json. This card grid is a wrapping HStack of fixed-width cells."
                 :: Ma.meta "SPEC section 4 -- a hard constraint, not a default" :: Nil )
          :: Nil )
      :: Nil ).

counterCell m =
  Ma.gridCell
    ( Ma.heading "Counter"
      :: G.El "div" [G.Cls "t-display tx-1"] [G.Dyn "{m.count}"]
      :: Ma.hstack 2 [Ma.buttonPrimary "+1" "bump" "1", Ma.button "+10" "bump" "10"]
      :: Nil ).

badges =
  Ma.hstack 2
    ( Ma.badge "success" "saved" :: Ma.badge "warning" "unsaved" :: Ma.badge "danger" "delete" :: Ma.badge "celebration" "milestone" :: Nil ).

tokensTab =
  G.El "div" [G.ShowIf "tab:2"]
    ( Ma.card
        ( Ma.title "Type scale"
          :: Ma.display "Display 32" :: Ma.title "Title 22" :: Ma.heading "Heading 17"
          :: Ma.body "Body 15" :: Ma.caption "Caption 13" :: Ma.divider
          :: Ma.meta "radius 6/10/16, space 4..64, shadows sm/md/lg -- all from tokens.json" :: Nil )
      :: Nil ).

aboutTab =
  G.El "div" [G.ShowIf "tab:3"]
    ( Ma.card
        ( Ma.title "About"
          :: Ma.body "One tree. Statics fixed by shape, dynamics by the model, locals by the client."
          :: Ma.meta "theme flip = reshape (full re-render); count/toast = deltas" :: Nil )
      :: Nil ).

# ---- harness: the MVU cycle, observable --------------------------------------
main =
  m0 = init;
  (s0, d0) = G.render (view m0);
  css = Ma.maCssFor (view m0);
  _ = print "MABEGIN";
  _ = print "<!doctype html><html><head><meta charset='utf-8'><style>";
  _ = print css;
  _ = print "</style></head><body>";
  _ = print (pageOf s0 d0 0);
  _ = print "</body></html>";
  _ = print "MAEND";
  _ = print "ma: statics={List.len s0} dynamics={List.len d0}";
  m1 = update m0 "bump" 1;
  (s1, d1) = G.render (view m1);
  _ = print "ma: bump same-statics={G.sameStatics s0 s1} delta={G.deltaJson d0 d1}";
  m2 = update m1 "save" 0;
  (s2, d2) = G.render (view m2);
  _ = print "ma: save same-statics={G.sameStatics s1 s2} delta={G.deltaJson d1 d2}";
  m3 = update m2 "theme" 0;
  (s3, d3) = G.render (view m3);
  _ = print "ma: theme same-statics={G.sameStatics s2 s3} (reshape -> full re-render)";
  0 .

# interleave statics and dynamics: s0 d0 s1 d1 ... sn
pageOf : unsafe List String -> List a85 -> Int -> String .
pageOf [s] Nil i = s.
pageOf (s :: sr) (d :: dr) i = strcat s (strcat "<span data-slot=\"{i}\">{d}</span>" (pageOf sr dr (i + 1))).
pageOf ss ds i = "".

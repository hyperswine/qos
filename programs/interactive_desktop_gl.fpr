# interactive_desktop_gl.fpr -- a tiny FPR_DESKTOP_GL scene.
#
# Build on Apple Silicon:
#   make qos-app-macos PROG=programs/interactive_desktop_gl.fpr \
#     QA_OUT=interactive_desktop_gl.qa
# Seed a dedicated QLOG disk image:
#   python3 tools/mkdisk.py ../qos/interactive_desktop_gl.disk 8 \
#     interactive_desktop_gl.qa
# Run under QOS Portable from the qos directory:
#   FPR_DISK=interactive_desktop_gl.disk ./qosp-gl --yes \
#     ../interactive_desktop_gl.qa
#
# W/A/S/D move the blue sphere. Q or Escape exits.

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).

keyW = 1.
keyA = 2.
keyS = 4.
keyD = 8.
keyQuit = 16.

hasKey keys bit = band keys bit != 0.

keyDown keys bit | hasKey keys bit = keys.
keyDown keys bit = keys + bit.

keyUp keys bit | hasKey keys bit = keys - bit.
keyUp keys bit = keys.

keyBit 17 = keyW.
keyBit 30 = keyA.
keyBit 31 = keyS.
keyBit 32 = keyD.
keyBit code = 0.

applyKey keys 16 1 = keyDown keys keyQuit.
applyKey keys 1 1 = keyDown keys keyQuit.
applyKey keys code 1 = keyDown keys (keyBit code).
applyKey keys code 0 = keyUp keys (keyBit code).
applyKey keys code value = keys.

pollKeys : unsafe Int -> Int -> Int .
pollKeys keys 0 = keys.
pollKeys keys n = pollEvent keys n (inputPoll 0).

pollEvent : unsafe Int -> Int -> (Int, Int, Int) -> Int .
pollEvent keys n ev =
  (kind, code, value) = ev;
  _ = drop ev;
  pollDecoded keys n kind code value.

pollDecoded : unsafe Int -> Int -> Int -> Int -> Int -> Int .
pollDecoded keys n 0 code value = keys.
pollDecoded keys n 4 code value = pollKeys (applyKey keys code value) (n - 1).
pollDecoded keys n kind code value = pollKeys keys (n - 1).

clamp lo hi value | value < lo = lo.
clamp lo hi value | value > hi = hi.
clamp lo hi value = value.

axis positive negative keys = isDown positive keys - isDown negative keys.
isDown bit keys | hasKey keys bit = 1.
isDown bit keys = 0.

move x z keys =
  dx = axis keyD keyA keys;
  dz = axis keyS keyW keys;
  (clamp (0 - 3000) 3000 (x + dx * 55),
   clamp (0 - 3000) 3000 (z + dz * 55)).

ground =
  Ent "plane" (0, 0, 0) 0 (8000, 1000, 8000) (180, 240, 220) ::
  Ent "cube" (0 - 3200, 250, 0 - 3200) 0 (500, 500, 500) (900, 400, 220) ::
  Ent "cube" (3200, 400, 0 - 3200) 0 (600, 800, 600) (950, 700, 180) ::
  Ent "cube" (0 - 3200, 600, 3200) 0 (700, 1200, 700) (300, 780, 420) ::
  Ent "cube" (3200, 300, 3200) 0 (900, 600, 900) (820, 300, 300) :: Nil.

player x z =
  Ent "sphere" (x, 500, z) 0 (850, 1000, 850) (160, 620, 1000) ::
  Ent "sphere" (x, 1050, z) 0 (430, 430, 430) (850, 940, 1000) :: Nil.

lights = ((4500, 9000, 5000), (1000, 1000, 1000)) :: Nil.
camera = ((7000, 8000, 9000), (0, 0, 0), 800).

renderFrame x z =
  scene = Scene ground (player x z) lights camera;
  result = glRender scene;
  _ = drop result;
  drop scene.

Frame = Type (Frame x z keys).

frameWorker : unsafe Int -> Int -> Unit .
frameWorker parent self =
  message = receiveFrom self parent;
  Frame x z keys = message;
  _ = drop message;
  nextKeys = pollKeys keys 32;
  (nextX, nextZ) = move x z nextKeys;
  _ = renderFrame nextX nextZ;
  reply = Frame nextX nextZ nextKeys;
  _ = send parent reply;
  _ = drop reply;
  _ = Sys.poolReset 0;
  frameWorker parent self.

run : unsafe Int -> Int -> Int -> Int -> Int -> String .
run me worker x z keys =
  request = Frame x z keys;
  _ = send worker request;
  _ = drop request;
  message = receiveFrom me worker;
  Frame nextX nextZ nextKeys = message;
  _ = drop message;
  nextFrame me worker nextX nextZ nextKeys.

nextFrame : unsafe Int -> Int -> Int -> Int -> Int -> String .
nextFrame me worker x z keys | hasKey keys keyQuit =
  "interactive_desktop_gl: stopped at ({x}, {z})".
nextFrame me worker x z keys =
  _ = Sys.sleepUs 16000;
  _ = Sys.poolReset 0;
  run me worker x z keys.

main =
  disk = device "blk";
  _ = blkPages disk;
  _ = glInit 960 640;
  me = myself 0;
  worker = spawn (frameWorker me);
  run me worker 0 0 0.
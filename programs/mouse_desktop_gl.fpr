# mouse_desktop_gl.fpr -- a tiny FPR_DESKTOP_GL scene.
#
# Build on Apple Silicon:
#   make qos-app-macos PROG=programs/mouse_desktop_gl.fpr \
#     QA_OUT=mouse_desktop_gl.qa
# Seed a dedicated QLOG disk image:
#   python3 tools/mkdisk.py ../qos/mouse_desktop_gl.disk 8 \
#     mouse_desktop_gl.qa
# Run under QOS Portable from the qos directory:
#   FPR_DISK=mouse_desktop_gl.disk ./qosp-gl --yes \
#     ../mouse_desktop_gl.qa
#
# W/A/S/D move the blue sphere. Hold LMB and drag to orbit the scene.
# Q or Escape exits. Pitch is clamped to keep the camera above the ground.
#: host gl

Gfx = Type (Scene statics dynamics lights camera
          | Ent mesh pos yaw scale color).

keyW = 1.
keyA = 2.
keyS = 4.
keyD = 8.
keyQuit = 16.

hasKey keys bit = band keys bit != 0.

keyDown keys bit | hasKey keys bit = keys.
keyDown keys bit = keys + bit.

keyUp keys bit | hasKey keys bit = keys - bit.
keyUp keys bit = keys.

keyBit 17 = keyW.
keyBit 30 = keyA.
keyBit 31 = keyS.
keyBit 32 = keyD.
keyBit code = 0.

applyKey keys 16 1 = keyDown keys keyQuit.
applyKey keys 1 1 = keyDown keys keyQuit.
applyKey keys code 1 = keyDown keys (keyBit code).
applyKey keys code 0 = keyUp keys (keyBit code).
applyKey keys code value = keys.

# Input kind 2 = relative motion (positive y is UP); kind 3 = button mask.
# Preserve event order so a press/move/release in one frame still drags.
Input = Type (Input keys buttons yaw pitch).

pollInput : unsafe Input -> Int -> Input .
pollInput state 0 = state.
pollInput state n = pollEvent state n (inputPoll 0).

pollEvent : unsafe Input -> Int -> (Int, Int, Int) -> Input .
pollEvent state n ev =
  (kind, code, value) = ev;
  _ = drop ev;
  pollDecoded state n kind code value.

pollDecoded : unsafe Input -> Int -> Int -> Int -> Int -> Input .
pollDecoded state n 0 code value = state.
pollDecoded (Input keys buttons yaw pitch) n 4 code value =
  pollInput (Input (applyKey keys code value) buttons yaw pitch) (n - 1).
pollDecoded (Input keys buttons yaw pitch) n 3 buttonsNow value =
  pollInput (Input keys buttonsNow yaw pitch) (n - 1).
pollDecoded (Input keys buttons yaw pitch) n 2 dx dy =
  case hasKey buttons 1 of
    True -> pollInput (Input keys buttons (wrapAngle (yaw - dx * 5))
                        (clamp 100 1450 (pitch + dy * 5))) (n - 1)
  | False -> pollInput (Input keys buttons yaw pitch) (n - 1).
pollDecoded state n kind code value = pollInput state (n - 1).

wrapAngle x = ((x % 6283) + 6283) % 6283.
# Integer trig in milli-radians, following terra2.fpr's Bhaskara approximation.
sinHalf r = 16 * r * (3142 - r) * 1000 / (5 * 3142 * 3142 - 4 * r * (3142 - r)).
sinM x =
  r = wrapAngle x;
  case r > 3142 of
    True -> 0 - sinHalf (r - 3142)
  | False -> sinHalf r.
cosM x = sinM (x + 1571).

clamp lo hi value | value < lo = lo.
clamp lo hi value | value > hi = hi.
clamp lo hi value = value.

axis positive negative keys = isDown positive keys - isDown negative keys.
isDown bit keys | hasKey keys bit = 1.
isDown bit keys = 0.

move x z keys =
  dx = axis keyD keyA keys;
  dz = axis keyS keyW keys;
  (clamp (0 - 3000) 3000 (x + dx * 55),
   clamp (0 - 3000) 3000 (z + dz * 55)).

ground =
  Ent "plane" (0, 0, 0) 0 (8000, 1000, 8000) (180, 240, 220) ::
  Ent "cube" (0 - 3200, 250, 0 - 3200) 0 (500, 500, 500) (900, 400, 220) ::
  Ent "cube" (3200, 400, 0 - 3200) 0 (600, 800, 600) (950, 700, 180) ::
  Ent "cube" (0 - 3200, 600, 3200) 0 (700, 1200, 700) (300, 780, 420) ::
  Ent "cube" (3200, 300, 3200) 0 (900, 600, 900) (820, 300, 300) :: Nil.

player x z =
  Ent "sphere" (x, 500, z) 0 (850, 1000, 850) (160, 620, 1000) ::
  Ent "sphere" (x, 1050, z) 0 (430, 430, 430) (850, 940, 1000) :: Nil.

lights = ((4500, 9000, 5000), (1000, 1000, 1000)) :: Nil.
camera yaw pitch =
  radius = 14000;
  horizontal = radius * cosM pitch / 1000;
  ((horizontal * sinM yaw / 1000, radius * sinM pitch / 1000,
    horizontal * cosM yaw / 1000), (0, 0, 0), 800).

renderFrame x z yaw pitch =
  scene = Scene ground (player x z) lights (camera yaw pitch);
  result = glRender scene;
  _ = drop result;
  drop scene.

Frame = Type (Frame x z keys buttons yaw pitch).

frameWorker : unsafe Int -> Int -> Unit .
frameWorker parent self =
  message = receiveFrom self parent;
  Frame x z keys buttons yaw pitch = message;
  _ = drop message;
  Input nextKeys nextButtons nextYaw nextPitch =
    pollInput (Input keys buttons yaw pitch) 64;
  (nextX, nextZ) = move x z nextKeys;
  _ = renderFrame nextX nextZ nextYaw nextPitch;
  reply = Frame nextX nextZ nextKeys nextButtons nextYaw nextPitch;
  _ = send parent reply;
  _ = drop reply;
  _ = Sys.poolReset 0;
  frameWorker parent self.

run : unsafe Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> String .
run me worker x z keys buttons yaw pitch =
  request = Frame x z keys buttons yaw pitch;
  _ = send worker request;
  _ = drop request;
  message = receiveFrom me worker;
  Frame nextX nextZ nextKeys nextButtons nextYaw nextPitch = message;
  _ = drop message;
  nextFrame me worker nextX nextZ nextKeys nextButtons nextYaw nextPitch.

nextFrame : unsafe Int -> Int -> Int -> Int -> Int -> Int -> Int -> Int -> String .
nextFrame me worker x z keys buttons yaw pitch | hasKey keys keyQuit =
  "mouse_desktop_gl: stopped at ({x}, {z})".
nextFrame me worker x z keys buttons yaw pitch =
  _ = Sys.sleepUs 16000;
  _ = Sys.poolReset 0;
  run me worker x z keys buttons yaw pitch.

main =
  disk = device "blk";
  _ = blkPages disk;
  _ = glInit 960 640;
  me = myself 0;
  worker = spawn (frameWorker me);
  run me worker 0 0 0 0 660 610.

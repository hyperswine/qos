# liveboard.fpr -- a LIVE app on a plain posix process: FP-RISC + ExtBase hosting
# a real GUI the FPRLive way (../fprisc/docs/2026-09-20-LIVE.md, docs/2026-09-02-FPRLIVE.md).
#
#   ../fprisc/fpr run programs/liveboard.fpr [--port=8080] [--store=board.kvlog] [--dev]
#
# One shared board; every browser tab is a session (two actors) that renders
# its OWN view of the one model.  What this file shows, top to bottom:
#
#   std/ui        stacks, cards, text roles, buttons: every screen is primitives
#   statics/dyn   G.Dyn values are the only thing that moves on the wire
#   messages      `Msg` is a type; the view sends VALUES of it, `update` matches on
#                 them, and the codec that carries them is minted from the type
#   client state  the active tab and the draft text live in the BROWSER: a record,
#                 its fields named by paths and typed (a typo or a wrong value
#                 is a compile error; the tab is a value of its own type)
#   fields        `count` and `notes` are durable, each named by a path and with
#                 its own policy; `seconds` and `visitors` are not, on purpose
#   Cmd / Sub     a slow job runs in its own actor and comes back as an event;
#                 a toast clears itself; the clock ticks only while it is on
#   replay        every event is journaled: `--replay` rebuilds the model from
#                 the log alone and checks it against the durable fields
#   reload        --dev: edit this file, the server rebuilds and becomes the new
#                 program, the browser reconnects, the board is still there
unsafe base.

Live = use "std/live".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Digest = use "std/digest".
Encoding = use "std/encoding".
KvLog = use "std/kvlog".
Program = use "std/program".
List = use "std/list".
String = use "std/string".
Option = use "std/option".
Result = use "std/result".
G = use "std/view".
UI = use "std/ui".
LJ = use "std/livejs".

# ---- the model, the messages, the client's state: three declarations --------------------------
# a note remembers which session wrote it: a durable field that is a LIST OF RECORDS,
# with no encoder written for it (the path literal carries one)
Note = {text : String, by : Int}.
Model = {count : Int, notes : List Note, visitors : Int, seconds : Int, running : Bool, toast : String, job : String}.

init = {count = 0, notes = Nil, visitors = 0, seconds = 0, running = False, toast = "", job = ""}.

# every message the app understands.  `codec` is minted from this declaration
# (the compiler's @Type literal): it is how a Msg crosses the page and the log.
Msg = Type (Bump Int | Add String | Clear | Clock | Second | ClearToast | Hash | Digested String | Mem | MemIs String | Stop
           | Fetch String | Fetched String | Home | Ping | Uploaded String).
codec = @Msg.

# WHAT LIVES IN THE BROWSER: a record too, never sent unless a message carries it
Tab = Type (Board | Notes | Jobs).
Client = {tab : Tab, draft : String}.
client = {tab = Board, draft = ""}.

# WHAT IS DURABLE, field by field, each named by a PATH (a field that does not
# exist is a compile error) and each with its own policy.  The counter is written
# on every change; the notes at most once a second (a burst of edits is one
# write).  Everything else is deliberately not here.
fields =
     Live.field Live.Always @Model.count
  :: Live.field (Live.AtMostEvery 1000) @Model.notes
  :: Nil.

# ---- update: a pure function of the event ---------------------------------------------------
update ev m = case ev of
    Live.Joined _ -> ({m | visitors = m.visitors + 1}, Nil)
  | Live.Left _ -> ({m | visitors = m.visitors - 1}, Nil)
  | Live.Refused _ _ -> (m, Nil)
  | Live.Msg sid msg -> (case msg of
        Bump n -> ({m | count = m.count + n}, Nil)
      | Add text -> (if strlen (String.trim text) == 0 then (m, Nil)
                     else ({m | notes = List.append m.notes ({text = String.trim text, by = sid} :: Nil), toast = "note added"}, Live.After 2000 ClearToast :: Nil))
      | Clear -> ({m | notes = Nil}, Nil)
      | Clock -> ({m | running = not m.running}, Nil)
      | Second -> ({m | seconds = m.seconds + 1}, Nil)
      | ClearToast -> ({m | toast = ""}, Nil)
      | Hash -> ({m | toast = "working..."}, Live.Run (fn u -> Digested (Digest.sha256 (String.join "\n" (List.map (fn n -> n.text) m.notes)))) :: Nil)
      | Digested hex -> ({m | toast = "digest ready", job = hex}, Live.After 2000 ClearToast :: Nil)
      | Mem -> (m, Live.Run (fn u -> MemIs (case Sys.memInfo 0 of arena :: free :: _ -> "heap in use {(arena - free) / 1024} MiB" | _ -> "?")) :: Nil)
      | MemIs text -> ({m | toast = text}, Nil)
      | Stop -> (m, Live.Quit :: Nil)
      # the rest of the commands: an HTTP request whose reply is a message, sending
      # THIS session's browser somewhere, an event for the page's own script, a file
      | Fetch url -> ({m | toast = "fetching..."}, Live.http {method = "GET", url = url, headers = Nil, body = ""}
            (fn r -> Fetched (case r of Ok resp -> "{resp.status}: {strlen resp.body} bytes" | Err why -> "failed: {why}")) :: Nil)
      | Fetched what -> ({m | toast = what}, Nil)
      | Home -> (m, Live.Navigate sid "/" :: Nil)
      | Ping -> (m, Live.Emit 0 "ping" "from session {sid}" :: Nil)
      | Uploaded file -> ({m | toast = uploadInfo file}, Nil)).

uploadInfo file = case String.indexOf ":" file of
    Option.None -> "not a file"
  | Option.Some at -> (case Encoding.fromBase64 (String.dropLeft (at + 1) file) of
        Ok bytes -> "{String.left at file}: {strlen bytes} bytes, sha256 {String.left 12 (Digest.sha256 bytes)}"
      | Err why -> "bad upload: {why}").

# the clock is a SUBSCRIPTION: it exists only while the model says so
subs m = if m.running then Live.Every 1000 Second :: Nil else Nil.

# ---- view: std/ui primitives only ---------------------------------------------------------
view sid m =
  UI.pageWith UI.day { UI.stack | gap = 6, pad = 5 } (G.locals @Client client)
    [ UI.hstack { UI.stack | gap = 4, align = UI.Center, wrap = True }
        [ UI.vstack { UI.stack | gap = 1, fill = UI.Grow } [UI.label title "Live board", UI.label caption "one model, many screens"]
        , UI.badge UI.Muted "session {sid}"
        , UI.status UI.Muted Nil "{m.visitors} online" ]
    , UI.hstack { UI.stack | gap = 2 } [tab Board "Board", tab Notes "Notes", tab Jobs "Jobs"]
    , UI.hstackWith { UI.stack | gap = 4, wrap = True } [G.showIf @Client.tab Board]
        [ UI.card UI.panel
            [ UI.label heading "Shared counter", UI.text big "{m.count}"
            , UI.hstack { UI.stack | gap = 2 } [btn "+1" (Bump 1), btn "+10" (Bump 10)]
            , UI.label caption "durable: written on every change" ]
        , UI.card UI.panel
            [ UI.label heading "Clock", UI.text big "{m.seconds} s"
            , btn (if m.running then "stop" else "start") Clock
            , UI.label caption "a subscription: ticks only while on" ] ]
    , UI.vstackWith UI.stack [G.showIf @Client.tab Notes]
        [ UI.card UI.panel
            [ UI.label heading "Notes"
            , UI.hstack { UI.stack | gap = 2, align = UI.Center }
                [ UI.input { UI.field | fill = UI.Grow, placeholder = "write a note, press enter" } [G.bind @Client.draft, G.enterWith codec Add @Client.draft]
                , UI.button { UI.btn | kind = UI.Primary } [G.sendWith codec Add @Client.draft] "add"
                , btn "clear" Clear ]
            , UI.text UI.txt (if List.isEmpty m.notes then "nothing yet" else String.join " | " (List.map (fn n -> "{n.text} (s{n.by})") m.notes))
            , UI.label caption "durable: at most one write a second" ] ]
    , UI.vstackWith UI.stack [G.showIf @Client.tab Jobs]
        [ UI.card UI.panel
            [ UI.label heading "A slow job, off the register"
            , btn "digest the notes" Hash
            , UI.hstack { UI.stack | gap = 2, align = UI.Center, wrap = True } [btn "go home" Home, btn "ping the page" Ping, G.Inp [G.uploadWith codec (Uploaded "")]]
            , UI.text caption (if strlen m.job == 0 then "no digest yet" else m.job)
            , UI.label caption "a command: runs in its own actor, returns as a message" ] ]
    , UI.text caption m.toast ].

title = { UI.txt | size = UI.Title }.
heading = { UI.txt | size = UI.Heading }.
big = { UI.txt | size = UI.Hero, tabular = True }.
caption = { UI.txt | size = UI.Caption, tone = UI.Muted }.

# a button that sends a MESSAGE (a value of Msg, not its name)
btn : String -> Msg -> G.Node .
btn label msg = UI.button UI.btn [G.send codec msg] label.
# a tab is client state: shown by it, set by it, no server involved
tab t label = UI.button { UI.btn | kind = UI.Pill, vary = [UI.onState @Client.tab t [UI.Inverted]] } [G.setTo @Client.tab t] label.

app = { init = init, update = update, subs = subs, fields = fields, codec = codec,
        view = (fn sid m -> G.renderStyled (view sid m)), css = (fn m -> UI.css (view 0 m)) }.

# ---- settings, replay, main --------------------------------------------------------------------
Settings = Type (Settings port store dev replay).
settings = Decode.map4 Settings (Decode.field "port" Decode.int) (Decode.field "store" Decode.string)
  (Decode.field "dev" Decode.bool) (Decode.field "replay" Decode.bool).

# rebuild the model from the journal ALONE and compare its durable parts with what was saved
checkReplay store = case Live.replay app store of
    Err why -> Program.fail 1 "replay: {why}"
  | Ok m ->
      db = (case KvLog.open store of Ok d -> d | Err why -> Program.fail 1 why);
      savedCount = Option.andThen Json.asInt (KvLog.get "model.count" db);
      _ = print "replayed from the journal: count={m.count} notes={m.notes}";
      _ = print "saved durable fields:      count={savedCount}";
      (if Option.Some m.count == savedCount then 0 else 1).

main = case Config.load { defaults = Json.object (("port", Json.Integer 8080) :: ("store", Json.Text "board.kvlog") :: ("dev", Json.Boolean False) :: ("replay", Json.Boolean False) :: Nil),
                          file = Option.None, envPrefix = "BOARD_", args = Program.args Unit } |> Result.andThen (Decode.run settings) of
    Err why -> Program.fail 2 "liveboard: {why}"
  | Ok (Settings port store dev replay) ->
      (if replay then checkReplay store
       else
         exe = "/tmp/liveboard-{port}.bin";
         src = "programs/liveboard.fpr";
         cfg = { address = "127.0.0.1", port = port, title = "Live board", store = store, journal = True, script = LJ.src 0,
                 watch = (if dev then src :: Nil else Nil),
                 # the compiler that built this one ($FPR_HOME/fpr), unless FPR names another
                 rebuild = Program.envOr "{Program.envOr "../fprisc" "FPR_HOME"}/fpr" "FPR" :: "build" :: src :: "-o" :: exe :: Nil,
                 restart = exe :: "--port={port}" :: "--store={store}" :: "--dev" :: Nil };
         _ = Live.serve cfg app;
         0).

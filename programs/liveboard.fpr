# liveboard.fpr -- a LIVE app on a plain posix process: FP-RISC + ExtBase hosting
# a real GUI the FPRLive way (../fprisc/docs/LIVE.md, docs/FPRLIVE.md).
#
#   ../fprisc/fpr run programs/liveboard.fpr [--port=8080] [--store=board.kvlog] [--dev]
#
# One shared board; every browser tab is a session (two actors) that renders
# its OWN view of the one model.  What this file shows, top to bottom:
#
#   Ma            stacks, spacers, cards, text roles: every screen is primitives
#   statics/dyn   G.Dyn values are the only thing that moves on the wire
#   client state  the active tab and the draft text live in the BROWSER
#                 (declared once, below, the way durable fields are)
#   fields        `count` and `notes` are durable, each with its own policy;
#                 `seconds` and `visitors` are not, on purpose
#   Cmd / Sub     a slow job runs in its own actor and comes back as an event;
#                 a toast clears itself; the clock ticks only while it is on
#   replay        every event is journaled: `--replay` rebuilds the model from
#                 the log alone and checks it against the durable fields
#   reload        --dev: edit this file, the server rebuilds and becomes the new
#                 program, the browser reconnects, the board is still there
unsafe base.

Live = use "std/live".
Config = use "std/config".
Decode = use "std/decode".
Json = use "std/json".
Digest = use "std/digest".
KvLog = use "std/kvlog".
Program = use "std/program".
List = use "std/list".
String = use "std/string".
Option = use "std/option".
Result = use "std/result".
G = use "std/view".
Ma = use "std/ma".
LJ = use "std/livejs".

# ---- the model -----------------------------------------------------------------------
Model = Type (Model count notes visitors seconds running toast job).

init = Model 0 Nil 0 0 False "" "".

count m = case m of Model c _ _ _ _ _ _ -> c.
notes m = case m of Model _ n _ _ _ _ _ -> n.

# WHAT IS DURABLE, field by field, each with its own policy.  The counter is
# written on every change; the notes at most once a second (a burst of edits is
# one write).  Everything else is deliberately not here.
fields =
     Live.intField "board/count" Live.Always count (fn c m -> case m of Model _ n v s r t j -> Model c n v s r t j)
  :: Live.stringsField "board/notes" (Live.AtMostEvery 1000) notes (fn n m -> case m of Model c _ v s r t j -> Model c n v s r t j)
  :: Nil.

# WHAT LIVES IN THE BROWSER: declared the same way, never sent unless an event
# carries it.  (name, initial value)
clientState = ("tab", "1") :: ("draft", "") :: Nil.

# ---- update: a pure function of the event ---------------------------------------------------
update ev m = case m of Model c n v s r t j ->
  (case ev of
      Live.Joined _ -> (Model c n (v + 1) s r t j, Nil)
    | Live.Left _ -> (Model c n (v - 1) s r t j, Nil)
    | Live.Tick _ -> (Model c n v (s + 1) r t j, Nil)
    | Live.Done "digest" result -> (Model c n v s r "digest ready" result, Live.After 2000 "clearToast" "" :: Nil)
    | Live.Done "mem" result -> (Model c n v s r result j, Nil)
    | Live.Done _ _ -> (m, Nil)
    | Live.Msg _ name arg -> (case name of
          "bump" -> (Model (c + Result.withDefault 0 (String.toInt arg)) n v s r t j, Nil)
        | "add" -> (if strlen (String.trim arg) == 0 then (m, Nil)
                    else (Model c (List.append n (String.trim arg :: Nil)) v s r "note added" j, Live.After 2000 "clearToast" "" :: Nil))
        | "clear" -> (Model c Nil v s r t j, Nil)
        | "clock" -> (Model c n v s (not r) t j, Nil)
        | "clearToast" -> (Model c n v s r "" j, Nil)
        | "digest" -> (Model c n v s r "working..." j, Live.Run "digest" (fn u -> Digest.sha256 (String.join "\n" n)) :: Nil)
        | "mem" -> (m, Live.Run "mem" (fn u -> case Sys.memInfo 0 of arena :: free :: _ -> "heap in use {(arena - free) / 1024} MiB" | _ -> "?") :: Nil)
        | "quit" -> (m, Live.Quit :: Nil)
        | _ -> (m, Nil))).

# the clock is a SUBSCRIPTION: it exists only while the model says so
subs m = case m of Model _ _ _ _ running _ _ -> (if running then Live.Every 1000 "second" :: Nil else Nil).

# ---- view: Ma primitives only ---------------------------------------------------------------
view sid m = case m of Model c n v s r t j ->
  Ma.page "day"
    ( G.El "div" (List.map (fn kv -> case kv of (k, init0) -> G.Local k init0) clientState)
        ( Ma.vstack 6
            ( Ma.hstack 4
                ( Ma.vstack 1 [Ma.display "Live board", Ma.caption "one model, many screens"]
                  :: Ma.spacer
                  :: Ma.chip "session {sid}"
                  :: G.El "span" [G.Cls "chip t-label"] [G.Dyn "{v} online"]
                  :: Nil )
              :: Ma.navBar "tab" [Ma.navTab "tab" "1" "Board", Ma.navTab "tab" "2" "Notes", Ma.navTab "tab" "3" "Jobs"]
              :: G.El "div" [G.ShowIf "tab:1"]
                   ( Ma.cardGrid
                       ( Ma.gridCell
                           ( Ma.heading "Shared counter" :: G.El "div" [G.Cls "t-display tx-1"] [G.Dyn "{c}"]
                             :: Ma.hstack 2 [sendBtn "+1" "bump" "1", sendBtn "+10" "bump" "10"] :: Ma.meta "durable: written on every change" :: Nil )
                         :: Ma.gridCell
                           ( Ma.heading "Clock" :: G.El "div" [G.Cls "t-display tx-1"] [G.Dyn "{s} s"]
                             :: sendBtn (if r then "stop" else "start") "clock" "" :: Ma.meta "a subscription: ticks only while on" :: Nil )
                         :: Nil ) :: Nil )
              :: G.El "div" [G.ShowIf "tab:2"]
                   ( Ma.card
                       ( Ma.heading "Notes"
                         :: Ma.hstack 2
                              ( G.Inp [G.Cls "inp t-body grow", G.Input "draft", G.OnEnter "add" "draft", G.Att "placeholder" "write a note, press enter"]
                                :: G.El "button" [G.Cls "btn btn-primary t-label", G.OnClick "add" "draft"] [G.Txt "add"]
                                :: sendBtn "clear" "clear" "" :: Nil )
                         :: G.El "div" [G.Cls "t-body tx-1"] [G.Dyn (if List.isEmpty n then "nothing yet" else String.join " | " n)]
                         :: Ma.meta "durable: at most one write a second" :: Nil ) :: Nil )
              :: G.El "div" [G.ShowIf "tab:3"]
                   ( Ma.card
                       ( Ma.heading "A slow job, off the register"
                         :: sendBtn "digest the notes" "digest" ""
                         :: G.El "div" [G.Cls "t-caption tx-2"] [G.Dyn (if strlen j == 0 then "no digest yet" else j)]
                         :: Ma.meta "a command: runs in its own actor, returns as an event" :: Nil ) :: Nil )
              :: G.El "div" [G.Cls "t-caption tx-3"] [G.Dyn t]
              :: Nil )
          :: Nil )
      :: Nil ).

sendBtn label msg lit = G.El "button" [G.Cls "btn t-label", G.OnSend msg lit] [G.Txt label].

app = { init = init, update = update, subs = subs, fields = fields,
        view = (fn sid m -> G.render (view sid m)), css = (fn m -> Ma.maCssFor (view 0 m)) }.

# ---- settings, replay, main --------------------------------------------------------------------
Settings = Type (Settings port store dev replay).
settings = Decode.map4 Settings (Decode.field "port" Decode.int) (Decode.field "store" Decode.string)
  (Decode.field "dev" Decode.bool) (Decode.field "replay" Decode.bool).

# rebuild the model from the journal ALONE and compare its durable parts with what was saved
checkReplay store = case Live.replay app store of
    Err why -> Program.fail 1 "replay: {why}"
  | Ok m ->
      db = (case KvLog.open store of Ok d -> d | Err why -> Program.fail 1 why);
      savedCount = Option.andThen Json.asInt (KvLog.get "board/count" db);
      _ = print "replayed from the journal: count={count m} notes={notes m}";
      _ = print "saved durable fields:      count={savedCount}";
      (if Option.Some (count m) == savedCount then 0 else 1).

main = case Config.load { defaults = Json.object (("port", Json.Integer 8080) :: ("store", Json.Text "board.kvlog") :: ("dev", Json.Boolean False) :: ("replay", Json.Boolean False) :: Nil),
                          file = Option.None, envPrefix = "BOARD_", args = Program.args Unit } |> Result.andThen (Decode.run settings) of
    Err why -> Program.fail 2 "liveboard: {why}"
  | Ok (Settings port store dev replay) ->
      (if replay then checkReplay store
       else
         exe = "/tmp/liveboard-{port}.bin";
         src = "programs/liveboard.fpr";
         cfg = { address = "127.0.0.1", port = port, title = "Live board", store = store, journal = True, script = LJ.src 0,
                 watch = (if dev then src :: "programs/mods/ma.fpr" :: Nil else Nil),
                 rebuild = Program.envOr "../fprisc/fpr" "FPR" :: "build" :: src :: "-o" :: exe :: Nil,
                 restart = exe :: "--port={port}" :: "--store={store}" :: "--dev" :: Nil };
         _ = Live.serve cfg app;
         0).

# Public desktop API v2. Wire conversion stays in the generated adapter.
# Storage is bound by Main to the installed manifest ID, independent of app
# version/source filename. Cooperative native plugins are not isolated.
AW = use "programs/mods/appwire".
S = use "programs/mods/scene2d".
Event = Type (Key Int | Tick | Resize Int Int | Pointer Int Int Int | Wheel Int Int | Focus Bool | Cancel | Arrived Int (Result Snapshot String)).
Job = Type (Clock | Read String | Write String String | Remove String).
Snapshot = Type (Time Int | Missing | Value String | Saved | Removed).
Cmd = Type (Fetch Int Job).
text viewport title subtitle rows =
  (w, h) = viewport;
  S.Box [S.Col, S.W w, S.H h, S.Pad 20, S.Gap 14, S.Bg (18, 30, 60), S.Clip]
    (label 28 title :: label 16 subtitle :: labels rows).
label size text = S.Lbl [S.Fs size, S.Fg (940, 950, 990)] text.
labels Nil = Nil.
labels (row :: rest) = label 20 row :: labels rest.
fromWire (AW.Key k) = Key k.
fromWire AW.Tick = Tick.
fromWire (AW.Resize w h) = Resize w h.
fromWire (AW.Pointer x y buttons) = Pointer x y buttons.
fromWire (AW.Wheel x y) = Wheel x y.
fromWire (AW.Focus active) = Focus active.
fromWire AW.Cancel = Cancel.
fromWire (AW.Arrived token result) = Arrived token (case result of
    Ok (AW.Time seconds) -> Ok (Time seconds)
  | Ok AW.StoreMissing -> Ok Missing
  | Ok (AW.StoreValue text) -> Ok (Value text)
  | Ok AW.StoreSaved -> Ok Saved
  | Ok AW.StoreRemoved -> Ok Removed
  | Err why -> Err why
  | other -> Err "unsupported desktop SDK result").
commands Nil = Nil.
commands (Fetch token Clock :: rest) = AW.Fetch token AW.Clock :: commands rest.
commands (Fetch token (Read key) :: rest) = AW.Fetch token (AW.StoreRead key) :: commands rest.
commands (Fetch token (Write key text) :: rest) = AW.Fetch token (AW.StoreWrite key text) :: commands rest.
commands (Fetch token (Remove key) :: rest) = AW.Fetch token (AW.StoreRemove key) :: commands rest.

# Namespace adapter over the system-owned block protocol, with no Device handle.
# Explicit grants authorize raw pages; no application gets such a grant by default.
# Lifecycle administration stays with the direct protocol's creator.
EP = use "ep#f5a7c81840106100".
AC = use "std/actor#06e72a5feec8a6d4".
B = use "std/blockio#1326ddf2a0e4841e".
serve : unsafe Int -> Int -> a .
Handle = Type (Handle Int String Int String).
serve block me = loop block Nil me.
loop : unsafe Int -> List Handle -> Int -> a .
loop block handles me =
  borrowed = receive me;
  (from, id, q) = keep borrowed;
  _ = drop borrowed;
  next = step block handles me from id q;
  fresh = AC.boundary me (block, next);
  again fresh me.
again : unsafe (Int, List Handle) -> Int -> a .
again state me = (block, handles) = state; loop block handles me.
step : unsafe Int -> List Handle -> Int -> Int -> Int -> EP.Ep -> List Handle .
step block handles me from id q = case q of
    EP.Open url mode -> opened handles from id url mode
  | EP.Read h n -> result = readHandle block me from (find handles h from);
                   answered handles from id h result
  | EP.Write h value -> result = writeHandle block me from value (find handles h from);
                        answered handles from id h result
  | EP.Close h -> case find handles h from of
      Err why -> _ = AC.reply (from, id) (Err why); handles
    | Ok found -> _ = AC.reply (from, id) (Ok 0); without handles h.
opened handles from id url mode = if mode == "read" or mode == "write" or mode == "rw" then
  h = Sys.nextId Unit;
  case AC.reply (from, id) (EP.Opened h) of
    Ok u -> Handle h url from mode :: handles
  | Err why -> handles
  else _ = AC.reply (from, id) (EP.Refused "block endpoint: invalid open mode"); handles.
find : unsafe List Handle -> Int -> Int -> Result (String, String) String .
find Nil h caller = Err "block endpoint: no such handle".
find (Handle id url client mode :: rest) h caller =
  if id == h then if client == caller then Ok (url, mode) else Err "block endpoint: handle belongs to another client"
  else find rest h caller.
without : unsafe List Handle -> Int -> List Handle .
without Nil h = Nil.
without (Handle id url client mode :: rest) h = if id == h then rest else Handle id url client mode :: without rest h.
readHandle : unsafe Int -> Int -> Int -> Result (String, String) String -> Result EP.IoV String .
readHandle block me client found = case found of
    Err why -> Err why
  | Ok (url, mode) -> if mode == "read" or mode == "rw" then readAt block me client url else Err "block endpoint: handle is write-only".
writeHandle : unsafe Int -> Int -> Int -> EP.IoV -> Result (String, String) String -> Result EP.IoV String .
writeHandle block me client value found = case found of
    Err why -> Err why
  | Ok (url, mode) -> if mode == "write" or mode == "rw" then writeAt block me client url value else Err "block endpoint: handle is read-only".
answered : unsafe List Handle -> Int -> Int -> Int -> Result EP.IoV String -> List Handle .
answered handles from id h result = case AC.reply (from, id) result of
    Ok u -> handles
  | Err why -> if why == "dead actor" then without handles h else handles.
readAt : unsafe Int -> Int -> Int -> String -> Result EP.IoV String .
readAt block me client url =
  if EP.strEq url "/services/block/capacity" then pagesReply (B.call me block B.Capacity)
  else if EP.strEq url "/services/block/status" then statusReply (B.call me block B.Status)
  else if EP.strEq url "/services/block/budget" then budgetReply (B.call me block B.GetBudget)
  else pageRead block me (pageNumber block me url).
writeAt : unsafe Int -> Int -> Int -> String -> EP.IoV -> Result EP.IoV String .
writeAt block me client url value = case value of
    EP.IStr bytes -> owned = keep bytes; pageWrite block me owned (pageNumber block me url)
  | other -> Err "block endpoint: writes require bytes".
pagesReply (Ok (B.Pages n)) = Ok (EP.IInt n).
pagesReply (Err why) = Err why.
pagesReply other = Err "block endpoint: invalid capacity reply".
statusReply (Ok (B.State mode queued active)) = Ok (EP.IStr "mode={mode} queued={queued} active={active}").
statusReply (Err why) = Err why.
statusReply other = Err "block endpoint: invalid status reply".
budgetReply (Ok (B.Budget policy)) = (version, us, probes, factor) = policy; Ok (EP.IStr "version={version} deadlineUs={us} resetProbes={probes} waitFactor={factor}").
budgetReply (Err why) = Err why.
budgetReply other = Err "block endpoint: invalid budget reply".
pageRead block me number = case number of
    Err why -> Err why
  | Ok p -> pageReply (B.call me block (B.Read p)).
pageReply (Ok (B.Page bytes)) = Ok (EP.IStr bytes).
pageReply (Err why) = Err why.
pageReply other = Err "block endpoint: invalid page reply".
pageWrite block me bytes number = case number of
    Err why -> Err why
  | Ok p -> writtenReply (B.call me block (B.Write p bytes)).
writtenReply (Ok (B.Written n)) = Ok (EP.IInt n).
writtenReply (Err why) = Err why.
writtenReply other = Err "block endpoint: invalid write reply".
pageNumber : unsafe Int -> Int -> String -> Result Int String .
pageNumber block me url = if EP.prefixOf "/services/block/pages" url and strlen url > 22 then
    case B.capacity me block of
      Err why -> Err why
    | Ok pages -> if pages <= 0 then Err "block: page out of range" else parsePage url 22 0 (pages - 1)
  else Err "block endpoint: unknown path".
parsePage : unsafe String -> Int -> Int -> Int -> Result Int String .
parsePage url index value limit = if index >= strlen url then Ok value else
  digit = charAt url index - 48;
  if digit < 0 or digit > 9 then Err "block endpoint: invalid page number"
  else if value > limit / 10 or (value == limit / 10 and digit > limit % 10) then Err "block: page out of range"
  else parsePage url (index + 1) (value * 10 + digit) limit.

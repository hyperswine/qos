# coreutil.fpr -- small pure helpers shared by separately compiled modules.
# Domain parsers and policies stay with their owning modules; this file holds
# only generic boolean, string-token, and list mechanics.

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
not1 a = case a of True -> False | False -> True.

strEq : unsafe String -> String -> Bool .
strEq a b = case strlen a == strlen b of
    True -> strEqGo a b 1 (strlen a)
  | False -> False.
strEqGo : unsafe String -> String -> Int -> Int -> Bool .
strEqGo a b i n = case i > n of
    True -> True
  | False -> case charAt a i == charAt b i of
      True -> strEqGo a b (i + 1) n
    | False -> False.

# Split on newlines, omitting empty lines.
lines : unsafe String -> List String .
lines s = linesGo s 1 (strlen s) "".
linesGo : unsafe String -> Int -> Int -> String -> List String .
linesGo s i n acc = case i > n of
    True -> linesEnd acc
  | False -> linesCh s i n acc (charAt s i).
linesCh : unsafe String -> Int -> Int -> String -> Int -> List String .
linesCh s i n acc c = case c == 10 of
    True -> linesNl s i n acc
  | False -> linesGo s (i + 1) n (strcat acc (chr c)).
linesNl : unsafe String -> Int -> Int -> String -> List String .
linesNl s i n acc = case strlen acc == 0 of
    True -> linesGo s (i + 1) n ""
  | False -> acc :: linesGo s (i + 1) n "".
linesEnd acc = case strlen acc == 0 of True -> Nil | False -> acc :: Nil.

# Read a space/newline-delimited token at i, returning the next byte index.
wordAt : unsafe String -> Int -> Int -> (String, Int) .
wordAt s i n = wordGo s i n "".
wordGo : unsafe String -> Int -> Int -> String -> (String, Int) .
wordGo s i n acc = case i > n of
    True -> (acc, i)
  | False -> wordCh s i n acc (charAt s i).
wordCh : unsafe String -> Int -> Int -> String -> Int -> (String, Int) .
wordCh s i n acc c = case or2 (c == 32) (c == 10) of
    True -> (acc, i + 1)
  | False -> wordGo s (i + 1) n (strcat acc (chr c)).

# Strict natural-number parsing for format boundaries.
parseNat : unsafe String -> Result Int String .
parseNat s = case strlen s == 0 of
    True -> Err "empty natural number"
  | False -> parseNatGo s 1 (strlen s) 0.
parseNatGo : unsafe String -> Int -> Int -> Int -> Result Int String .
parseNatGo s i n acc = case i > n of
    True -> Ok acc
  | False -> parseNatCh s i n acc (charAt s i).
parseNatCh : unsafe String -> Int -> Int -> Int -> Int -> Result Int String .
parseNatCh s i n acc c = case and2 (c >= 48) (c <= 57) of
    True -> parseNatGo s (i + 1) n (acc * 10 + (c - 48))
  | False -> Err "not a natural number".

# Compatibility parser: consume the leading digit run, returning zero when
# there are no leading digits. Existing format readers use this behavior.
parseDigits : unsafe String -> Int .
parseDigits s = parseDigitsAt s 1.
parseDigitsAt : unsafe String -> Int -> Int .
parseDigitsAt s i = parseDigitsGo s i (strlen s) 0.
parseDigitsGo : unsafe String -> Int -> Int -> Int -> Int .
parseDigitsGo s i n acc = case i > n of
    True -> acc
  | False -> parseDigitsCh s i n acc (charAt s i).
parseDigitsCh : unsafe String -> Int -> Int -> Int -> Int -> Int .
parseDigitsCh s i n acc c = case and2 (c >= 48) (c <= 57) of
    True -> parseDigitsGo s (i + 1) n (acc * 10 + (c - 48))
  | False -> acc.

listAppend : unsafe List a -> List a -> List a .
listAppend xs ys = case xs of Nil -> ys | x :: rest -> x :: listAppend rest ys.
listLen : unsafe List a -> Int .
listLen xs = case xs of Nil -> 0 | _ :: rest -> 1 + listLen rest.
# Concatenate many strings in O(n log n) bytes of garbage: pairwise
# passes instead of one growing accumulator (a per-piece `strcat acc x`
# copies the whole prefix every time -- quadratic in the total length,
# which a long-lived pool pays for as its high-water mark).
# (accumulator loops throughout: a list as long as a receipt log must
# not cost a stack frame per element)
concat : unsafe List String -> String .
concat Nil = "".
concat (x :: Nil) = x.
concat xs = concat (concatPairs xs Nil).
concatPairs : unsafe List String -> List String -> List String .
concatPairs (a :: b :: r) acc = concatPairs r (strcat a b :: acc).
concatPairs (a :: Nil) acc = revS (a :: acc) Nil.
concatPairs Nil acc = revS acc Nil.
revS : unsafe List String -> List String -> List String .
revS Nil acc = acc.
revS (x :: r) acc = revS r (x :: acc).

joinWith : unsafe String -> List String -> String .
joinWith sep Nil = "".
joinWith sep (x :: r) = concat (x :: joinSep sep r Nil).
joinSep : unsafe String -> List String -> List String -> List String .
joinSep sep Nil acc = revS acc Nil.
joinSep sep (x :: r) acc = joinSep sep r (x :: sep :: acc).

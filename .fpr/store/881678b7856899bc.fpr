# ============================================================================
# svc.fpr -- the ONE IO funnel: everything an app does is `Svc.read caps
# url` or `Svc.write caps url v`.
#
# The Sol HAL collapse, upstreamed: Sol's builtin IO became two functions
# over structured values and device paths; here every System.qa service
# becomes a URL routed through one dispatcher.  The capability check
# happens ONCE, HERE, derived from the URL itself (granted (u, mode)
# covers url iff u is a '/'-boundary prefix of url) -- a service function
# that forgets its own hasCap can no longer exist, because services are
# not functions any more, they are routes.
#
# The value moved is IoV, one shape both directions.  Absence and
# unknown routes are DATA (IErr) per the resolver doctrine -- only an
# UNGRANTED url faults loudly (a bug, not a condition).  System.qa
# re-exports this surface and keeps its historical svc* names as
# wrappers; apps see the same API, now with one funnel under it.
#
# Routes (all prefixes are also the manifest capability strings):
#   read  /services/keyboard          -> IInt key        (blocking)
#   read  /services/keyboard/poll     -> IInt key|0      (nonblocking)
#   write /services/display     (IStr s)                 puts
#   write /services/display/line(IStr s)                 puts + newline
#   read  /services/clock             -> IInt mtime
#   read  /services/modules/<hash>/<fn> -> IFn f | IErr  (miss is data)
#   read  /services/storage/kv        -> IStr stream | IErr   (replay)
#   write /services/storage/kv  (IStr line)              append one msg
#   write /services/timer       (IInt ms)                TFire to caller later
#   read  /pins/<n>                   -> IInt level
#   write /pins/<n>             (IInt v)                 set level
#   write /pins/<n>/mode        (IInt m)                 set direction
#
# The storage route keeps the structural-scoping invariant: the kv URL
# an app reaches is built HERE from its capability id -- there is no url
# an app can pass that names another app's stream.  Storage is the
# actor-backed route (the RPC shape every future service actor follows:
# send (me, tag, url, payload), receiveRes); display/keyboard/clock are
# built-in device routes behind the same two verbs.
# ============================================================================

IoV = Type (IUnit | IInt Int | IStr String | IFn Int | IErr String).

UartM = use "uart#8753d4509634e17a".
UWrite = UartM.UWrite.
UGet = UartM.UGet.
UOkI = UartM.UOkI.
UOkS = UartM.UOkS.
UErr = UartM.UErr.

TimerM = use "timer#38fa906125d48580".
TAfter = TimerM.TAfter.

# ---- module-local helpers ---------------------------------------------------

and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
isOdd v = v - (v / 2) * 2 == 1.

strEq a b = case strlen a == strlen b of
    False -> False
  | True -> seGo a b 0 (strlen a).
seGo : unsafe String -> String -> Int -> Int -> Bool .
seGo a b i n = case i >= n of
    True -> True
  | False -> case charAt a i == charAt b i of
      True -> seGo a b (i + 1) n
    | False -> False.

# '/'-boundary prefix: p covers u iff u == p, or u starts with p and the
# next char is '/'.  "/pins" covers "/pins/5/mode"; it does not cover
# "/pinstripe".
prefixOf : unsafe String -> String -> Bool .
prefixOf p u =
  pn = strlen p;
  case pn > strlen u of
    True -> False
  | False -> case peGo p u 0 pn of
      False -> False
    | True -> case strlen u == pn of
        True -> True
      | False -> charAt u pn == 47.
peGo : unsafe String -> String -> Int -> Int -> Bool .
peGo p u i n = case i >= n of
    True -> True
  | False -> case charAt p i == charAt u i of
      True -> peGo p u (i + 1) n
    | False -> False.

# the path segment starting at 0-based position start; "" when absent
segAfter : unsafe String -> Int -> String .
segAfter url start =
  case start >= strlen url of True -> "" | False -> segTake url start (strlen url).
segTake : unsafe String -> Int -> Int -> String .
segTake url i n =
  k = segSlash url i n;
  case k < 0 of True -> substr url i (n - i) | False -> substr url i (k - i).
segSlash : unsafe String -> Int -> Int -> Int .
segSlash url i n = case i >= n of
    True -> 0 - 1
  | False -> case charAt url i == 47 of True -> i | False -> segSlash url (i + 1) n.

parseNum s = pnGo s 0 (strlen s) 0.
pnGo : unsafe String -> Int -> Int -> Int -> Int .
pnGo s i n acc = case i >= n of
    True -> acc
  | False -> pnGo s (i + 1) n (acc * 10 + (charAt s i - 48)).

# ---- the caps value (System.qa's ABI) ---------------------------------------
# A declared constructor, NOT a tuple: the ABI has Tup2/Tup3 only (a wider
# tuple used to pack into a Tup2 header and silently truncate under any
# header-arity-driven copy). Tids are content-addressed by (declaring
# unit, type name), so every importer of THIS module — System.qa and apps
# compiled separately — agrees on the tag.

Caps = Type (Caps con me clk granted aid st).

# the RPC envelope every service actor speaks: (replyTo, tag, url, payload)
Rpc = Type (Rpc me tag url pay).

capCon (Caps c _ _ _ _ _) = c.
capMe  (Caps _ m _ _ _ _) = m.
capClk (Caps _ _ k _ _ _) = k.
capGranted (Caps _ _ _ g _ _) = g.
capId  (Caps _ _ _ _ a _) = a.
capSt  (Caps _ _ _ _ _ s) = s.
# the st slot is a RECORD {has, act, uart, timer}: row-typed, so its
# shape id hashes the FIELD NAMES only -- adding a service actor is a
# new field, never an arity change rippling through every constructor
stHas st = st.has.
stAct st = st.act.
stUart st = st.uart.
stTimer st = st.timer.

# mode "rw" covers both verbs
modeOk m want = or2 (strEq m want) (strEq m "rw").

# is url covered by any granted (prefix, mode)?
covered : unsafe List (String, String) -> String -> String -> Bool .
covered g url want = case g of
    Nil -> False
  | p :: r -> case p of (u, m) ->
      case and2 (prefixOf u url) (modeOk m want) of
        True -> True
      | False -> covered r url want.

capBug url = error (strcat "capability fault: app used ungranted url " url).

# ---- console over the con register pair (uart LSR/THR via Mmio) -------------

putc con c = (lsr, dat) = con; putcW lsr dat c.
putcW : unsafe Int -> Int -> Int -> Unit .
putcW lsr dat c = putcV lsr dat c (read lsr).
putcV : unsafe Int -> Int -> Int -> Int -> Unit .
putcV lsr dat c v = case isOdd (v / 32) of
    True -> write dat c
  | False -> putcW lsr dat c.
puts con s = putsFrom con s 0 (strlen s).
putsFrom : unsafe (Int, Int) -> String -> Int -> Int -> Unit .
putsFrom con s i n = case i >= n of
    True -> Unit
  | False -> putc con (charAt s i) >> putsFrom con s (i + 1) n.
nl con = putc con 13 >> putc con 10.

getc me con = (lsr, dat) = con; getcW me lsr dat.
getcW : unsafe Int -> Int -> Int -> Int .
getcW me lsr dat = getcV me lsr dat (read lsr).
getcV : unsafe Int -> Int -> Int -> Int -> Int .
getcV me lsr dat v = case isOdd v of
    True -> read dat
  | False -> Actor.yield me >> getcW me lsr dat.

pollKey con = (lsr, dat) = con;
  case isOdd (read lsr) of True -> read dat | False -> 0.

# ---- the router --------------------------------------------------------------

# the one gate: derive the needed capability FROM the url (longest route
# prefix), check the grant, dispatch.  read = coeffect, write = effect.
route : unsafe Caps -> String -> String -> IoV -> IoV .
route caps url want v =
  case covered (capGranted caps) url want of
    False -> capBug url
  | True -> dispatch caps url want v.

dispatch : unsafe Caps -> String -> String -> IoV -> IoV .
dispatch caps url want v =
  case prefixOf "/services/display" url of
    True -> dDisplay caps url v
  | False -> case prefixOf "/services/keyboard" url of
      True -> dKeyboard caps url
    | False -> case prefixOf "/services/clock" url of
        True -> IInt (read (capClk caps))
      | False -> case prefixOf "/services/modules" url of
          True -> dModules url
        | False -> case prefixOf "/services/storage" url of
            True -> dStorage caps url want v
          | False -> case prefixOf "/services/uart" url of
              True -> dUart caps want v
            | False -> case prefixOf "/services/timer" url of
                True -> dTimer caps want v
              | False -> case prefixOf "/pins" url of
                  True -> dPins url want v
                | False -> IErr (strcat "no route: " url).

# "/services/timer": the actor-backed route to Timer.qa (mods/
# timer.fpr).  write (IInt ms) schedules ONE fire: Timer.qa arms the
# CLINT (aux-hart interrupt on native; sleeper child on qosp) and,
# once due, sends TFire to the CALLING actor's mailbox -- the caller
# is moved from the backlog into the ready zone by that message under
# the scheduler's ordinary admission bounds.  One send, no round
# trip; block on the fire (receive) for a sleep, or keep working and
# collect it later.
dTimer caps want v = case strEq want "write" of
    True -> dTimerW caps v
  | False -> IErr "/services/timer is write-only (write IInt ms; TFire lands in your mailbox)".
# the send is checked: a timer service that refused the request (its
# ring full) or ended is an IErr to the caller, not a tick that never comes
dTimerW caps v = case v of
    IInt ms -> dTimerSend caps ms
  | _ -> IErr "/services/timer wants IInt".
dTimerSend caps ms = case send (stTimer (capSt caps)) (capMe caps, TAfter ms) of
    Ok u -> IUnit
  | Err e -> IErr (strcat "/services/timer: the timer service refused the request (" (strcat e ")")).

# "/services/uart": the actor-backed route to UART.qa (mods/uart.fpr).
# write (IStr s) enqueues a DMA-shaped transmit and answers IInt n
# (bytes accepted); read takes the rx buffer as IStr.  On System.qa's
# native tier the service runs UNARMED and SHARED: tx rides the
# service's outgoing buffer onto the console UART, rx stays the
# keyboard service's (one 16550 is both).  A dedicated app that owns
# its UART gets the full armed/interrupt path through std.uart.
dUart caps want v = case strEq want "write" of
    True -> dUartW caps v
  | False -> dUartR caps.
dUartW caps v = case v of
    IStr s -> dUartW1 caps s
  | _ -> IErr "/services/uart wants IStr".
dUartW1 : unsafe _ -> String -> _ .
dUartW1 caps s =
  r = uartRpc caps (UWrite s);
  o = uartWRep r;
  _ = drop r;
  o.
uartWRep r = case r of
    UOkI k -> IInt k
  | UErr e -> IErr e
  | ox -> IErr "/services/uart: protocol reply mismatch".
dUartR : unsafe _ -> _ .
dUartR caps =
  r = uartRpc caps UGet;
  o = uartRRep r;
  _ = drop r;
  o.
uartRRep r = case r of
    UOkS m -> IStr (strcat m "")
  | UErr e -> IErr e
  | ox -> IErr "/services/uart: protocol reply mismatch".
# the send is checked and the wait answers: a UART service that refused
# the request or ended is a UErr to the route (an IErr to the caller),
# never a receive that waits for a reply that was never accepted
uartRpc caps msg =
  u = stUart (capSt caps);
  case send u (capMe caps, msg) of
    Err e -> UErr (strcat "/services/uart: the UART service refused the request (" (strcat e ")"))
  | Ok s -> uartAwait caps u.
uartAwait caps u = case receiveFromRes (capMe caps) u of
    Ok r -> r
  | Err e -> UErr (strcat "/services/uart: the UART service " (strcat e " before answering")).

dDisplay caps url v = case v of
    IStr s -> dDisp1 caps url s
  | _ -> IErr "/services/display wants IStr".
dDisp1 : unsafe Caps -> String -> String -> IoV .
dDisp1 caps url s =
  case strEq (segAfter url 18) "line" of
    True -> puts (capCon caps) s >> nl (capCon caps) >> IUnit
  | False -> puts (capCon caps) s >> IUnit.

dKeyboard : unsafe Caps -> String -> IoV .
dKeyboard caps url =
  case strEq (segAfter url 19) "poll" of
    True -> IInt (pollKey (capCon caps))
  | False -> IInt (getc (capMe caps) (capCon caps)).

# "/services/modules/<hash>/<fn>": a miss is data
dModules : unsafe String -> IoV .
dModules url =
  h = segAfter url 18;
  f = segAfter url (18 + strlen h + 1);
  dMod1 (Mod.resolve h f).
dMod1 r = case r of (ok, f) ->
  case ok == 1 of True -> IFn f | False -> IErr "module miss".

# app-scoped kv: the url an app reaches is built from ITS id -- naming
# another app's stream is structurally impossible
dStorage : unsafe Caps -> String -> String -> IoV -> IoV .
dStorage caps url want v =
  case strEq (segAfter url 18) "kv" of
    False -> IErr (strcat "no storage route: " url)
  | True -> dKv caps want v.
dKv caps want v = case strEq want "write" of
    True -> dKvW caps v
  | False -> dKvR (storeRpc caps 3 (kvUrl caps) "").
dKvW caps v = case v of
    IStr line -> dKvR (storeRpc caps 2 (kvUrl caps) (strcat line (chr 10)))
  | _ -> IErr "/services/storage/kv wants IStr".
dKvR r = case r of Ok s -> IStr s | Err e -> IErr e.

kvUrl caps = strcat "apps/" (strcat (capId caps) (strcat "/" (strcat (capId caps) ".kv"))).

# the actor-backed route: the RPC shape every service actor follows
storeRpc caps tag url pay = storeRpcAt (capMe caps) (capSt caps) tag url pay.
storeRpcAt me st tag url pay =
  case stHas st of
    True -> (case send (stAct st) (Rpc me tag url pay) of
      Err e -> Err e
    | Ok u -> (case receiveFromRes me (stAct st) of
        Err e -> Err e
      | Ok reply -> resultKept reply))
  | False -> Err "no disk".

resultKept reply =
  r = keep reply;
  _ = drop reply;
  r.

# "/pins/<n>" and "/pins/<n>/mode"
dPins : unsafe String -> String -> IoV -> IoV .
dPins url want v =
  ns = segAfter url 6;
  n = parseNum ns;
  case strEq (segAfter url (6 + strlen ns + 1)) "mode" of
    True -> dPinMode n v
  | False -> dPinRW n want v.
dPinMode n v = case v of
    IInt m -> Pin.mode n m >> IUnit
  | _ -> IErr "/pins mode wants IInt".
dPinRW n want v = case strEq want "write" of
    False -> IInt (Pin.read n)
  | True -> dPinW n v.
dPinW n v = case v of
    IInt lv -> Pin.write n lv >> IUnit
  | _ -> IErr "/pins wants IInt".

# ---- the surface -------------------------------------------------------------

Svc = Struct {
  read  = fn caps url -> route caps url "read" IUnit,
  write = fn caps url v -> route caps url "write" v
}.

# Shared block service. Correlated, serialized requests; 64 slots per sender channel.
# The creator is the cooperative administrator: Configure checks the call
# envelope's return actor. This is a convention inside one trusted image,
# not an unforgeable capability or the namespace/process authorization gate.
AC = use "std/actor#06e72a5feec8a6d4".
Request = Type (Capacity | Read Int | Write Int String | GetBudget | Configure (Int, Int, Int, Int)).
Reply = Type (Pages Int | Page String | Written Int | Budget (Int, Int, Int, Int)).
# budget tuple: expected/current version, deadline us, reset probes, wait factor.
# Common page protocol; the host has no virt DMA/reset budget settings.
unsupported q = Err "block: native budgets unsupported".
serve : unsafe Int -> Device -> Int .
serve admin dev = serveWith admin dev unsupported unsupported.
serveWith : unsafe Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int .
serveWith admin dev query update = AC.spawnWith (AC.Static 64) (actor admin dev query update).
serveWithOn : unsafe Int -> Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int .
serveWithOn hart admin dev query update = AC.spawnWithOn hart (AC.Static 64) (actor admin dev query update).
call : Int -> Int -> Request -> Result Reply String .
call me service q = flatten (AC.call me service q).
capacity me service = case call me service Capacity of
    Ok (Pages n) -> Ok n
  | Err why -> Err why
  | other -> Err "block: invalid capacity reply".
flatten : Result (Result Reply String) String -> Result Reply String .
flatten r = case r of Ok reply -> reply | Err why -> Err "block service: {why}".
actor : unsafe Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int -> Unit .
actor admin dev query update me =
  msg = receive me;
  (from, rid, borrowed) = msg;
  q = keep borrowed;
  _ = drop msg;
  result = dispatch me admin dev query update from q;
  _ = AC.reply (from, rid) result;
  fresh = AC.boundary me (admin, dev, query, update);
  again fresh me.
again : unsafe (Int, Device, (Unit -> Result Reply String), ((Int, Int, Int, Int) -> Result Reply String)) -> Int -> Unit .
again pair me = (admin, dev, query, update) = pair; actor admin dev query update me.
dispatch : Int -> Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int -> Request -> Result Reply String .
dispatch me admin dev query update from q = case q of
    GetBudget -> query Unit
  | Configure policy -> if from == admin then update policy else Err "block: configuration requires administrator"
  | other -> worker = AC.spawnWithOn (hartId 0) (AC.Static 1) (io dev); flattenIO (AC.call me worker other).
flattenIO : Result (Result Reply String) String -> Result Reply String .
flattenIO r = case r of Ok reply -> reply | Err why -> Err "block device: {why}".
io : Device -> Int -> Unit .
io dev me =
  msg = receive me;
  (from, rid, borrowed) = msg;
  q = keep borrowed;
  _ = drop msg;
  result = operate dev q;
  _ = AC.reply (from, rid) result;
  Unit.
operate dev q = case q of
    Capacity -> Ok (Pages (blkPages dev))
  | Read p -> readOne dev p
  | Write p bytes -> writeOne dev p bytes
  | other -> Err "block: invalid I/O request".
readOne dev p = if validPage dev p then Ok (Page (blkRead dev p)) else Err "block: page out of range".
writeOne dev p bytes = if not (validPage dev p) then Err "block: page out of range" else if strlen bytes > 4096 then Err "block: payload exceeds one page" else written dev p bytes.
written dev p bytes = _ = blkWrite dev p bytes; Ok (Written (strlen bytes)).

validPage dev p = p >= 0 and p < blkPages dev.

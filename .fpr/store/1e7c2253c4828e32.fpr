# Shared block owner. Mailboxes have 64 slots per sender; admitted pending I/O
# has a separate global bound of 64. Administrator identity is cooperative
# inside a trusted image; process authorization belongs to the namespace.
AC = use "std/actor#06e72a5feec8a6d4".
Request = Type (Capacity | Read Int | Write Int String | GetBudget | Configure (Int, Int, Int, Int) | Status | Cancel Int | CancelFor Int Int | Drain | Completed (Result Reply String)).
Reply = Type (Pages Int | Page String | Written Int | Budget (Int, Int, Int, Int) | State Int Int Bool | Cancelled Bool | Drained).
# State = admission mode (0 open, 1 draining, 2 drained), queued I/O, active.
Context = Type (Context Int Device (Unit -> Result Reply String) ((Int, Int, Int, Int) -> Result Reply String)).
Pending = Type (Pending Int Int Request).
Active = Type (Idle | Running Int Int Int Int Bool).
Mode = Type (Open | Closing Int Int | Closed).
Owner = Type (Owner Active (List Pending) Int Mode).
unsupported q = Err "block: native budgets unsupported".
serve : unsafe Int -> Device -> Int .
serve admin dev = serveWith admin dev unsupported unsupported.
serveWith : unsafe Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int .
serveWith admin dev query update = AC.spawnWith (AC.Static 64) (actor (Context admin dev query update)).
serveWithOn : unsafe Int -> Int -> Device -> (Unit -> Result Reply String) -> ((Int, Int, Int, Int) -> Result Reply String) -> Int .
serveWithOn hart admin dev query update = AC.spawnWithOn hart (AC.Static 64) (actor (Context admin dev query update)).
submit : Int -> Int -> Request -> Result Int String .
submit me service q = id = Sys.nextId Unit; case send service (me, id, q) of Ok u -> Ok id | Err why -> Err "block service: {why}".
await : Int -> Int -> Int -> Result Reply String .
await me service id = flatten (AC.awaitReply me service id).
call : Int -> Int -> Request -> Result Reply String .
call me service q = case submit me service q of Ok id -> await me service id | Err why -> Err why.
capacity me service = case call me service Capacity of
    Ok (Pages n) -> Ok n
  | Err why -> Err why
  | other -> Err "block: invalid capacity reply".
flatten : Result (Result Reply String) String -> Result Reply String .
flatten r = case r of Ok reply -> reply | Err why -> Err "block service: {why}".
actor : unsafe Context -> Int -> Unit .
actor ctx me = loop ctx (Owner Idle Nil 0 Open) me.
loop : unsafe Context -> Owner -> Int -> Unit .
loop ctx state me =
  ready = advance ctx state me;
  borrowed = receive me;
  (from, id, q) = keep borrowed;
  _ = drop borrowed;
  next = handle ctx ready me from id q;
  fresh = AC.boundary me (ctx, next);
  again fresh me.
again : unsafe (Context, Owner) -> Int -> Unit .
again pair me = (ctx, state) = pair; loop ctx state me.
advance : Context -> Owner -> Int -> Owner .
advance ctx (Owner Idle queue count mode) me = case queue of
    Pending from id q :: rest -> Owner (start ctx me from id q) rest (count - 1) mode
  | Nil -> drained me mode.
advance ctx state me = state.
drained me mode = case mode of
    Closing from id -> _ = AC.reply (from, id) (Ok Drained); Owner Idle Nil 0 Closed
  | other -> Owner Idle Nil 0 other.
start : Context -> Int -> Int -> Int -> Request -> Active .
start (Context admin dev query update) me from id q =
  worker = AC.spawnWithOn (hartId 0) (AC.Static 1) (io dev);
  relay = AC.spawnWithOn (hartId 0) (AC.Static 1) (completion me worker id q);
  Running from id worker relay False.
completion : Int -> Int -> Int -> Request -> Int -> Unit .
completion owner worker token q me =
  result = flattenIO (AC.call me worker q);
  _ = send owner (me, token, Completed result);
  Unit.
flattenIO : Result (Result Reply String) String -> Result Reply String .
flattenIO r = case r of Ok reply -> reply | Err why -> Err "block device: {why}".
handle : unsafe Context -> Owner -> Int -> Int -> Int -> Request -> Owner .
handle ctx state me from id q = case q of
    Completed result -> finish state from id result
  | Capacity -> (Context admin dev query update) = ctx; respond state from id (Ok (Pages (blkPages dev)))
  | GetBudget -> (Context admin dev query update) = ctx; respond state from id (query Unit)
  | Configure policy -> (Context admin dev query update) = ctx;
                        respond state from id (if from == admin then update policy else Err "block: configuration requires administrator")
  | Status -> respond state from id (status state)
  | Cancel target -> cancel state from id from target
  | CancelFor caller target -> (Context admin dev query update) = ctx;
                               if from == admin then cancel state from id caller target else respond state from id (Err "block: cancellation requires administrator")
  | Drain -> (Context admin dev query update) = ctx;
             if from == admin then drain state from id else respond state from id (Err "block: drain requires administrator")
  | other -> admit ctx state me from id other.
respond state from id result = _ = AC.reply (from, id) result; state.
status (Owner active queue count mode) = Ok (State (modeId mode) count (case active of Idle -> False | other -> True)).
modeId Open = 0.
modeId (Closing from id) = 1.
modeId Closed = 2.
admit : unsafe Context -> Owner -> Int -> Int -> Int -> Request -> Owner .
admit ctx state me from id q = case state of Owner active queue count mode ->
  case mode of
    Open -> if count >= 64 then respond state from id (Err "block: queue full") else enqueue ctx active queue count me from id q
  | other -> respond state from id (Err "block: draining").
enqueue : unsafe Context -> Active -> List Pending -> Int -> Int -> Int -> Int -> Request -> Owner .
enqueue ctx Idle queue count me from id q = Owner (start ctx me from id q) queue count Open.
enqueue ctx active queue count me from id q = Owner active (push queue (Pending from id q)) (count + 1) Open.
push : unsafe List Pending -> Pending -> List Pending .
push Nil item = item :: Nil.
push (head :: rest) item = head :: push rest item.
finish : Owner -> Int -> Int -> Result Reply String -> Owner .
finish state sender token result = case state of Owner active queue count mode ->
  case active of
    Idle -> state
  | Running from id worker relay cancelled ->
      if sender == relay and token == id then
        _ = AC.reply (from, id) (if cancelled then Err "block: request cancelled (outcome unknown)" else result);
        Owner Idle queue count mode
      else state.
cancel : unsafe Owner -> Int -> Int -> Int -> Int -> Owner .
cancel state from id caller target = case state of Owner active queue count mode ->
  case active of
    Running owner token worker relay cancelled ->
      if owner == caller and token == target then
        _ = kill worker;
        respond (Owner (Running owner token worker relay True) queue count mode) from id (Ok (Cancelled True))
      else cancelQueued state from id caller target
  | Idle -> cancelQueued state from id caller target.
cancelQueued : unsafe Owner -> Int -> Int -> Int -> Int -> Owner .
cancelQueued state from id caller target = case state of Owner active queue count mode ->
  (found, rest) = remove queue caller target;
  respond (Owner active rest (if found then count - 1 else count) mode) from id (Ok (Cancelled found)).
remove : unsafe List Pending -> Int -> Int -> (Bool, List Pending) .
remove Nil caller target = (False, Nil).
remove (Pending from id q :: rest) caller target =
  if from == caller and id == target then
    _ = AC.reply (from, id) (Err "block: request cancelled before I/O"); (True, rest)
  else (found, tail) = remove rest caller target; (found, Pending from id q :: tail).
drain state from id = case state of Owner active queue count mode ->
  case mode of
    Open -> Owner active queue count (Closing from id)
  | Closed -> respond state from id (Ok Drained)
  | other -> respond state from id (Err "block: already draining").
io : Device -> Int -> Unit .
io dev me =
  msg = receive me;
  (from, rid, borrowed) = msg;
  q = keep borrowed;
  _ = drop msg;
  result = operate dev q;
  _ = AC.reply (from, rid) result;
  Unit.
operate dev q = case q of
    Read p -> readOne dev p
  | Write p bytes -> writeOne dev p bytes
  | other -> Err "block: invalid I/O request".
readOne dev p = if validPage dev p then Ok (Page (blkRead dev p)) else Err "block: page out of range".
writeOne dev p bytes = if not (validPage dev p) then Err "block: page out of range" else if strlen bytes > 4096 then Err "block: payload exceeds one page" else written dev p bytes.
written dev p bytes = _ = blkWrite dev p bytes; Ok (Written (strlen bytes)).
validPage dev p = p >= 0 and p < blkPages dev.

# ============================================================================
# tui.fpr -- stui's TUI engine as a separately compiled `use` module.
#
# Three layers, ported from programs/stui.fpr (where each was proven and
# measured); ONE architectural change: the renderer does not know what a
# console is.  Every emitting function takes `w : String -> Unit` -- the
# app passes its display capability (`svcWrite caps` partially applied),
# so rendering flows through the permission system like any other write
# and this module compiles against nothing but the prelude.
#
#   LAYER 1  packed cells + row buffers   cell = ch*256 + fg*16 + bg
#   LAYER 2  widgets: Widget = sz -> rows; vbox/hbox with LFix/LFlex,
#            border, pad, text/line/fill; Dyn splices for cached buffers
#   LAYER 3  ANSI diff renderer: dirty runs merged (gap <= 4 fused),
#            SGR state packed + threaded, one w-call per run
#
# colors: 0 Default 1 Black 2 Red 3 Green 4 Yellow 5 Blue 6 Magenta
#         7 Cyan 8 White      blank = (' ',0,0) = 8192; invalid = 1
# ============================================================================

LMode = Type (LFix Int | LFlex Int).

# ---- module-local helpers ---------------------------------------------------
and2 a b = case a of True -> b | False -> False.
or2 a b = case a of True -> True | False -> b.
append : unsafe List h289 -> List h289 -> List h289 .
append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.
len : unsafe List i289 -> Int .
len xs = case xs of Nil -> 0 | _ :: t -> 1 + len t.
takeN : unsafe Int -> List j289 -> List j289 .
takeN n xs = case n <= 0 of True -> Nil | False -> takeGo n xs.
takeGo : unsafe Int -> List k289 -> List k289 .
takeGo n xs = case xs of Nil -> Nil | x :: r -> x :: takeN (n - 1) r.
maxI a b = case a > b of True -> a | False -> b.

# ---- LAYER 1: cells ---------------------------------------------------------
mkCell ch f b = ((ch * 256) + (f * 16)) + b.
cellCh v = v / 256.
cellFg v = (v / 16) - ((v / 256) * 16).
cellBg v = v - ((v / 16) * 16).

repCell : unsafe l289 -> Int -> List l289 .
repCell c n = case n <= 0 of True -> Nil | False -> c :: repCell c (n - 1).
repRow : unsafe m289 -> Int -> List m289 .
repRow row h = case h <= 0 of True -> Nil | False -> row :: repRow row (h - 1).
fillRows c w h = repRow (repCell c w) h.
blankRows w h = fillRows 8192 w h.
invalidBuf w h = fillRows 1 w h.

strCells s f b = scGo s f b 1 (strlen s).
scGo : unsafe String -> Int -> Int -> Int -> Int -> List Int .
scGo s f b i n =
  case i > n of
    True -> Nil
  | False -> mkCell (charAt s i) f b :: scGo s f b (i + 1) n.

padTo w padc cells = append cells (repCell padc (w - len cells)).
rowFrom f b s w = padTo w 8192 (takeN w (strCells s f b)).
lineRow f b s w = padTo w (mkCell 32 f b) (takeN w (strCells s f b)).

# ---- LAYER 2: widgets -------------------------------------------------------
sumFix : unsafe List LMode -> Int .
sumFix ms = case ms of Nil -> 0 | LFix n :: r -> n + sumFix r | _ :: r -> sumFix r.
sumFlex : unsafe List LMode -> Int .
sumFlex ms = case ms of Nil -> 0 | LFlex k :: r -> k + sumFlex r | _ :: r -> sumFlex r.
hasFlex : unsafe List LMode -> Bool .
hasFlex ms = case ms of Nil -> False | LFlex _ :: _ -> True | _ :: r -> hasFlex r.

splitSizes avail ms = splitGo ms (maxI 0 (avail - sumFix ms)) (maxI 1 (sumFlex ms)) 0.
splitGo : unsafe List LMode -> Int -> Int -> Int -> List Int .
splitGo ms rest ft given =
  case ms of
    Nil -> Nil
  | LFix n :: r -> n :: splitGo r rest ft given
  | LFlex k :: r -> splitFlex k r rest ft given.
splitFlex : unsafe Int -> List LMode -> Int -> Int -> Int -> List Int .
splitFlex k r rest ft given =
  case hasFlex r of
    True -> splitFlex2 ((rest * k) / ft) r rest ft given
  | False -> (rest - given) :: splitGo r rest ft given.
splitFlex2 : unsafe Int -> List LMode -> Int -> Int -> Int -> List Int .
splitFlex2 s r rest ft given = s :: splitGo r rest ft (given + s).

modesOf : unsafe List (p289, q289) -> List p289 .
modesOf parts = case parts of Nil -> Nil | (m, _) :: r -> m :: modesOf r.

vboxW parts sz =
  (w, h) = sz;
  vbuild parts (splitSizes h (modesOf parts)) w.
vbuild : unsafe List (u289, (t289, v289) -> List w289) -> List v289 -> t289 -> List w289 .
vbuild parts sizes w =
  case (parts, sizes) of
    ((_, wg) :: pr, s :: sr) -> append (wg (w, s)) (vbuild pr sr w)
  | _ -> Nil.

hboxW parts sz =
  (w, h) = sz;
  hcat (hbufs parts (splitSizes w (modesOf parts)) h).
hbufs : unsafe List (a290, (b290, z289) -> c290) -> List b290 -> z289 -> List c290 .
hbufs parts sizes h =
  case (parts, sizes) of
    ((_, wg) :: pr, s :: sr) -> wg (s, h) :: hbufs pr sr h
  | _ -> Nil.
hcat : unsafe List (List (List d290)) -> List (List d290) .
hcat bufs = case bufs of
    Nil -> Nil
  | b :: _ -> hcat2 b bufs.
hcat2 : unsafe List (List e290) -> List (List (List e290)) -> List (List e290) .
hcat2 b bufs = case b of
    Nil -> Nil
  | _ -> catHeads bufs :: hcat (tailsOf bufs).
catHeads : unsafe List (List (List f290)) -> List f290 .
catHeads bufs = case bufs of Nil -> Nil | b :: r -> catHeads2 b r.
catHeads2 : unsafe List (List g290) -> List (List (List g290)) -> List g290 .
catHeads2 b r = case b of Nil -> Nil | row :: _ -> append row (catHeads r).
tailsOf : unsafe List (List h290) -> List (List h290) .
tailsOf bufs = case bufs of Nil -> Nil | b :: r -> tailsOf2 b r.
tailsOf2 : unsafe List i290 -> List (List i290) -> List (List i290) .
tailsOf2 b r = case b of Nil -> Nil :: tailsOf r | _ :: rt -> rt :: tailsOf r.

textW f b s sz =
  (w, h) = sz;
  rowFrom f b s w :: blankRows w (h - 1).
lineW f b s sz =
  (w, h) = sz;
  lineRow f b s w :: blankRows w (h - 1).
fillW c sz =
  (w, h) = sz;
  fillRows c w h.

borderW col child sz =
  (w, h) = sz;
  bWrap col w (child (w - 2, h - 2)).
bWrap col w inner =
  hb = mkCell 45 col 0;
  vb = mkCell 124 col 0;
  cn = mkCell 43 col 0;
  bar = cn :: append (repCell hb (w - 2)) (cn :: Nil);
  append (bar :: bMid vb inner) (bar :: Nil).
bMid : unsafe k290 -> List (List k290) -> List (List k290) .
bMid vb rows =
  case rows of
    Nil -> Nil
  | row :: r -> (vb :: append row (vb :: Nil)) :: bMid vb r.

padW n child sz =
  (w, h) = sz;
  padWrap w n (child (w - (2 * n), h - (2 * n))).
padWrap w n inner = append (blankRows w n) (append (padMid n inner) (blankRows w n)).
padMid : unsafe Int -> List (List Int) -> List (List Int) .
padMid n rows =
  case rows of
    Nil -> Nil
  | row :: r -> append (repCell 8192 n) (append row (repCell 8192 n)) :: padMid n r.

# ---- Dyn splices ------------------------------------------------------------
spliceSeg : unsafe List l290 -> Int -> List l290 -> List l290 .
spliceSeg row c0 seg =
  case c0 > 0 of
    True -> spHead row c0 seg
  | False -> spBody row seg.
spHead : unsafe List m290 -> Int -> List m290 -> List m290 .
spHead row c0 seg = case row of Nil -> Nil | x :: r -> x :: spliceSeg r (c0 - 1) seg.
spBody : unsafe List n290 -> List n290 -> List n290 .
spBody row seg =
  case seg of
    Nil -> row
  | s :: sr -> s :: spTail row sr.
spTail : unsafe List o290 -> List o290 -> List o290 .
spTail row sr = case row of Nil -> Nil | _ :: r -> spBody r sr.

spliceRows : unsafe List (List p290) -> Int -> Int -> Int -> List (List p290) -> List (List p290) .
spliceRows rows idx i0 c0 segs =
  case rows of
    Nil -> Nil
  | row :: rest -> spliceRow1 row rest idx i0 c0 segs.
spliceRow1 : unsafe List q290 -> List (List q290) -> Int -> Int -> Int -> List (List q290) -> List (List q290) .
spliceRow1 row rest idx i0 c0 segs =
  case idx < i0 of
    True -> row :: spliceRows rest (idx + 1) i0 c0 segs
  | False -> spliceRow2 row rest idx i0 c0 segs.
spliceRow2 : unsafe List r290 -> List (List r290) -> Int -> Int -> Int -> List (List r290) -> List (List r290) .
spliceRow2 row rest idx i0 c0 segs =
  case segs of
    Nil -> row :: rest
  | seg :: srest -> spliceSeg row c0 seg :: spliceRows rest (idx + 1) i0 c0 srest.

# ---- LAYER 3: diff renderer (sink = w : String -> Unit) ---------------------
esc s = strcat (chr 27) s.
fgCode c = case c == 0 of True -> "39" | False -> numS (29 + c).
bgCode c = case c == 0 of True -> "49" | False -> numS (39 + c).
numS n = "{n}".
cupS r c = esc "[{r};{c}H".
sgrS f b = esc "[{fgCode f};{bgCode b}m".

dirtyCols : unsafe List v290 -> List v290 -> Int -> List Int .
dirtyCols o n c =
  case o of
    Nil -> Nil
  | a :: ar -> dirtyCols2 a ar n c.
dirtyCols2 : unsafe w290 -> List w290 -> List w290 -> Int -> List Int .
dirtyCols2 a ar n c =
  case n of
    Nil -> Nil
  | b :: br -> dirtyHit a b ar br c.
dirtyHit : unsafe x290 -> x290 -> List x290 -> List x290 -> Int -> List Int .
dirtyHit a b ar br c =
  case a == b of
    True -> dirtyCols ar br (c + 1)
  | False -> c :: dirtyCols ar br (c + 1).

mergeRuns xs = case xs of Nil -> Nil | x :: rest -> mrGo x x rest.
mrGo : unsafe Int -> Int -> List Int -> List (Int, Int) .
mrGo s e xs =
  case xs of
    Nil -> (s, e) :: Nil
  | c :: cs -> mrStep s e c cs.
mrStep : unsafe Int -> Int -> Int -> List Int -> List (Int, Int) .
mrStep s e c cs =
  case (c - e) <= 5 of
    True -> mrGo s c cs
  | False -> (s, e) :: mrGo c c cs.

# fb = fg*16 + bg packed sgr state, 9999 = unknown.  Each run is built
# into ONE string (cursor move + sgr changes + glyphs) and handed to the
# writer whole: one capability call per run, not per byte.
diffFrame w fb old new = dfRows w fb old new 0.
dfRows : unsafe (String -> a291) -> Int -> List (List b291) -> List (List b291) -> Int -> Int .
dfRows w fb old new r =
  case old of
    Nil -> fb
  | orow :: orest -> dfRows2 w fb orow orest new r.
dfRows2 : unsafe (String -> c291) -> Int -> List d291 -> List (List d291) -> List (List d291) -> Int -> Int .
dfRows2 w fb orow orest new r =
  case new of
    Nil -> fb
  | nrow :: nrest -> dfRows w (diffRow w fb r orow nrow) orest nrest (r + 1).
diffRow w fb r orow nrow = emitRuns w fb r nrow (mergeRuns (dirtyCols orow nrow 0)).

emitRuns : unsafe (String -> h291) -> Int -> Int -> g291 -> List (Int, Int) -> Int .
emitRuns w fb r nrow runs =
  case runs of
    Nil -> fb
  | (c0, c1) :: rest -> emitRuns w (emitRun w fb r nrow c0 c1) r nrow rest.
emitRun w fb r nrow c0 c1 =
  (fb2, s) = runStr fb (cupS (r + 1) (c0 + 1)) nrow c0 c1;
  _ = w s;
  fb2.
cellLow v = v - ((v / 256) * 256).
runStr : unsafe Int -> String -> k291 -> Int -> Int -> (Int, String) .
runStr fb acc nrow c c1 =
  case c > c1 of
    True -> (fb, acc)
  | False -> runCell fb acc nrow c c1 (nrow ! (c + 1)).
runCell : unsafe Int -> String -> l291 -> Int -> Int -> Int -> (Int, String) .
runCell fb acc nrow c c1 v =
  case cellLow v == fb of
    True -> runStr fb (strcat acc (chr (v / 256))) nrow (c + 1) c1
  | False -> runStr (cellLow v)
               (strcat acc (strcat (sgrS (cellFg v) (cellBg v)) (chr (v / 256))))
               nrow (c + 1) c1.

# frame: render widget at sz, diff against old, emit, return the new
# buffer (the app's cache for the next frame).  fb 9999 forces sgr.
frame w old widget sz =
  new = widget sz;
  _ = diffFrame w 9999 old new;
  new.

enterScreen w = w (esc "[?1049h") >> w (esc "[?25l") >> w (esc "[2J").
leaveScreen w = w (esc "[0m") >> w (esc "[?25h") >> w (esc "[?1049l").

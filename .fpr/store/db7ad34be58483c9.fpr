# ============================================================================
# qlog.fpr -- the append-only page log, as a separately compiled module,
#             plus the STORAGE ACTOR System.qa spawns to own it.
#
# The on-disk layout is docs/DISK.txt made concrete:
#
#   [ METADATA | DATA | SWAP ]
#
#   METADATA   page 0, one line:  "QLOG <head> v<ver> w<wr> c<commit>
#              d<dataEnd> s<swapHead> m<merkleRoot>".  head is the DATA
#              log's first free page; w is the write flag (1 = append in
#              flight, 2 = compaction in flight); c is the commit flag
#              (0 = the last write never completed -- `ensure` rolls it
#              back by truncation at head, which never moved); d is the
#              first page past the DATA partition (0 = unpartitioned
#              legacy image, data runs to the end); s is the SWAP
#              cursor; m is the merkle root minted by the last compact.
#              A bare "QLOG <head>" superblock (the v1 grammar) still
#              opens: every field defaults, images interoperate.
#   DATA       append only and BOUNDED (appends past d are refused):
#     a record   header page "QREC <npages> <paylen> <url> h<hash>", a
#                "QDEL 0 0 <url> h<hash>" tombstone, or a BULK record
#                "QBLK <npages> <paylen> <count> h<hash>" whose payload
#                packs <count> small chunks ("<len> <url>\n" + bytes,
#                repeated) into shared pages; then <npages> whole
#                payload pages -- page-aligned, so a reader that knows
#                where a record starts does arithmetic.  h is the chunk
#                hash (31-polynomial mod 1e9+7 over the payload; 0
#                never occurs, so a v1 header's absent field reads as
#                "no hash" and verification skips it).
#     recency    position: later records for a url shadow earlier ones;
#                nothing is rewritten but the superblock.
#   SWAP       pages [d, blkPages): a circular buffer -- swapWrite
#              appends at the cursor and wraps, overwriting the oldest,
#              the reserved region actor paging (docsdata: /actorchunks)
#              lands in.
#
#   compact    the GC sweep: copy every LIVE record forward in log
#              order, truncate by writing the new head.  Liveness is
#              positional (a record is dead iff a later QDEL covers its
#              url; a bulk survives if ANY of its chunks is live; a
#              tombstone survives while an older kept record still
#              carries its url) -- so the sweep is IDEMPOTENT: compact
#              of a compacted log rewrites the same pages to the same
#              places and mints the same merkle root, which is the
#              fold of the live chunk hashes stored in the superblock.
#
# TWO read disciplines, both exported:
#   readLatest  -- the FILE read: the newest record for the url wins
#                  (a .qa, a text file, a binary blob).
#   replayAll   -- the EVENT-SOURCE read: concatenate EVERY live record
#                  for the url in log order.  This is Sol's Persistent
#                  model mapped onto the log: an app's kv url is a msg
#                  stream, `append` logs one msg, replay folds them.
#
# The ACTOR (spawned by System.qa; single writer, which is what keeps
# append-only sound with no further ceremony) answers 4-tuples
# (replyTo, tag, url, payload) with builtin Ok/Err Results:
#   tag 1 read-latest   2 append-record   3 replay-concat
#   tag 4 tombstone     5 stats           6 compact
#   tag 7 append-bulk (payload = packed chunks)   8 verify-hashes
# Requests and replies are tuples/Strings/Ints only -- the shapes that
# are stable across separately compiled units by construction.
# ============================================================================

# ---- small self-contained helpers (module units see only the prelude) ------
SVC = use "svc#47b139af84410e49".
Rpc = SVC.Rpc.

# the parsed record header: Rec is the v1 shape kept for API compat,
# RecH carries the hash field (0 = absent) -- declared constructors:
# the ABI has Tup2/Tup3 only
Rec = Type (Rec tag np pl url).
RecH = Type (RecH tag np pl url hh).

minI a b = case a < b of True -> a | False -> b.
ceilDiv a b = (a + b - 1) / b.
imod a b = a - (a / b) * b.

parseNum w = pnGo w 1 (strlen w) 0.
pnGo : unsafe String -> Int -> Int -> Int -> Int .
pnGo w i n acc = case i > n of True -> acc | False -> pnCh w i n acc (charAt w i).
pnCh : unsafe String -> Int -> Int -> Int -> Int -> Int .
pnCh w i n acc c =
  case and2 (c >= 48) (c <= 57) of
    True -> pnGo w (i + 1) n (acc * 10 + (c - 48))
  | False -> acc.
and2 a b = case a of True -> b | False -> False.

# "<letter><digits>" superblock/header field -> its number
fieldNum w = pnGo w 2 (strlen w) 0.

# word starting at i; returns (word, next index past the delimiter)
takeWord s i n = twGo s i n "".
twGo : unsafe String -> Int -> Int -> String -> (String, Int) .
twGo s i n acc = case i > n of True -> (acc, i) | False -> twCh s i n acc (charAt s i).
twCh : unsafe String -> Int -> Int -> String -> Int -> (String, Int) .
twCh s i n acc c =
  case or2 (c == 32) (c == 10) of
    True -> (acc, i + 1)
  | False -> twGo s (i + 1) n (strcat acc (chr c)).
or2 a b = case a of True -> True | False -> b.

pgsz = 4096.

# ---- the chunk hash ---------------------------------------------------------
# 31-polynomial over the payload bytes mod 1e9+7, pinned to nonzero so
# that "0" can mean "v1 header, no hash stored".  mkdisk.py computes
# the SAME fold when it seeds an image.
hprime = 1000000007.
hFix h = case h == 0 of True -> 1 | False -> h.
hashStr s = hFix (hGo s 1 (strlen s) 7).
hGo : unsafe String -> Int -> Int -> Int -> Int .
hGo s i n acc = case i > n of True -> acc | False -> hGo s (i + 1) n (imod (acc * 31 + charAt s i) hprime).
# interior merkle node over two child hashes
hCombine a b = hFix (imod ((imod (a * 1000003) hprime) + b + 17) hprime).

# ---- headers ---------------------------------------------------------------
lf = chr 10.
hdrLine tag np pl url = strcat "{tag} {np} {pl} {url}" lf.
hdrLineH tag np pl url hh = strcat "{tag} {np} {pl} {url} h{hh}" lf.
sbLine head = strcat "QLOG {head}" lf.

# parse "TAG NP PL URL [hHASH]"; -> Ok (RecH tag np pl url hh) | Err.
# For QBLK the url slot carries the chunk COUNT word.
parseHdrH s =
  n = strlen s;
  (tag, i1) = takeWord s 1 n;
  case or2 (strEq tag "QREC") (or2 (strEq tag "QDEL") (strEq tag "QBLK")) of
    True -> phRest s n i1 tag
  | False -> Err "not a record header".
phRest s n i1 tag =
  (npw, i2) = takeWord s i1 n;
  (plw, i3) = takeWord s i2 n;
  (url, i4) = takeWord s i3 n;
  Ok (RecH tag (parseNum npw) (parseNum plw) url (phHash s n i4)).
# the url's delimiter was the newline on a v1 header: no hash field
phHash s n i4 =
  case charAt s (i4 - 1) == 10 of
    True -> 0
  | False -> phWord (takeWord s i4 n).
phWord wp = case wp of (w, i) -> phTag w.
phTag w = case strlen w >= 2 of False -> 0 | True -> phTag2 w.
phTag2 w = case charAt w 1 == 104 of True -> fieldNum w | False -> 0.

# v1 shim: the historical 4-field header shape
parseHdr s = case parseHdrH s of Err e -> Err e | Ok r -> phOld r.
phOld r =
  RecH tag np pl url hh = r;
  Ok (Rec tag np pl url).
strEq a b = case strlen a == strlen b of True -> seGo a b 1 (strlen a) | False -> False.
seGo : unsafe String -> String -> Int -> Int -> Bool .
seGo a b i n = case i > n of True -> True | False -> seCh a b i n.
seCh : unsafe String -> String -> Int -> Int -> Bool .
seCh a b i n = case charAt a i == charAt b i of True -> seGo a b (i + 1) n | False -> False.

# ---- the superblock (METADATA partition) ------------------------------------
# Meta head ver wflag cflag dataEnd swapHead merkleRoot
Meta = Type (Meta head ver wflag cflag dend shead mroot).

sbLineM m =
  Meta h v w c d sw mr = m;
  strcat "QLOG {h} v{v} w{w} c{c} d{d} s{sw} m{mr}" lf.

sbMeta s =
  n = strlen s;
  (tag, i1) = takeWord s 1 n;
  case strEq tag "QLOG" of
    True -> sbMeta2 s n i1
  | False -> Err "unformatted".
sbMeta2 s n i1 =
  (hw, i2) = takeWord s i1 n;
  case charAt s (i2 - 1) == 10 of
    True -> Ok (Meta (parseNum hw) 1 0 1 0 0 0)
  | False -> Ok (sbFields s i2 n (Meta (parseNum hw) 1 0 1 0 0 0)).
sbFields : unsafe String -> Int -> Int -> Meta -> Meta .
sbFields s i n m = case i > n of True -> m | False -> sbF2 s n m (takeWord s i n).
sbF2 : unsafe String -> Int -> Meta -> (String, Int) -> Meta .
sbF2 s n m wp = case wp of (w, i2) -> sbF3 s n (sbPut m w) i2.
sbF3 : unsafe String -> Int -> Meta -> Int -> Meta .
sbF3 s n m2 i2 = case charAt s (i2 - 1) == 10 of True -> m2 | False -> sbFields s i2 n m2.
sbPut m w = case strlen w >= 2 of False -> m | True -> sbPut2 m (charAt w 1) (fieldNum w).
sbPut2 m c val =
  Meta h v w cf d sw mr = m;
  case c == 118 of True -> Meta h val w cf d sw mr
  | False -> case c == 119 of True -> Meta h v val cf d sw mr
  | False -> case c == 99 of True -> Meta h v w val d sw mr
  | False -> case c == 100 of True -> Meta h v w cf val sw mr
  | False -> case c == 115 of True -> Meta h v w cf d val mr
  | False -> case c == 109 of True -> Meta h v w cf d sw val
  | False -> m.

sbHead s = case sbMeta s of Ok m -> sbHeadM m | Err e -> Err e.
sbHeadM m =
  Meta h v w c d sw mr = m;
  Ok h.

openMeta dev = sbMeta (blkRead dev 0).
metaOr dev head = case sbMeta (blkRead dev 0) of Ok m -> m | Err _ -> Meta head 2 0 1 0 0 0.
sbW dev m = blkWrite dev 0 (sbLineM m).

# ---- format / open ----------------------------------------------------------
# ensure dev -> head : format page 0 if unrecognized, return the head.
# A cleared commit flag (a torn append: the head never moved, so the
# half-written record sits past it) is rolled back by simply marking
# the log committed again -- truncation at head IS the rollback.
ensure dev =
  case sbMeta (blkRead dev 0) of
    Ok m -> ensureCk dev m
  | Err _ -> ensureFmt dev.
ensureCk dev m =
  Meta h v w c d sw mr = m;
  case c == 0 of
    True -> ensureFix dev (Meta h v 0 1 d sw mr)
  | False -> h.
ensureFix dev m =
  Meta h v w c d sw mr = m;
  _ = sbW dev m;
  h.
# a fresh disk formats v2: the last 1/8th of the pages is the SWAP
# partition (none on tiny disks), DATA is bounded at d
ensureFmt dev =
  d = fmtDataEnd (blkPages dev);
  _ = sbW dev (Meta 1 2 0 1 d d 0);
  1.
fmtDataEnd np = case np >= 16 of True -> np - (np / 8) | False -> 0.
# ensure, returning the whole superblock
ensureMeta dev =
  _ = ensure dev;
  metaOr dev 1.

# ---- writes (single writer: the actor) --------------------------------------
# append a record under the write-ahead discipline: mark the superblock
# write-in-flight/uncommitted (head UNCHANGED), lay the pages, then
# commit head+flags in one superblock write.  -> Ok newHead | Err when
# the bounded DATA partition is full.
appendRes dev head tag url s =
  pl = strlen s;
  np = ceilDiv pl pgsz;
  wrGo dev head (hdrLineH tag np pl url (hashStr s)) s pl np (metaOr dev head).
wrGo dev head hdr s pl np m =
  Meta h v w c d sw mr = m;
  case and2 (d > 0) (head + 1 + np > d) of
    True -> Err "data partition full"
  | False -> wrDo dev head hdr s pl np (Meta head v 1 0 d sw mr).
wrDo dev head hdr s pl np m =
  Meta h v w c d sw mr = m;
  _ = sbW dev m;
  _ = blkWrite dev head hdr;
  _ = writePages dev (head + 1) s 1 pl;
  h2 = head + 1 + np;
  _ = sbW dev (Meta h2 v 0 1 d sw mr);
  Ok h2.
# v1 surface: on a full data partition the head simply does not move
appendRec dev head tag url s =
  case appendRes dev head tag url s of Ok h2 -> h2 | Err _ -> head.
writePages : unsafe dv -> Int -> String -> Int -> Int -> Unit .
writePages dev p s i pl =
  case i > pl of
    True -> Unit
  | False -> writeOne dev p s i pl.
writeOne : unsafe dv -> Int -> String -> Int -> Int -> Unit .
writeOne dev p s i pl =
  _ = blkWrite dev p (substr s i (minI pgsz (pl - i + 1)));
  writePages dev (p + 1) s (i + pgsz) pl.

# ---- BULK records -----------------------------------------------------------
# many small chunks, ONE record: the packed payload is "<len> <url>\n"
# + bytes, repeated, so a 30-byte kv msg no longer costs two pages.
bulkPack prs = bpGo prs "" 0.
bpGo : unsafe List (String, String) -> String -> Int -> (String, Int) .
bpGo prs acc cnt = case prs of Nil -> (acc, cnt) | e :: r -> bpOne r acc cnt e.
bpOne : unsafe List (String, String) -> String -> Int -> (String, String) -> (String, Int) .
bpOne r acc cnt e =
  case e of (url, pay) ->
    bpGo r (strcat acc (strcat "{strlen pay} {url}" (strcat lf pay))) (cnt + 1).

appendBulkRes dev head prs = abGo dev head (bulkPack prs).
abGo dev head pc = case pc of (pay, cnt) -> appendPackedRes dev head pay cnt.
appendBulk dev head prs =
  case appendBulkRes dev head prs of Ok h2 -> h2 | Err _ -> head.
appendPackedRes dev head pay cnt =
  pl = strlen pay;
  np = ceilDiv pl pgsz;
  wrGo dev head (hdrLineH "QBLK" np pl "{cnt}" (hashStr pay)) pay pl np (metaOr dev head).

# walkers over a packed payload
bulkLast : unsafe String -> String -> Result String String -> Result String String .
bulkLast pay url best = blGo pay url 1 (strlen pay) best.
blGo : unsafe String -> String -> Int -> Int -> Result String String -> Result String String .
blGo pay url i n best = case i > n of True -> best | False -> blE pay url n best (takeWord pay i n).
blE : unsafe String -> String -> Int -> Result String String -> (String, Int) -> Result String String .
blE pay url n best wp = case wp of (lw, i2) -> blE2 pay url n best (parseNum lw) (takeWord pay i2 n).
blE2 : unsafe String -> String -> Int -> Result String String -> Int -> (String, Int) -> Result String String .
blE2 pay url n best len wp = case wp of (uw, i3) -> blE3 pay url n best len uw i3.
blE3 : unsafe String -> String -> Int -> Result String String -> Int -> String -> Int -> Result String String .
blE3 pay url n best len uw i3 =
  case strEq uw url of
    True -> blGo pay url (i3 + len) n (Ok (substr pay i3 len))
  | False -> blGo pay url (i3 + len) n best.

bulkCat : unsafe String -> String -> String -> String .
bulkCat pay url acc = bcGo pay url 1 (strlen pay) acc.
bcGo : unsafe String -> String -> Int -> Int -> String -> String .
bcGo pay url i n acc = case i > n of True -> acc | False -> bcE pay url n acc (takeWord pay i n).
bcE : unsafe String -> String -> Int -> String -> (String, Int) -> String .
bcE pay url n acc wp = case wp of (lw, i2) -> bcE2 pay url n acc (parseNum lw) (takeWord pay i2 n).
bcE2 : unsafe String -> String -> Int -> String -> Int -> (String, Int) -> String .
bcE2 pay url n acc len wp = case wp of (uw, i3) -> bcE3 pay url n acc len uw i3.
bcE3 : unsafe String -> String -> Int -> String -> Int -> String -> Int -> String .
bcE3 pay url n acc len uw i3 =
  case strEq uw url of
    True -> bcGo pay url (i3 + len) n (strcat acc (substr pay i3 len))
  | False -> bcGo pay url (i3 + len) n acc.

bulkCnt : unsafe String -> String -> Int .
bulkCnt pay url = bnGo pay url 1 (strlen pay) 0.
bnGo : unsafe String -> String -> Int -> Int -> Int -> Int .
bnGo pay url i n c = case i > n of True -> c | False -> bnE pay url n c (takeWord pay i n).
bnE : unsafe String -> String -> Int -> Int -> (String, Int) -> Int .
bnE pay url n c wp = case wp of (lw, i2) -> bnE2 pay url n c (parseNum lw) (takeWord pay i2 n).
bnE2 : unsafe String -> String -> Int -> Int -> Int -> (String, Int) -> Int .
bnE2 pay url n c len wp = case wp of (uw, i3) -> bnE3 pay url n c len uw i3.
bnE3 : unsafe String -> String -> Int -> Int -> Int -> String -> Int -> Int .
bnE3 pay url n c len uw i3 =
  case strEq uw url of
    True -> bnGo pay url (i3 + len) n (c + 1)
  | False -> bnGo pay url (i3 + len) n c.

bulkCntAll : unsafe String -> Int .
bulkCntAll pay = baGo pay 1 (strlen pay) 0.
baGo : unsafe String -> Int -> Int -> Int -> Int .
baGo pay i n c = case i > n of True -> c | False -> baE pay n c (takeWord pay i n).
baE : unsafe String -> Int -> Int -> (String, Int) -> Int .
baE pay n c wp = case wp of (lw, i2) -> baE2 pay n c (parseNum lw) (takeWord pay i2 n).
baE2 : unsafe String -> Int -> Int -> Int -> (String, Int) -> Int .
baE2 pay n c len wp = case wp of (uw, i3) -> baGo pay (i3 + len) n (c + 1).

bulkUrls : unsafe String -> List String .
bulkUrls pay = buGo pay 1 (strlen pay) Nil.
buGo : unsafe String -> Int -> Int -> List String -> List String .
buGo pay i n acc = case i > n of True -> acc | False -> buE pay n acc (takeWord pay i n).
buE : unsafe String -> Int -> List String -> (String, Int) -> List String .
buE pay n acc wp = case wp of (lw, i2) -> buE2 pay n acc (parseNum lw) (takeWord pay i2 n).
buE2 : unsafe String -> Int -> List String -> Int -> (String, Int) -> List String .
buE2 pay n acc len wp = case wp of (uw, i3) -> buGo pay (i3 + len) n (append acc (uw :: Nil)).

# ---- reads -------------------------------------------------------------------
# payload of the record whose header is at page p (paylen pl)
readPayload dev p pl = rpGo dev (p + 1) pl "".
rpGo : unsafe dv -> Int -> Int -> String -> String .
rpGo dev p left acc =
  case left <= 0 of
    True -> acc
  | False -> rpOne dev p left acc.
rpOne : unsafe dv -> Int -> Int -> String -> String .
rpOne dev p left acc =
  s = blkRead dev p;
  rpGo dev (p + 1) (left - pgsz) (strcat acc (substr s 1 (minI pgsz left))).

# readLatest: STREAM the log, keep the last live record for url.
#   -> Ok content | Err "no such file"
readLatest dev head url = rlGo dev head url 1 (Err "no such file").
rlGo : unsafe dv -> Int -> String -> Int -> Result String String -> Result String String .
rlGo dev head url p best =
  case p >= head of
    True -> best
  | False -> rlStep dev head url p best (parseHdrH (blkRead dev p)).
rlStep : unsafe dv -> Int -> String -> Int -> Result String String -> Result RecH String -> Result String String .
rlStep dev head url p best h =
  case h of
    Err _ -> best
  | Ok rec -> rlHit dev head url p best rec.
rlHit : unsafe dv -> Int -> String -> Int -> Result String String -> RecH -> Result String String .
rlHit dev head url p best rec =
  RecH tag np pl u hh = rec;
  case strEq tag "QBLK" of
    True -> rlGo dev head url (p + 1 + np) (bulkLast (readPayload dev p pl) url best)
  | False -> rlHit2 dev head url p best rec.
rlHit2 : unsafe dv -> Int -> String -> Int -> Result String String -> RecH -> Result String String .
rlHit2 dev head url p best rec =
  RecH tag np pl u hh = rec;
  case strEq u url of
    True -> rlTake dev head url p pl (strEq tag "QDEL") np
  | False -> rlGo dev head url (p + 1 + np) best.
rlTake : unsafe dv -> Int -> String -> Int -> Int -> Bool -> Int -> Result String String .
rlTake dev head url p pl dead np =
  case dead of
    True -> rlGo dev head url (p + 1 + np) (Err "no such file")
  | False -> rlGo dev head url (p + 1 + np) (Ok (readPayload dev p pl)).

# replayAll: concatenate EVERY live record for url, log order (the
# event-source read; a QDEL resets the stream -- "forget my history").
replayAll dev head url = raGo dev head url 1 "".
raGo : unsafe dv -> Int -> String -> Int -> String -> String .
raGo dev head url p acc =
  case p >= head of
    True -> acc
  | False -> raStep dev head url p acc (parseHdrH (blkRead dev p)).
raStep : unsafe dv -> Int -> String -> Int -> String -> Result RecH String -> String .
raStep dev head url p acc h =
  case h of
    Err _ -> acc
  | Ok rec -> raHit dev head url p acc rec.
raHit : unsafe dv -> Int -> String -> Int -> String -> RecH -> String .
raHit dev head url p acc rec =
  RecH tag np pl u hh = rec;
  case strEq tag "QBLK" of
    True -> raGo dev head url (p + 1 + np) (bulkCat (readPayload dev p pl) url acc)
  | False -> raHit2 dev head url p acc rec.
raHit2 : unsafe dv -> Int -> String -> Int -> String -> RecH -> String .
raHit2 dev head url p acc rec =
  RecH tag np pl u hh = rec;
  case strEq u url of
    True -> raTake dev head url (p + 1 + np) acc (strEq tag "QDEL") (readPayload dev p pl)
  | False -> raGo dev head url (p + 1 + np) acc.
raTake : unsafe dv -> Int -> String -> Int -> String -> Bool -> String -> String .
raTake dev head url pnext acc dead pay =
  case dead of
    True -> raGo dev head url pnext ""
  | False -> raGo dev head url pnext (strcat acc pay).

# count live records for url (replay length without the bytes)
countRecs dev head url = crGo dev head url 1 0.
crGo : unsafe dv -> Int -> String -> Int -> Int -> Int .
crGo dev head url p n =
  case p >= head of
    True -> n
  | False -> crStep dev head url p n (parseHdrH (blkRead dev p)).
crStep : unsafe dv -> Int -> String -> Int -> Int -> Result RecH String -> Int .
crStep dev head url p n h =
  case h of
    Err _ -> n
  | Ok rec -> crHit dev head url p n rec.
crHit : unsafe dv -> Int -> String -> Int -> Int -> RecH -> Int .
crHit dev head url p n rec =
  RecH tag np pl u hh = rec;
  case strEq tag "QBLK" of
    True -> crGo dev head url (p + 1 + np) (n + bulkCnt (readPayload dev p pl) url)
  | False -> crHit2 dev head url p n rec.
crHit2 : unsafe dv -> Int -> String -> Int -> Int -> RecH -> Int .
crHit2 dev head url p n rec =
  RecH tag np pl u hh = rec;
  case strEq u url of
    True -> crTake dev head url p n (strEq tag "QDEL") np
  | False -> crGo dev head url (p + 1 + np) n.
crTake : unsafe dv -> Int -> String -> Int -> Int -> Bool -> Int -> Int .
crTake dev head url p n dead np =
  case dead of
    True -> crGo dev head url (p + 1 + np) 0
  | False -> crGo dev head url (p + 1 + np) (n + 1).

# ---- hash verification ------------------------------------------------------
# walk every record, recompute each stored chunk hash.
#   -> Ok "verified <n> records" | Err "hash mismatch at page <p>"
verifyLog dev head = vGo dev head 1 0.
vGo : unsafe dv -> Int -> Int -> Int -> Result String String .
vGo dev head p cnt =
  case p >= head of
    True -> Ok "verified {cnt} records"
  | False -> vStep dev head p cnt (parseHdrH (blkRead dev p)).
vStep : unsafe dv -> Int -> Int -> Int -> Result RecH String -> Result String String .
vStep dev head p cnt h =
  case h of
    Err _ -> Ok "verified {cnt} records"
  | Ok rec -> vHit dev head p cnt rec.
vHit : unsafe dv -> Int -> Int -> Int -> RecH -> Result String String .
vHit dev head p cnt rec =
  RecH tag np pl u hh = rec;
  case hh == 0 of
    True -> vGo dev head (p + 1 + np) (cnt + 1)
  | False -> vChk dev head p cnt np (hh == hashStr (readPayload dev p pl)).
vChk : unsafe dv -> Int -> Int -> Int -> Int -> Bool -> Result String String .
vChk dev head p cnt np ok =
  case ok of
    True -> vGo dev head (p + 1 + np) (cnt + 1)
  | False -> Err "hash mismatch at page {p}".

# ---- the SWAP partition -----------------------------------------------------
# a circular page buffer over [dataEnd, blkPages): swapWrite lays the
# page at the cursor and advances it (wrapping onto the oldest --
# DISK.txt's "can be overwritten when it reaches the end, but also
# append").  -> the page written, or -1 on an unpartitioned image.
swapWrite dev s = swGo dev s (metaOr dev 1).
swGo dev s m =
  Meta h v w c d sw mr = m;
  case d == 0 of
    True -> 0 - 1
  | False -> swDo dev s m.
swDo dev s m =
  Meta h v w c d sw mr = m;
  _ = blkWrite dev sw s;
  _ = sbW dev (Meta h v w c d (swNext (sw + 1) (blkPages dev) d) mr);
  sw.
swNext nxt np d = case nxt >= np of True -> d | False -> nxt.
swapRead dev p = blkRead dev p.

# ---- compaction (GC) --------------------------------------------------------
# The sweep the log's latest-wins semantics make cheap: liveness is a
# per-url positional predicate, no reference tracing.  Copy live
# records forward IN ORDER, truncate by superblock, mint the merkle
# root over the live chunk hashes.  Buffering the live pages first
# makes the copy alias-free; the w2/c0 superblock marks the sweep
# in flight (a crash mid-sweep is DETECTED, not yet recovered -- the
# next elaboration is sweeping through the swap partition).
RI = Type (RI page np del urls).

scanRIs dev head = riGo dev head 1 Nil.
riGo : unsafe dv -> Int -> Int -> List RI -> List RI .
riGo dev head p acc =
  case p >= head of
    True -> acc
  | False -> riStep dev head p acc (parseHdrH (blkRead dev p)).
riStep : unsafe dv -> Int -> Int -> List RI -> Result RecH String -> List RI .
riStep dev head p acc h =
  case h of
    Err _ -> acc
  | Ok rec -> riHit dev head p acc rec.
riHit : unsafe dv -> Int -> Int -> List RI -> RecH -> List RI .
riHit dev head p acc rec =
  RecH tag np pl u hh = rec;
  riGo dev head (p + 1 + np) (append acc ((RI p np (strEq tag "QDEL") (riUrls dev tag p pl u)) :: Nil)).
riUrls dev tag p pl u =
  case strEq tag "QBLK" of
    True -> bulkUrls (readPayload dev p pl)
  | False -> u :: Nil.

# per-url position of the LAST tombstone
lastDels ris = ldGo ris Nil.
ldGo : unsafe List RI -> List (String, Int) -> List (String, Int) .
ldGo ris acc = case ris of Nil -> acc | ri :: r -> ldStep r acc ri.
ldStep : unsafe List RI -> List (String, Int) -> RI -> List (String, Int) .
ldStep r acc ri =
  RI p np del urls = ri;
  case del of
    True -> ldGo r (ldPut acc (headUrl urls) p)
  | False -> ldGo r acc.
headUrl urls = case urls of Nil -> "" | u :: r -> u.
ldPut : unsafe List (String, Int) -> String -> Int -> List (String, Int) .
ldPut acc u p = case acc of Nil -> (u, p) :: Nil | e :: r -> ldPut2 r u p e.
ldPut2 : unsafe List (String, Int) -> String -> Int -> (String, Int) -> List (String, Int) .
ldPut2 r u p e =
  case e of (eu, ep) ->
    case strEq eu u of True -> (u, p) :: r | False -> e :: ldPut r u p.
ldGet : unsafe List (String, Int) -> String -> Int .
ldGet acc u = case acc of Nil -> 0 | e :: r -> ldGet2 r u e.
ldGet2 : unsafe List (String, Int) -> String -> (String, Int) -> Int .
ldGet2 r u e =
  case e of (eu, ep) ->
    case strEq eu u of True -> ep | False -> ldGet r u.

# a chunk at position p is live iff no later tombstone covers its url
anyLive : unsafe List (String, Int) -> List String -> Int -> Bool .
anyLive ld urls p = case urls of Nil -> False | u :: r -> anyLive2 ld r p (p > ldGet ld u).
anyLive2 : unsafe List (String, Int) -> List String -> Int -> Bool -> Bool .
anyLive2 ld r p hit = case hit of True -> True | False -> anyLive ld r p.

member : unsafe List String -> String -> Bool .
member urls u = case urls of Nil -> False | x :: r -> member2 r u (strEq x u).
member2 : unsafe List String -> String -> Bool -> Bool .
member2 r u hit = case hit of True -> True | False -> member r u.

# a tombstone earns its keep while an older kept record carries its url
hasEarlier : unsafe List RI -> String -> Int -> Bool .
hasEarlier keptA u dp = case keptA of Nil -> False | ri :: r -> heStep r u dp ri.
heStep : unsafe List RI -> String -> Int -> RI -> Bool .
heStep r u dp ri =
  RI p np del urls = ri;
  heStep2 r u dp (and2 (p < dp) (member urls u)).
heStep2 : unsafe List RI -> String -> Int -> Bool -> Bool .
heStep2 r u dp hit = case hit of True -> True | False -> hasEarlier r u dp.

kaAdd acc ri keep = case keep of True -> append acc (ri :: Nil) | False -> acc.
# pass 1: the kept DATA records (any live chunk)
kaGo : unsafe List RI -> List (String, Int) -> List RI -> List RI .
kaGo ris ld acc = case ris of Nil -> acc | ri :: r -> kaStep r ld acc ri.
kaStep : unsafe List RI -> List (String, Int) -> List RI -> RI -> List RI .
kaStep r ld acc ri =
  RI p np del urls = ri;
  case del of
    True -> kaGo r ld acc
  | False -> kaGo r ld (kaAdd acc ri (anyLive ld urls p)).
# pass 2: everything kept, in log order (tombstones included when needed)
kGo : unsafe List RI -> List (String, Int) -> List RI -> List RI -> List RI .
kGo ris ld keptA acc = case ris of Nil -> acc | ri :: r -> kStep r ld keptA acc ri.
kStep : unsafe List RI -> List (String, Int) -> List RI -> List RI -> RI -> List RI .
kStep r ld keptA acc ri =
  RI p np del urls = ri;
  case del of
    True -> kGo r ld keptA (kaAdd acc ri (hasEarlier keptA (headUrl urls) p))
  | False -> kGo r ld keptA (kaAdd acc ri (anyLive ld urls p)).

rpsGo : unsafe dv -> Int -> Int -> List String -> List String .
rpsGo dev p cnt acc =
  case cnt <= 0 of
    True -> acc
  | False -> rpsGo dev (p + 1) (cnt - 1) (append acc ((blkRead dev p) :: Nil)).
bufPages : unsafe dv -> List RI -> List String -> List String .
bufPages dev kept acc = case kept of Nil -> acc | ri :: r -> bufStep dev r acc ri.
bufStep : unsafe dv -> List RI -> List String -> RI -> List String .
bufStep dev r acc ri =
  RI p np del urls = ri;
  bufPages dev r (append acc (rpsGo dev p (np + 1) Nil)).

# merkle leaves: the kept records' chunk hashes (recomputed when a v1
# header stored none)
lvGo : unsafe dv -> List RI -> List Int -> List Int .
lvGo dev kept acc = case kept of Nil -> acc | ri :: r -> lvStep dev r acc ri.
lvStep : unsafe dv -> List RI -> List Int -> RI -> List Int .
lvStep dev r acc ri =
  RI p np del urls = ri;
  case del of
    True -> lvGo dev r acc
  | False -> lvGo dev r (append acc ((recLeaf dev p) :: Nil)).
recLeaf dev p = recLeaf2 dev p (parseHdrH (blkRead dev p)).
recLeaf2 dev p h = case h of Err _ -> 0 | Ok rec -> recLeaf3 dev p rec.
recLeaf3 dev p rec =
  RecH tag np pl u hh = rec;
  case hh == 0 of True -> hashStr (readPayload dev p pl) | False -> hh.

mkRoot : unsafe List Int -> Int .
mkRoot ls = case ls of Nil -> 0 | x :: r -> mkRoot2 ls r x.
mkRoot2 : unsafe List Int -> List Int -> Int -> Int .
mkRoot2 ls r x = case r of Nil -> x | y :: r2 -> mkRoot (pairUp ls).
pairUp : unsafe List Int -> List Int .
pairUp ls = case ls of Nil -> Nil | x :: r -> pairUp2 x r.
pairUp2 : unsafe Int -> List Int -> List Int .
pairUp2 x r = case r of Nil -> x :: Nil | y :: r2 -> (hCombine x y) :: pairUp r2.

writeBuf : unsafe dv -> Int -> List String -> Int .
writeBuf dev p pages = case pages of Nil -> p | pg :: r -> writeBuf2 dev p r pg.
writeBuf2 : unsafe dv -> Int -> List String -> String -> Int .
writeBuf2 dev p r pg =
  _ = blkWrite dev p pg;
  writeBuf dev (p + 1) r.

# compact dev head -> the new head (idempotent: see the header comment)
compact dev head =
  ris = scanRIs dev head;
  ld = lastDels ris;
  kept = kGo ris ld (kaGo ris ld Nil) Nil;
  cpDo dev (metaOr dev head) (bufPages dev kept Nil) (mkRoot (lvGo dev kept Nil)).
cpDo dev m pages root =
  Meta h v w c d sw mr = m;
  _ = sbW dev (Meta h v 2 0 d sw mr);
  h2 = writeBuf dev 1 pages;
  _ = sbW dev (Meta h2 v 0 1 d sw root);
  h2.

# ---- the boot-scan INDEX -----------------------------------------------------
# One pass over the log at actor start builds the index: one entry per
# LIVE chunk -- bulk records index each packed chunk at its byte
# offset -- in log order (a QDEL drops the url's earlier entries).
# Reads become index walks instead of disk walks; appends extend the
# index incrementally.  The next elaboration after this is per-url
# URActors.
Ent = Type (Ent url page pl off len).

entRead dev e =
  Ent u p pl off len = e;
  substr (readPayload dev p pl) off len.

scanIdxE dev head = sxGo dev head 1 Nil.
sxGo : unsafe dv -> Int -> Int -> List Ent -> List Ent .
sxGo dev head p idx =
  case p >= head of
    True -> idx
  | False -> sxStep dev head p idx (parseHdrH (blkRead dev p)).
sxStep : unsafe dv -> Int -> Int -> List Ent -> Result RecH String -> List Ent .
sxStep dev head p idx h =
  case h of
    Err _ -> idx
  | Ok rec -> sxHit dev head p idx rec.
sxHit : unsafe dv -> Int -> Int -> List Ent -> RecH -> List Ent .
sxHit dev head p idx rec =
  RecH tag np pl u hh = rec;
  case strEq tag "QDEL" of
    True -> sxGo dev head (p + 1 + np) (dropUrlE idx u)
  | False -> sxHit2 dev head p idx rec.
sxHit2 : unsafe dv -> Int -> Int -> List Ent -> RecH -> List Ent .
sxHit2 dev head p idx rec =
  RecH tag np pl u hh = rec;
  case strEq tag "QBLK" of
    True -> sxGo dev head (p + 1 + np) (append idx (bulkEnts (readPayload dev p pl) p pl))
  | False -> sxGo dev head (p + 1 + np) (append idx ((Ent u p pl 1 pl) :: Nil)).

bulkEnts : unsafe String -> Int -> Int -> List Ent .
bulkEnts pay page pl = beGo pay page pl 1 (strlen pay) Nil.
beGo : unsafe String -> Int -> Int -> Int -> Int -> List Ent -> List Ent .
beGo pay page pl i n acc = case i > n of True -> acc | False -> beE pay page pl n acc (takeWord pay i n).
beE : unsafe String -> Int -> Int -> Int -> List Ent -> (String, Int) -> List Ent .
beE pay page pl n acc wp = case wp of (lw, i2) -> beE2 pay page pl n acc (parseNum lw) (takeWord pay i2 n).
beE2 : unsafe String -> Int -> Int -> Int -> List Ent -> Int -> (String, Int) -> List Ent .
beE2 pay page pl n acc len wp =
  case wp of (uw, i3) ->
    beGo pay page pl (i3 + len) n (append acc ((Ent uw page pl i3 len) :: Nil)).

append : unsafe List t -> List t -> List t .
append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.
dropUrlE : unsafe List Ent -> String -> List Ent .
dropUrlE idx u =
  case idx of
    Nil -> Nil
  | e :: r -> dropUrlE2 r u e.
dropUrlE2 : unsafe List Ent -> String -> Ent -> List Ent .
dropUrlE2 r u e =
  Ent eu ep epl eo el = e;
  case strEq eu u of True -> dropUrlE r u | False -> e :: dropUrlE r u.

# index reads
idxLatestE dev idx url = ilGoE dev idx url (Err "no such file").
ilGoE : unsafe dv -> List Ent -> String -> Result String String -> Result String String .
ilGoE dev idx url best =
  case idx of
    Nil -> best
  | e :: r -> ilStepE dev r url best e.
ilStepE : unsafe dv -> List Ent -> String -> Result String String -> Ent -> Result String String .
ilStepE dev r url best e =
  Ent u p pl off len = e;
  case strEq u url of
    True -> ilGoE dev r url (Ok (entRead dev e))
  | False -> ilGoE dev r url best.
idxReplayE : unsafe dv -> List Ent -> String -> String -> String .
idxReplayE dev idx url acc =
  case idx of
    Nil -> acc
  | e :: r -> irStepE dev r url acc e.
irStepE : unsafe dv -> List Ent -> String -> String -> Ent -> String .
irStepE dev r url acc e =
  Ent u p pl off len = e;
  case strEq u url of
    True -> idxReplayE dev r url (strcat acc (entRead dev e))
  | False -> idxReplayE dev r url acc.
idxCountE : unsafe List Ent -> String -> Int .
idxCountE idx url =
  case idx of
    Nil -> 0
  | e :: r -> icStepE r url e.
icStepE : unsafe List Ent -> String -> Ent -> Int .
icStepE r url e =
  Ent u p pl off len = e;
  case strEq u url of True -> 1 + idxCountE r url | False -> idxCountE r url.

# ---- the v1 tuple index (kept for API compat; skips bulk records) -----------
scanIdx dev head = siGo dev head 1 Nil.
siGo : unsafe dv -> Int -> Int -> List (String, Int, o287) -> List (String, Int, o287) .
siGo dev head p idx =
  case p >= head of
    True -> idx
  | False -> siStep dev head p idx (parseHdr (blkRead dev p)).
siStep : unsafe dv -> Int -> Int -> List (String, Int, q287) -> Result Rec String -> List (String, Int, q287) .
siStep dev head p idx h =
  case h of
    Err _ -> idx
  | Ok rec -> siHit dev head p idx rec.
siHit : unsafe dv -> Int -> Int -> List (String, Int, s287) -> Rec -> List (String, Int, s287) .
siHit dev head p idx rec =
  Rec tag np pl u = rec;
  case strEq tag "QDEL" of
    True -> siGo dev head (p + 1 + np) (dropUrl idx u)
  | False -> siHit2 dev head p idx rec.
siHit2 : unsafe dv -> Int -> Int -> List (String, Int, s287) -> Rec -> List (String, Int, s287) .
siHit2 dev head p idx rec =
  Rec tag np pl u = rec;
  case strEq tag "QBLK" of
    True -> siGo dev head (p + 1 + np) idx
  | False -> siGo dev head (p + 1 + np) (append idx ((u, p, pl) :: Nil)).
dropUrl : unsafe List (String, u287, v287) -> String -> List (String, u287, v287) .
dropUrl idx u =
  case idx of
    Nil -> Nil
  | e :: r -> case e of (eu, ep, epl) ->
      case strEq eu u of True -> dropUrl r u | False -> e :: dropUrl r u.
idxLatest dev idx url = ilGo dev idx url (Err "no such file").
ilGo : unsafe dv -> List (String, Int, Int) -> String -> Result String y287 -> Result String y287 .
ilGo dev idx url best =
  case idx of
    Nil -> best
  | e :: r -> ilStep dev r url best e.
ilStep : unsafe dv -> List (String, Int, Int) -> String -> Result String a288 -> (String, Int, Int) -> Result String a288 .
ilStep dev r url best e =
  case e of (u, p, pl) ->
    case strEq u url of
      True -> ilGo dev r url (Ok (readPayload dev p pl))
    | False -> ilGo dev r url best.
idxReplay : unsafe dv -> List (String, Int, Int) -> String -> String -> String .
idxReplay dev idx url acc =
  case idx of
    Nil -> acc
  | e :: r -> irStep dev r url acc e.
irStep : unsafe dv -> List (String, Int, Int) -> String -> String -> (String, Int, Int) -> String .
irStep dev r url acc e =
  case e of (u, p, pl) ->
    case strEq u url of
      True -> idxReplay dev r url (strcat acc (readPayload dev p pl))
    | False -> idxReplay dev r url acc.
idxCount : unsafe List (String, d288, e288) -> String -> Int .
idxCount idx url =
  case idx of
    Nil -> 0
  | e :: r -> icStep r url e.
icStep : unsafe List (String, f288, g288) -> String -> (String, f288, g288) -> Int .
icStep r url e =
  case e of (u, _, _) ->
    case strEq u url of True -> 1 + idxCount r url | False -> idxCount r url.

# ---- the storage actor -------------------------------------------------------
# System.qa spawns `actor dev`; the actor owns (dev, head, idx) and is
# the ONE writer.  Reads consult the boot-scan index.
actor dev me =
  head = ensure dev;
  aLoop dev me head (scanIdxE dev head).
aLoop : unsafe dv -> Int -> Int -> List Ent -> zz .
aLoop dev me head idx =
  m = receive me;
  case m of Rpc replyTo tag url pay -> aServe dev me head idx replyTo tag url pay.
aServe : unsafe dv -> Int -> Int -> List Ent -> Int -> Int -> String -> String -> zz .
aServe dev me head idx replyTo tag url pay =
  case tag of
    1 -> send replyTo (idxLatestE dev idx url)           >> aLoop dev me head idx
  | 2 -> aAppend dev me head idx replyTo "QREC" url pay
  | 3 -> send replyTo (Ok (idxReplayE dev idx url ""))   >> aLoop dev me head idx
  | 4 -> aAppend dev me head idx replyTo "QDEL" url ""
  | 5 -> send replyTo (Ok (aStats dev head idx url))     >> aLoop dev me head idx
  | 6 -> aCompact dev me head replyTo
  | 7 -> aAppendBulk dev me head idx replyTo pay
  | 8 -> send replyTo (verifyLog dev head)               >> aLoop dev me head idx
  | _ -> send replyTo (Err "storage: unknown request tag") >> aLoop dev me head idx.
aStats dev head idx url = aStats2 head idx url (metaOr dev head).
aStats2 head idx url m =
  Meta h v w c d sw mr = m;
  "head={head} url-records={idxCountE idx url} v={v} w={w} c={c} data-end={d} swap-head={sw} merkle={mr}".
aAppend : unsafe dv -> Int -> Int -> List Ent -> Int -> String -> String -> String -> zz .
aAppend dev me head idx replyTo tag url pay =
  case appendRes dev head tag url pay of
    Err e -> send replyTo (Err e) >> aLoop dev me head idx
  | Ok h2 -> aAppendOk dev me head idx replyTo tag url pay h2.
aAppendOk : unsafe dv -> Int -> Int -> List Ent -> Int -> String -> String -> String -> Int -> zz .
aAppendOk dev me head idx replyTo tag url pay h2 =
  # OWN COPY of the url before it goes into the long-lived index: the
  # message's url string lives in the SENDER's slab -- freed when that
  # actor is reaped, or bulk-freed with a loaded process's whole arena
  # on exit (the syscall trampoline allocates it from the process
  # heap).  strcat always allocates fresh in the CURRENT actor's slab,
  # and aAppendOk runs in the storage actor, so this pins ownership here.
  u2 = strcat url "";
  idx2 = case strEq tag "QDEL" of
           True -> dropUrlE idx url
         | False -> append idx ((Ent u2 head (strlen pay) 1 (strlen pay)) :: Nil);
  _ = send replyTo (Ok "");
  aLoop dev me h2 idx2.
aAppendBulk : unsafe dv -> Int -> Int -> List Ent -> Int -> String -> zz .
aAppendBulk dev me head idx replyTo pay =
  case appendPackedRes dev head pay (bulkCntAll pay) of
    Err e -> send replyTo (Err e) >> aLoop dev me head idx
  | Ok h2 -> aAppendBulkOk dev me head idx replyTo pay h2.
aAppendBulkOk : unsafe dv -> Int -> Int -> List Ent -> Int -> String -> Int -> zz .
aAppendBulkOk dev me head idx replyTo pay h2 =
  # bulkEnts rebuilds each chunk url via takeWord/strcat, so the index
  # entries own their strings in THIS actor's slab (same discipline as
  # aAppendOk's u2)
  idx2 = append idx (bulkEnts pay head (strlen pay));
  _ = send replyTo (Ok "");
  aLoop dev me h2 idx2.
aCompact : unsafe dv -> Int -> Int -> Int -> zz .
aCompact dev me head replyTo =
  h2 = compact dev head;
  _ = send replyTo (Ok "compacted head={h2}");
  aLoop dev me h2 (scanIdxE dev h2).

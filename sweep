#!/usr/bin/env -S sol +0.13.1
# The old Bash leg manifest is archived; this runs current Sol checks only.
B = use "sol/lib/build".
> argv = args Unit;
  _ = if argv == [] or argv == ["--in-place"] then Unit else error "usage: ./sweep [--in-place]; legacy leg filters are retired";
  runner = B.setting "SOL" "sol";
  _ = B.command [runner,"tools/sol-only-check.sol"];
  _ = B.command [runner,"tools/checkout.sol","build","host"];
  _ = B.command [runner,"tools/checkout.sol","pack","tests/sol-hello.fpr","--out","build/sol-smoke/hello","--bundle"];
  output = B.query ["build/sol-smoke/hello/run"];
  if Str.contains "Sol-only bundle smoke" output then print "Sol build/package/run smoke: passed" else error "bundle output mismatch: {output}".

# qa.fpr -- QAR2 app archives (docs/2026-07-19-QA-FORMAT.md): written from a
# manifest and an ELF as tools/mkqa.py writes them, byte for byte, and read
# back with tools/qos_archive.py's checks.

E = use "elf".
H = use "host".
T = use "toml".
J = use "std/json".
L = use "std/list".
M = use "std/map".
O = use "std/option".
R = use "std/result".
Ord = use "std/order".
S = use "std/string".
B = use "std/binary".

# ---- shared helpers -----------------------------------------------------------------

require True _ = Ok Unit.
require False why = Err why.

allChars pred s i = allCharsGo pred s i (strlen s - i).
allCharsGo : (Int -> Bool) -> String -> Int -> (rem : Int | measure rem) -> Bool .
allCharsGo pred s i rem =
  if rem <= 0 then True
  else pred (charAt s i) and allCharsGo pred s (i + 1) (rem - 1).

# ---- writing ------------------------------------------------------------------------
# opts: { relocatable : Bool, moved : O.Option String, delta : Int, imports : Bool }
write : unsafe String -> String -> { relocatable : Bool, moved : O.Option String, delta : Int, imports : Bool } -> Result String String .
write manifest elf opts =
  E.flatten elf
  |> R.andThen (fn img ->
      E.architecture (E.machine elf)
      |> R.andThen (declared manifest)
      |> R.andThen (fn man ->
          if not opts.relocatable then Ok (assemble man img False "" False "")
          else require (img.base == 0) "mkqa: --relocatable expects an image linked at 0"
            |> R.andThen (fn u -> E.relocations elf img.base (strlen img.image))
            |> R.andThen (fn relocs ->
                importsOf opts elf img.base
                |> R.andThen (fn imps ->
                    movedOk opts img.image relocs
                    |> R.map (fn u ->
                        relocBytes = relocs |> L.map B.putU32le |> strJoin "";
                        impBytes = imps |> L.map (fn r -> strcat r "\n") |> strJoin "";
                        assemble man img True relocBytes opts.imports impBytes))))).

importsOf opts elf base | opts.imports = E.importRows elf base.
importsOf _ _ _ = Ok Nil.

movedOk : unsafe { relocatable : Bool, moved : O.Option String, delta : Int, imports : Bool } -> String -> List Int -> Result Unit String .
movedOk opts image relocs = case opts.moved of
    O.None -> Ok Unit
  | O.Some other -> E.flatten other |> R.andThen (fn o -> E.checkMoved image relocs o.image opts.delta).

# The architecture is a packaging fact from the ELF: a manifest that states
# it must agree, one that does not gets it as its first line.
declared manifest arch =
  found = manifest
    |> S.split "\n"
    |> L.takeWhile (fn l -> not (tableLine l 0 (strlen l)))
    |> L.filter archLine;
  case found of
      Nil -> Ok (strcat "architecture = \"{arch}\"\n" manifest)
    | l :: Nil ->
        if archValue l == arch then Ok manifest
        else Err "mkqa: manifest architecture differs from the ELF image"
    | _ -> Err "mkqa: manifest architecture differs from the ELF image".

tableLine : String -> Int -> (rem : Int | measure rem) -> Bool .
tableLine m i rem =
  if rem <= 0 then False
  else
    c = charAt m i;
    if c == 32 or c == 9 or c == 13 then tableLine m (i + 1) (rem - 1)
    else c == 91.

archLine l = S.startsWith "architecture" l and archEq l 12 (strlen l - 12).
archEq : String -> Int -> (rem : Int | measure rem) -> Bool .
archEq l i rem =
  if rem <= 0 then False
  else
    c = charAt l i;
    if c == 32 or c == 9 then archEq l (i + 1) (rem - 1)
    else c == 61.

# `architecture = "x"` exactly, with optional spaces; anything else is no value
archValue l =
  rest = substr l (strIndexOf "=" l + 1) (strlen l) |> S.trim;
  if strlen rest >= 2 and charAt rest 0 == 34 and charAt rest (strlen rest - 1) == 34
    then substr rest 1 (strlen rest - 2)
    else "".

assemble : unsafe String -> { base : Int, entry : Int, execsz : Int, rwoff : Int, image : String, memsz : Int } -> Bool -> String -> Bool -> String -> String .
assemble man img relocatable reloc withImports imports =
  load = S.concat [
    "base {img.base}\nentry {img.entry}\nexecsz {img.execsz}\n",
    "rwoff {img.rwoff}\nimagesz {strlen img.image}\nmemsz {img.memsz}\n",
    "sha {H.sha256 img.image}\n",
    if relocatable then "relsha {H.sha256 (strcat reloc imports)}\n" else ""];
  parts = L.concat [
    [("MANIFEST", man), ("LOAD", load), ("IMAGE", img.image)],
    if relocatable then [("RELOC", reloc)] else Nil,
    if withImports then [("IMPORT", imports)] else Nil];
  table = tableRows parts 0 Nil;
  strJoin "" ("QAR2\n" :: S.join "\n" table :: "\n\n" :: L.map (fn p -> (_, b) = p; b) parts).

tableRows : (parts : List (String, String) | measure parts) -> Int -> List String -> List String .
tableRows parts off acc = case parts of
    Nil -> L.reverse acc
  | (name, blob) :: rest -> tableRows rest (off + strlen blob) ("{name} {off} {strlen blob}" :: acc).

# ---- reading ------------------------------------------------------------------------

# archive ID rules: 1-64 ASCII bytes of [A-Za-z0-9_.-], not starting with . or -, no ".."
idStart c = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or S.isDigit c or c == 95.
validId v =
  strlen v > 0 and strlen v <= 64
  and idStart (charAt v 0)
  and allChars (fn c -> idStart c or c == 46 or c == 45) v 1
  and strIndexOf ".." v < 0.

nat t = strlen t > 0 and allChars S.isDigit t 0 and (strlen t == 1 or charAt t 0 != 48).
toNat t = S.toInt t |> R.withDefault (0 - 1).

# the section table: name -> bytes, checked as tools/qos_archive.py checks it
sections raw | not (S.startsWith "QAR2\n" raw) = Err "not a QAR2 archive".
sections raw =
  cut = strIndexOf "\n\n" raw;
  if cut < 0 then Err "not a QAR2 archive"
  else
    payload = substr raw (cut + 2) (strlen raw - cut - 2);
    rows = substr raw 0 cut |> S.split "\n" |> L.drop 1;
    sectionGo rows payload 0 (M.empty S.compare).

sectionGo : (rows : List String | measure rows) -> String -> Int -> M.Map String String -> Result (M.Map String String) String .
sectionGo rows payload cursor m = case rows of
    Nil ->
      if cursor != strlen payload then Err "archive has unclaimed trailing bytes"
      else if L.all (fn k -> M.member k m) ["MANIFEST", "LOAD", "IMAGE", "RELOC"] then Ok m
      else Err "archive lacks a required image/relocation section"
  | row :: rest -> case S.split " " row of
      name :: off :: size :: Nil ->
        if not (sectionName name and nat off and nat size) then Err "invalid QAR2 section table"
        else
          o = toNat off;
          n = toNat size;
          if M.member name m or o != cursor or n > strlen payload - o
            then Err "duplicate, overlapping or out-of-range archive section"
            else sectionGo rest payload (cursor + n) (M.insert name (substr payload cursor n) m)
    | _ -> Err "invalid QAR2 section table".

sectionName n =
  strlen n > 0
  and charAt n 0 >= 65 and charAt n 0 <= 90
  and allChars (fn c -> (c >= 65 and c <= 90) or S.isDigit c or c == 95) n 1.

part m name = M.getOr "" name m.

# the manifest of a QAR2 archive, without the other checks (qos run)
manifestOf : unsafe String -> Result J.Value String .
manifestOf raw = sections raw |> R.andThen (fn m -> T.parse (part m "MANIFEST")).

text v k = case J.field k v of O.Some (J.Text t) -> O.Some t | _ -> O.None.
textIs v k want = text v k == O.Some want.
plainField v k = case text v k of
    O.Some t -> strlen t > 0 and plainChars t 0
  | O.None -> False.
plainChars t i = allChars (fn c -> c >= 32 and c != 34 and c != 92) t i.

# want: { abi, architecture, session, api, desktop : Bool, bundled : Bool }
# answers { raw, manifest, id, version }
read : unsafe String -> { abi : String, architecture : String, session : String, api : String, desktop : Bool, bundled : Bool } -> Result { raw : String, manifest : J.Value, id : String, version : String } String .
read raw want =
  sections raw
  |> R.andThen (fn parts ->
      T.parse (part parts "MANIFEST")
      |> R.mapError (fn e -> "invalid archive manifest: {e}")
      |> R.andThen (fn man ->
          checks man want
          |> R.andThen (fn u -> loadFields (part parts "LOAD"))
          |> R.andThen (fn f -> imageChecks parts f want)
          |> R.map (fn u -> {
              raw = raw, manifest = man,
              id = text man "id" |> O.withDefault "",
              version = text man "version" |> O.withDefault "" }))).

checks man want =
  firstErr [
    require (text man "id" |> O.map validId |> O.withDefault False) "invalid archive manifest ID",
    require (plainField man "name") "invalid archive name",
    require (plainField man "version") "invalid archive version",
    require (textIs man "abi" want.abi) "incompatible ABI; rebuild for {want.abi}",
    if want.desktop
      then require (textIs man "loadMode" "plugin" and textIs man "entry" "fpr_modtab") "Main desktop apps must be plugins with entry=fpr_modtab"
      else require (textIs man "loadMode" "process") "Main entry must be a process archive",
    contract man "architecture" want.architecture want.bundled,
    contract man "desktopSession" want.session want.bundled,
    contract man "desktopApi" want.api want.bundled,
    require (noPermissions man) "desktop SDK does not support archive permission declarations"].

firstErr : (rs : List (Result Unit String) | measure rs) -> Result Unit String .
firstErr rs = case rs of
    Nil -> Ok Unit
  | Err e :: _ -> Err e
  | Ok _ :: rest -> firstErr rest.

# Legacy onboard plugins come from the pinned profile with verified hashes;
# external archives carry the whole desktop contract.
contract man field expected bundled =
  missing = O.isNone (J.field field man);
  require ((bundled and field != "architecture" and missing) or textIs man field expected)
          "incompatible/missing {field}; rebuild with this installed SDK".

noPermissions man = case J.field "permissions" man of
    O.None -> True
  | O.Some (J.Object m) -> M.isEmpty m
  | O.Some (J.Sequence Nil) -> True
  | O.Some (J.Boolean False) -> True
  | O.Some (J.Integer 0) -> True
  | O.Some (J.Text "") -> True
  | O.Some J.Null -> True
  | O.Some _ -> False.

loadFields text = loadGo (S.lines text) (M.empty S.compare).
loadGo : (rows : List String | measure rows) -> M.Map String J.Value -> Result (M.Map String J.Value) String .
loadGo rows m = case rows of
    Nil ->
      if L.all (fn k -> M.member k m) ["base", "entry", "execsz", "rwoff", "imagesz", "memsz", "sha", "relsha"]
        then Ok m
        else Err "incomplete LOAD section"
  | row :: rest -> case S.split " " row of
      key :: value :: Nil ->
        if M.member key m then Err "invalid/duplicate LOAD field"
        else if key == "sha" or key == "relsha" then
          if hex64 value then loadGo rest (M.insert key (J.Text value) m)
          else Err "invalid LOAD hash"
        else if not (loadKey key and nat value) then Err "invalid LOAD number"
        else if strlen value > 18 or toNat value > 4611686018427387903 then Err "LOAD number exceeds the runtime Int range"
        else loadGo rest (M.insert key (J.Integer (toNat value)) m)
    | _ -> Err "invalid/duplicate LOAD field".

loadKey k = L.member k ["base", "entry", "execsz", "rwoff", "imagesz", "memsz", "nativeabi", "planeactors", "planememory"].
hex64 v = strlen v == 64 and allChars (fn c -> S.isDigit c or (c >= 97 and c <= 102)) v 0.
num f k = case M.get k f of O.Some (J.Integer n) -> n | _ -> 0 - 1.
hashOf f k = case M.get k f of O.Some (J.Text t) -> t | _ -> "".

imageChecks : unsafe M.Map String String -> M.Map String J.Value -> { abi : String, architecture : String, session : String, api : String, desktop : Bool, bundled : Bool } -> Result Unit String .
imageChecks parts f want =
  image = part parts "IMAGE";
  rel = part parts "RELOC";
  imp = part parts "IMPORT";
  spans = num f "base" == 0 and 0 <= num f "entry" and num f "entry" < num f "execsz" and num f "execsz" <= strlen image
    and strlen image == num f "imagesz" and num f "imagesz" <= num f "memsz" and 0 <= num f "rwoff" and num f "rwoff" <= num f "memsz";
  require spans "inconsistent LOAD image spans"
  |> R.andThen (fn u -> require (H.sha256 image == hashOf f "sha") "IMAGE sha256 mismatch")
  |> R.andThen (fn u -> require (H.sha256 (strcat rel imp) == hashOf f "relsha") "RELOC/IMPORT sha256 mismatch")
  |> R.andThen (fn u -> require (strlen rel - (strlen rel / 4) * 4 == 0) "invalid RELOC byte length")
  |> R.andThen (fn u ->
      offsets = relocOffsets rel 0 (strlen rel) Nil;
      relocChecks offsets image (num f "memsz") (0 - 1)
      |> R.andThen (fn u2 -> importSpans imp image)
      |> R.andThen (fn sp ->
          sortedSpans = L.sortWith (Ord.by (fn p -> (x, _) = p; x) Ord.int) sp;
          spansApart sortedSpans offsets
          |> R.andThen (fn u3 ->
              if want.desktop then checkEntry image (num f "entry") (num f "execsz") offsets sp
              else Ok Unit))).

relocOffsets : String -> Int -> (rem : Int | measure rem) -> List Int -> List Int .
relocOffsets rel i rem acc =
  if rem <= 0 then L.reverse acc
  else relocOffsets rel (i + 4) (rem - 4) (E.u32 rel i :: acc).

relocChecks : (offs : List Int | measure offs) -> String -> Int -> Int -> Result Unit String .
relocChecks offs image memsz prev = case offs of
    Nil -> Ok Unit
  | at :: rest ->
      if at <= prev then Err "duplicate/unsorted RELOC offsets"
      else if at - (at / 8) * 8 != 0 or at + 8 > strlen image then Err "out-of-range/unaligned RELOC word"
      else case E.u64 image at of
          Ok p -> if p <= memsz then relocChecks rest image memsz at else Err "RELOC pointer outside image"
        | Err _ -> Err "RELOC pointer outside image".

importSpans imp image = spanGo (S.lines imp) image Nil.
spanGo : (rows : List String | measure rows) -> String -> List (Int, Int) -> Result (List (Int, Int)) String .
spanGo rows image acc = case rows of
    Nil -> Ok acc
  | row :: rest -> case S.split " " row of
      kind :: at :: size :: name :: Nil ->
        if not ((kind == "c" or kind == "d") and nat at and nat size and importName name) then Err "invalid IMPORT row"
        else
          a = toNat at;
          n = toNat size;
          expected = E.dataSize name;
          validKind = (kind == "c" and n == 8 and O.isNone expected) or (kind == "d" and O.withDefault (0 - 1) expected == n);
          if not validKind then Err "invalid IMPORT object kind/size"
          else if a - (a / 8) * 8 != 0 or n <= 0 or a + n > strlen image then Err "out-of-range IMPORT slot"
          else spanGo rest image ((a, a + n) :: acc)
    | _ -> Err "invalid IMPORT row".

importName n =
  S.startsWith "fpr_" n and strlen n > 4
  and allChars (fn c -> E.symStart c or S.isDigit c or c == 46 or c == 36) n 4.

spansApart sp offsets =
  if overlapping sp then Err "overlapping IMPORT slots"
  else if L.any (fn s -> (a, b) = s; L.any (fn o -> a < o + 8 and o < b) offsets) sp then Err "IMPORT overlaps RELOC"
  else Ok Unit.

overlapping : (sp : List (Int, Int) | measure sp) -> Bool .
overlapping sp = case sp of
    (_, b) :: rest -> (case rest of (c, _) :: _ -> b > c or overlapping rest | Nil -> False)
  | Nil -> False.

# the native module entry table a desktop plugin starts from
words image at count =
  if at - (at / 8) * 8 != 0 or at < 0 or at > strlen image - 8 * count
    then Err "module table pointer outside IMAGE"
    else wordGo image at count Nil.

wordGo : String -> Int -> (count : Int | measure count) -> List Int -> Result (List Int) String .
wordGo image at count acc =
  if count <= 0 then Ok (L.reverse acc)
  else E.u64 image at
    |> R.mapError (fn u -> "module table pointer outside IMAGE")
    |> R.andThen (fn w -> wordGo image (at + 8) (count - 1) (w :: acc)).

moduleString image at =
  words image at 2 |> R.andThen (fn ws -> case ws of
      header :: size :: Nil ->
        if header == 9000 and size <= strlen image - at - 16
          then Ok (substr image (at + 16) size)
          else Err "invalid module string"
    | _ -> Err "invalid module string").

checkEntry image entry executable relocs imports =
  words image entry 3 |> R.andThen (fn ws -> case ws of
      magic :: schema :: rootAt :: Nil ->
        require (magic == 1179669069 and (schema == 1 or schema == 2)) "unsupported module table schema"
        |> R.andThen (fn u -> require (L.member (entry + 16) relocs) "unrelocated module root")
        |> R.andThen (fn u -> moduleString image rootAt)
        |> R.andThen (fn root ->
            require (root != "") "missing root module identity"
            |> R.andThen (fn u -> moduleRows image entry schema relocs imports)
            |> R.andThen (fn at -> rowsGo image at (strlen image - at) root executable relocs 0))
    | _ -> Err "unsupported module table schema").

moduleRows _ entry 1 _ _ = Ok (entry + 24).
moduleRows image entry _ relocs imports =
  words image (entry + 24) 2 |> R.andThen (fn header -> case header of
      layout :: prefix :: Nil ->
        require (not (L.any (fn at -> at == entry or at == entry + 8 or at == entry + 32) relocs)
          and not (importTouches imports entry (entry + 40))) "fixup changes module header"
        |> R.andThen (fn u -> require (prefix == 8 or prefix == 16) "invalid managed prefix")
        |> R.andThen (fn u ->
            if not (L.member (entry + 24) relocs) then
              require (layout == 0) "unrelocated module layout" |> R.map (fn v -> entry + 40)
            else words image layout 1 |> R.andThen (fn sizes -> case sizes of
                count :: Nil ->
                  require (count <= (strlen image - layout - 8) / 24) "module layout outside IMAGE"
                  |> R.andThen (fn v ->
                      end = layout + 8 + count * 24;
                      require (not (L.any (fn at -> layout <= at and at < end) relocs) and not (importTouches imports layout end))
                        "fixup changes module layout")
                  |> R.map (fn v -> entry + 40)
              | _ -> Err "invalid module layout"))
    | _ -> Err "invalid module table header").

importTouches imports start end = L.any (fn span -> (a, b) = span; a < end and start < b) imports.

rowsGo : String -> Int -> (rem : Int | measure rem) -> String -> Int -> List Int -> Int -> Result Unit String .
rowsGo image at rem root executable relocs found =
  if rem <= 0 then Err "module table pointer outside IMAGE"
  else words image at 1 |> R.andThen (fn ws -> case ws of
      0 :: Nil -> require (found == 1) "desktop archive needs exactly one root appMain export"
    | _ -> words image at 4 |> R.andThen (fn row -> case row of
        scope :: name :: pap :: iface :: Nil ->
          require (L.all (fn i -> L.member (at + i * 8) relocs) [0, 1, 2, 3]) "unrelocated module table row"
          |> R.andThen (fn u ->
              case (moduleString image scope, moduleString image name, moduleString image iface) of
                  (Ok rowScope, Ok rowName, Ok _) ->
                    words image pap 4 |> R.andThen (fn pws -> case pws of
                        header :: code :: arity :: nargs :: Nil ->
                          if not (header == 9001 and code < executable and arity > 0 and nargs == 0 and L.member (pap + 8) relocs)
                            then Err "invalid module function closure"
                          else if rowScope == root and rowName == "appMain" then
                            require (arity == 1) "appMain must take one actor argument"
                            |> R.andThen (fn v -> rowsGo image (at + 32) (rem - 32) root executable relocs (found + 1))
                          else rowsGo image (at + 32) (rem - 32) root executable relocs found
                      | _ -> Err "invalid module function closure")
                | (Err e, _, _) -> Err e
                | (_, Err e, _) -> Err e
                | (_, _, Err e) -> Err e)
      | _ -> Err "module table pointer outside IMAGE")).

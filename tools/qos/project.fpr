# project.fpr -- qos.toml (v1 and v2) project loading and validation.

C = use "common".
H = use "host".
Q = use "qa".
T = use "toml".
J = use "std/json".
L = use "std/list".
M = use "std/map".
O = use "std/option".
R = use "std/result".
S = use "std/string".
V = use "version".

Project = { root : String, manifest : Int, app : J.Value, build : J.Value, run : J.Value, sdk : J.Value, platform : J.Value, entry : String }.

empty = J.Object (M.empty S.compare).
keys (J.Object m) = M.keys m.
keys _ = Nil.
isTable (J.Object _) = True.
isTable _ = False.
get k v = J.field k v |> O.withDefault J.Null.
has k v = J.field k v |> O.isSome.
text k v = C.textField k v.
isText k v want = text k v == O.Some want.
optIs d k v want = textOr d k v == O.Some want.

textOr d k v = case J.field k v of
    O.None -> O.Some d
  | O.Some (J.Text t) -> O.Some t
  | O.Some _ -> O.None.

sameSet a b = L.length a == L.length b and L.all (fn x -> L.member x b) a.
minus a b = L.filter (fn x -> not (L.member x b)) a.
sorted xs = L.sortWith S.compare xs.
commas xs = xs |> sorted |> S.join ", ".

findRoot : unsafe String -> Result String String .
findRoot where = case H.realpath where of
    Err _ -> Err "no qos.toml in this directory or its parents; use qos new NAME"
  | Ok p ->
      start = if H.isFile p then C.parent p else p;
      rootGo start (strlen start + 1).

rootGo : unsafe String -> (fuel : Int | measure fuel) -> Result String String .
rootGo p fuel =
  if fuel <= 0 then Err "no qos.toml in this directory or its parents; use qos new NAME"
  else if H.isFile (C.join p "qos.toml") then Ok p
  else if p == "/" then Err "no qos.toml in this directory or its parents; use qos new NAME"
  else rootGo (C.parent p) (fuel - 1).

load : unsafe String -> Result Project String .
load where =
  findRoot where
  |> R.andThen (fn root ->
      C.readFile (C.join root "qos.toml")
      |> R.andThen (fn raw -> T.parse raw |> R.mapError (fn e -> "qos.toml: {e}"))
      |> R.andThen (fn data -> if has "manifest" data then loadV2 root data else loadV1 root data)).

loadV1 : unsafe String -> J.Value -> Result Project String .
loadV1 root data =
  app = get "app" data;
  build = get "build" data;
  if not (sameSet (keys data) ["app", "build"]) then Err "qos.toml v1 requires only [app] and [build]"
  else if not (isTable app and isTable build) then Err "[app] and [build] must be TOML tables"
  else if not (sameSet (keys app) ["id", "name", "version", "kind"] and sameSet (keys build) ["entry", "target"])
    then Err "qos.toml v1 requires app.id/name/version/kind and build.entry/target; unknown keys are refused"
  else identity app
    |> R.andThen (fn u -> C.check (isText "kind" app "desktop" and isText "target" build "qos-portable") "SDK v2 supports kind=desktop and target=qos-portable only")
    |> R.andThen (fn u -> entryFile root build)
    |> R.map (fn entry -> { root = root, manifest = 1, app = app, build = build, run = empty, sdk = empty, platform = empty, entry = entry }).

identity app =
  if not (Q.validId (text "id" app |> O.withDefault ""))
    then Err "invalid app.id (archive ID rules; maximum 64 ASCII bytes)"
  else C.each (fn f -> case text f app of
      O.Some t -> C.check (strlen t > 0 and Q.plainChars t 0) "app.{f} must be a nonempty single-line string"
    | O.None -> Err "app.{f} must be a nonempty single-line string") ["name", "version"].

entryFile : unsafe String -> J.Value -> Result String String .
entryFile root build = case text "entry" build of
    O.None -> Err "build.entry must be a relative .fpr file inside the project"
  | O.Some e ->
      if C.isAbsolute e then Err "build.entry must be a relative .fpr file inside the project"
      else case H.realpath (C.join root e) of
          Err _ -> Err "build.entry must be an existing .fpr file inside the project"
        | Ok entry ->
            if not (C.inside root entry and H.isFile entry and C.suffix entry == ".fpr")
              then Err "build.entry must be an existing .fpr file inside the project"
            else if C.walk (C.join root "assets") |> L.any (fn n -> C.baseName n != ".gitkeep")
              then Err "asset packaging is not supported by desktop SDK v2"
            else Ok entry.

# ---- v2 --------------------------------------------------------------------------------
# table -> (required, optional)
v2Tables = [
  ("app", (["id", "name", "version", "kind"], Nil)),
  ("build", (["entry", "target"], ["optimize", "compiler-memory-mb"])),
  ("run", (Nil, ["display", "disk-mb", "port"])),
  ("sdk", (["version"], Nil)),
  ("platform", (Nil, ["override", "c-sources"]))].

tableNames = v2Tables |> L.map (fn t -> (n, _) = t; n).
rules name = v2Tables |> L.find (fn t -> (n, _) = t; n == name) |> O.map (fn t -> (_, r) = t; r) |> O.withDefault (Nil, Nil).

# `checks-only` keeps every type, safety and linearity check and turns off
# the optional optimisations a very large program may not afford
optimizeFlags "checks-only" = ["SPEC", "INLINE", "REUSE", "VEC_PEEK", "VEC_FUSE", "RECEIVE_TURNS"].
optimizeFlags _ = Nil.

hostOf "none" = "qosp".
hostOf _ = "qosp-gl".

loadV2 : unsafe String -> J.Value -> Result Project String .
loadV2 root data = case get "manifest" data of
    J.Integer 2 -> v2Tables2 root data
  | _ -> Err "this SDK reads qos.toml manifest = 2 (or v1, which has no manifest key)".

v2Tables2 : unsafe String -> J.Value -> Result Project String .
v2Tables2 root data =
  names = minus (keys data) ["manifest"];
  unknown = minus names tableNames;
  if not (L.isEmpty unknown) then
    Err "qos.toml v2 has [app] and [build], and optionally [run] and [sdk]; unknown tables are refused: {commas unknown}"
  else if not (L.member "app" names and L.member "build" names) then
    Err "qos.toml v2 requires [app] and [build]"
  else C.each (fn n -> tableKeys n (get n data)) names |> R.andThen (fn u -> v2Values root data).

tableKeys name table | not (isTable table) = Err "[{name}] must be a TOML table".
tableKeys name table =
  (required, optional) = rules name;
  missing = minus required (keys table);
  extra = minus (minus (keys table) required) optional;
  if L.isEmpty missing and L.isEmpty extra then Ok Unit
  else Err (S.concat [
    "[{name}] needs ",
    if L.isEmpty required then "no keys" else commas required,
    if L.isEmpty optional then "" else " and may set {commas optional}",
    "; ",
    if L.isEmpty missing then "unknown {commas extra}" else "missing {commas missing}"]).

positive table key low high = case J.field key table of
    O.None -> Ok O.None
  | O.Some (J.Integer n) ->
      if n >= low and (high < 0 or n <= high) then Ok (O.Some n) else Err (bound key low high)
  | O.Some _ -> Err (bound key low high).

bound key low high | high < 0 = "{key} must be an integer of at least {low}".
bound key low high = "{key} must be an integer from {low} to {high}".

v2Values : unsafe String -> J.Value -> Result Project String .
v2Values root data =
  app = get "app" data;
  build = get "build" data;
  run = J.field "run" data |> O.withDefault empty;
  pin = J.field "sdk" data |> O.withDefault empty;
  platform = J.field "platform" data |> O.withDefault empty;
  identity app
  |> R.andThen (fn u -> C.check (isText "kind" app "desktop" or isText "kind" app "app") "app.kind must be \"desktop\" (a Main plugin) or \"app\" (a standalone process image)")
  |> R.andThen (fn u -> C.check (isText "target" build "qos-portable") "build.target must be \"qos-portable\"")
  |> R.andThen (fn u -> C.check (optIs "full" "optimize" build "full" or optIs "full" "optimize" build "checks-only") "build.optimize must be one of: full, checks-only")
  |> R.andThen (fn u -> positive build "compiler-memory-mb" 1 (0 - 1))
  |> R.andThen (fn m -> C.check (L.isEmpty (keys run) or isText "kind" app "app") "[run] applies to kind = \"app\"; a desktop app runs inside Main (qos run DISK)")
  |> R.andThen (fn u -> C.check (optIs "gl" "display" run "gl" or optIs "gl" "display" run "none") "run.display must be one of: gl, none")
  |> R.andThen (fn u -> positive run "disk-mb" 1 (0 - 1))
  |> R.andThen (fn d -> positive run "port" 0 65535)
  |> R.andThen (fn p -> C.check (L.isEmpty (keys pin) or sdkPin (text "version" pin)) "sdk.version must be \"X.Y.Z\" (that release or a later compatible one) or \"=X.Y.Z\" (exactly)")
  |> R.andThen (fn u -> C.check (L.isEmpty (keys platform) or isText "kind" app "app") "[platform] applies to kind = \"app\"; a desktop app links no platform files")
  |> R.andThen (fn u -> platformLists root platform)
  |> R.andThen (fn u -> entryFile root build)
  |> R.map (fn entry -> { root = root, manifest = 2, app = app, build = build, run = run, sdk = pin, platform = platform, entry = entry }).

sdkPin (O.Some t) = V.parsePin t |> R.isOk.
sdkPin O.None = False.

overrideOf platform = case J.field "override" platform of
    O.None -> Ok Nil
  | O.Some (J.Object m) ->
      if M.entries m |> L.all (fn kv -> case kv of (_, J.Text _) -> True | _ -> False)
        then Ok (C.textMap m)
        else Err "[platform.override] maps SDK platform file names to project files, e.g. \"appside/hal.c\" = \"native/hal.c\""
  | O.Some _ -> Err "[platform.override] maps SDK platform file names to project files, e.g. \"appside/hal.c\" = \"native/hal.c\"".

sourcesOf platform = case J.field "c-sources" platform of
    O.None -> Ok Nil
  | O.Some (J.Sequence xs) ->
      if xs |> L.all (fn x -> case x of J.Text _ -> True | _ -> False)
        then Ok (xs |> L.filterMap J.asString)
        else Err "platform.c-sources must be a list of project files, e.g. [\"native/sensor.c\"]"
  | O.Some _ -> Err "platform.c-sources must be a list of project files, e.g. [\"native/sensor.c\"]".

platformLists : unsafe String -> J.Value -> Result Unit String .
platformLists root platform =
  overrideOf platform |> R.andThen (fn overrides ->
    sourcesOf platform |> R.andThen (fn sources ->
      values = overrides |> L.map (fn kv -> (_, v) = kv; v);
      C.check (L.length (L.unique sources) == L.length sources and not (L.any (fn s -> L.member s values) sources))
        "each platform file is listed once: no repeated c-sources, and no file is both an override and a c-source"
      |> R.andThen (fn u -> C.each (projectFile root) (L.append values sources)))).

# a file the project names in [platform]: relative, inside the project, existing
projectFile : unsafe String -> String -> Result String String .
projectFile _ value | C.isAbsolute value = Err "[platform] '{value}' must be relative to the project".
projectFile root value = case H.realpath (C.join root value) of
    Err _ -> Err "[platform] '{value}' must be an existing file inside the project"
  | Ok path ->
      if not (C.inside root path and H.isFile path) then Err "[platform] '{value}' must be an existing file inside the project"
      else if not (C.suffix path == ".c" or C.suffix path == ".S") then Err "[platform] '{value}' must be a .c or .S file"
      else Ok path.

# Explicit overrides and added sources, checked against the SDK's inventory.
# Only names in it can be replaced; headers are the ABI and the linker
# script the layout the host loads, so neither can.  A file that merely sits
# in the project never takes part.  -> (overrides [(name, value, path)], added [(value, path)])
platformChoices : unsafe String -> J.Value -> List String -> Result (List (String, String, String), List (String, String)) String .
platformChoices root platform files =
  overrideOf platform |> R.andThen (fn overrides ->
    sourcesOf platform |> R.andThen (fn sources ->
      overridable = files |> L.filter (fn n -> C.suffix n == ".c" or C.suffix n == ".S") |> sorted;
      sortedOverrides = overrides |> L.sortWith (fn a b -> (x, _) = a; (y, _) = b; S.compare x y);
      C.mapR (fn kv -> (name, value) = kv; chooseOverride root files overridable name value) sortedOverrides
      |> R.andThen (fn chosen ->
          headers = files |> L.filter (S.endsWith ".h") |> L.map C.baseName |> sorted |> L.unique;
          C.mapR (fn value ->
            projectFile root value |> R.andThen (fn source ->
              case headers |> L.find (fn h -> H.exists (C.join (C.parent source) h)) of
                  O.Some h -> Err "{C.relativeTo root (C.join (C.parent source) h)} would replace the SDK's {h} for {value}; rename or move it"
                | O.None -> Ok (value, source))) sources
          |> R.map (fn added -> (chosen, added))))).

chooseOverride : unsafe String -> List String -> List String -> String -> String -> Result (String, String, String) String .
chooseOverride root files overridable name value =
  if not (L.member name files) then
    Err "[platform.override] '{name}' is not an SDK platform file; these can be overridden: {S.join ", " overridable}"
  else if S.endsWith ".h" name then
    Err "[platform.override] {name} is part of the SDK's ABI and cannot be overridden; a program that needs a different ABI needs a different SDK"
  else if not (L.member name overridable) then
    Err "[platform.override] {name} is the image layout the host loads and cannot be overridden"
  else projectFile root value |> R.andThen (fn source ->
    if C.suffix source != C.suffix name
      then Err "[platform.override] {name} must be replaced by a {C.suffix name} file, not '{value}'"
      else Ok (name, value, source)).

checkSdkVersion pin meta = case text "version" pin of
    O.None -> Ok Unit
  | O.Some wanted -> case V.parsePin wanted of
      Err _ -> Err "sdk.version must be \"X.Y.Z\" (that release or a later compatible one) or \"=X.Y.Z\" (exactly)"
    | Ok p -> case C.textField "release" meta of
        O.None ->
          _ = C.say "qos: this is a development SDK with no release number; sdk.version = '{wanted}' is not checked";
          Ok Unit
      | O.Some release -> case V.parse release of
          Err _ -> Err "SDK release '{release}' is not X.Y.Z"
        | Ok have ->
            if V.satisfies p have then Ok Unit
            else if p.exact then Err "qos.toml pins SDK {wanted}; this is QOS Portable {release}"
            else Err "qos.toml needs SDK {wanted} or a later compatible release; this is QOS Portable {release}".

# the strings of a project's tables
appText k p = text k p.app |> O.withDefault "".
optimize p = textOr "full" "optimize" p.build |> O.withDefault "full".
memoryMb p = case J.field "compiler-memory-mb" p.build of O.Some (J.Integer n) -> n | _ -> 0.
display p = textOr "gl" "display" p.run |> O.withDefault "gl".
diskMb p = case J.field "disk-mb" p.run of O.Some (J.Integer n) -> n | _ -> 32.
port p = case J.field "port" p.run of O.Some (J.Integer n) -> n | _ -> 0.

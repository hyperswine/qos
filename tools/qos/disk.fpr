# disk.fpr -- durable QLOG v3 block disk format for Main profiles.

C = use "common".
H = use "host".
L = use "std/list".
M = use "std/map".
O = use "std/option".
P = use "std/parse".
R = use "std/result".
S = use "std/string".
OS = use "std/os".

page = 4096.

checksum data seed = sumGo data 0 (strlen data) seed.
sumGo : String -> Int -> (rem : Int | measure rem) -> Int -> Int .
sumGo d i rem h =
  if rem <= 0 then h
  else
    x = h * 31 + charAt d i;
    sumGo d (i + 1) (rem - 1) (x - (x / 1000000007) * 1000000007).

orOne 0 = 1.
orOne n = n.

pad : unsafe String -> Int -> String .
pad bytes n = strcat bytes (H.zeros (n - strlen bytes)).
roundUp n = ((n + page - 1) / page) * page.

# meta: { head, w, c, dataEnd, swap, merkle, generation, stage }
Meta = { head : Int, w : Int, c : Int, dataEnd : Int, swap : Int, merkle : Int, generation : Int, stage : Int }.

sealPage : unsafe Meta -> String .
sealPage m =
  prefix = "QLOG {m.head} v3 w{m.w} c{m.c} d{m.dataEnd} s{m.swap} m{m.merkle} g{m.generation} j{m.stage}";
  pad (strcat prefix " x{orOne (checksum prefix 7)}\n") page.

firstLine raw =
  n = strIndexOf "\n" raw;
  if n < 0 then Err "missing QLOG header newline" else Ok (substr raw 0 (n + 1)).

# "0" or a digit string without a leading zero
num t = strlen t > 0 and S.allChars S.isDigit t and (strlen t == 1 or charAt t 0 != 48).
toNum t = S.toInt t |> R.withDefault (0 - 1).

isKeyChar c = c > 32 and c != 127.
validKey k = strlen k > 0 and S.allChars isKeyChar k.

tagNat tag = P.literal tag |> P.andThen (fn u -> P.natNoLeadZero).

sealParser =
  P.succeed (fn head w c d s m g j x ->
    { head = head, w = w, c = c, dataEnd = d, swap = s, merkle = m, generation = g, stage = j })
  |> P.skip (P.literal "QLOG ") |> P.andMap P.natNoLeadZero
  |> P.skip (P.literal " v3 ")  |> P.andMap (tagNat "w")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "c")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "d")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "s")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "m")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "g")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "j")
  |> P.skip (P.char 32)         |> P.andMap (tagNat "x").

parseSeal : unsafe String -> Int -> Result Meta String .
parseSeal raw pages =
  firstLine raw |> R.andThen (fn line ->
    substr line 0 (strlen line - 1)
    |> P.run sealParser
    |> R.mapError (fn u -> "invalid QLOG v3 superblock")
    |> R.andThen (fn meta ->
        firstLine (sealPage meta) |> R.andThen (fn l ->
          if l != line then Err "superblock checksum mismatch"
          else if not (sealBounds meta pages) then Err "invalid superblock bounds/flags"
          else Ok meta))).

sealBounds m pages =
  1 <= m.head and m.head <= m.dataEnd and m.dataEnd <= pages - 1 and pages >= 3
  and ((m.dataEnd <= m.swap and m.swap < pages - 1) or (m.swap == m.dataEnd and m.dataEnd == pages - 1))
  and 0 < m.generation and m.generation <= 1000000000 and m.merkle >= 0
  and ((m.w == 0 and m.c == 1) or (m.w == 1 and m.c == 0) or (m.w == 2 and m.c == 0)).

sameMeta a b =
  a.head == b.head and a.w == b.w and a.c == b.c and a.dataEnd == b.dataEnd and a.swap == b.swap
  and a.merkle == b.merkle and a.generation == b.generation and a.stage == b.stage.

metadata : unsafe Int -> Result Meta String .
metadata fd =
  H.fdSize fd |> R.andThen (fn size ->
    if size - (size / page) * page != 0 or size < 3 * page then Err "invalid disk size"
    else
      pages = size / page;
      valid = [0, (pages - 1) * page]
        |> L.map (fn at -> H.pread fd at page |> R.andThen (fn raw -> parseSeal raw pages))
        |> R.oks;
      case valid of
          Nil -> Err "no valid durable QLOG v3 superblock; open/recover legacy disks in QOS first"
        | _ ->
            if conflicting valid then Err "conflicting superblock generations"
            else
              chosen = newest valid;
              if chosen.w == 0 and chosen.c == 1 and chosen.stage == 0 then Ok chosen
              else Err "pending disk operation; recover in QOS first").

conflicting [a, b] = a.generation == b.generation and not (sameMeta a b).
conflicting _ = False.

newest [a, b] = if b.generation > a.generation then b else a.
newest (a :: _) = a.
newest Nil = { head = 0, w = 0, c = 0, dataEnd = 0, swap = 0, merkle = 0, generation = 0, stage = 0 }.

# the record headers from page 1 to head: key -> (offset, size) of the latest value
scan : unsafe Int -> Meta -> Result (M.Map String (Int, Int)) String .
scan fd meta = scanGo fd meta 1 (meta.head - 1) (M.empty S.compare).

scanGo : unsafe Int -> Meta -> Int -> (rem : Int | measure rem) -> M.Map String (Int, Int) -> Result (M.Map String (Int, Int)) String .
scanGo fd meta at rem latest =
  if rem <= 0 then Ok latest
  else
    H.pread fd (at * page) page
    |> R.andThen firstLine
    |> R.andThen (fn line ->
        case substr line 0 (strlen line - 1) |> record of
            O.None -> Err "invalid record header at page {at}"
          | O.Some r ->
              if not (validKey r.key and r.pages == (r.size + page - 1) / page and at + r.pages + 1 <= meta.head)
                then Err "record bounds/shape at page {at}"
              else
                start = (at + 1) * page;
                H.pread fd start r.size |> R.andThen (fn value ->
                  if not (r.hash < 0 or r.hash == 0 or r.hash == orOne (checksum value 7))
                    then Err "record checksum at page {at}"
                  else apply r start value latest |> R.andThen (fn l2 ->
                    step = r.pages + 1;
                    if step <= 0 then Err "record bounds/shape at page {at}"
                    else scanGo fd meta (at + step) (rem - 1) l2))).

# "TAG pages size key[ hN]"
recordParser =
  P.succeed (fn tag pages size key hash -> { tag = tag, pages = pages, size = size, key = key, hash = hash })
  |> P.andMap (P.oneOf [P.literal "QREC", P.literal "QDEL", P.literal "QBLK"])
  |> P.skip (P.char 32) |> P.andMap P.natNoLeadZero
  |> P.skip (P.char 32) |> P.andMap P.natNoLeadZero
  |> P.skip (P.char 32) |> P.andMap (P.takeWhile1 isKeyChar "key")
  |> P.andMap (P.withDefault (0 - 1) (P.literal " h" |> P.andThen (fn u -> P.natNoLeadZero))).

record line = P.run recordParser line |> O.fromResult.

apply r start value latest = case r.tag of
    "QDEL" -> if r.size == 0 then Ok (M.remove r.key latest) else Err "nonempty tombstone"
  | "QREC" -> Ok (M.insert r.key (start, r.size) latest)
  | _ ->
      if not (num r.key) then Err "invalid bulk count"
      else frames value start 0 (toNum r.key) latest.

frames : String -> Int -> Int -> (count : Int | measure count) -> M.Map String (Int, Int) -> Result (M.Map String (Int, Int)) String .
frames value start pos count latest =
  if count <= 0 then
    if pos == strlen value then Ok latest else Err "bulk trailing bytes"
  else if pos >= strlen value then Err "truncated bulk frame"
  else
    nl = strIndexFrom "\n" value pos;
    if nl < 0 then Err "bulk frame missing newline"
    else case substr value pos (nl - pos) |> S.split " " of
        [len, key] ->
          if not (num len and validKey key) then Err "invalid bulk frame"
          else
            n = toNum len;
            if n > strlen value - (nl + 1) then Err "bulk frame bounds"
            else frames value start (nl + 1 + n) (count - 1) (M.insert key (start + nl + 1, n) latest)
      | _ -> Err "invalid bulk frame".

valueOf : unsafe Int -> (Int, Int) -> Result String String .
valueOf fd (off, size) = H.pread fd off size.

# items: List (key, bytes)
bulkRecord : unsafe List (String, String) -> Result String String .
bulkRecord items =
  keys = items |> L.map (fn kv -> (k, _) = kv; k);
  if L.isEmpty items or L.length (L.unique keys) != L.length keys then Err "duplicate/empty bulk keys"
  else if not (L.all validKey keys) then Err "invalid bulk key"
  else
    payload = items |> L.concatMap (fn kv -> (k, v) = kv; [str (strlen v), " ", k, "\n", v]) |> strJoin "";
    header = "QBLK {(strlen payload + page - 1) / page} {strlen payload} {L.length items} h{orOne (checksum payload 7)}\n";
    if strlen header > page then Err "bulk header too long"
    else Ok (strcat (pad header page) (pad payload (roundUp (strlen payload)))).

# the disk at path, locked; Err "disk is in use..." when another process has it
locked : unsafe String -> Result (String, Int) String .
locked path =
  H.realpath path |> R.andThen (fn real ->
    case H.lock real of
        Err "in use" -> Err "disk is in use; close QOS before installing or starting another session"
      | Err "not a regular file" -> Err "disk must be a regular file"
      | Err e -> Err e
      | Ok fd -> Ok (real, fd)).

append : unsafe Int -> Meta -> List (String, String) -> Result Meta String .
append fd meta items =
  bulkRecord items |> R.andThen (fn rec ->
    end = meta.head + strlen rec / page;
    if end > meta.dataEnd then Err "disk DATA partition full; compact in QOS or create a larger disk"
    else if meta.generation >= 1000000000 then Err "superblock generation exhausted"
    else
      H.pwrite fd (meta.head * page) rec
      |> R.andThen (fn u -> H.fullSync fd)
      |> R.andThen (fn u -> H.fdSize fd)
      |> R.andThen (fn size ->
          updated = { meta | head = end, generation = meta.generation + 1 };
          sealAt = if updated.generation - (updated.generation / 2) * 2 == 0 then 0 else size - page;
          H.pwrite fd sealAt (sealPage updated)
          |> R.andThen (fn u -> H.fullSync fd)
          |> R.map (fn u -> updated))).

# A private inode is prepared and published by a no-clobber hard link only
# after the complete seed is flushed: an empty disk path is never visible.
create : unsafe String -> Int -> List (String, String) -> Result Unit String .
create _ sizeMib _ | sizeMib < 1 = Err "disk size must be at least 1 MiB".
create path sizeMib items =
  if H.exists path then Err "disk already exists; refusing to overwrite"
  else H.tempFile (strcat (C.parent path) "/.qos-disk-XXXXXX") |> R.andThen (fn pair ->
    (fd, name) = pair;
    result = seed fd name path sizeMib items;
    _ = OS.close fd;
    _ = if H.exists name then OS.remove name else Ok Unit;
    result).

seed : unsafe Int -> String -> String -> Int -> List (String, String) -> Result Unit String .
seed fd name path sizeMib items =
  pages = sizeMib * 1048576 / page;
  end = pages - pages / 8;
  H.truncate fd (pages * page)
  |> R.andThen (fn u -> bulkRecord items)
  |> R.andThen (fn rec ->
      head = 1 + strlen rec / page;
      if head > end then Err "profile does not fit in disk DATA partition"
      else
        meta = { head = head, w = 0, c = 1, dataEnd = end, swap = end, merkle = 0, generation = 1, stage = 0 };
        H.pwrite fd page rec
        |> R.andThen (fn u -> H.pwrite fd ((pages - 1) * page) (sealPage meta))
        |> R.andThen (fn u -> H.pwrite fd 0 (sealPage { meta | generation = 2 }))
        |> R.andThen (fn u -> H.fullSync fd)
        |> R.andThen (fn u -> H.link name path)
        |> R.andThen (fn u -> _ = OS.remove name; H.syncDir (C.parent path))).

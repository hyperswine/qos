# install.fpr -- installed Main disk/profile policy above disk.fpr's durable
# block format (tools/desktop_install.py): qos disk create, qos install,
# qos run DISK.
unsafe base.

C = use "common".
D = use "disk".
H = use "host".
Q = use "qa".
J = use "std/json".
L = use "std/list".
M = use "std/map".
O = use "std/option".
S = use "std/string".
OS = use "std/os".

profileKey = "qos/profile".

compatibleSdk sdk = C.readFile (C.join sdk "sdk.json") |>? (fn raw -> case J.parse raw of
    Err e -> Err "sdk.json: {e}"
  | Ok meta ->
      C.check (C.textIs "architecture" meta "aarch64") "installed desktop disk workflow currently supports AArch64 only" |>? (fn u1 ->
      C.check ((case C.intField "diskLockContract" meta of O.Some 1 -> True | _ -> False) and nonEmpty (C.listField "profileApps" meta))
        "SDK has no matching lock-capable Main profile; install the complete SDK" |>? (fn u2 ->
      C.check (C.textIs "os" meta (H.system Unit)) "SDK targets a different host OS" |>? (fn u3 ->
      files = C.textMap (O.withDefault (M.empty S.compare) (C.objectField "profileFiles" meta));
      C.each (fn kv -> case kv of (name, expected) ->
          p = C.join sdk (C.join "profile" name);
          (case H.isFile p and hashMatches (H.sha256File p) expected of
            True -> Ok Unit
          | False -> Err "profile {name} changed; reinstall matching SDK")) files |>? (fn u4 ->
      C.check (L.any (fn kv -> case kv of (n, _) -> n == "main.qa") files) "SDK has no verified Main entry archive" |>? (fn u5 ->
      Ok meta)))))).
nonEmpty o = case o of O.Some (_ :: _) -> True | _ -> False.

hashMatches r expected = case r of Ok h -> h == expected | Err _ -> False.

want meta bundled desktop = { abi = C.textOr "" "abi" meta, architecture = C.textOr "" "architecture" meta,
                              session = C.textOr "" "desktopSession" meta, api = C.textOr "" "desktopApi" meta,
                              desktop = desktop, bundled = bundled }.
parse raw meta bundled desktop = Q.read raw (want meta bundled desktop).

# json.dumps(profile, sort_keys=True): the marker Main and this tool compare
profileText meta = S.concat ("\{\"abi\": " :: C.jsonStr (C.textOr "" "abi" meta) ::
  ", \"architecture\": " :: C.jsonStr (C.textOr "" "architecture" meta) ::
  ", \"desktopApi\": " :: C.jsonStr (C.textOr "" "desktopApi" meta) ::
  ", \"desktopSession\": " :: C.jsonStr (C.textOr "" "desktopSession" meta) ::
  ", \"format\": 1, \"os\": " :: C.jsonStr (C.textOr "" "os" meta) :: ", \"profile\": \"Main\"}" :: Nil).

# the app catalogue: one ID a line, canonical
index raw = case asciiOnly raw 0 of
    False -> Err "invalid app catalogue encoding"
  | True ->
      ids = S.lines raw;
      C.check (L.all Q.validId ids and L.length (L.unique ids) == L.length ids) "invalid/duplicate app catalogue IDs" |>? (fn u ->
      C.check (raw == S.concat (L.map (fn i -> strcat i "\n") ids)) "noncanonical app catalogue" |>? (fn u2 ->
      Ok ids)).
asciiOnly t i | i >= strlen t = True.
asciiOnly t i | charAt t i < 128 = asciiOnly t (i + 1).
asciiOnly t i = False.

catalogue ids = S.concat (L.map (fn i -> strcat i "\n") ids).

openProfile fd meta = D.metadata fd |>? (fn current ->
  D.scan fd current |>? (fn latest ->
  C.check (M.member profileKey latest and M.member "apps/index" latest) "disk lacks Main profile metadata; use qos disk create" |>? (fn u ->
  read fd latest profileKey |>? (fn marker ->
  C.check (sameJson marker (profileText meta)) "disk/profile compatibility mismatch; rebuild installed apps for the matching SDK before migrating this disk" |>? (fn u2 ->
  read fd latest "apps/index" |>? (fn raw ->
  index raw |>? (fn ids ->
  # every discovered native archive is verified before launching or updating
  trusted = L.filterMap (fn kv -> case kv of (name, sha) -> (case name != "main.qa" and S.endsWith ".qa" name of
      True -> O.Some (substr name 0 (strlen name - 3), sha)
    | False -> O.None)) (C.textMap (O.withDefault (M.empty S.compare) (C.objectField "profileFiles" meta)));
  C.each (fn aid ->
      key = "apps/{aid}.qa";
      C.check (M.member key latest) "catalogue references missing archive {aid}" |>? (fn u3 ->
      read fd latest key |>? (fn raw2 ->
      bundled = (case L.find (fn t -> case t of (a, _) -> a == aid) trusted of O.Some (_, sha) -> H.sha256 raw2 == sha | O.None -> False);
      parse raw2 meta bundled True |>? (fn app ->
      C.check (app.id == aid) "catalogue/manifest ID mismatch")))) ids |>? (fn u4 ->
  Ok (current, latest, ids))))))))).

read fd latest key = case M.get key latest of
    O.Some entry -> D.valueOf fd entry
  | O.None -> Err "missing {key}".
sameJson a b = case (J.parse a, J.parse b) of
    (Ok x, Ok y) -> J.equal x y
  | _ -> False.

create sdk destination size = compatibleSdk sdk |>? (fn meta ->
  names = L.filterMap (fn v -> case v of J.Text t -> O.Some t | _ -> O.None) (O.withDefault Nil (C.listField "profileApps" meta));
  C.mapR (fn name -> C.readFile (C.join sdk (C.join "profile" name)) |>? (fn raw -> parse raw meta True True)) names |>? (fn apps ->
  ids = L.map (fn a -> a.id) apps;
  C.check (L.length (L.unique ids) == L.length ids) "duplicate bundled app ID" |>? (fn u ->
  items = L.append (L.map (fn a -> ("apps/{a.id}.qa", a.raw)) apps)
                   (("apps/index", catalogue ids) :: (profileKey, profileText meta) :: Nil);
  D.create (C.absolute destination) size items |>? (fn u2 ->
  _ = C.say "Created Main disk {destination} ({L.length ids} apps)";
  Ok Unit)))).

install sdk archive destination = compatibleSdk sdk |>? (fn meta ->
  C.readFile archive |>? (fn raw ->
  parse raw meta False True |>? (fn app ->
  D.locked destination |>? (fn held -> case held of (path, fd) ->
    result = openProfile fd meta |>? (fn opened -> case opened of (current, latest, ids) ->
      changed = L.member app.id ids;
      ids2 = (case changed of True -> ids | False -> L.append ids (app.id :: Nil));
      D.append fd current (("apps/{app.id}.qa", app.raw) :: ("apps/index", catalogue ids2) :: Nil) |>? (fn updated ->
      _ = C.say "{(case changed of True -> "Updated" | False -> "Installed")} {app.id} {app.version} in {destination} (generation {updated.generation})";
      Ok Unit));
    _ = OS.close fd;
    result)))).

# Main on a disk; the host takes over this same locked open file
runMain sdk destination = compatibleSdk sdk |>? (fn meta ->
  entry = C.join sdk "profile/main.qa";
  C.readFile entry |>? (fn raw ->
  parse raw meta True False |>? (fn u ->
  host = C.join sdk "runtime/qosp-gl";
  expected = (case C.objectField "runtimeFiles" meta of O.Some m -> (case M.get "qosp-gl" m of O.Some (J.Text t) -> t | _ -> "") | O.None -> "");
  C.check (strlen expected > 0 and H.isFile host and hashMatches (H.sha256File host) expected)
    "matching prebuilt graphical host missing or changed; reinstall SDK" |>? (fn u2 ->
  D.locked destination |>? (fn held -> case held of (path, fd) ->
    case openProfile fd meta of
      Err e ->
        _ = OS.close fd;
        Err e
    | Ok _ ->
        _ = H.setEnv "FPR_DISK" path;
        _ = H.setEnv "FPR_DISK_LOCK_FD" (str fd);
        OS.exec (host :: "--yes" :: entry :: Nil)))))).

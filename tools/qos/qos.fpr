# qos.fpr -- the `qos` command-line entry point for the QOS Portable SDK.

B = use "build".
C = use "common".
H = use "host".
I = use "install".
P = use "project".
Q = use "qa".
J = use "std/json".
L = use "std/list".
M = use "std/map".
O = use "std/option".
R = use "std/result".
S = use "std/string".
OS = use "std/os".

# the SDK: this binary is <sdk>/tools/qos
sdkRoot : unsafe Unit -> Result String String .
sdkRoot _ =
  OS.exePath Unit
  |> R.andThen H.realpath
  |> R.map (fn real -> C.parent (C.parent real))
  |> R.mapError (fn e -> "cannot find the SDK: {e}").

usage = "usage: qos [-h] [--version] \{new,build,disk,install,run} ...\n".
helpText = S.concat [
  usage, "\nInstalled QOS Portable SDK: scaffold, desktop plugin and standalone app builder.\n\n",
  "commands:\n",
  "  new DEST                         a desktop app project\n",
  "  build [PROJECT] [-v]             build build/ID.qa (kind = \"desktop\" or \"app\")\n",
  "  disk create DEST [--size MIB]    a Main disk with the SDK's bundled apps\n",
  "  install APP.qa DISK              install or update a desktop app on a Main disk\n",
  "  run [PROJECT|DISK] [--disk D] [--trace]\n",
  "                                   run a kind = \"app\" project (default: this directory), or Main on DISK\n",
  "\noptions:\n  -h, --help  show this help message and exit\n  --version   show installed release and API versions\n"].

usageError why =
  _ = Sys.stderr (strcat usage "qos: error: {why}\n");
  Sys.exit 2.

# argv -> { positional, values : [(option, value)], flags : [option] }
# valued: the options that take a value
parseArgs args valued flags = argGo args valued flags Nil Nil Nil.
argGo : (args : List String | measure args) -> List String -> List String -> List String -> List (String, String) -> List String -> Result { positional : List String, values : List (String, String), flags : List String } String .
argGo args valued flags pos vals seen = case args of
    Nil -> Ok { positional = L.reverse pos, values = vals, flags = seen }
  | a :: rest ->
      if L.member a valued then
        case rest of
            v :: more -> argGo more valued flags pos ((a, v) :: vals) seen
          | Nil -> Err "argument {a}: expected one argument"
      else if L.member a flags then argGo rest valued flags pos vals (a :: seen)
      else if S.startsWith "--" a and strIndexOf "=" a > 0 and L.member (substr a 0 (strIndexOf "=" a)) valued then
        eq = strIndexOf "=" a;
        argGo rest valued flags pos ((substr a 0 eq, substr a (eq + 1) (strlen a)) :: vals) seen
      else if S.startsWith "-" a and strlen a > 1 then Err "unrecognized arguments: {a}"
      else argGo rest valued flags (a :: pos) vals seen.

value parsed name = parsed.values |> L.find (fn kv -> (k, _) = kv; k == name) |> O.map (fn kv -> (_, v) = kv; v).
flag parsed names = names |> L.any (fn n -> L.member n parsed.flags).

# argparse's contract: a usage error exits 2
withArgs args valued flags most body =
  case parseArgs args valued flags |> R.andThen (atMost most) of
      Err e -> usageError e
    | Ok a -> body a.

atMost n parsed =
  if L.length parsed.positional > n
    then Err "unrecognized arguments: {parsed.positional |> L.drop n |> S.join " "}"
    else Ok parsed.

argOr parsed i d = L.get i parsed.positional |> O.withDefault d.

# str.title for ASCII: a letter after a non-letter is upper case, others lower
title t = titleGo t 0 (strlen t) False Nil.
titleGo : String -> Int -> (rem : Int | measure rem) -> Bool -> List String -> String .
titleGo t i rem prev acc =
  if rem <= 0 then acc |> L.reverse |> S.concat
  else
    c = charAt t i;
    letter = (c >= 65 and c <= 90) or (c >= 97 and c <= 122);
    out = if not letter then c
          else if prev then (if c >= 65 and c <= 90 then c + 32 else c)
          else (if c >= 97 and c <= 122 then c - 32 else c);
    titleGo t (i + 1) (rem - 1) letter (chr out :: acc).

trimSlashes p = trimSlashesGo p (strlen p).
trimSlashesGo : String -> (rem : Int | measure rem) -> String .
trimSlashesGo p rem =
  if rem <= 1 then p
  else if strlen p > 1 and S.endsWith "/" p then trimSlashesGo (substr p 0 (strlen p - 1)) (rem - 1)
  else p.

scaffold : unsafe String -> String -> Result Unit String .
scaffold sdk destination =
  dest = trimSlashes destination;
  name = C.baseName dest;
  if not (Q.validId name) then
    Err "app ID: use 1-64 ASCII letters, digits, underscores, dots or hyphens; start with a letter, digit or underscore; no '..'"
  else if H.exists dest then Err "{dest} already exists"
  else
    t = name |> S.replace "-" " " |> S.replace "_" " " |> title;
    toml = S.concat [
      "[app]\nid = ", C.jsonStr name, "\nname = ", C.jsonStr t,
      "\nversion = \"0.1.0\"\nkind = \"desktop\"\n\n[build]\nentry = \"main.fpr\"\ntarget = \"qos-portable\"\n"];
    C.mkdirs dest
    |> R.andThen (fn u -> C.mkdirs (C.join dest "assets"))
    |> R.andThen (fn u -> C.writeFile (C.join dest "assets/.gitkeep") "")
    |> R.andThen (fn u -> C.copyFile (C.join sdk "tools/desktop-counter.fpr") (C.join dest "main.fpr"))
    |> R.andThen (fn u -> C.writeFile (C.join dest ".gitignore") "/build/\n")
    |> R.andThen (fn u -> C.writeFile (C.join dest "qos.toml") toml)
    |> R.map (fn u -> _ = C.say "Created {dest}; cd there and run qos build"; Unit).

# ---- qos run PROJECT ---------------------------------------------------------------------
overrideLine row = case C.textField "kind" row of
    O.Some "override" -> "qos: this image replaces the SDK's {C.textOr "None" "file" row} with {C.textOr "None" "source" row}"
  | _ -> "qos: this image adds {C.textOr "None" "source" row} to the SDK's platform files".

# A kind = "app" image on its own disk; the host replaces this process.
runApp : unsafe String -> String -> O.Option String -> Bool -> Result Unit String .
runApp sdk where disk trace =
  B.sdkMeta sdk |> R.andThen (fn meta ->
    P.load where |> R.andThen (fn p ->
      archive = C.join p.root (C.join "build" "{P.appText "id" p}.qa");
      C.check (P.appText "kind" p == "app") "qos run PROJECT runs kind = \"app\"; a desktop app runs inside Main: qos run DISK"
      |> R.andThen (fn u -> C.check (H.isFile archive) "{archive} does not exist; run qos build first")
      |> R.andThen (fn u -> C.readFile archive)
      |> R.andThen (fn raw -> Q.manifestOf raw |> R.mapError (fn e -> "{archive} is not a QOS app archive; rebuild with qos build"))
      |> R.andThen (fn built ->
          C.check (C.textIs "id" built (P.appText "id" p) and C.textIs "loadMode" built "process" and C.textIs "abi" built (C.textOr "" "abi" meta))
            "{archive} was not built by this SDK for this project; run qos build"
          |> R.andThen (fn u ->
              _ = C.listField "platformOverrides" built |> O.withDefault Nil |> L.each (fn row -> C.say (overrideLine row));
              hostName = P.display p |> P.hostOf;
              host = C.join sdk (C.join "runtime" hostName);
              expected = C.objectField "runtimeFiles" meta |> O.andThen (M.get hostName) |> O.andThen J.asString |> O.withDefault "";
              C.check (strlen expected > 0 and H.isFile host and I.hashMatches (H.sha256File host) expected)
                "matching prebuilt host {hostName} missing or changed; reinstall SDK"
              |> R.andThen (fn u2 ->
                  path = disk |> O.withDefault (C.join p.root (C.join "data" "{P.appText "id" p}.disk"));
                  newDisk path (P.diskMb p)
                  |> R.andThen (fn u3 -> H.realpath path)
                  |> R.andThen (fn real ->
                      case H.lock real of
                          Err "in use" -> Err "{real} is in use by another QOS process"
                        | Err e -> Err "{real}: {e}"
                        | Ok fd ->
                            # The host takes over this locked open file (hal/unix/blk_raw.c), so
                            # nothing can open the disk between this check and the launch.
                            _ = H.setEnv "FPR_DISK" real;
                            _ = H.setEnv "FPR_DISK_LOCK_FD" (str fd);
                            _ = H.setEnv "FPR_PORT" (str (P.port p));
                            OS.exec (L.concat [[host, "--yes"], if trace then ["--trace"] else Nil, [archive]]))))))).

# sparse and unformatted, as the host makes one
newDisk : unsafe String -> Int -> Result Unit String .
newDisk path size =
  if H.exists path then Ok Unit
  else C.mkdirs (C.parent (C.absolute path))
    |> R.andThen (fn u -> H.createSparse path (size * 1048576) |> R.mapError (fn e -> "{path}: {e}"))
    |> R.map (fn u -> _ = C.say "Created {path} ({size} MiB)"; Unit).

# A bundled profile archive, checked as tools/qos_archive.py read it: a desktop
# plugin, or with --main the Main entry process image.
inspect : unsafe String -> String -> Bool -> Result Unit String .
inspect archive abi isMain =
  B.native Unit |> R.andThen (fn nat ->
    (arch, _, _, _) = nat;
    C.readFile archive
    |> R.andThen (fn raw -> Q.read raw { abi = abi, architecture = arch, session = C.session, api = C.api, desktop = not isMain, bundled = True })
    |> R.map (fn app -> _ = C.say "{app.id} {H.sha256 app.raw}"; Unit)).

# ---- the command line --------------------------------------------------------------------
version sdk =
  B.sdkMeta sdk
  |> R.map (fn meta -> _ = C.say "QOS Portable {C.textOr "development" "release" meta} ({C.api}, {C.session})"; Unit).

command : unsafe String -> List String -> Result Unit String .
command _ Nil = usageError "choose a command (see --help)".
command _ ("-h" :: _) = Ok (C.say helpText).
command _ ("--help" :: _) = Ok (C.say helpText).
command sdk ("--version" :: _) = version sdk.
command sdk ("new" :: rest) =
  withArgs rest Nil Nil 1 (fn a ->
    case a.positional of
        [dest] -> scaffold sdk dest
      | _ -> usageError "the following arguments are required: destination").
command sdk ("build" :: rest) =
  withArgs rest ["--compiler"] ["-v", "--verbose"] 1 (fn a ->
    B.build sdk (argOr a 0 ".") (value a "--compiler") (flag a ["-v", "--verbose"]) |> R.map (fn d -> Unit)).
command sdk ("disk" :: "create" :: rest) =
  withArgs rest ["--profile", "--size"] Nil 1 (fn a ->
    case (a.positional, value a "--profile", value a "--size") of
        ([dest], prof, size) ->
          if O.withDefault "main" prof != "main"
            then usageError "argument --profile: invalid choice: '{O.withDefault "" prof}' (choose from 'main')"
          else (case S.toInt (O.withDefault "32" size) of
              Ok n -> I.create sdk dest n
            | Err _ -> usageError "argument --size: invalid int value: '{O.withDefault "" size}'")
      | _ -> usageError "the following arguments are required: destination").
command _ ("disk" :: _) = usageError "argument disk_command: invalid choice (choose from 'create')".
command sdk ("install" :: rest) =
  withArgs rest ["--prefix"] Nil 2 (fn a ->
    case value a "--prefix" of
        O.Some _ -> Err "toolchain installation moved to qos toolchain install --prefix (contributor CLI)"
      | O.None -> case a.positional of
          [archive, dest] -> I.install sdk archive dest
        | _ -> Err "usage: qos install APP.qa DISK").
command sdk ("run" :: rest) =
  withArgs rest ["--disk"] ["--trace"] 1 (fn a ->
    case a.positional of
        Nil -> runApp sdk "." (value a "--disk") (flag a ["--trace"])
      | target :: _ ->
          if H.isDir target then runApp sdk target (value a "--disk") (flag a ["--trace"])
          else if O.isSome (value a "--disk") or flag a ["--trace"]
            then Err "--disk and --trace apply to qos run PROJECT (kind = \"app\")"
          else I.runMain sdk target).
# for the SDK stager: check a profile archive against an ABI, print "ID SHA256"
command _ ("inspect" :: rest) =
  withArgs rest ["--abi"] ["--main"] 1 (fn a ->
    case (a.positional, value a "--abi") of
        ([archive], O.Some abi) -> inspect archive abi (flag a ["--main"])
      | _ -> usageError "usage: qos inspect ARCHIVE --abi ABI [--main]").
command _ (c :: _) = usageError "argument command: invalid choice: '{c}' (choose from 'new', 'build', 'disk', 'install', 'run')".

main =
  case sdkRoot Unit |> R.andThen (fn sdk -> command sdk (Sys.args Unit)) of
      Ok _ -> Sys.exit 0
    | Err e -> _ = C.warn "qos: {e}"; Sys.exit 1.

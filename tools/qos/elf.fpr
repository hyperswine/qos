# elf.fpr -- what the SDK reads from an ELF64 image: its loadable bytes, its
# symbols and its relocations.  The FP-RISC form of tools/mkqa.py's reader,
# tools/mkimports.py and tools/mkexports.py; the generated assembly is the
# same text byte for byte, so the images are the same.
#
# Only little-endian ELF64 is read: every QOS app target is.

H = use "host".
L = use "std/list".
O = use "std/option".
R = use "std/result".
S = use "std/string".
Ord = use "std/order".

u8 s o = charAt s o.
u16 s o = charAt s o + charAt s (o + 1) * 256.
u32 s o = u16 s o + u16 s (o + 2) * 65536.
# a 64-bit field; values at or above 2^62 do not fit an Int and are refused
u64 s o | u32 s (o + 4) >= 1073741824 = Err "an ELF field at 0x{hex o} is too large".
u64 s o = Ok (u32 s o + u32 s (o + 4) * 4294967296).
u64z s o = R.withDefault (0 - 1) (u64 s o).

hexDigit d = substr "0123456789abcdef" d 1.
hex n = hexGo 16 n "".
hexGo : (fuel : Int | measure fuel) -> Int -> String -> String .
hexGo fuel n acc | fuel <= 0 = strcat (hexDigit n) acc.
hexGo _ n acc | n < 16 = strcat (hexDigit n) acc.
hexGo fuel n acc = hexGo (fuel - 1) (n / 16) (strcat (hexDigit (n - (n / 16) * 16)) acc).

within s o n = o >= 0 and n >= 0 and o + n <= strlen s.

ptLoad = 1.
pfX = 1.
pfW = 2.
shtSymtab = 2.
shtRela = 4.
shfAlloc = 2.
shnUndef = 0.
shnAbs = 65521.
stbGlobal = 1.
stbWeak = 2.

# Remove adjacent duplicates on a sorted list using a key extractor.
# `keepLast = True` keeps the last item in each equal-key run; `False` keeps the first.
dedupBy _ _ Nil = Nil.
dedupBy keepLast key (x :: xs) = dedupGo keepLast key x xs.

dedupGo : Bool -> (a -> k) -> a -> (xs : List a | measure xs) -> List a .
dedupGo keepLast key prev xs = case xs of
    Nil -> [prev]
  | x :: rest ->
      if key prev == key x
        then dedupGo keepLast key (if keepLast then x else prev) rest
        else prev :: dedupGo keepLast key x rest.

maxOf d xs = L.fold Int.max d xs.
minOf d xs = L.fold Int.min d xs.

header s | strlen s < 64 or substr s 0 4 != "\x7fELF" = Err "mkqa: not an ELF image".
header s | u8 s 4 != 2 = Err "mkqa: only ELF64 (the QOS app targets are all 64-bit)".
header s | u8 s 5 != 1 = Err "mkqa: only little-endian ELF".
header _ = Ok Unit.

machine s = u16 s 18.
architecture 183 = Ok "aarch64".
architecture 62  = Ok "x86_64".
architecture 243 = Ok "riscv64".
architecture m   = Err "mkqa: unsupported ELF machine {m}".

# ---- program headers: the flattened image ------------------------------------------
segments s = u64 s 32 |> R.andThen (segmentsAt s).
segmentsAt s phoff =
  size = u16 s 54;
  count = u16 s 56;
  if not (within s phoff (size * count) and (count == 0 or size >= 56))
    then Err "mkqa: program headers outside the file"
    else segGo s phoff size 0 count Nil.

segGo : String -> Int -> Int -> Int -> (rem : Int | measure rem) -> List { flags : Int, offset : Int, vaddr : Int, filesz : Int, memsz : Int } -> Result (List { flags : Int, offset : Int, vaddr : Int, filesz : Int, memsz : Int }) String .
segGo s phoff size i rem acc =
  if rem <= 0 then Ok (L.reverse acc)
  else
    o = phoff + i * size;
    if u32 s o != ptLoad then segGo s phoff size (i + 1) (rem - 1) acc
    else segment s o |> R.andThen (fn seg ->
      if seg.memsz == 0 then segGo s phoff size (i + 1) (rem - 1) acc
      else if not (within s seg.offset seg.filesz and seg.filesz <= seg.memsz)
        then Err "mkqa: a ptLoad segment lies outside the file"
        else segGo s phoff size (i + 1) (rem - 1) (seg :: acc)).

segment s o = case (u64 s (o + 8), u64 s (o + 16), u64 s (o + 32), u64 s (o + 40)) of
    (Ok off, Ok vaddr, Ok filesz, Ok memsz) ->
      Ok { flags = u32 s (o + 4), offset = off, vaddr = vaddr, filesz = filesz, memsz = memsz }
  | _ -> Err "mkqa: a ptLoad field is too large".

# ELF64 PT_LOADs -> { base, entry, execsz, rwoff, image, memsz }: the bytes up
# to the last file byte; the bss tail past it is the loader's to zero
flatten : unsafe String -> Result { base : Int, entry : Int, execsz : Int, rwoff : Int, image : String, memsz : Int } String .
flatten s =
  header s
  |> R.andThen (fn u -> segments s)
  |> R.andThen nonEmptySegments
  |> R.andThen (fn segs -> u64 s 24 |> R.andThen (flatSorted s (L.sortBy Ord.int (fn g -> g.vaddr) segs))).

nonEmptySegments Nil = Err "mkqa: ELF has no ptLoad segments".
nonEmptySegments segs = Ok segs.

flatSorted : unsafe String -> List { flags : Int, offset : Int, vaddr : Int, filesz : Int, memsz : Int } -> Int -> Result { base : Int, entry : Int, execsz : Int, rwoff : Int, image : String, memsz : Int } String .
flatSorted _ Nil _ = Err "mkqa: ELF has no ptLoad segments".
flatSorted s (first :: rest) entry =
  segs = first :: rest;
  base = first.vaddr;
  memsz = (segs |> L.map (fn g -> g.vaddr + g.memsz) |> maxOf 0) - base;
  filed = segs |> L.filter (fn g -> g.filesz > 0);
  execsz = segs |> L.filter (fn g -> band g.flags pfX != 0) |> L.map (fn g -> g.vaddr + g.filesz - base) |> maxOf 0;
  rwoff = segs |> L.filter (fn g -> band g.flags pfW != 0) |> L.map (fn g -> g.vaddr - base) |> minOf memsz;
  if entry < base or entry >= base + memsz then Err "mkqa: e_entry outside the loadable span"
  else pieces s filed base 0 Nil |> R.map (fn parts ->
    { base = base, entry = entry - base, execsz = execsz, rwoff = rwoff,
      image = strJoin "" parts, memsz = memsz }).

# file bytes in address order, gaps zero-filled (segments do not overlap)
pieces : unsafe String -> (segs : List { flags : Int, offset : Int, vaddr : Int, filesz : Int, memsz : Int } | measure segs) -> Int -> Int -> List String -> Result (List String) String .
pieces s segs base cursor acc = case segs of
    Nil -> Ok (L.reverse acc)
  | g :: rest ->
      at = g.vaddr - base;
      if at < cursor then Err "mkqa: ptLoad segments overlap"
      else pieces s rest base (at + g.filesz) (substr s g.offset g.filesz :: H.zeros (at - cursor) :: acc).

# ---- sections and symbols -------------------------------------------------------------
sections s = u64 s 40 |> R.andThen (sectionsAt s).
sectionsAt s shoff =
  size = u16 s 58;
  count = u16 s 60;
  if not (within s shoff (size * count) and (count == 0 or size >= 64))
    then Err "mkqa: section headers outside the file"
    else secGo s shoff size 0 count Nil.

secGo : String -> Int -> Int -> Int -> (rem : Int | measure rem) -> List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> Result (List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int }) String .
secGo s shoff size i rem acc =
  if rem <= 0 then Ok (L.reverse acc)
  else
    o = shoff + i * size;
    case (u64 s (o + 8), u64 s (o + 16), u64 s (o + 24), u64 s (o + 32), u64 s (o + 56)) of
      (Ok flags, Ok addr, Ok off, Ok sz, Ok entsz) ->
        typ = u32 s (o + 4);
        if typ != 8 and not (within s off sz)
          then Err "mkqa: section {i} lies outside the file"
          else secGo s shoff size (i + 1) (rem - 1)
                 ({ typ = typ, flags = flags, addr = addr, off = off, size = sz,
                    link = u32 s (o + 40), info = u32 s (o + 44), entsz = entsz } :: acc)
    | _ -> Err "mkqa: a section header field is too large".

# every symbol of the static symbol tables: { name, value, size, shndx, bind }
symbols s =
  header s
  |> R.andThen (fn u -> sections s)
  |> R.andThen (fn secs -> symTables s secs secs Nil).

symTables : String -> List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> (rest : List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } | measure rest) -> List (List { name : String, value : Int, size : Int, shndx : Int, bind : Int }) -> Result (List { name : String, value : Int, size : Int, shndx : Int, bind : Int }) String .
symTables s secs rest acc = case rest of
    Nil -> Ok (acc |> L.reverse |> L.concat)
  | sec :: more ->
      if sec.typ != shtSymtab then symTables s secs more acc
      else readSymTable s secs sec |> R.andThen (fn syms -> symTables s secs more (syms :: acc)).

readSymTable s secs sec | sec.entsz < 24 = Err "mkqa: invalid symbol table entry size".
readSymTable s secs sec = case L.get sec.link secs of
    O.None -> Err "mkqa: a symbol table names a missing string table"
  | O.Some strtab -> symGo s sec strtab 0 (sec.size / sec.entsz) Nil.

symGo : String -> { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> Int -> (rem : Int | measure rem) -> List { name : String, value : Int, size : Int, shndx : Int, bind : Int } -> Result (List { name : String, value : Int, size : Int, shndx : Int, bind : Int }) String .
symGo s sec strtab k rem acc =
  if rem <= 0 then Ok (L.reverse acc)
  else
    o = sec.off + k * sec.entsz;
    start = strtab.off + u32 s o;
    stop = strIndexFrom "\x00" s start;
    case (u64 s (o + 8), u64 s (o + 16)) of
      (Ok value, Ok size) ->
        if stop < 0 or start >= strtab.off + strtab.size
          then Err "mkqa: a symbol name lies outside its string table"
          else symGo s sec strtab (k + 1) (rem - 1)
                 ({ name = substr s start (stop - start), value = value, size = size,
                    shndx = u16 s (o + 6), bind = u8 s (o + 4) / 16 } :: acc)
    | _ -> Err "mkqa: a symbol field is too large".

# ---- relocations ------------------------------------------------------------------------
rules 243 = O.Some ("RISC-V", 2, [0, 16, 17, 18, 19, 23, 24, 25, 33, 34, 35, 36, 37, 38, 39, 40,
                                  43, 44, 45, 51, 52, 53, 54, 55, 56, 57]).
rules 183 = O.Some ("AArch64", 257, [0, 260, 261, 262, 273, 274, 275, 276, 277, 278, 284, 285, 286, 299,
                                     279, 280, 282, 283]).
rules 62  = O.Some ("x86-64", 1, [0, 2, 4, 24]).
rules _   = O.None.

# the offsets (from base) of every 64-bit word holding an absolute address
# inside the image, from an ELF linked with --emit-relocs
relocations s base imagesz = case rules (machine s) of
    O.None -> Err "mkqa: --relocatable knows no relocation rules for ELF machine {machine s}"
  | O.Some (arch, abs64, free) ->
      sections s
      |> R.andThen (fn secs -> relocSecs s secs secs base imagesz abs64 free Nil 0 0 Nil)
      |> R.andThen (relocDone arch).

relocDone _ (offs, 0, _, _) = Ok (offs |> L.sortWith Ord.int |> dedupBy False (fn x -> x)).
relocDone arch (_, refused, first, kinds) =
  kindStr = kinds |> L.map str |> L.sortWith Ord.string |> dedupBy False (fn x -> x) |> S.join ", ";
  Err "mkqa: {refused} relocation(s) bind this image to its link address ({arch} types {kindStr}; first at 0x{hex first}) -- it cannot be moved".

relocSecs : String -> List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> (rest : List { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } | measure rest) -> Int -> Int -> Int -> List Int -> List Int -> Int -> Int -> List Int -> Result (List Int, Int, Int, List Int) String .
relocSecs s secs rest base imagesz abs64 free offs refused first kinds = case rest of
    Nil -> Ok (offs, refused, first, kinds)
  | sec :: more ->
      if sec.typ != shtRela then
        relocSecs s secs more base imagesz abs64 free offs refused first kinds
      else case (L.get sec.info secs, L.get sec.link secs) of
          (O.Some target, O.Some symtab) ->
            if band target.flags shfAlloc == 0 then
              relocSecs s secs more base imagesz abs64 free offs refused first kinds
            else if sec.entsz < 24 or symtab.entsz < 24 then
              Err "mkqa: invalid relocation or symbol entry size"
            else
              relocGo s sec symtab 0 (sec.size / sec.entsz) base imagesz abs64 free offs refused first kinds
              |> R.andThen (fn st -> (o2, r2, f2, k2) = st; relocSecs s secs more base imagesz abs64 free o2 r2 f2 k2)
        | _ -> Err "mkqa: a relocation section names a missing section".

relocGo : String -> { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> { typ : Int, flags : Int, addr : Int, off : Int, size : Int, link : Int, info : Int, entsz : Int } -> Int -> (rem : Int | measure rem) -> Int -> Int -> Int -> List Int -> List Int -> Int -> Int -> List Int -> Result (List Int, Int, Int, List Int) String .
relocGo s sec symtab k rem base imagesz abs64 free offs refused first kinds =
  if rem <= 0 then Ok (offs, refused, first, kinds)
  else
    o = sec.off + k * sec.entsz;
    rtype = u32 s (o + 8);
    rsym = u32 s (o + 12);
    so = symtab.off + rsym * symtab.entsz + 6;
    u64 s o |> R.andThen (fn roffset ->
      if not (within s so 2) then Err "mkqa: a relocation names a missing symbol"
      else
        shndx = u16 s so;
        if L.member rtype free or shndx == shnAbs then
          relocGo s sec symtab (k + 1) (rem - 1) base imagesz abs64 free offs refused first kinds
        else if rtype == abs64 and shndx != shnUndef then
          at = roffset - base;
          if at < 0 or at > imagesz - 8
            then Err "mkqa: an address word at 0x{hex roffset} lies outside the image's file bytes"
            else relocGo s sec symtab (k + 1) (rem - 1) base imagesz abs64 free (at :: offs) refused first kinds
        else
          first2 = if refused == 0 then roffset else first;
          relocGo s sec symtab (k + 1) (rem - 1) base imagesz abs64 free offs (refused + 1) first2 (rtype :: kinds)).

# The same image linked `delta` higher must differ from this one at exactly
# the relocated words, by exactly delta: the list is complete.
checkMoved : unsafe String -> List Int -> String -> Int -> Result Unit String .
checkMoved image relocs other delta | strlen other != strlen image =
  Err "mkqa: --check-moved: the two links differ in size".
checkMoved image relocs other delta = case uncovered (H.differences image other) relocs of
    O.Some o -> Err "mkqa: --check-moved: the byte at 0x{hex o} moves with the link address but is not in a relocated word"
  | O.None -> movedBy image other relocs delta.

# both lists ascending; relocated words are 8 bytes from each offset
dropRelocs : Int -> (relocs : List Int | measure relocs) -> List Int .
dropRelocs d relocs = case relocs of
    Nil -> Nil
  | r :: more -> if d >= r + 8 then dropRelocs d more else r :: more.

uncovered : (diffs : List Int | measure diffs) -> List Int -> O.Option Int .
uncovered diffs relocs = case diffs of
    Nil -> O.None
  | d :: rest -> case dropRelocs d relocs of
      Nil -> O.Some d
    | r :: more -> if d < r then O.Some d else uncovered rest (r :: more).

movedBy : String -> String -> (relocs : List Int | measure relocs) -> Int -> Result Unit String .
movedBy image other relocs delta = case relocs of
    Nil -> Ok Unit
  | o :: rest -> case (u64 image o, u64 other o) of
      (Ok a, Ok b) ->
        if b - a == delta then movedBy image other rest delta
        else Err "mkqa: --check-moved: the word at 0x{hex o} moved by {b - a}, not {delta}"
    | _ -> Err "mkqa: --check-moved: a relocated word is too large".

# ---- imports (a Portable plugin's, tools/mkimports.py) ------------------------------
dataSize "fpr_true"     = O.Some 8.
dataSize "fpr_false"    = O.Some 8.
dataSize "fpr_unit"     = O.Some 8.
dataSize "fpr_g_tlsoff" = O.Some 8.
dataSize name | S.startsWith "fpr_g_" name and not (callSuffix name) = O.Some 32.
dataSize _ = O.None.

# "..._call<digits>"
callSuffix name = callGo name (strlen name) False.
callGo : String -> (rem : Int | measure rem) -> Bool -> Bool .
callGo name rem digits =
  if rem <= 0 then False
  else if S.isDigit (charAt name (rem - 1)) then callGo name (rem - 1) True
  else digits and rem >= 5 and substr name (rem - 5) 5 == "_call".

symbolName n = strlen n > 0 and symStart (charAt n 0) and symRest n 1 (strlen n - 1).
symStart c = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95.
symRest : String -> Int -> (rem : Int | measure rem) -> Bool .
symRest n i rem =
  if rem <= 0 then True
  else if symStart (charAt n i) or S.isDigit (charAt n i) or charAt n i == 46 or charAt n i == 36
    then symRest n (i + 1) (rem - 1)
    else False.

stub "a64" n = ["    adrp x16, __qosimp_c_{n}", "    ldr x16, [x16, :lo12:__qosimp_c_{n}]", "    br x16"].
stub "x64" n = ["    jmp *__qosimp_c_{n}(%rip)"].
stub _ n     = ["    lla t0, __qosimp_c_{n}", "    ld t0, 0(t0)", "    jr t0"].

# the import stubs' assembly, from a first link's undefined symbols
importStubs arch s =
  symbols s |> R.andThen (fn syms ->
    names = syms
      |> L.filter (fn y -> y.shndx == shnUndef and strlen y.name > 0 and y.bind != stbWeak)
      |> L.map (fn y -> y.name)
      |> L.sortWith Ord.string
      |> dedupBy False (fn x -> x);
    stubLines arch names
      ["# generated by tools/mkimports.py: the plugin's imports, completed by",
       "# the loader from the app's export table (docs/2026-10-01-IMPORT-TABLE.md)"]).

stubLines : String -> (names : List String | measure names) -> List String -> Result String String .
stubLines arch names acc = case names of
    Nil -> Ok (strcat (S.join "\n" acc) "\n")
  | n :: rest ->
      if not (symbolName n) then Err "mkimports: cannot stub the symbol '{n}'"
      else case dataSize n of
          O.Some size ->
            stubLines arch rest (L.append acc
              ["    .section .data.qosimp,\"aw\",@progbits", "    .balign 8", "    .globl {n}",
               "    .globl __qosimp_d{size}_{n}", "{n}:", "__qosimp_d{size}_{n}:", "    .zero {size}"])
        | O.None ->
            if not (S.startsWith "fpr_" n)
              then Err "mkimports: the plugin needs {n}, which is not part of the runtime an app exports"
              else stubLines arch rest (L.concat [acc,
                     ["    .section .text.qosimp,\"ax\",@progbits", "    .balign 4", "    .globl {n}", "{n}:"],
                     stub arch n,
                     ["    .section .data.qosimp,\"aw\",@progbits", "    .balign 8",
                      "    .globl __qosimp_c_{n}", "__qosimp_c_{n}:", "    .quad 0"]]).

# the IMPORT section rows, from the final link's __qosimp_ markers
importRows s base =
  symbols s |> R.andThen (fn syms ->
    syms
    |> L.filter (fn y -> S.startsWith "__qosimp_" y.name and y.shndx != shnUndef)
    |> (fn ms -> rowsGo ms base Nil)).

rowsGo : (syms : List { name : String, value : Int, size : Int, shndx : Int, bind : Int } | measure syms) -> Int -> List { sym : String, row : String } -> Result (List String) String .
rowsGo syms base acc = case syms of
    Nil ->
      rowOrder = Ord.by (fn r -> r.sym) Ord.string |> Ord.thenBy (Ord.by (fn r -> r.row) Ord.string);
      Ok (acc |> L.sortWith rowOrder |> dedupBy False (fn r -> r.row) |> L.map (fn r -> r.row))
  | y :: rest ->
      tail = substr y.name 9 (strlen y.name - 9);
      cut = strIndexOf "_" tail;
      kind = if cut < 0 then tail else substr tail 0 cut;
      sym = if cut < 0 then "" else substr tail (cut + 1) (strlen tail - cut - 1);
      if kind == "c" then
        rowsGo rest base ({ sym = sym, row = "c {y.value - base} 8 {sym}" } :: acc)
      else if strlen kind > 1 and charAt kind 0 == 100 and allDigits kind 1 (strlen kind - 1) then
        rowsGo rest base ({ sym = sym, row = "d {y.value - base} {substr kind 1 (strlen kind - 1)} {sym}" } :: acc)
      else
        Err "mkqa: unknown import marker {y.name}".

allDigits : String -> Int -> (rem : Int | measure rem) -> Bool .
allDigits t i rem =
  if rem <= 0 then True
  else if S.isDigit (charAt t i) then allDigits t (i + 1) (rem - 1)
  else False.

# ---- exports (a Portable app's, tools/mkexports.py) ----------------------------------
exported name = S.startsWith "fpr_" name
  and not (S.startsWith "fpr_fn_" name)
  and not (S.startsWith "fpr_obj_" name)
  and name != "fpr_modtab"
  and name != "fpr_contab".

exportTable s =
  symbols s |> R.map (fn syms ->
    byNameIdx = Ord.by (fn r -> r.name) Ord.string |> Ord.thenBy (Ord.by (fn r -> r.idx) Ord.int);
    rows = syms
      |> L.filter (fn y -> y.bind == stbGlobal and y.shndx != shnUndef and y.shndx != shnAbs and exported y.name)
      |> L.indexedMap (fn i y -> { name = y.name, idx = i, size = y.size })
      |> L.sortWith byNameIdx
      |> dedupBy True (fn r -> r.name);
    head = ["# generated by tools/mkexports.py: the runtime this app exports to plugins",
            "    .section .rodata.qos_exports,\"a\",@progbits", "    .balign 8", "    .globl qos_exports",
            "qos_exports:", "    .quad {L.length rows}"];
    entries = rows |> L.indexedMap (fn i r -> ["    .quad .Lqx{i}", "    .quad {r.name}", "    .quad {r.size}"]) |> L.concat;
    names = rows |> L.indexedMap (fn i r -> [".Lqx{i}:", "    .asciz \"{r.name}\""]) |> L.concat;
    strcat (S.join "\n" (L.concat [head, entries, names])) "\n").

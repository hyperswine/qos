# build.fpr -- builds desktop plugins and standalone apps into QAR2 archives.

C = use "common".
E = use "elf".
H = use "host".
P = use "project".
Q = use "qa".
J = use "std/json".
L = use "std/list".
M = use "std/map".
O = use "std/option".
R = use "std/result".
S = use "std/string".
OS = use "std/os".

# kind = "app": the platform units in link order, and their build settings.
# Both are part of the platform cache key.
platformUnits = [
  "appside/entry.c", "appside/hal.c", "appside/support.c",
  "runtime/runtime.c", "runtime/i32.c", "runtime/actors.c", "runtime/bits.c",
  "runtime/vec.c", "runtime/mod.c", "runtime/buddy.c",
  "loader/qaimg.c", "portable/sha256.c", "machine/unix/ctx_a64.S"].
platformLinkerScript = "appside/link-qosapp-a64.ld".

# macOS reserves 0x180000000-0x7000000000 in every process, so Darwin hosts
# and their apps sit at 1 TiB (qos-app.mk, qos_abi.h)
arenaBase : unsafe Unit -> String .
arenaBase _ = if H.system Unit == "darwin" then "0x10000000000ul" else "0x400000000ul".

appCflags : unsafe Unit -> List String .
appCflags _ = [
  "-O2", "-ffreestanding", "-nostdlib", "-fno-stack-protector", "-fno-asynchronous-unwind-tables",
  "-fno-pic", "-ffixed-x18", "-ffixed-x27", "-ffixed-x28", "-DFPR_POSIX", "-DFPR_QOSAPP",
  "-DQOS_ARENA_BASE={arenaBase Unit}", "-DFPR_NHARTS=8", "-DFPR_SLAB_SZ=262144", "-DFPR_STACK_SZ=1048560"].

movedDelta = "0x10000000".
movedDeltaInt = 268435456.

# platform files another file #includes instead of compiling them itself
includedBy "hal/net_actor_bridge.c" = "appside/hal.c".
includedBy "hal/timed_receive.c" = "appside/hal.c".
includedBy "runtime/bigint.inc" = "runtime/runtime.c".
includedBy name = name.

# (arch, target, importsArch, triple)
native : unsafe Unit -> Result (String, String, String, String) String .
native _ = case H.machine Unit of
    "arm64"   -> Ok ("aarch64", "qa64", "a64", "aarch64-none-elf")
  | "aarch64" -> Ok ("aarch64", "qa64", "a64", "aarch64-none-elf")
  | "x86_64"  -> Ok ("x86_64", "qx64", "x64", "x86_64-none-elf")
  | "amd64"   -> Ok ("x86_64", "qx64", "x64", "x86_64-none-elf")
  | m         -> Err "desktop SDK v2 does not support {m}".

sdkMeta sdk =
  C.readFile (C.join sdk "sdk.json")
  |> R.andThen (fn raw -> J.parse raw |> R.mapError (fn e -> "sdk.json: {e}")).

# Do not inherit checkout/module overrides from a contributor's shell.
environment : unsafe String -> Unit .
environment sdk =
  _ = H.envNames Unit |> L.each (fn n -> if S.startsWith "FPR_" n or n == "FPRISC_ROOT" then H.unsetEnv n else Unit);
  _ = H.setEnv "FPR_HOME" (C.join sdk "modules");
  _ = H.setEnv "FPR_PATH" (C.join sdk "compiler");
  _ = H.setEnv "FPR_FOREIGN" (C.join sdk "modules/core/foreign.fpr");
  H.setEnv "LC_ALL" "C.UTF-8".

# qos.toml v2 [build] settings; the compiler's environment is never the interface
compilerSettings : unsafe { root : String, manifest : Int, app : J.Value, build : J.Value, run : J.Value, sdk : J.Value, platform : J.Value, entry : String } -> Unit .
compilerSettings p =
  _ = H.unsetEnv "GHCRTS";
  _ = P.optimize p |> P.optimizeFlags |> L.each (fn n -> H.setEnv "FPR_NO_{n}" "1");
  if P.memoryMb p > 0 then H.setEnv "GHCRTS" "-M{P.memoryMb p}M -A32M" else Unit.

# The SDK's own ld.lld (toolchain/ld.lld, hash-checked) when it ships one, else PATH's.
tools : unsafe String -> J.Value -> Result (String, String) String .
tools sdk meta = case C.which "clang" of
    O.None -> Err "install Clang and lld and add their bin directories to PATH"
  | O.Some clang -> linker sdk meta |> R.map (fn ld -> (clang, ld)).

linker : unsafe String -> J.Value -> Result String String .
linker sdk meta = case C.objectField "toolchainFiles" meta |> O.andThen (M.get "ld.lld") of
    O.Some (J.Text expected) ->
      ld = C.join sdk "toolchain/ld.lld";
      (case H.sha256File ld of
          Ok h -> if h == expected then Ok ld else Err "SDK linker changed; install a matching release set"
        | Err _ -> Err "SDK linker missing; install a matching release set")
  | _ -> pathLinker Unit.

pathLinker : unsafe Unit -> Result String String .
pathLinker _ = case C.which "ld.lld" of
    O.Some ld -> Ok ld
  | O.None -> Err "install Clang and lld and add their bin directories to PATH".

compatible : unsafe J.Value -> String -> Result Unit String .
compatible meta arch =
  ok = C.textIs "desktopApi" meta C.api
    and C.textIs "desktopSession" meta C.session
    and C.textIs "os" meta (H.system Unit)
    and C.textIs "architecture" meta arch
    and C.intField "format" meta == O.Some 1;
  C.check ok "incompatible SDK: install a matching native QOS Portable SDK".

build : unsafe String -> String -> O.Option String -> Bool -> Result String String .
build sdk where compiler verbose =
  native Unit |> R.andThen (fn nat ->
    (arch, _, _, _) = nat;
    sdkMeta sdk |> R.andThen (fn meta ->
      compatible meta arch
      |> R.andThen (fn u -> H.realpath (C.join sdk "compiler/fpr") |> R.mapError (fn e -> "SDK compiler missing; install a matching release set"))
      |> R.andThen (fn fpr ->
          sameCompiler compiler fpr
          |> R.andThen (fn u -> C.digest fpr)
          |> R.andThen (fn h -> C.check (C.textIs "compilerSha256" meta h) "SDK compiler changed; install a matching release set")
          |> R.andThen (fn u -> P.load where)
          |> R.andThen (fn p ->
              P.checkSdkVersion p.sdk meta
              |> R.andThen (fn u ->
                  if P.appText "kind" p == "app" then buildApp sdk meta fpr p verbose nat
                  else buildDesktop sdk meta fpr p verbose nat))))).

sameCompiler : unsafe O.Option String -> String -> Result Unit String .
sameCompiler O.None _ = Ok Unit.
sameCompiler (O.Some c) fpr = case H.realpath c of
    Ok r -> C.check (r == fpr) "the selected fpr and SDK differ; build with this SDK's `qos build`"
  | Err _ -> Err "the selected fpr and SDK differ; build with this SDK's `qos build`".

outDir : unsafe { root : String, manifest : Int, app : J.Value, build : J.Value, run : J.Value, sdk : J.Value, platform : J.Value, entry : String } -> Result String String .
outDir p =
  out = C.join p.root "build";
  if H.kind out == 2 then Err "build/ cannot be a symlink"
  else C.mkdirs out |> R.map (fn u -> out).

# A unique intermediate directory, removed afterwards; the archive is moved
# into build/ only when every step succeeded.
withWork : unsafe String -> String -> Bool -> (String -> { fd : Int, path : String, verbose : Bool } -> Result a String) -> Result a String .
withWork out prefix verbose body =
  H.tempDir (C.join out "{prefix}XXXXXX")
  |> R.mapError (fn e -> "{out}: {e}")
  |> R.andThen (fn work ->
      case C.openLog (C.join out "qos-build.log") verbose of
          Err e -> _ = H.removeTree work; Err e
        | Ok log ->
            result = body work log;
            _ = C.closeLog log;
            _ = H.removeTree work;
            result).

lines text = text |> S.lines |> L.filter (fn l -> strlen l > 0).

compileUnits log clang triple work asm =
  C.readFile (strcat asm ".units") |> R.andThen (fn units ->
    sources = asm :: lines units;
    C.mapR (fn iv ->
      (i, source) = iv;
      obj = C.join work "unit-{i}.o";
      C.run log [clang, "--target={triple}", "-c", source, "-o", obj] "" |> R.map (fn u -> obj)) (L.indexed sources)).

abiOf meta asm =
  C.readFile (strcat asm ".abirev") |> R.andThen (fn rev ->
    abi = "{C.textOr "" "portableAbi" meta}.{S.trim rev}";
    C.check (C.textIs "abi" meta abi) "SDK compiler/profile ABI mismatch; reinstall a matching SDK"
    |> R.map (fn u -> abi)).

manifestLine (k, v) = "{k} = {v}\n".

buildDesktop : unsafe String -> J.Value -> String -> { root : String, manifest : Int, app : J.Value, build : J.Value, run : J.Value, sdk : J.Value, platform : J.Value, entry : String } -> Bool -> (String, String, String, String) -> Result String String .
buildDesktop sdk meta fpr p verbose (arch, target, importsArch, triple) =
  C.check (not (L.any (fn c -> strIndexOf c p.entry >= 0) ["\"", "\\", "\n", "\r"])) "project path cannot contain quotes, backslashes or newlines"
  |> R.andThen (fn u -> outDir p)
  |> R.andThen (fn out ->
      _ = environment sdk;
      _ = if p.manifest == 2 then compilerSettings p else Unit;
      tools sdk meta |> R.andThen (fn tl ->
        (clang, ld) = tl;
        withWork out ".desktop-" verbose (fn work log ->
          adapter = C.join work "entry.fpr";
          asm = C.join work "app.s";
          common = [ld, "-T", C.join sdk "support/link-qosplug.ld", "--emit-relocs", "--no-relax"];
          first = C.join work "first.elf";
          image = C.join work "image.elf";
          moved = C.join work "moved.elf";
          stub = C.join work "imports.s";
          stubObj = C.join work "imports.o";
          C.readFile (C.join sdk "tools/desktop-adapter.fpr.in")
          |> R.andThen (fn template -> C.writeFile adapter (S.replace "__ENTRY__" (C.withoutSuffix p.entry) template))
          |> R.andThen (fn u -> C.run log [fpr, "compile", "--target={target}", "--plugin", "--prelude={C.join sdk "compiler/core/prelude.fpr"}", adapter, asm] "")
          |> R.andThen (fn u -> compileUnits log clang triple work asm)
          |> R.andThen (fn objects ->
              C.run log (L.concat [common, ["--defsym=PLUG_BASE=0", "--unresolved-symbols=ignore-all"], objects, ["-o", first]]) ""
              |> R.andThen (fn u -> C.readFile first)
              |> R.andThen (E.importStubs importsArch)
              |> R.andThen (C.writeFile stub)
              |> R.andThen (fn u ->
                  _ = C.logWrite log "mkimports: wrote {stub}\n";
                  C.run log [clang, "--target={triple}", "-c", stub, "-o", stubObj] "")
              |> R.andThen (fn u -> C.each (fn bd ->
                  (base, dest) = bd;
                  C.run log (L.concat [common, ["--defsym=PLUG_BASE={base}"], objects, [stubObj, "-o", dest]]) "") [("0", image), ("0x10000000", moved)])
              |> R.andThen (fn u -> abiOf meta asm)
              |> R.andThen (fn abi ->
                  fields = [
                    ("name", C.jsonStr (P.appText "name" p)), ("id", C.jsonStr (P.appText "id" p)),
                    ("version", C.jsonStr (P.appText "version" p)), ("entry", C.jsonStr "fpr_modtab"),
                    ("loadMode", C.jsonStr "plugin"), ("abi", C.jsonStr abi), ("architecture", C.jsonStr arch),
                    ("desktopSession", C.jsonStr C.session), ("desktopApi", C.jsonStr C.api)];
                  archive sdk work log (fields |> L.map manifestLine |> S.concat) image moved True)
              |> R.andThen (fn qa -> publish qa out p))))).

archive : unsafe String -> String -> { fd : Int, path : String, verbose : Bool } -> String -> String -> String -> Bool -> Result String String .
archive _ work log manifest image moved imports =
  _ = C.writeFile (C.join work "manifest.toml") manifest;
  C.readFile image |> R.andThen (fn elf ->
    C.readFile moved |> R.andThen (fn other ->
      case Q.write manifest elf { relocatable = True, moved = O.Some other, delta = movedDeltaInt, imports = imports } of
          Err e -> _ = C.logWrite log (strcat e "\n"); Err e
        | Ok bytes ->
            qa = C.join work "app.qa";
            _ = C.logWrite log "mkqa: wrote {qa}: {strlen bytes}B total\n";
            C.writeFile qa bytes |> R.map (fn u -> qa))).

publish qa out p =
  destination = C.join out "{P.appText "id" p}.qa";
  OS.rename qa destination
  |> R.mapError (fn e -> "{destination}: {e}")
  |> R.map (fn u -> _ = C.say "Built {destination}"; destination).

# ---- kind = "app" ------------------------------------------------------------------------
platformDigest : unsafe List (String, String) -> String .
platformDigest files =
  files
  |> L.sortWith (fn a b -> (x, _) = a; (y, _) = b; S.compare x y)
  |> L.map (fn kv -> (name, sha) = kv; "{sha}  {name}\n")
  |> S.concat
  |> H.sha256.

# the verified platform inventory; a changed or missing file is refused by name
platformInputs : unsafe String -> J.Value -> Result (List String) String .
platformInputs sdk meta = case C.objectField "platformFiles" meta of
    O.None -> Err "this SDK has no kind = \"app\" platform files; install QOS Portable 0.3.0 or later"
  | O.Some m ->
      files = C.textMap m;
      if not (C.textIs "platformSha256" meta (platformDigest files) and L.length files == M.size m)
        then Err "this SDK has no kind = \"app\" platform files; install QOS Portable 0.3.0 or later"
      else
        names = files |> L.map (fn kv -> (n, _) = kv; n);
        C.each (fn n -> C.check (L.member n names) "SDK platform inventory lacks {n}; reinstall a matching SDK") (L.append platformUnits [platformLinkerScript])
        |> R.andThen (fn u -> C.each (fn kv ->
            (name, expected) = kv;
            path = C.join sdk (C.join "platform" name);
            case H.sha256File path of
                Ok h -> C.check (h == expected and H.isFile path) "SDK platform file {name} changed; reinstall a matching SDK"
              | Err _ -> Err "SDK platform file {name} changed; reinstall a matching SDK") files)
        |> R.map (fn u -> names).

appFlags : unsafe String -> String -> List String .
appFlags triple platform = L.concat [
  ["--target={triple}"],
  appCflags Unit,
  ["-I{C.join platform "runtime"}", "-I{C.join platform "appside"}", "-I{C.join platform "hal"}"]].

cacheHome _ =
  base = case C.env "XDG_CACHE_HOME" of
      O.Some d -> if d == "" then C.join (C.env "HOME" |> O.withDefault "") ".cache" else d
    | O.None -> C.join (C.env "HOME" |> O.withDefault "") ".cache";
  C.join base "qos-portable".

objName unit = strcat (S.replace "/" "-" unit) ".o".

# Platform C compiled once per SDK hash, Clang and settings, into the user's cache.
platformObjects : unsafe String -> J.Value -> String -> String -> { fd : Int, path : String, verbose : Bool } -> Result (List String) String .
platformObjects sdk meta clang triple log = case OS.run [clang, "--version"] "" "" Nil 0 of
    Err e -> Err "clang: {e}"
  | Ok (_, clangVersion, _) ->
      platform = C.join sdk "platform";
      flags = appFlags triple platform;
      identity = S.concat [
        "\{\n  \"clang\": ", C.jsonStr clangVersion, ",\n  \"flags\": [",
        flags |> L.map C.jsonStr |> S.join ", ", "],\n  \"platform\": ",
        C.jsonStr (C.textOr "" "platformSha256" meta), ",\n  \"sdk\": ", C.jsonStr sdk,
        ",\n  \"units\": [", platformUnits |> L.map C.jsonStr |> S.join ", ", "]\n}\n"];
      home = C.join (cacheHome Unit) "platform";
      done = C.join home (H.sha256 identity);
      objects = platformUnits |> L.map (fn unit -> C.join done (objName unit));
      if H.isFile (C.join done "identity.json") and L.all H.isFile objects then Ok objects
      else C.mkdirs home |> R.andThen (fn u ->
        H.tempDir (C.join home ".build-XXXXXX")
        |> R.mapError (fn e -> "{home}: {e}")
        |> R.andThen (fn work ->
            made = C.each (fn unit -> C.run log (L.concat [[clang], flags, ["-c", C.join platform unit, "-o", C.join work (objName unit)]]) "") platformUnits
              |> R.andThen (fn u2 -> C.writeFile (C.join work "identity.json") identity)
              |> R.andThen (fn u3 -> case OS.rename work done of
                  Ok _ -> Ok Unit
                | Err e ->
                    # another build published the same key first; its objects are equivalent
                    if H.isFile (C.join done "identity.json") then Ok Unit else Err "{done}: {e}");
            _ = H.removeTree work;
            made |> R.map (fn u4 -> _ = C.say "Compiled SDK platform objects into {done}"; objects))).

# Replace overridden platform objects and append added sources.  An override
# compiles from an overlay of the SDK's platform folder, in the SDK file's own
# place, so it sees exactly the SDK's headers and relative includes.
projectPlatform : unsafe String -> String -> List String -> List (String, String, String) -> List (String, String) -> String -> String -> { fd : Int, path : String, verbose : Bool } -> Result (List String) String .
projectPlatform sdk work cached overrides added clang triple log =
  overlay = C.join work "platform";
  platform = C.join sdk "platform";
  C.each (fn name ->
    dest = C.join overlay name;
    source = overrides |> L.find (fn o -> (n, _, _) = o; n == name) |> O.map (fn o -> (_, _, path) = o; path) |> O.withDefault (C.join platform name);
    C.mkdirs (C.parent dest) |> R.andThen (fn u -> C.copyFile source dest)) (C.walk platform)
  |> R.andThen (fn u ->
      rebuild = overrides |> L.map (fn o -> (n, _, _) = o; includedBy n);
      C.mapR (fn iu ->
        (i, unit) = iu;
        if not (L.member unit rebuild) then Ok (L.get i cached |> O.withDefault "")
        else
          obj = C.join work (strcat "override-" (objName unit));
          C.run log (L.concat [[clang], appFlags triple overlay, ["-c", C.join overlay unit, "-o", obj]]) "" |> R.map (fn u2 -> obj)) (L.indexed platformUnits))
  |> R.andThen (fn objects ->
      C.mapR (fn ia ->
        (i, (value, source)) = ia;
        obj = C.join work "added-{i}-{C.stem source}.o";
        C.run log (L.concat [[clang], appFlags triple platform, ["-c", source, "-o", obj]]) "" |> R.map (fn u2 -> obj)) (L.indexed added)
      |> R.map (fn extra -> L.append objects extra)).

short h = substr h 0 16.

# [[platformOverrides]] tables for the archive manifest, after its top-level keys
platformRecord : unsafe List (String, String, String) -> List (String, String) -> Result String String .
platformRecord overrides added =
  rows = L.append
    (overrides |> L.map (fn o -> (name, value, source) = o; (True, name, value, source)))
    (added |> L.map (fn a -> (value, source) = a; (False, "", value, source)));
  C.mapR (fn r ->
    (isOverride, name, value, source) = r;
    C.digest source |> R.map (fn h ->
      if isOverride
        then "\n[[platformOverrides]]\nkind = \"override\"\nfile = {C.jsonStr name}\nsource = {C.jsonStr value}\nsha256 = {C.jsonStr h}\n"
        else "\n[[platformOverrides]]\nkind = \"added\"\nsource = {C.jsonStr value}\nsha256 = {C.jsonStr h}\n")) rows
  |> R.map S.concat.

announce : unsafe List (String, String, String) -> List (String, String) -> Result Unit String .
announce overrides added =
  C.each (fn o -> (name, value, source) = o; C.digest source |> R.map (fn h -> _ = C.say "qos: platform override: {name} replaced by {value} (sha256 {short h})"; Unit)) overrides
  |> R.andThen (fn u -> C.each (fn a -> (value, source) = a; C.digest source |> R.map (fn h -> _ = C.say "qos: platform source added: {value} (sha256 {short h})"; Unit)) added).

buildApp : unsafe String -> J.Value -> String -> { root : String, manifest : Int, app : J.Value, build : J.Value, run : J.Value, sdk : J.Value, platform : J.Value, entry : String } -> Bool -> (String, String, String, String) -> Result String String .
buildApp sdk meta fpr p verbose (arch, target, _, triple) =
  C.check (arch == "aarch64") "kind = \"app\" needs an AArch64 host; this SDK's platform files are AArch64"
  |> R.andThen (fn u -> platformInputs sdk meta)
  |> R.andThen (P.platformChoices p.root p.platform)
  |> R.andThen (fn choice ->
      (overrides, added) = choice;
      announce overrides added
      |> R.andThen (fn u -> outDir p)
      |> R.andThen (fn out ->
          _ = environment sdk;
          # an app may use the onboard programs' modules (mods/...), as Main does
          _ = H.setEnv "FPR_PATH" "{C.join sdk "compiler"}:{C.join sdk "modules/programs"}";
          _ = compilerSettings p;
          tools sdk meta |> R.andThen (fn tl ->
            (clang, ld) = tl;
            withWork out ".app-" verbose (fn work log ->
              asm = C.join work "app.s";
              common = [ld, "-T", C.join sdk (C.join "platform" platformLinkerScript), "--emit-relocs",
                        "--defsym=_heap_start=_proc_image_end", "--defsym=_heap_end=_proc_image_end"];
              first = C.join work "first.elf";
              image = C.join work "image.elf";
              moved = C.join work "moved.elf";
              exports = C.join work "exports.s";
              exportsObj = C.join work "exports.o";
              # relative imports (../models/...) resolve from the project, as with fpr
              C.run log [fpr, "compile", "--target={target}", "--prelude={C.join sdk "compiler/core/prelude.fpr"}", p.entry, asm] p.root
              |> R.andThen (fn u -> abiOf meta asm)
              |> R.andThen (fn abi ->
                  compileUnits log clang triple work asm |> R.andThen (fn program ->
                    platformObjects sdk meta clang triple log |> R.andThen (fn cached ->
                      (if L.isEmpty overrides and L.isEmpty added then Ok cached
                       else projectPlatform sdk work cached overrides added clang triple log)
                      |> R.andThen (fn platform ->
                          # two links: the first learns the runtime's symbols, the export table
                          # plugins import from by name is generated, and the real link has it
                          C.run log (L.concat [common, ["--defsym=QOS_SLOT_BASE=0", "--unresolved-symbols=ignore-all"], program, platform, ["-o", first]]) ""
                          |> R.andThen (fn u2 -> C.readFile first)
                          |> R.andThen E.exportTable
                          |> R.andThen (C.writeFile exports)
                          |> R.andThen (fn u2 ->
                              _ = C.logWrite log "mkexports: wrote {exports}\n";
                              C.run log [clang, "--target={triple}", "-c", exports, "-o", exportsObj] "")
                          |> R.andThen (fn u2 -> C.each (fn bd ->
                              (base, dest) = bd;
                              C.run log (L.concat [common, ["--defsym=QOS_SLOT_BASE={base}"], program, platform, [exportsObj, "-o", dest]]) "") [("0", image), (movedDelta, moved)])
                          |> R.andThen (fn u2 -> platformRecord overrides added)
                          |> R.andThen (fn tables ->
                              # the archive records what built it, so a build can be repeated
                              fields = L.concat [
                                [("name", C.jsonStr (P.appText "name" p)), ("id", C.jsonStr (P.appText "id" p)),
                                 ("version", C.jsonStr (P.appText "version" p)), ("entry", C.jsonStr "n/a"),
                                 ("loadMode", C.jsonStr "process"), ("abi", C.jsonStr abi), ("architecture", C.jsonStr arch),
                                 ("sdkPlatformSha256", C.jsonStr (C.textOr "" "platformSha256" meta)),
                                 ("sdkCompilerSha256", C.jsonStr (C.textOr "" "compilerSha256" meta)),
                                 ("optimize", C.jsonStr (P.optimize p))],
                                case C.textField "release" meta of O.Some r -> [("sdkRelease", C.jsonStr r)] | O.None -> Nil,
                                if P.memoryMb p > 0 then [("compilerMemoryMb", str (P.memoryMb p))] else Nil];
                              archive sdk work log (strcat (fields |> L.map manifestLine |> S.concat) tables) image moved False)
                          |> R.andThen (fn qa -> publish qa out p))))))))).

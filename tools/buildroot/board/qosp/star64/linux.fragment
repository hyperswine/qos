# Vendor STAR64 kernel supplies DC8200/HDMI and the RTL8852BU USB driver.
# Keep warnings visible without making new compiler warnings fatal in this BSP.
# CONFIG_WERROR is not set
CONFIG_DRM=y
CONFIG_DRM_VERISILICON=y
CONFIG_STARFIVE_INNO_HDMI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_RTL8852BU=m
CONFIG_CFG80211=y
CONFIG_STMMAC_ETH=y
CONFIG_MOTORCOMM_PHY=y
# Also permit emulated Linux/userspace checks, without claiming board proof.
CONFIG_SOC_VIRT=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_EXT4_FS=y

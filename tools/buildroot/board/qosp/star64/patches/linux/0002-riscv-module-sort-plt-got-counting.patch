STAR64 Linux 5.15: filter and sort PLT/GOT relocations when sizing tables

Adapted from upstream be17c0df67959fe4f88dac75dc26ed9252d4b133 by
Samuel Holland. Preserve this vendor kernel's supported relocation types
and per-section sizing totals. Sort only a scratch copy so the original
HI20/LO12 order is intact. Use one allocation per section rather than the
newer kvrealloc API, returning ENOMEM without leaking storage on failure.

Upstream: https://github.com/torvalds/linux/commit/be17c0df67959fe4f88dac75dc26ed9252d4b133

--- a/arch/riscv/kernel/module-sections.c
+++ b/arch/riscv/kernel/module-sections.c
@@ -9,6 +9,8 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/moduleloader.h>
+#include <linux/mm.h>
+#include <linux/sort.h>
 
 unsigned long module_emit_got_entry(struct module *mod, unsigned long val)
 {
@@ -55,36 +57,44 @@
 	return (unsigned long)&plt[i];
 }
 
-static int is_rela_equal(const Elf_Rela *x, const Elf_Rela *y)
+static int cmp_rela(const void *a, const void *b)
 {
-	return x->r_info == y->r_info && x->r_addend == y->r_addend;
+	const Elf_Rela *x = a, *y = b;
+
+	if (x->r_info != y->r_info)
+		return x->r_info < y->r_info ? -1 : 1;
+	return x->r_addend < y->r_addend ? -1 : x->r_addend > y->r_addend;
 }
 
-static bool duplicate_rela(const Elf_Rela *rela, int idx)
+static int count_max_entries(const Elf_Rela *relas, unsigned int num,
+			     unsigned int *plts, unsigned int *gots)
 {
-	int i;
-	for (i = 0; i < idx; i++) {
-		if (is_rela_equal(&rela[i], &rela[idx]))
-			return true;
-	}
-	return false;
-}
+	Elf_Rela *scratch;
+	unsigned int type, i, used = 0;
 
-static void count_max_entries(Elf_Rela *relas, int num,
-			      unsigned int *plts, unsigned int *gots)
-{
-	unsigned int type, i;
+	if (!num)
+		return 0;
+	scratch = kvmalloc_array(num, sizeof(*scratch), GFP_KERNEL);
+	if (!scratch)
+		return -ENOMEM;
 
+	/* Sort a filtered copy: HI20/LO12 lookup needs the original order. */
 	for (i = 0; i < num; i++) {
 		type = ELF_RISCV_R_TYPE(relas[i].r_info);
-		if (type == R_RISCV_CALL_PLT) {
-			if (!duplicate_rela(relas, i))
-				(*plts)++;
-		} else if (type == R_RISCV_GOT_HI20) {
-			if (!duplicate_rela(relas, i))
-				(*gots)++;
-		}
+		if (type == R_RISCV_CALL_PLT || type == R_RISCV_GOT_HI20)
+			scratch[used++] = relas[i];
 	}
+	sort(scratch, used, sizeof(*scratch), cmp_rela, NULL);
+	for (i = 0; i < used; i++) {
+		if (i && !cmp_rela(&scratch[i], &scratch[i - 1]))
+			continue;
+		if (ELF_RISCV_R_TYPE(scratch[i].r_info) == R_RISCV_CALL_PLT)
+			(*plts)++;
+		else
+			(*gots)++;
+	}
+	kvfree(scratch);
+	return 0;
 }
 
 int module_frob_arch_sections(Elf_Ehdr *ehdr, Elf_Shdr *sechdrs,
@@ -92,7 +102,7 @@
 {
 	unsigned int num_plts = 0;
 	unsigned int num_gots = 0;
-	int i;
+	int i, ret;
 
 	/*
 	 * Find the empty .got and .plt sections.
@@ -132,7 +142,9 @@
 		if (!(dst_sec->sh_flags & SHF_EXECINSTR))
 			continue;
 
-		count_max_entries(relas, num_rela, &num_plts, &num_gots);
+		ret = count_max_entries(relas, num_rela, &num_plts, &num_gots);
+		if (ret)
+			return ret;
 	}
 
 	mod->arch.plt.shdr->sh_type = SHT_NOBITS;

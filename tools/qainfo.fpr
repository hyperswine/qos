# qainfo.fpr -- what a .qa says, read by the SAME code the kernel launches with.
#
#   fpr run tools/qainfo.fpr app.qa            the manifest, as interpreted
#   fpr run tools/qainfo.fpr app.qa --caps     the capability blob with every
#                                              permission granted (qosp --yes),
#                                              printed as tests/capsecho.fpr prints it
#
# A Base program for the posix system: mods/manifest.fpr and mods/qar.fpr run
# here unchanged, which is what lets tools/qainfo-parity.sh hold the portable
# host's C parser (qos/portable/qa.c) to them.
unsafe base.

M = use "../programs/mods/manifest".

count xs acc = case xs of Nil -> acc | _ :: r -> count r (acc + 1).
append xs ys = case xs of Nil -> ys | h :: t -> h :: append t ys.

showPerms tag ps = case ps of
    Nil -> Unit
  | p :: r -> case p of (u, m) -> _ = print "{tag} {m} {u}"; showPerms tag r.

report man =
  _ = print "name = {M.name man}";
  _ = print "id = {M.id man}";
  _ = print "loadMode = {M.mode man}";
  _ = print "abi = {M.abi man}";
  _ = print "shell = {M.shell man}";
  _ = print "permissions = {count (M.req man) 0} required, {count (M.opt man) 0} optional";
  _ = showPerms "required" (M.req man);
  showPerms "optional" (M.opt man).

run path wantCaps =
  case M.parseQa (fileRead path) of
    Err e -> _ = Sys.stderr "qainfo: {path}: {e}\n"; Sys.exit 1
  | Ok man -> case wantCaps of
      True -> print (M.capsBlob (M.id man) (append (M.req man) (M.opt man)))
    | False -> report man.

main = case Sys.args Unit of
    path :: Nil -> run path False
  | path :: flag :: Nil -> run path (flag == "--caps")
  | _ -> _ = Sys.stderr "usage: qainfo <app.qa> [--caps]\n"; Sys.exit 2.

E = use "elf-symbols".
Sort = use "sdk/sort".
letter c = or (and (c >= 65) (c <= 90)) (and (c >= 97) (c <= 122)).
digit c = and (c >= 48) (c <= 57).
valid name = case Str.codes name of
    first :: rest -> and (or (letter first) (first == 95))
      (List.all (fn c -> or (letter c) (or (digit c) (List.has c [95,46,36]))) rest)
  | [] -> False.
dataSize name =
  tail = (case List.rev (Str.split 95 name) of word :: _ -> word | [] -> "");
  numbered = and (Str.startsWith "call" tail) (and (Str.len tail > 4) (List.all digit (List.drop 4 (Str.codes tail))));
  if List.has name ["fpr_true","fpr_false","fpr_unit","fpr_g_tlsoff"] then 8
  else if and (Str.startsWith "fpr_g_" name) (not numbered) then 32 else 0.
stub arch slot = case arch of
    "a64" -> ["    adrp x16, {slot}","    ldr x16, [x16, :lo12:{slot}]","    br x16"]
  | "x64" -> ["    jmp *{slot}(%rip)"]
  | "rv64" -> ["    lla t0, {slot}","    ld t0, 0(t0)","    jr t0"]
  | _ -> error "unsupported plugin architecture {arch}".
emit arch name =
  size = dataSize name; dataHeader = ["    .section .data.qosimp,\"aw\",@progbits","    .balign 8"];
  if not (valid name) then error "cannot stub symbol {name}"
  else if not (Str.startsWith "fpr_" name) then error "plugin needs {name}, outside runtime exports"
  else if size != 0 then dataHeader + ["    .globl {name}","    .globl __qosimp_d{size}_{name}","{name}:","__qosimp_d{size}_{name}:","    .zero {size}"]
  else slot = "__qosimp_c_{name}";
    ["    .section .text.qosimp,\"ax\",@progbits","    .balign 4","    .globl {name}","{name}:"] +
      stub arch slot + dataHeader + ["    .globl {slot}","{slot}:","    .quad 0"].
unique : unsafe List String -> List String .
unique xs = case xs of a :: b :: rest -> if a == b then unique (b :: rest) else a :: unique (b :: rest) | tail -> tail.
generate : unsafe String -> String -> String -> Unit .
generate arch elf out =
  rows = E.symbols (E.readFile elf) (fn bind section -> and (section == 0) (bind != 2));
  names = List.filter (fn name -> name != "") (List.map (fn row -> (name,value,size) = row; name) rows);
  imports = unique (Sort.sortText names);
  header = ["# generated by tools/mkimports.sol: the plugin's imports, completed by","# the loader from the app's export table (docs/2026-10-01-IMPORT-TABLE.md)"];
  writePath out (Str.join "\n" (header + List.concat (List.map (emit arch) imports)) + "\n").
main : unsafe Unit -> Unit .
> case args Unit of [arch,elf,out] -> generate arch elf out | _ -> error "usage: mkimports.sol ARCH ELF OUTPUT".

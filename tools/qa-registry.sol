# Emit the native kernel's fallback registry, in QAPPS order.
readArchive path =
  reader = unwrap (Stream.openRead path 65536);
  (result,next) = Stream.foldChunks (fn chunks bytes -> bytes :: chunks) [] reader;
  _ = unwrap (Stream.closeRead next);
  Bytes.concat (List.rev (unwrap result)).
headerEnd : unsafe Bytes -> Int -> Int .
headerEnd archive index =
  if index + 1 >= Bytes.len archive then error "unterminated QAR2 header"
  else if and (unwrap (Bytes.at index archive) == 10) (unwrap (Bytes.at (index + 1) archive) == 10)
       then index else headerEnd archive (index + 1).
manifestText : unsafe Bytes -> String .
manifestText archive =
  end = headerEnd archive 0;
  header = unwrap (Utf8.decode (unwrap (Bytes.slice 0 end archive)));
  case Str.lines header of
    magic :: rows -> if magic != "QAR2" then error "expected QAR2 archive" else
      (case List.filter (fn words -> case words of "MANIFEST" :: _ -> True | _ -> False) (List.map Str.words rows) of
        [["MANIFEST",offset,size]] ->
          start = parseInt offset; count = parseInt size;
          if or (start < 0) (count < 0) then error "negative manifest extent"
          else unwrap (Utf8.decode (unwrap (Bytes.slice (end + 2 + start) count archive)))
      | _ -> error "expected one QAR2 MANIFEST")
  | [] -> error "expected QAR2 archive".
appId manifest =
  fields = List.map (Str.split 61) (Str.lines manifest);
  case List.filter (fn field -> case field of key :: _ -> Str.trim key == "id" | _ -> False) fields of
    field :: _ -> (case Str.split 34 (Str.join "=" (List.drop 1 field)) of
        prefix :: id :: _ -> if and (Str.trim prefix == "") (id != "") then id else error "invalid manifest id"
      | _ -> error "expected quoted manifest id")
  | [] -> error "missing manifest id".
openBrace = unwrap (Utf8.decode (unwrap (Bytes.fromList [123]))).
stringObject name bytes =
  size = Bytes.len bytes;
  values = Str.join "," (List.map (fn byte -> "{byte}") (Bytes.toList bytes));
  "static const struct {openBrace} uint32_t tid, var; uw len; uint8_t bytes[{size}]; } __attribute__((aligned(8))) {name} = {openBrace} T_STR, 0, {size}, " + openBrace + values + "} };".
rows : unsafe List String -> Int -> (List String,List String,List String) .
rows paths index = case paths of
    [] -> ([],[],[])
  | path :: rest ->
      archive = readArchive path; id = appId (manifestText archive);
      (arrays,entries,ids) = rows rest (index + 1);
      array = stringObject "qa_{index}" archive;
      row = "  {openBrace}" + " \"{id}\", (const str_t *)&qa_{index} " + "},";
      (array :: arrays,row :: entries,id :: ids).
# Match the compiler's ASCII symbol encoding, including Unicode code points.
hexDigit n = substr "0123456789abcdef" n 1.
hexDigits : unsafe Int -> String .
hexDigits n = if n < 16 then hexDigit n else hexDigits (n / 16) + hexDigit (n % 16).
encoded : unsafe Int -> String .
encoded c =
  if or (and (c >= 48) (c <= 57)) (or (and (c >= 65) (c <= 90)) (and (c >= 97) (c <= 122)))
  then unwrap (Utf8.decode (unwrap (Bytes.fromList [c])))
  else "_x" + (if c < 16 then "0" else "") + hexDigits c.
symbol : unsafe String -> String .
symbol name = "fpr_obj_" + Str.join "" (List.map encoded (Str.codes name)).
generate : unsafe String -> List String -> List String -> Unit .
generate out names paths =
  (arrays,entries,ids) = rows paths 0;
  listing = stringObject "qa_listing" (unwrap (Utf8.encode (Str.join "\n" ids + "\n")));
  symbols = List.map (fn name -> (name,symbol name)) names;
  lines = List.concat [
    ["/* GENERATED by tools/qa-registry.sol -- do not edit */","#include \"fpr.h\"",
     "typedef struct {openBrace} const char *id; const str_t *archive; } qa_blob_t;",
     "typedef struct {openBrace} const char *symbol; const pap0_t *pap; } app_entry_t;",""],
    arrays,[listing,"const str_t *const fpr_qa_listing = (const str_t *)&qa_listing;","","const qa_blob_t fpr_qa_blobs[] = {openBrace}"],entries,
    ["  {openBrace} 0, 0 }","};",""],
    List.map (fn pair -> (name,sym) = pair; "extern const pap0_t {sym};") symbols,
    ["const app_entry_t fpr_app_entries[] = {openBrace}"],
    List.map (fn pair -> (name,sym) = pair; "  {openBrace} \"{name}\", &{sym} },") symbols,
    ["  {openBrace} 0, 0 }","};"]];
  writePath out (Str.join "\n" lines + "\n").
entryCount : unsafe List String -> Int .
entryCount words = case words of "--" :: _ -> 0 | word :: rest -> 1 + entryCount rest | [] -> error "expected -- before archives".
registry : unsafe String -> List String -> Unit .
registry out argv = case argv of
    "--entries" :: rest ->
      count = entryCount rest;
      paths = List.drop (count + 1) rest;
      if paths == [] then error "expected -- ARCHIVE..." else generate out (List.take count rest) paths
  | "--" :: paths -> registry out paths
  | [] -> error "expected at least one archive"
  | paths -> generate out [] paths.
main : unsafe Unit -> Unit .
> case args Unit of
    "--out" :: out :: rest -> registry out rest
  | "--entries" :: rest -> registry "runtime/core/apps_data.c" ("--entries" :: rest)
  | out :: rest -> registry out rest
  | _ -> error "usage: qa-registry.sol OUTPUT [--entries NAME... --] ARCHIVE...".

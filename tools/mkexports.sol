E = use "elf-symbols".
Sort = use "sdk/sort".
runtime row = (name,value,size) = row;
  and (Str.startsWith "fpr_" name) (not (or (Str.startsWith "fpr_fn_" name)
    (or (Str.startsWith "fpr_obj_" name) (List.has name ["fpr_modtab","fpr_contab"])))).
key row = (name,value,size) = row; name.
# Last definition wins, as in the original symbol map. sortBy is stable.
unique : unsafe List (String,Int,Int) -> List (String,Int,Int) .
unique rows = case rows of
    a :: b :: rest -> if key a == key b then unique (b :: rest) else a :: unique (b :: rest)
  | xs -> xs.
generate : unsafe String -> String -> Unit .
generate elf out =
  symbols = E.symbols (E.readFile elf) (fn bind section -> and (bind == 1) (and (section != 0) (section != 65521)));
  rows = unique (Sort.sortBy key (List.filter runtime symbols));
  items = List.zip (E.indices (List.len rows)) rows;
  table = List.map (fn item -> (index,row) = item; (name,value,size) = row;
    "    .quad .Lqx{index}\n    .quad {name}\n    .quad {size}") items;
  names = List.map (fn item -> (index,row) = item; name = key row; ".Lqx{index}:\n    .asciz \"{name}\"") items;
  prefix = ["# generated by tools/mkexports.sol: the runtime this app exports to plugins",
    "    .section .rodata.qos_exports,\"a\",@progbits","    .balign 8","    .globl qos_exports","qos_exports:","    .quad {List.len rows}"];
  writePath out (Str.join "\n" (prefix + table + names) + "\n").
main : unsafe Unit -> Unit .
> case args Unit of [elf,out] -> generate elf out | _ -> error "usage: mkexports.sol ELF OUTPUT".

# ============================================================================
# std/loader.fpr -- std.loader: code as DATA, interpreted by a service.
#
# The loader actor is the only thing that turns disk records into live
# code, and it RECORDS what it did -- so the running module set is a
# pure function of the log:
#
#   LLoad id     read apps/<id>.qa from the Files service, refuse it
#                unless it passes EVERY gate (the abi stamp, every import
#                found in this app's exports by name, then the arity
#                compat chain against the previously newest table),
#                attach it, and append the
#                new attach chain as the sys/live record
#   LReplay u    read sys/live and re-attach the whole chain in order --
#                the boot step: kill the machine, boot the same disk,
#                and the same live set reassembles, hot-swaps included,
#                with no compiler and no operator anywhere
#   LList u      the live chain, newest last ("a b c")
#   LLaunch id   read apps/<id>.qa, attach it through the same host
#                gate, and RUN it: its `app me` export is spawned under
#                a fresh pid (Sys.spawnApp), handed the launcher's
#                handle as its first message, and its table is popped
#                straight back out of the registry -- the registry is
#                the module chain; an app is a process, not a binding.
#                Answers Ok <actor>.  Apps are runtime state: nothing
#                is recorded, so a reboot starts none of them.
#
# The gates make refusal the loader's ONLY failure mode: a version that
# was built for another ABI, needs a name this app does not export, or
# drifts an export's arity is REFUSED and
# detached, the previous binding stands, and sys/live is NOT written --
# the log never records a set that was not actually live.
#
# Resolution stays Mod.find's newest-attachment-wins (`bind`), exactly
# std.livereload's contract; what this module adds is that the registry
# being resolved against is itself REBUILT FROM THE DISK on boot.
#
#   me = myself 0;
#   fs = FS.serve (device "blk");
#   ld = serve fs;
#   n  = expectOk (replay me ld);      # boot: the disk decides what's live
#   _  = expectOk (load me ld "edit2");# a swap: one message, one record
#   f  = bind "editLine";
# ============================================================================

FS = use "fs".
AC = use "std/actor".
Plug = use "../programs/mods/plug".
Manifest = use "../programs/mods/manifest".
EP = use "../programs/mods/ep#f5a7c81840106100".

Sys.pidOf : Int -> Int .

LMsg = Type (LLoad id | LList u | LReplay u | LLaunch id).

# the loader; with the namespace, a launched app's manifest grants are
# recorded under its pid before it is told who launched it (its first
# message, which an app waits for before anything else)
serve fs = serveWith fs 0.
serveWith fs ns = AC.spawnWith (AC.Dynamic 64) (loaderNs fs ns).

# ---- the client side --------------------------------------------------------

# std/actor's correlated request/reply: a loader that refused the request
# or has ended is an Err, like any refusal of the loader's own
load : unsafe Int -> Int -> String -> Result Int String .
load me ld id = flat (AC.call me ld (LLoad id)).

replay : unsafe Int -> Int -> Result Int String .
replay me ld = flat (AC.call me ld (LReplay 0)).

list : unsafe Int -> Int -> String .
list me ld = case AC.call me ld (LList 0) of
    Ok s -> s
  | Err e -> "(loader unavailable: {e})".

# run an app image from the disk under its own pid: Ok <its root actor>
launch : unsafe Int -> Int -> String -> Result Int String .
launch me ld id = flat (AC.call me ld (LLaunch id)).

flat r = case r of
    Ok inner -> inner
  | Err e -> Err "loader unavailable: {e}".

# newest attached export wins; a miss is loud (the loader gated every load)
bind : String -> _ .
bind name =
  (ok, f) = Mod.find name;
  case ok == 1 of
    True -> f
  | False -> error "loader: no attached module exports {name}".

# ---- the loader actor -------------------------------------------------------
# Loop state: the attach CHAIN, newest first (ids only; table indices
# are attach order, which replay reproduces exactly).

loaderNs : unsafe Int -> Int -> Int -> a .
loaderNs fs ns me = lLoop fs ns me Nil.
lLoop : unsafe Int -> Int -> Int -> List String -> a .
lLoop fs ns me chain =
  m = receive me;
  (from, rid, q) = m;
  lServe fs ns me chain (from, rid) q.

lServe : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> LMsg -> a .
lServe fs ns me chain from q = case q of
    LLoad id -> lLoad fs ns me chain from id 1
  | LList u -> AC.reply from (lRender chain "") >> lLoop fs ns me chain
  | LReplay u -> lReplay fs ns me chain from
  | LLaunch id -> lLaunch fs ns me chain from id.

# one launch: record -> the host gate -> its `app` export -> a fresh pid
lLaunch : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> a .
lLaunch fs ns me chain from id =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> AC.reply from (Err "launch {id}: {e}") >> lLoop fs ns me chain
  | Ok qa -> lLaunch2 fs ns me chain from id r qa.
lLaunch2 : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> _ -> String -> a .
lLaunch2 fs ns me chain from id r qa =
  ar = Plug.attach qa;
  _ = drop r;                        # the image is in its window now
  case ar of
    Err e -> AC.reply from (Err "launch {id}: {e}") >> lLoop fs ns me chain
  | Ok n -> lStart fs ns me chain from id (lGrants qa).
lStart : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> List (String, String) -> a .
lStart fs ns me chain from id gs =
  (ok, f) = Mod.findAt (Mod.plugs 0 - 1) "app";
  _ = Mod.detachLast Unit;           # the registry is the module chain; the
                                     # app's code stays in its window
  case ok == 1 of
    True -> lRun fs ns me chain from id gs f
  | False -> AC.reply from (Err "launch {id}: no `app` export") >> lLoop fs ns me chain.
lRun : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> List (String, String) -> _ -> a .
lRun fs ns me chain from id gs f =
  h = Sys.spawnApp f;
  _ = case ns == 0 of
      True -> Ok 0
    | False -> EP.grant me ns (Sys.pidOf h) gs; # under its pid, before it is told anything
  _ = AC.sendOrDie h (retActor from); # its first message: who launched it
  _ = AC.reply from (Ok h);
  lLoop fs ns me chain.

# one load: record -> gates -> attach -> the new chain -> sys/live
lLoad : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> Int -> a .
lLoad fs ns me chain from id wm =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> AC.reply from (Err "loader {id}: {e}") >> lLoop fs ns me chain
  | Ok qa -> lAttach fs ns me chain from id 1 r qa wm.
lAttach : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> Int -> _ -> String -> Int -> a .
lAttach fs ns me chain from id u r qa wm =
  before = Mod.plugs 0;
  ar = Plug.attach qa;
  _ = drop r;                        # the record's bytes are in the window now
  case ar of
    Err e -> AC.reply from (Err "loader {id}: {e}") >> lLoop fs ns me chain
  | Ok n -> lGate fs ns me chain from id before wm.
lGate : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> Int -> Int -> a .
lGate fs ns me chain from id before wm =
  case before == 0 of
    True -> lLive fs ns me chain from id wm      # first attachment: nothing to gate
  | False -> lGate2 fs ns me chain from id before wm.
lGate2 : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> Int -> Int -> a .
lGate2 fs ns me chain from id before wm =
  (ok, why) = Mod.compatAt (before - 1) before;
  case ok == 1 of
    True -> lLive fs ns me chain from id wm
  | False -> lRefuse fs ns me chain from id why.
lRefuse : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> String -> a .
lRefuse fs ns me chain from id why =
  # a refused version must leave every binding as it was: detach the
  # just-attached table, do NOT touch sys/live
  _ = Mod.detachLast Unit;
  _ = AC.reply from (Err "loader {id}: incompatible, refused: {why}");
  lLoop fs ns me chain.
# The load is live only once sys/live says so: the reply and the new chain
# follow the record.  An append that fails is a failed load -- the table is
# detached, the chain stays as it was, and the caller hears why -- so the
# log and the running set never disagree (a reboot replays exactly this).
lLive : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> Int -> a .
lLive fs ns me chain from id wm =
  chain2 = id :: chain;
  case wm of
    1 -> lRecorded fs ns me chain from id chain2 (lManifest me fs chain2)
  | w -> lAdopt fs ns me from chain2.
lRecorded : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> List String -> Result String String -> a .
lRecorded fs ns me chain from id chain2 h = case h of
    Ok u -> lAdopt fs ns me from chain2
  | Err e -> lUnrecorded fs ns me chain from id e.
lAdopt : unsafe Int -> Int -> Int -> (Int, Int) -> List String -> a .
lAdopt fs ns me from chain2 =
  _ = AC.reply from (Ok (Mod.plugs 0 - 1));
  lLoop fs ns me chain2.
lUnrecorded : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> String -> a .
lUnrecorded fs ns me chain from id e =
  _ = Mod.detachLast Unit;
  _ = AC.reply from (Err "loader {id}: sys/live not recorded ({e}); the load was rolled back");
  lLoop fs ns me chain.
lManifest : unsafe Int -> Int -> List String -> Result String String .
lManifest me fs chain2 = FS.append me fs "sys/live" (lRenderNl (lRev chain2 Nil) "").

# boot: read sys/live, re-attach the chain in order (each load passes
# the same gates again -- replay is not a bypass)
lReplay : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> a .
lReplay fs ns me chain from =
  r = FS.readLatest me fs "sys/live";
  case r of
    Err e -> AC.reply from (Ok 0) >> lLoop fs ns me chain    # empty disk: nothing live
  | Ok mf -> lRep fs ns me chain from (splitNl mf 0 0 Nil) 0.
lRep : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> List String -> Int -> a .
lRep fs ns me chain from ids n = case ids of
    Nil -> AC.reply from (Ok n) >> lLoop fs ns me chain
  | id :: rest -> lRep1 fs ns me chain from rest n id.
lRep1 : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> List String -> Int -> String -> a .
lRep1 fs ns me chain from rest n id =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> AC.reply from (Err "replay {id}: {e}") >> lLoop fs ns me chain
  | Ok qa -> lRepAtt fs ns me chain from rest n id r qa.
lRepAtt : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> List String -> Int -> String -> _ -> String -> a .
lRepAtt fs ns me chain from rest n id r qa =
  before = Mod.plugs 0;
  ar = Plug.attach qa;
  _ = drop r;
  case ar of
    Err e -> AC.reply from (Err "replay {id}: {e}") >> lLoop fs ns me chain
  | Ok u -> lRepGate fs ns me chain from rest n id before.
lRepGate : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> List String -> Int -> String -> Int -> a .
lRepGate fs ns me chain from rest n id before =
  case before == 0 of
    True -> lRep fs ns me (id :: chain) from rest (n + 1)
  | False -> lRepGate2 fs ns me chain from rest n id before.
lRepGate2 : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> List String -> Int -> String -> Int -> a .
lRepGate2 fs ns me chain from rest n id before =
  (ok, why) = Mod.compatAt (before - 1) before;
  case ok == 1 of
    True -> lRep fs ns me (id :: chain) from rest (n + 1)
  | False -> lRepBad fs ns me chain from id why.
lRepBad : unsafe Int -> Int -> Int -> List String -> (Int, Int) -> String -> String -> a .
lRepBad fs ns me chain from id why =
  _ = Mod.detachLast Unit;
  _ = AC.reply from (Err "replay {id}: incompatible, refused: {why}");
  lLoop fs ns me chain.

# the caller in a request's return address (from, id)
retActor from = case from of (a, i) -> a.

# an app's grants: its manifest's required and optional permissions (no
# prompt on this tier: installing the archive is the consent)
lGrants : unsafe String -> List (String, String) .
lGrants qa = case Manifest.parseQa qa of
    Ok m -> lCat (Manifest.req m) (Manifest.opt m)
  | Err e -> Nil.
lCat : unsafe List a -> List a -> List a .
lCat l b = case l of Nil -> b | x :: r -> x :: lCat r b.

# ---- small string helpers ---------------------------------------------------

lRev : unsafe List a -> List a -> List a .
lRev l acc = case l of Nil -> acc | x :: r -> lRev r (x :: acc).
lRender : unsafe List String -> String -> String .
lRender l acc = case l of
    Nil -> acc
  | s :: r -> lRender r (lJoin acc s).
lJoin acc s = case strlen acc == 0 of True -> s | False -> "{acc} {s}".
lRenderNl : unsafe List String -> String -> String .
lRenderNl l acc = case l of Nil -> acc | s :: r -> lRenderNl r "{acc}{s}\n".
splitNl : unsafe String -> Int -> Int -> List String -> List String .
splitNl s i st acc = case i >= strlen s of
    True -> lRev acc Nil
  | False -> splitNl2 s i st acc.
splitNl2 : unsafe String -> Int -> Int -> List String -> List String .
splitNl2 s i st acc = case charAt s i == 10 of
    True -> splitNl s (i + 1) (i + 1) (splitPush s st i acc)
  | False -> splitNl s (i + 1) st acc.
splitPush s st i acc = case i > st of
    True -> substr s st (i - st) :: acc
  | False -> acc.

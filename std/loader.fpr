# ============================================================================
# std/loader.fpr -- std.loader: code as DATA, interpreted by a service.
#
# The loader actor is the only thing that turns disk records into live
# code, and it RECORDS what it did -- so the running module set is a
# pure function of the log:
#
#   LLoad id     read apps/<id>.qa from the Files service, refuse it
#                unless it passes EVERY gate (the host's abi + shell
#                matched-set stamps, then the arity compat chain against
#                the previously newest table), attach it, and append the
#                new attach chain as the sys/live record
#   LReplay u    read sys/live and re-attach the whole chain in order --
#                the boot step: kill the machine, boot the same disk,
#                and the same live set reassembles, hot-swaps included,
#                with no compiler and no operator anywhere
#   LList u      the live chain, newest last ("a b c")
#   LLaunch id   read apps/<id>.qa, attach it through the same host
#                gate, and RUN it: its `app me` export is spawned under
#                a fresh pid (Sys.spawnApp), handed the launcher's
#                handle as its first message, and its table is popped
#                straight back out of the registry -- the registry is
#                the module chain; an app is a process, not a binding.
#                Answers Ok <actor>.  Apps are runtime state: nothing
#                is recorded, so a reboot starts none of them.
#
# The gates make refusal the loader's ONLY failure mode: a version that
# does not match this shell image (plugsyms bakes absolute addresses --
# the host compares stamps) or drifts an export's arity is REFUSED and
# detached, the previous binding stands, and sys/live is NOT written --
# the log never records a set that was not actually live.
#
# Resolution stays Mod.find's newest-attachment-wins (`bind`), exactly
# std.livereload's contract; what this module adds is that the registry
# being resolved against is itself REBUILT FROM THE DISK on boot.
#
#   me = myself 0;
#   fs = FS.serve (device "blk");
#   ld = serve fs;
#   n  = expectOk (replay me ld);      # boot: the disk decides what's live
#   _  = expectOk (load me ld "edit2");# a swap: one message, one record
#   f  = bind "editLine";
# ============================================================================

FS = use "fs".
AC = use "std/actor".

LMsg = Type (LLoad id | LList u | LReplay u | LLaunch id).

serve fs = AC.spawnWith (AC.Dynamic 64) (loader fs).

# ---- the client side --------------------------------------------------------

load : unsafe Int -> Int -> String -> Result Int String .
load me ld id = _ = send ld (me, LLoad id); receiveFrom me ld.

replay : unsafe Int -> Int -> Result Int String .
replay me ld = _ = send ld (me, LReplay 0); receiveFrom me ld.

list : unsafe Int -> Int -> String .
list me ld = _ = send ld (me, LList 0); receiveFrom me ld.

# run an app image from the disk under its own pid: Ok <its root actor>
launch : unsafe Int -> Int -> String -> Result Int String .
launch me ld id = _ = send ld (me, LLaunch id); receiveFrom me ld.

# newest attached export wins; a miss is loud (the loader gated every load)
bind : String -> _ .
bind name =
  (ok, f) = Mod.find name;
  case ok == 1 of
    True -> f
  | False -> error "loader: no attached module exports {name}".

# ---- the loader actor -------------------------------------------------------
# Loop state: the attach CHAIN, newest first (ids only; table indices
# are attach order, which replay reproduces exactly).

loader : unsafe Int -> Int -> a .
loader fs me = lLoop fs me Nil.
lLoop : unsafe Int -> Int -> List String -> a .
lLoop fs me chain =
  m = receive me;
  case m of
    (from, q) -> lServe fs me chain from q
  | u -> lLoop fs me chain.

lServe : unsafe Int -> Int -> List String -> Int -> LMsg -> a .
lServe fs me chain from q = case q of
    LLoad id -> lLoad fs me chain from id 1
  | LList u -> send from (lRender chain "") >> lLoop fs me chain
  | LReplay u -> lReplay fs me chain from
  | LLaunch id -> lLaunch fs me chain from id.

# one launch: record -> the host gate -> its `app` export -> a fresh pid
lLaunch : unsafe Int -> Int -> List String -> Int -> String -> a .
lLaunch fs me chain from id =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> send from (Err "launch {id}: {e}") >> lLoop fs me chain
  | Ok qa -> lLaunch2 fs me chain from id r qa.
lLaunch2 : unsafe Int -> Int -> List String -> Int -> String -> _ -> String -> a .
lLaunch2 fs me chain from id r qa =
  ar = Sys.attachQa qa;
  _ = drop r;                        # the image is in its window now
  case ar of
    Err e -> send from (Err "launch {id}: {e}") >> lLoop fs me chain
  | Ok n -> lStart fs me chain from id.
lStart : unsafe Int -> Int -> List String -> Int -> String -> a .
lStart fs me chain from id =
  (ok, f) = Mod.findAt (Mod.plugs 0 - 1) "app";
  _ = Mod.detachLast Unit;           # the registry is the module chain; the
                                     # app's code stays in its window
  case ok == 1 of
    True -> lRun fs me chain from id f
  | False -> send from (Err "launch {id}: no `app` export") >> lLoop fs me chain.
lRun : unsafe Int -> Int -> List String -> Int -> String -> _ -> a .
lRun fs me chain from id f =
  h = Sys.spawnApp f;
  _ = AC.sendOrDie h from;           # its first message: who launched it
  _ = send from (Ok h);
  lLoop fs me chain.

# one load: record -> gates -> attach -> the new chain -> sys/live
lLoad : unsafe Int -> Int -> List String -> Int -> String -> Int -> a .
lLoad fs me chain from id wm =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> send from (Err "loader {id}: {e}") >> lLoop fs me chain
  | Ok qa -> lAttach fs me chain from id 1 r qa wm.
lAttach : unsafe Int -> Int -> List String -> Int -> String -> Int -> _ -> String -> Int -> a .
lAttach fs me chain from id u r qa wm =
  before = Mod.plugs 0;
  ar = Sys.attachQa qa;
  _ = drop r;                        # the record's bytes are in the window now
  case ar of
    Err e -> send from (Err "loader {id}: {e}") >> lLoop fs me chain
  | Ok n -> lGate fs me chain from id before wm.
lGate : unsafe Int -> Int -> List String -> Int -> String -> Int -> Int -> a .
lGate fs me chain from id before wm =
  case before == 0 of
    True -> lLive fs me chain from id wm      # first attachment: nothing to gate
  | False -> lGate2 fs me chain from id before wm.
lGate2 : unsafe Int -> Int -> List String -> Int -> String -> Int -> Int -> a .
lGate2 fs me chain from id before wm =
  (ok, why) = Mod.compatAt (before - 1) before;
  case ok == 1 of
    True -> lLive fs me chain from id wm
  | False -> lRefuse fs me chain from id why.
lRefuse : unsafe Int -> Int -> List String -> Int -> String -> String -> a .
lRefuse fs me chain from id why =
  # a refused version must leave every binding as it was: detach the
  # just-attached table, do NOT touch sys/live
  _ = Mod.detachLast Unit;
  _ = send from (Err "loader {id}: incompatible, refused: {why}");
  lLoop fs me chain.
lLive : unsafe Int -> Int -> List String -> Int -> String -> Int -> a .
lLive fs me chain from id wm =
  chain2 = id :: chain;
  _ = case wm of
    1 -> lManifest me fs chain2
  | w -> 0;
  _ = send from (Ok (Mod.plugs 0 - 1));
  lLoop fs me chain2.
lManifest : unsafe Int -> Int -> List String -> Int .
lManifest me fs chain2 =
  h = FS.append me fs "sys/live" (lRenderNl (lRev chain2 Nil) "");
  _ = drop h;
  0.

# boot: read sys/live, re-attach the chain in order (each load passes
# the same gates again -- replay is not a bypass)
lReplay : unsafe Int -> Int -> List String -> Int -> a .
lReplay fs me chain from =
  r = FS.readLatest me fs "sys/live";
  case r of
    Err e -> send from (Ok 0) >> lLoop fs me chain    # empty disk: nothing live
  | Ok mf -> lRep fs me chain from (splitNl mf 1 1 Nil) 0.
lRep : unsafe Int -> Int -> List String -> Int -> List String -> Int -> a .
lRep fs me chain from ids n = case ids of
    Nil -> send from (Ok n) >> lLoop fs me chain
  | id :: rest -> lRep1 fs me chain from rest n id.
lRep1 : unsafe Int -> Int -> List String -> Int -> List String -> Int -> String -> a .
lRep1 fs me chain from rest n id =
  r = FS.readLatest me fs "apps/{id}.qa";
  case r of
    Err e -> send from (Err "replay {id}: {e}") >> lLoop fs me chain
  | Ok qa -> lRepAtt fs me chain from rest n id r qa.
lRepAtt : unsafe Int -> Int -> List String -> Int -> List String -> Int -> String -> _ -> String -> a .
lRepAtt fs me chain from rest n id r qa =
  before = Mod.plugs 0;
  ar = Sys.attachQa qa;
  _ = drop r;
  case ar of
    Err e -> send from (Err "replay {id}: {e}") >> lLoop fs me chain
  | Ok u -> lRepGate fs me chain from rest n id before.
lRepGate : unsafe Int -> Int -> List String -> Int -> List String -> Int -> String -> Int -> a .
lRepGate fs me chain from rest n id before =
  case before == 0 of
    True -> lRep fs me (id :: chain) from rest (n + 1)
  | False -> lRepGate2 fs me chain from rest n id before.
lRepGate2 : unsafe Int -> Int -> List String -> Int -> List String -> Int -> String -> Int -> a .
lRepGate2 fs me chain from rest n id before =
  (ok, why) = Mod.compatAt (before - 1) before;
  case ok == 1 of
    True -> lRep fs me (id :: chain) from rest (n + 1)
  | False -> lRepBad fs me chain from id why.
lRepBad : unsafe Int -> Int -> List String -> Int -> String -> String -> a .
lRepBad fs me chain from id why =
  _ = Mod.detachLast Unit;
  _ = send from (Err "replay {id}: incompatible, refused: {why}");
  lLoop fs me chain.

# ---- small string helpers ---------------------------------------------------

lRev : unsafe List a -> List a -> List a .
lRev l acc = case l of Nil -> acc | x :: r -> lRev r (x :: acc).
lRender : unsafe List String -> String -> String .
lRender l acc = case l of
    Nil -> acc
  | s :: r -> lRender r (lJoin acc s).
lJoin acc s = case strlen acc == 0 of True -> s | False -> "{acc} {s}".
lRenderNl : unsafe List String -> String -> String .
lRenderNl l acc = case l of Nil -> acc | s :: r -> lRenderNl r "{acc}{s}\n".
splitNl : unsafe String -> Int -> Int -> List String -> List String .
splitNl s i st acc = case i > strlen s of
    True -> lRev acc Nil
  | False -> splitNl2 s i st acc.
splitNl2 : unsafe String -> Int -> Int -> List String -> List String .
splitNl2 s i st acc = case charAt s i == 10 of
    True -> splitNl s (i + 1) (i + 1) (splitPush s st i acc)
  | False -> splitNl s (i + 1) st acc.
splitPush s st i acc = case i > st of
    True -> substr s st (i - st) :: acc
  | False -> acc.

# ============================================================================
# std/hosted.fpr -- Hosted: an app its host runs (the Editor's Run), in the
# shape of std/term's (docs/2026-10-17-PROGRAMS.md).  Not fprisc's
# std/program, a process's arguments, environment and streams.
#
#   H = use "std/hosted".
#   app = { init = ..., update = ..., view = ..., subs = ... }.
#
#     init    : model
#     update  : H.Ev msg -> model -> (model, List (H.Cmd msg))
#     view    : (Int, Int) -> model -> List String      a line each, for a
#                                                       panel that size
#     subs    : model -> List (H.Sub msg)
#
# `update` is a function of events; effects are DATA and their results come
# back as messages, so nothing a program asks for can fail it -- a refusal is
# an `Err` in its own message:
#
#   H.Key k              a key (H.Char "a", H.Enter, H.Up, (H.Ctrl "s"), ...)
#   H.Resized cols rows  at the start, and when the panel changes
#   H.Msg msg            what a command or a subscription produced
#
#   H.readFile path toMsg          toMsg : Result String String -> msg
#   H.writeFile path text toMsg    toMsg : Result Unit String -> msg (replaces)
#   H.appendFile path text toMsg   the same, adding to it
#   H.removeFile path toMsg        the same, for a delete
#   H.listFiles prefix toMsg       toMsg : Result (List String) String -> msg
#   H.after ms msg                 msg once, ms milliseconds on
#   H.quit                         the program ends
#   H.every ms msg                 (a subscription) msg every ms milliseconds
#   H.tryAfter / H.tryEvery        Result for user-entered durations
#
# Removed subscriptions are cancelled; the same (period, message) retains
# one worker. Periods coalesce while an app is
# busy. After/Every share defaults.maxTimers (32); hostWith accepts an explicit
# configuration and returns Result after closing the linear timer pool.
#
# Files: a program may read and write under /home and nothing else.  It holds
# no capability to do so: it ASKS its host (the Editor), which checks the
# path, does the work and answers -- so there is nothing it could misuse, and
# an answer is the only way a file reaches it.
#
# The program runs as a confined process of its own (programs/mods/runprog.fpr,
# fprisc docs/2026-10-17-CONFINED-PROCESSES.md): a memory budget, no devices,
# its actors ended with it.  This module is the loop inside it, between the
# host's messages and the four functions.
# ============================================================================
AK = use "../programs/mods/appkit".
Timers = use "hostedtimers".
Time = use "hostedtime".

Key = Type (Char String | Enter | Escape | Backspace | Tab | Up | Down | Left | Right
          | Home | End | PageUp | PageDown | Insert | Delete | F Int | Ctrl String | Alt String).
Ev msg = Type (Key Key | Resized Int Int | Msg msg).
Cmd msg = Type (After Int msg | Quit
              | ReadFile String (Result String String -> msg)
              | WriteFile String String (Result Unit String -> msg)
              | AppendFile String String (Result Unit String -> msg)
              | RemoveFile String (Result Unit String -> msg)
              | ListFiles String (Result (List String) String -> msg)).
Sub msg = Type (Every Int msg).

# ---- what a program writes -----------------------------------------------------------
# A bad internal duration is named contract blame. User-entered durations
# instead use tryAfter/tryEvery and get an ordinary Result. Direct constructor
# use is checked again by the host before acquiring any timer resource.
after : (ms : Int | ms >= 0) -> msg -> Cmd msg .
after ms msg = After ms msg.
every : (ms : Int | ms >= 1) -> msg -> Sub msg .
every ms msg = Every ms msg.
tryAfter ms msg = if Time.validDelay ms then Ok (After ms msg) else Err "delay must be nonnegative".
tryEvery ms msg = if Time.validPeriod ms then Ok (Every ms msg) else Err "period must be positive".
defaults = Timers.defaults.
quit : Cmd msg .
quit = Quit.
readFile : String -> (Result String String -> msg) -> Cmd msg .
readFile path toMsg = ReadFile path toMsg.
writeFile : String -> String -> (Result Unit String -> msg) -> Cmd msg .
writeFile path text toMsg = WriteFile path text toMsg.
appendFile : String -> String -> (Result Unit String -> msg) -> Cmd msg .
appendFile path text toMsg = AppendFile path text toMsg.
removeFile : String -> (Result Unit String -> msg) -> Cmd msg .
removeFile path toMsg = RemoveFile path toMsg.
listFiles : String -> (Result (List String) String -> msg) -> Cmd msg .
listFiles prefix toMsg = ListFiles prefix toMsg.

# ---- the conversation with the host ---------------------------------------------------
# The host (the Editor) sends a program ToProgram values; the program sends
# its host ToHost values.  The host reads ONLY the program's root actor (the
# runtime's selective receive: no other actor can speak for it) and checks
# every Ask before it does anything.
Req = Type (ReadReq String | WriteReq String String | AppendReq String String | RemoveReq String | ListReq String).
Reply = Type (Text String | Done | Names (List String) | Failed String).
ToHost = Type (Frame (List String) | Ask Int Req).
ToProgram msg = Type (Start Int Int Int | KeyIn Int | Resize Int Int | Answer Int Reply | Fire msg | TimerFired Int).

# a QOS key code (the input tier's: shift +1000, ctrl +4000, alt +8000) as
# the keys a program sees; a code that is no key to it is none
keyOf : Int -> List Key .
keyOf 28 = Enter :: Nil.
keyOf 1 = Escape :: Nil.
keyOf 14 = Backspace :: Nil.
keyOf 15 = Tab :: Nil.
keyOf 103 = Up :: Nil.
keyOf 108 = Down :: Nil.
keyOf 105 = Left :: Nil.
keyOf 106 = Right :: Nil.
keyOf 102 = Home :: Nil.
keyOf 107 = End :: Nil.
keyOf 104 = PageUp :: Nil.
keyOf 109 = PageDown :: Nil.
keyOf 110 = Insert :: Nil.
keyOf 111 = Delete :: Nil.
keyOf c = if c >= 59 and c <= 68 then F (c - 58) :: Nil
  else if c >= 8000 then named 2 (AK.keyChar (c - 8000))
  else if c >= 4000 then named 1 (AK.keyChar (c - 4000))
  else named 0 (AK.keyChar c).
named : Int -> String -> List Key .
named how s = if strlen s == 0 then Nil
  else if how == 2 then Alt s :: Nil
  else if how == 1 then Ctrl s :: Nil
  else Char s :: Nil.

# an answer as the Result its command promised; the wrong kind is an Err
asText : Reply -> Result String String .
asText r = case r of Text s -> Ok s | Failed why -> Err why | other -> Err "the host answered with the wrong kind of reply".
asDone : Reply -> Result Unit String .
asDone r = case r of Done -> Ok Unit | Failed why -> Err why | other -> Err "the host answered with the wrong kind of reply".
asNames : Reply -> Result (List String) String .
asNames r = case r of Names ns -> Ok ns | Failed why -> Err why | other -> Err "the host answered with the wrong kind of reply".

# ---- the loop ---------------------------------------------------------------------------
# The state: the host, the model, the panel as last sent, its size, the
# asks waiting for answers (token -> what the answer becomes), the next
# token, quit/failure, and the timer owner. Only this service state is linear;
# the model given to update/view/subs remains an ordinary immutable value.
PSt 1 model msg = Type (PSt Int model (List String) Int Int (List (Int, Reply -> msg)) Int Bool String (Timers.Pool msg)).

# the entry the Editor's Run calls (runprog.fpr appends it): the first
# message from the host is its Start
host : unsafe Int -> ToProgram msg -> { init : model, update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Unit .
host me go app = case hostWith defaults me go app of
    Ok u -> Unit
  | Err why -> error "hosted: {why}".

# A configured host reports admission failure after releasing every acquired
# timer. The compatible entry above turns that Result into a captured program
# failure, rather than silently losing a requested effect.
hostWith : unsafe { maxTimers : Int, checkMs : Int } -> Int -> ToProgram msg -> { init : model, update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Result Unit String .
hostWith config me go app = if not (Time.validLimits config.maxTimers config.checkMs) then
    Err "timer limits must be 1..1024 timers and 1..1000 ms owner checks"
  else case go of
    Start editor cols rows ->
      # Resized is the first update. Only its resulting subscriptions are
      # acquired; an initial subscription removed there never starts.
      first = step config me app (Resized cols rows) (PSt editor app.init Nil cols rows Nil 1 False "" (Timers.open config.maxTimers));
      (again, ready) = continuing first;
      finish (if again then Sys.loop ready (fn s -> listen config me app s) else ready)
  | other -> Err "expected the host's Start message".

continuing : PSt model msg -> (Bool, PSt model msg) .
continuing st = case st of PSt editor model screen cols rows asks token q why timers ->
  (not q and why == "", PSt editor model screen cols rows asks token q why timers).
finish : PSt model msg -> Result Unit String .
finish st = case st of PSt editor model screen cols rows asks token q why timers ->
  _ = Timers.close timers;
  if why == "" then Ok Unit else Err why.

# one message from the host or a helper, one turn (Sys.loop reclaims each
# turn's garbage: a program that runs all day does not grow by its turns)
listen : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> PSt model msg -> (Bool, PSt model msg) .
listen config me app st =
  m = receive me;
  x = keep m;
  _ = drop m;
  next = (case x of
      KeyIn code -> keys config me app (keyOf code) st
    | Resize cols rows -> resized config me app cols rows st
    | Answer token reply -> answered config me app token reply st
    | Fire msg -> step config me app (Msg msg) st
    | TimerFired token -> fired config me app token st
    | other -> st);
  continuing next.

keys : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> (ks : List Key | measure ks) -> PSt model msg -> PSt model msg .
keys config me app ks st = case ks of
    Nil -> st
  | k :: rest -> (again, next) = continuing (step config me app (Key k) st);
      if again then keys config me app rest next else next.

resized : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Int -> Int -> PSt model msg -> PSt model msg .
resized config me app cols rows st = case st of PSt editor model screen c r asks token q why timers ->
  step config me app (Resized cols rows) (PSt editor model Nil cols rows asks token q why timers).

answered : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Int -> Reply -> PSt model msg -> PSt model msg .
answered config me app token reply st = case st of PSt editor model screen cols rows asks next q why timers ->
  (case takeAsk token asks Nil of
      (Nil, kept) -> PSt editor model screen cols rows asks next q why timers
    | (back :: more, kept) -> step config me app (Msg (back reply)) (PSt editor model screen cols rows kept next q why timers)).
# the waiter for a token, and the asks without it
takeAsk : Int -> (asks : List (Int, Reply -> msg) | measure asks) -> List (Int, Reply -> msg) -> (List (Reply -> msg), List (Int, Reply -> msg)) .
takeAsk token asks seen = case asks of
    Nil -> (Nil, seen)
  | a :: rest -> (case a of (t, back) -> (if t == token then (back :: Nil, appendAsks seen rest) else takeAsk token rest (a :: seen))).
appendAsks : (xs : List (Int, Reply -> msg) | measure xs) -> List (Int, Reply -> msg) -> List (Int, Reply -> msg) .
appendAsks xs ys = case xs of Nil -> ys | x :: r -> x :: appendAsks r ys.

# one update, its effects, and the panel sent when it changed
step : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Ev msg -> PSt model msg -> PSt model msg .
step config me app ev st = case st of PSt editor model screen cols rows asks token q why timers ->
  (case app.update ev model of (model2, cmds) ->
    case specs (app.subs model2) config.maxTimers of
      Err failure -> PSt editor model2 screen cols rows asks token True failure timers
    | Ok wanted -> (case Timers.retain wanted timers of
      (Err failure, retained) -> PSt editor model2 screen cols rows asks token True failure retained
    | (Ok u0, retained) -> (case perform config me editor cmds asks token retained of
          (asks2, token2, quit, result, held) ->
            case result of
                Err failure -> PSt editor model2 screen cols rows asks2 token2 True failure held
              | Ok u -> if quit then PSt editor model2 screen cols rows asks2 token2 True "" held else
                  case Timers.add TimerFired me config.checkMs wanted held of
                      (Err failure, active) -> PSt editor model2 screen cols rows asks2 token2 True failure active
                    | (Ok u2, active) ->
                        lines = app.view (cols, rows) model2;
                        sent = (if lines == screen then Ok Unit else send editor (Frame lines));
                        failure = case sent of Ok u3 -> "" | Err e -> "the host is gone ({e})";
                        PSt editor model2 lines cols rows asks2 token2 q failure active))).

specs : (subs : List (Sub msg) | measure subs) -> Int -> Result (List (Int, msg)) String .
specs subs left = case subs of
    Nil -> Ok Nil
  | Every ms msg :: rest -> if left <= 0 then Err "subscription budget exhausted"
      else if not (Time.validPeriod ms) then Err "subscription period must be positive"
      else case specs rest (left - 1) of
          Err why -> Err why
        | Ok tail -> Ok ((ms, msg) :: tail).

fired : unsafe { maxTimers : Int, checkMs : Int } -> Int -> { update : Ev msg -> model -> (model, List (Cmd msg)), view : (Int, Int) -> model -> List String, subs : model -> List (Sub msg) | r } -> Int -> PSt model msg -> PSt model msg .
fired config me app wanted st = case st of PSt editor model screen cols rows asks token q why timers ->
  case Timers.fire wanted timers of
      (Err failure, held) -> PSt editor model screen cols rows asks token True failure held
    | (Ok Nil, held) -> PSt editor model screen cols rows asks token q why held
    | (Ok (msg :: rest), held) -> step config me app (Msg msg) (PSt editor model screen cols rows asks token q why held).

# the commands: a timer is a helper actor of the program's own, a file is an
# Ask of the host (its answer arrives as an Answer, becomes a Msg)
perform : unsafe { maxTimers : Int, checkMs : Int } -> Int -> Int -> (cmds : List (Cmd msg) | measure cmds) -> List (Int, Reply -> msg) -> Int -> Timers.Pool msg -> (List (Int, Reply -> msg), Int, Bool, Result Unit String, Timers.Pool msg) .
perform config me editor cmds asks token timers = case cmds of
    Nil -> (asks, token, False, Ok Unit, timers)
  | c :: rest -> (case c of
        Quit -> (asks, token, True, Ok Unit, timers)
      | After ms msg -> (case Timers.arm TimerFired me config.checkMs False ms msg timers of
          (Err why, held) -> (asks, token, True, Err why, held)
        | (Ok u, held) -> perform config me editor rest asks token held)
      | ReadFile path k ->
          (waiting, next) = ask me editor (ReadReq path) (fn r -> k (asText r)) asks token;
          perform config me editor rest waiting next timers
      | WriteFile path text k ->
          (waiting, next) = ask me editor (WriteReq path text) (fn r -> k (asDone r)) asks token;
          perform config me editor rest waiting next timers
      | AppendFile path text k ->
          (waiting, next) = ask me editor (AppendReq path text) (fn r -> k (asDone r)) asks token;
          perform config me editor rest waiting next timers
      | RemoveFile path k ->
          (waiting, next) = ask me editor (RemoveReq path) (fn r -> k (asDone r)) asks token;
          perform config me editor rest waiting next timers
      | ListFiles prefix k ->
          (waiting, next) = ask me editor (ListReq prefix) (fn r -> k (asNames r)) asks token;
          perform config me editor rest waiting next timers).
ask : Int -> Int -> Req -> (Reply -> msg) -> List (Int, Reply -> msg) -> Int -> (List (Int, Reply -> msg), Int) .
ask me editor req back asks token = case send editor (Ask token req) of
    Ok u -> ((token, back) :: asks, token + 1)
  | Err why -> _ = send me (Fire (back (Failed "the host is gone ({why})"))); (asks, token + 1).

# QOS adapter for MVU.runLive: store retrieval and image attachment only.
# Policy (attach/gate/scoped binding) lives in FP-RISC std/reload.
# This path does not write sys/live: replay remains the existing loader policy.
FS = use "fs".
Plug = use "../programs/mods/plug".
Reload = use "std/reload".
load me fs archive baseline = case FS.readLatest me fs "apps/{archive}.qa" of
    Err why -> Err "reload store: {why}"
  | Ok qa -> Reload.attachAt baseline Plug.attach qa.
bindAt table name = Reload.bindAt table name.

# Watcher/event adapter path: verify source identity before retrieval and again
# before adoption. Archive addressing is platform policy, independent of hashes.
loadVersion me fs archive baseline from to = case Reload.preflightVersionAt baseline from to of
    Err why -> Err why
  | Ok u -> versionBytes baseline from to (FS.readLatest me fs "apps/{archive}.qa").
versionBytes baseline from to r = case r of
    Err why -> Err "reload store: {why}"
  | Ok qa -> Reload.attachVersionAt baseline from to Plug.attach qa.
identityAt table = Mod.hashAt table.

# Published identities map to immutable archives, never mutable app aliases.
Publication = use "std/qpublication".
loadPublished me fs baseline info = case Reload.preflightVersionAt baseline info.from info.to of
    Err why -> Err why
  | Ok u -> case Publication.imageFor me fs info.name info.to of
      Err why -> Err why
    | Ok archive -> loadVersion me fs archive baseline info.from info.to.

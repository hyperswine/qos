# std/compile.fpr -- std.compile: the fpr compiler AS A SERVICE, from
# inside a running QOS Portable app.
#
# The compiler itself never runs inside QOS: it is a host process
# (tools/fprd.py hosting ./fprc behind a unix domain socket),
# and Sys.compile is the app's one-call bridge -- the source string
# rides the qosp syscall channel (tag 7), qosp's C side speaks the
# socket, and the reply comes back as Ok <assembly .s text> or
# Err <compiler diagnostics>.  What to compile, when, and where the
# result goes (e.g. a NEW file on qosp.disk via mods/qlog) stays app
# policy -- see tests/editor.fpr for the whole loop.
#
# Not in std/std.fpr on purpose: std's charter is "no unbounded worst
# case", and a compile's cost is the program's, not std's.  This
# module is the honest home for the bounded-call WRAPPER: one
# request, one framed reply, no retries.
#
#   compile profile src    the general form; profile is a token the
#                          daemon whitelists ("qos-portable",
#                          "bare-metal") -- never shell passthrough
#   qosApp src             compile for THIS tier (a qosp app image)
#   bareMetal src          compile for the rv64 bare-metal profile
#   plugin slot id src     the PACKAGE op: source -> a hot-loadable
#                          module .qa (bytes in the Ok), linked at
#                          sub-slot <slot>'s base against the CURRENT
#                          shell -- append it to the qlog store as
#                          "apps/<id>.qa" and LR.load pulls it through
#                          the compat gate: the whole edit-compile-
#                          swap ladder without leaving QOS.  The slot
#                          is the runtime mapping base: one slot per
#                          LIVE version, exactly like the disk-seeded
#                          flow (tests/selfhost.fpr is the loop).

compile profile src = Sys.compile profile src.

qosApp src = Sys.compile "qos-portable" src.

bareMetal src = Sys.compile "bare-metal" src.

plugin slot id src = Sys.compile "plugin:{slot}:{id}" src.

# Checked version + frozen package. Built has compiler identity, version, bytes.
S = use "std/string".
Reply = Type (Same | Built package).
publication name source = packageReply (Sys.compile "publication:{name}" source).
watchVersion name known = packageReply (Sys.compile "watch:{name}:{known}" "").
packageReply result = case result of Err why -> Err why | Ok bytes -> packageBytes bytes.
packageBytes bytes = case bytes == "same\n" of
    True -> Ok Same
  | False -> packageHeader bytes (strIndexOf "\n" bytes).
packageHeader bytes at = case at < 0 of
    True -> Err "compile publication: missing package header"
  | False -> packageFields (substr bytes (at + 1) (strlen bytes - at - 1)) (S.split "\t" (substr bytes 0 at)).
packageFields qa fields = case fields of
    name :: version :: hash :: Nil -> (case strlen name > 0 and strlen version > 0 and strlen hash == 16 and strlen qa > 0 of
      True -> Ok (Built {name = name, version = version, hash = hash, qa = qa})
    | False -> Err "compile publication: invalid package fields")
  | _ -> Err "compile publication: invalid package header".

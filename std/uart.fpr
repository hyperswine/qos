# ============================================================================
# std/uart.fpr -- std.uart: the TYPE-SAFE client for UART.qa
# (programs/mods/uart.fpr).  Two LINEAR PHASE TYPES make the protocol
# a compile-time property:
#
#   UartCfg    open -> params/buffer     the un-armed device: you can
#                                        configure it, you cannot write
#   Uart       arm -> write/flush/get/   the live device: DMA-shaped
#              sub, close                writes, completion flushes,
#                                        downstream rx
#
# Both are LINEAR (`1`): every operation consumes the handle and
# returns the successor, so use-after-close, double-close, handle
# aliasing, and write-before-arm are all COMPILE errors -- the same
# exactly-once discipline Vec carries, now inference-enforced, so an
# unannotated caller gets the checks too.  Memory safety rides the
# same fact: the one handle is the one owner, and every transfer
# round-trips through the service actor (no shared buffers, no
# aliased device registers).
#
#   svc = spawn UM.actor;              # or System.qa's /services/uart
#   h  = U.open svc;                   # UartCfg
#   h2 = U.params h 1;                 # divisor
#   h3 = U.buffer h2 8192;             # outgoing budget
#   u  = U.arm h3;                     # UartCfg -> Uart: interrupts on
#   (n, u2) = U.write u "payload";     # DMA enqueue, returns at once
#   u3 = U.flush u2;                   # completion round trip
#   (rx, u4) = U.readRx u3;            # take buffered rx bytes
#   _ = U.close u4;                    # release: handle is CONSUMED
#
# Every call is a full round trip through the UART.qa main actor --
# buffer setup, params, DMA kick, flush completion, rx take -- and the
# DEVICE's interrupts (tx-empty, rx-ready) interrupt that actor only.
# ============================================================================

UM = use "../programs/mods/uart".

UOpen = UM.UOpen.
UParams = UM.UParams.
UBuf = UM.UBuf.
UArm = UM.UArm.
UWrite = UM.UWrite.
UFlush = UM.UFlush.
UGet = UM.UGet.
USub = UM.USub.
UClose = UM.UClose.
UOk = UM.UOk.
UOkI = UM.UOkI.
UOkS = UM.UOkS.
UErr = UM.UErr.

UartCfg 1 = Type Int.
Uart 1 = Type Int.

# unwrap-and-consume: the case IS the one use of the incoming handle
cfgSvc h = case h of UartCfg svc -> svc.
uSvc h = case h of Uart svc -> svc.

# one RPC round trip to the service actor
rpc svc msg =
  me = myself 0;
  _ = send svc (me, msg);
  receiveFrom me svc.

# one checked round trip: rpc is a transitive receive-origin, so
# AUTODROP v2 discharges the reply's release here -- no manual drop
# anywhere in this module (the leak this client once shipped is now
# impossible to write)
okCall what svc msg =
  r = rpc svc msg;
  case r of
    UOk -> Unit
  | UErr e -> error "uart {what}: {e}"
  | o -> error "uart {what}: protocol reply mismatch".

# ---- phase 1: configuration -------------------------------------------------

open : Int -> UartCfg .
open svc =
  _ = okCall "open" svc UOpen;
  UartCfg svc.

params : UartCfg -> Int -> UartCfg .
params h d =
  svc = cfgSvc h;
  _ = okCall "params" svc (UParams d);
  UartCfg svc.

buffer : UartCfg -> Int -> UartCfg .
buffer h n =
  svc = cfgSvc h;
  _ = okCall "buffer" svc (UBuf n);
  UartCfg svc.

# ---- the phase transition ---------------------------------------------------

arm : UartCfg -> Uart .
arm h =
  svc = cfgSvc h;
  _ = okCall "arm" svc UArm;
  Uart svc.

# ---- phase 2: live ----------------------------------------------------------

# DMA-shaped: enqueue and return; n = bytes accepted (0 = budget full)
write : Uart -> String -> (Int, Uart) .
write h s =
  svc = uSvc h;
  r = rpc svc (UWrite s);
  n = case r of
    UOkI k -> k
  | UErr e -> error "uart write: {e}"
  | o -> error "uart write: protocol reply mismatch";
  (n, Uart svc).

# completion: answered when the outgoing buffer has fully drained
flush : Uart -> Uart .
flush h =
  svc = uSvc h;
  _ = okCall "flush" svc UFlush;
  Uart svc.

# take whatever rx bytes the interrupt path has buffered (may be "")
readRx : Uart -> (String, Uart) .
readRx h =
  svc = uSvc h;
  r = rpc svc UGet;
  # copy the payload OUT of the message slab (strcat) -- the returned
  # string must outlive our next receive; the reply root's release is
  # autodrop's (shape 3, after this binding)
  s = case r of
    UOkS m -> m + ""
  | UErr e -> error "uart readRx: {e}"
  | o -> error "uart readRx: protocol reply mismatch";
  (s, Uart svc).

# downstream push: future rx chunks arrive at `a` as (URx bytes)
sub : Uart -> Int -> Uart .
sub h a =
  svc = uSvc h;
  _ = okCall "sub" svc (USub a);
  Uart svc.

# owner's opt-in to SHARED data movement (System.qa's routed tier)
share : Uart -> Uart .
share h =
  svc = uSvc h;
  _ = okCall "share" svc UM.UShare;
  Uart svc.

close : Uart -> Unit .
close h = okCall "close" (uSvc h) UClose.

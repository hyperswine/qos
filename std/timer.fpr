# ============================================================================
# std/timer.fpr -- std.timer: the client for Timer.qa (mods/timer.fpr).
#
#   svc = spawn TM.actor;            # or System.qa's /services/timer
#   _ = T.after svc 30;              # fire-and-forget: ONE send, no
#                                    # round trip -- TFire lands in
#                                    # YOUR mailbox ~30 ms later
#   ... do other work ...
#   f = receiveFrom me svc;          # collect the fire when ready
#
#   _ = T.sleep svc 50;              # blocking: after + wait for it
#
# The wake story is the scheduler's own: while you sit in receive you
# are BLOCKED (backlog, costing nothing); Timer.qa's TFire moves you
# to the ready zone under the ordinary admission bounds -- the same
# WCET-bounded machinery every message wake rides.  No polling, no
# busy loop, and on native QOS the deadline itself is a CLINT
# interrupt serviced on an AUXILIARY hart (never hart 0).
# ============================================================================

TM = use "../programs/mods/timer".

TAfter = TM.TAfter.
TPing = TM.TPing.
TFire = TM.TFire.
TOkI = TM.TOkI.

# fire-and-forget: TFire arrives in the caller's mailbox after ~ms
after : Int -> Int -> Unit .
after svc ms =
  me = myself 0;
  _ = send svc (me, TAfter ms);   # a full service ring drops the tick: the
  Unit.                           # caller's sleep loop re-checks anyway

# blocking sleep: schedule the fire, then wait for it
sleep : Int -> Int -> Unit .
sleep svc ms =
  me = myself 0;
  _ = send svc (me, TAfter ms);
  f = receiveFrom me svc;
  Unit.
  # ^ f's release is autodrop's (unused receive: dropped at once)

# liveness probe; answers 1 iff the hardware CLINT bridge is live
ping : Int -> Int .
ping svc =
  me = myself 0;
  _ = send svc (me, TPing);
  r = receiveFrom me svc;
  case r of
    TOkI n -> n
  | o -> error "timer ping: protocol reply mismatch".
